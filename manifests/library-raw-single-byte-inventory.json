{
 "schema_version": 1,
 "recorded_on": "2026-08-15",
 "purpose": "ISSUE-007 定位副产品：v0.2.0 候选 ISO 三个图鉴档案文本字段中的裸单字节（半角空格/半角标点）实测盘点。这些字节在 VT1 字库对应槽位为空白字形，且会被严格双字节渲染器错位解析，即玩家截图中的■与乱码。",
 "candidate_iso_sha256": "24319f1bc509beab4e838bc7078b22d576280b55aece18948901fc7c0fa01bba",
 "method": "decode_production 解块 → zkan_escape_transform 解转义 → 按双字节配对走查文本字段，命中 0x20–0x7E 的裸单字节；VOIC 为二进制语音表已排除。",
 "cause": [
  "tools/build_library_v02_component.py 的 two_byte_visible_spaces 仅对 KYWD 档案生效，ROBO/CHAR 档案译文中的半角空格以裸 0x20 写入（例：角色事典 chunk400 兰德 DSCR 的『ＴＨＥ 0x20 ＨＥＡＴ』即玩家反馈的■）；",
  "ORIGINAL_FULLWIDTH_ASCII 仅覆盖数字与字母（62 字符），全部半角标点无全角替换 override；其中 <%&+-./:=~‘ 已由发布码表单独分配，其余（含 < >）在语料中出现即裸存；",
  "VT1 字库 ASCII 槽位（glyph 191–286）中标点/符号槽在原版与发布版均为空白（0 墨迹）。"
 ],
 "current_resolution": {
  "verified_on": "2026-08-21",
  "scope": "仅重建并回读 LIBRARY 组件；按本轮要求未构建、未写入 ISO，也未做 PCSX2 运行时验证。",
  "double_wing_root_cause": {
   "member": "DATA/MTVZKNPT.BIN",
   "chunk": 345,
   "source_name": "両翅＜モロハ＞",
   "historical_trigger": "旧译文正文中的 <托马> 以裸 0x3C/0x3E 写入；该项同时位于历史 CHAR 尖括号受影响清单。严格双字节渲染器由此错位，导致标题、说明及同屏标签连锁乱码。",
   "capacity_is_not_the_cause": "现行整档重排后该项槽位 528 字节，编码输出 527 字节，余量 1 字节；组件回读、二进制字段保持和编码往返均通过。"
  },
  "generalized_fix": [
   "所有 ROBO、CHAR、KYWD 文本字段在写回前统一执行双字节可见空格转换；",
   "新增按游戏字节规则游走的裸可见 ASCII 扫描，跳过双字节字符尾字节及带参数控制码，避免误报；",
   "构建器对任一文本字段命中独立 0x20–0x7E 即失败，并在归档级验收中要求 all_library_visible_ascii_two_byte=true。"
  ],
