        },
        {
          "operation": "insert",
          "original": "",
          "sp": "大戦Ｚ」"
        },
        {
          "operation": "replace",
          "original": "略称",
          "sp": "難易度\nを決定する数値"
        },
        {
          "operation": "delete",
          "original": "各シナリ\nオごとに設定されています。",
          "sp": ""
        },
        {
          "operation": "delete",
          "original": "\n",
          "sp": ""
        },
        {
          "operation": "replace",
          "original": "した時点でＳＲポイントを",
          "sp": "すと\n"
        },
        {
          "operation": "insert",
          "original": "",
          "sp": "する事が"
        },
