  "auto_accepted_count": 7,
  "user_confirmed_count": 7,
  "decisions": [
    {
      "suggestionId": "13b00d2d-8893-4168-bb8d-10989c422f38",
      "targetId": "story/006/dialogue/01.12/0001",
      "kind": "dialogue",
      "sourceTextSha256": "3101fc39b56b9c1ab9553c92461699cc900ad731033a2f0502f4e067618f8b9e",
      "previousTranslation": "“王牌变形！！”",
      "finalTranslation": "“<width:0E><space:0C>ACE CHANGE<width:16><space:16>！！”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "1ed988de-b3ee-41bb-a6cb-e535b1d637bb",
      "targetId": "story/006/dialogue/02.04/0005",
      "kind": "dialogue",
      "sourceTextSha256": "65833572fdef6b4140abe23fdeeca2cb04933a223478a3c6f5b52a43967dadbb",
      "previousTranslation": "“好，好。有形之物注定都会毁灭。\n　多米拉正因为毁灭才显得壮烈。”",
      "finalTranslation": "“好，很好。\n　有形之物注定都会毁灭。\n　多米拉唯有被毁灭才显得它光彩华丽。”",
      "choice": "submitted"
    },
    {
      "suggestionId": "5e37cc2d-9471-413e-8667-e543f6751a04",
      "targetId": "story/006/dialogue/02.04/0006",
      "kind": "dialogue",
      "sourceTextSha256": "a970dd5d26e27be52e24a699736413b8f90799fc77574b1c29d8aeb5bfca1eed",
      "previousTranslation": "“不过，这颗星球上的生物还真是有趣。\n　活蹦乱跳的猎物，实在令人愉快。”",
      "finalTranslation": "“不过，这颗星球上的生物还真是有趣。\n　这些活蹦乱跳的猎物真让人欢喜。”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "5ff06521-1f06-4c0b-894b-d8d07730a5d5",
      "targetId": "story/006/dialogue/02.04/0007",
      "kind": "dialogue",
      "sourceTextSha256": "012b8ae0cc37fd46ea9463e37781de82286d9ad6355b13478e32ba818e907649",
      "previousTranslation": "“我先说明，那台古连泰沙和我们一样，\n　也不是这个世界的居民。”",
      "finalTranslation": "“丑话说在前头，那台古连泰沙和我们一样，\n　也不是这个世界的东西。”",
      "choice": "submitted"
    },
    {
      "suggestionId": "9394aa7a-c41a-496b-928d-7b5352834914",
      "targetId": "story/006/dialogue/02.04/0009",
      "kind": "dialogue",
      "sourceTextSha256": "126190702370d2502816170b5ef5c128ce0cf57467eb15bca8386991a5509489",
      "previousTranslation": "“居然会害怕那种东西，呵呵呵呵。”",
      "finalTranslation": "“你们居然会害怕那种东西，呵呵呵呵。”",
      "choice": "submitted"
    },
    {
      "suggestionId": "a076194f-90b6-4f31-9b01-e8453cdf5a86",
      "targetId": "story/006/dialogue/02.04/0011",
      "kind": "dialogue",
      "sourceTextSha256": "1b675154f8d3b20ceec7913c39eebe629061f21880be15462e52259f8b1242aa",
      "previousTranslation": "“嗯？那我们救了这位宇宙支配者，\n　是不是该被称作宇宙救世主呢？”",
      "finalTranslation": "“嗯？那我们救了这位宇宙支配者，\n　是不是该被尊称为宇宙救世主大人呢？”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "d09c1d68-445f-4231-8836-41f8d22b2bf9",
      "targetId": "story/006/dialogue/02.04/0014",
      "kind": "dialogue",
      "sourceTextSha256": "4df61e62ceabcc95ccbdc3608df35ce400a7e67c05f5ab1212ef38848175895e",
      "previousTranslation": "“不用在意，贝加大王。正如你所见，\n　我可是个温柔的人。哈哈哈哈哈哈！”",
      "finalTranslation": "“不用在意，贝加大王。正如你所见，\n　我可是个仁慈之人。哈哈哈哈哈哈！”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "a4082d88-b99f-41d7-825f-0f0fb48788b0",
      "targetId": "story/006/dialogue/02.04/0019",
      "kind": "dialogue",
      "sourceTextSha256": "c2cdeb750ab0721718ed9a465ea45bd043826520a5bca3d828399d4da83915ff",
      "previousTranslation": "“巴雷塔，你来设计新的机械战士。”",
      "finalTranslation": "“巴雷塔，你来设计新的装甲怪兽。”",
      "choice": "custom"
    },
    {
      "suggestionId": "4a651752-638d-4a68-8ef6-e645905092d1",
      "targetId": "story/006/dialogue/02.04/0017",
      "kind": "dialogue",
      "sourceTextSha256": "93a741c382dbc4a320c2eef7e3c6bd176f23905ef275f3059dd35dc86e643a9e",
      "previousTranslation": "“今天心情真好！吉扎！拿酒来！\n　今天要和贝加大王干杯！”",
      "finalTranslation": "“今天心情真好！吉扎！拿酒来！\n　我要敬贝加大王一杯！”",
      "choice": "custom"
    },
    {
      "suggestionId": "3e09e525-850a-434b-ac2d-9964e055843e",
      "targetId": "robot/047/DSCR",
      "kind": "library",
      "sourceTextSha256": "f713c4a187ec2bf4aac00df8709bf46049260a0e81910058c126f49b944cc03f",
      "previousTranslation": "在第1话《赞波<width:0E><space:0C>ACE<width:16><space:16>登场》中登场的侦察用\n机械战士。可以利用触手前端的刀刃在地下掘进，\n还能从口中发射激光，从腰部发射追踪导弹。",
      "finalTranslation": "在第1话《赞波<width:0E><space:0C>ACE<width:16><space:16>登场》中登场的侦察用\n装甲怪兽。可以利用触手前端的刀刃在地下掘进，\n还能从口中发射激光，从腰部发射追踪导弹。",
      "choice": "custom"
    },
    {
      "suggestionId": "e0be38aa-99e6-46a9-ad2d-798a91e409ea",
      "targetId": "story/019/dialogue/02.01/0004",
      "kind": "dialogue",
      "sourceTextSha256": "685fd4a1c24eeed52685e959bfa8041ae29496f55a0bfa0556b3b9a7fbe914a8",
      "previousTranslation": "“姬艾尔小姐、苏茜亚小姐，到诺克斯城了。”",
      "finalTranslation": "“姬艾尔小姐、苏茜亚小姐，诺克斯城到了。”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "a14887d3-cb3f-4c8a-b776-9421199d014a",
      "targetId": "battle:19349",
      "kind": "battle-line",
      "sourceTextSha256": "a8a1ff742066df43ba653f14a91216396569ef62278d18bc21455be7cd58f49b",
      "previousTranslation": "“达令！加油，一百发！”",
      "finalTranslation": "“达令！加油——百鼓作气！”",
      "choice": "custom"
    },
    {
      "suggestionId": "d17ad67c-37a1-4249-9d70-c82d56c89b4e",
      "targetId": "battle:19396",
      "kind": "battle-line",
      "sourceTextSha256": "9d9d99a0df5445607875556dc7a95f60d3755fcdca2f1f477294081123cc8a7d",
      "previousTranslation": "“大姐头照顾过我，\\n　也骗过我！”",
      "finalTranslation": "“大姐头既照顾过我，\\n　也骗过我啊！”",
      "choice": "auto-accepted-submission"
    },
    {
      "suggestionId": "302cc20b-fe5c-4ad1-a353-c2380f2cd9ce",
      "targetId": "battle:19397",
      "kind": "battle-line",
      "sourceTextSha256": "10fed6e90f98e3e70d3ac7f848f2843d92367018cfe8d519d9c5b2e543b252fb",
      "previousTranslation": "“那些全都在这里还给你！”",
      "finalTranslation": "“那些全都在这里跟你算清楚！”",
      "choice": "auto-accepted-submission"
    }
  ],
  "terminology_replacements": {
