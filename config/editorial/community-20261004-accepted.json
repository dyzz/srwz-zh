  "decisions": [
    {
      "suggestionId": "5631860d-521f-49c7-9aef-ac4f186b95d7",
      "targetId": "story/019/dialogue/01.01/0026",
      "kind": "dialogue",
      "sourceTextSha256": "08db5c5d13b5fc3884277e9e5f8ddc3989ef10609e4630f7ce8ff4462dd0e8d0",
      "previousTranslation": "“总之……据我所知，\n　这里的人过着尽量不使用机械的生活。”",
      "finalTranslation": "“总之……据我所知，\n　这一带的人，生活上不会过度依赖机械。”",
      "choice": "auto-accepted-submission",
      "reason": "必要以上にはメカを使わない指只在必要时使用机械。“生活上不会过度依赖机械”自然表达这一生活方式，避免现译“尽量不使用”过于绝对。",
      "encodedSize": 62
    },
    {
      "suggestionId": "04555b43-571d-4df7-b5e8-f3fda4dc9f19",
      "targetId": "story/019/dialogue/01.01/0027",
      "kind": "dialogue",
      "sourceTextSha256": "fbbf2b755dc520048681c345ea7479d66c0a54eaa8da942ad0589980b86937c7",
      "previousTranslation": "“那要是我们的机器出现，可就要闹翻天了。”",
      "finalTranslation": "“那一旦我们的机体在这边露面，\n　岂不是要闹翻天了。”",
      "choice": "auto-accepted-submission",
      "reason": "あたし達のマシン明确指一行人的机器人机体。“我们的机体在这边露面”消除现译“机器”的泛指，保留出现后引起骚动的判断。",
      "encodedSize": 54
    },
    {
      "suggestionId": "da3237a9-a208-4763-8d8f-8b95b8d23e43",
      "targetId": "story/019/dialogue/01.01/0032",
      "kind": "dialogue",
      "sourceTextSha256": "1d9838b04d4a6bd1976ff4b1078376fe59f4b0eb32b0d74602f59e5d0e1a3f63",
      "previousTranslation": "“加利亚的家伙们好像不知道啊。\n　宇宙里也住着人呢。”",
      "finalTranslation": "“看来加利亚的人好像不知道啊。\n　宇宙里也是有人居住的哦。”",
      "choice": "auto-accepted-submission",
      "reason": "连中在此泛指加利亚来的人，“加利亚的人”自然准确；后半句保留宇宙也有人居住的解释及口语语气。",
      "encodedSize": 60
    },
    {
      "suggestionId": "cc0992ef-9ba2-4bda-a6e4-798ae0428cf9",
      "targetId": "story/019/dialogue/01.01/0036",
      "kind": "dialogue",
      "sourceTextSha256": "a4f118590a6b645df4d4244bdaa30c2f50b09f10665add6f74085a9871c168f9",
      "previousTranslation": "“不明白的是，\n　为什么我们会被人误认为是月之民……”",
      "finalTranslation": "“现在搞不懂的是，\n　为什么我们会被误认为是月之民……”",
      "choice": "auto-accepted-submission",
      "reason": "“现在搞不懂的是”自然引出对月之民误认的疑问，保留与下一句共同列举两项问题的结构。",
      "encodedSize": 56
    },
    {
      "suggestionId": "126dab1f-0e8c-4a9c-94b3-2a4673be5ff6",
      "targetId": "story/019/dialogue/01.01/0037",
      "kind": "dialogue",
      "sourceTextSha256": "ad60ed8518998165ed76997565e3737d54c46109511b853c23f8f61745df0563",
      "previousTranslation": "“以及，住在难以置信的乡下的那个少年，\n　为什么会知道月之民……”",
      "finalTranslation": "“以及，身居穷乡僻壤的那个少年，\n　为什么会知道月之民……”",
      "choice": "auto-accepted-submission",
      "reason": "“身居穷乡僻壤”简洁表达住在极其偏远乡下的少年，并保留为何知道月之民的疑问。",
      "encodedSize": 60
    },
    {
      "suggestionId": "dece2912-10ef-49c3-b63b-2d4f62a1aa98",
      "targetId": "story/019/dialogue/01.01/0038",
      "kind": "dialogue",
      "sourceTextSha256": "eb9dc9ebdcab885e52c6b5fb099c12773854104ed6775385a7d65fb6c4c9044b",
      "previousTranslation": "“那方面，只能直接问那个罗兰君了。”",
      "finalTranslation": "“那方面，只能直接问罗兰本人了。”",
      "choice": "auto-accepted-submission",
      "reason": "本人に聞く明确说只能向罗兰本人求证。去掉直译称谓“君”使中文自然，并不改变该隐此时平和的说话态度。",
      "encodedSize": 35
    },
    {
      "suggestionId": "f310e317-39ef-42ae-834a-919e4116113f",
      "targetId": "story/019/dialogue/01.01/0040",
      "kind": "dialogue",
      "sourceTextSha256": "2ff7c9cc82d1682e8c2ef65c4c7d105b54360fcc5cea686e306a7235e61b7fc9",
      "previousTranslation": "“已经吓唬过他了。他不会说的。”",
      "finalTranslation": "“我都那样吓唬过他了。他不会说的。”",
      "choice": "auto-accepted-submission",
      "reason": "“我都那样吓唬过他了”补出布鲁梅对自己的威吓有把握的语气，对应あれだけ；后句仍判断罗兰不会泄露信息。",
      "encodedSize": 37
    },
    {
      "suggestionId": "93ff6acd-c603-41fc-8985-f5d6fad69bb9",
      "targetId": "story/019/dialogue/01.01/0042",
      "kind": "dialogue",
      "sourceTextSha256": "b695f35d0df52c41555c55523707e6256a0e54a3b1cc04bd6a19017bb33c6149",
      "previousTranslation": "“那个少年，值得信任。”",
      "finalTranslation": "“那个少年是可以信任的。”",
      "choice": "auto-accepted-submission",
      "reason": "顺畅表达该隐对少年可信的判断，含义与原文一致，语气更适合对话。",
      "encodedSize": 27
    },
    {
      "suggestionId": "5b90c165-8802-41fb-afc4-00102a35ac9f",
      "targetId": "story/019/dialogue/01.01/0044",
      "kind": "dialogue",
      "sourceTextSha256": "bd92cd9fbc3f64ebe8c151d1fc20ad6878d33c3857af2558ddf1a6e9cb0860e1",
      "previousTranslation": "“没错。不过，那么清澈的眼神，\n　在这一带可不多见。”",
      "finalTranslation": "“没错。像他那么清澈的眼神，\n　在这一带可不多见。”",
      "choice": "auto-accepted-submission",
      "reason": "“像他那么清澈的眼神”明确该隐所指是罗兰，后句保留这种眼神在附近罕见的判断；与“凭直觉吗”的上句衔接自然。",
      "encodedSize": 52
    },
    {
      "suggestionId": "6f55590d-3d71-4810-a52e-5ebd73552754",
      "targetId": "story/019/dialogue/01.01/0054",
      "kind": "dialogue",
      "sourceTextSha256": "de929056935a0dd00ea2c4502d031934eeaa8ca6bb7df85c6ee60af2b5edbdcc",
      "previousTranslation": "“我可没那种心情……”",
      "finalTranslation": "“我可没那种心情啊……”",
      "choice": "auto-accepted-submission",
      "reason": "句末“啊”自然表达盖纳此时提不起兴致的语气，没有增加新含义。",
      "encodedSize": 25
    },
    {
      "suggestionId": "24827fd1-4f61-4c86-9d04-0701bf4bb2ec",
      "targetId": "story/019/dialogue/02.02/0006",
      "kind": "dialogue",
      "sourceTextSha256": "69a99c02e6b500ae0923aefaae704701fa3f2222d41bcc22e1a5ee1b3cc6be19",
      "previousTranslation": "“这是成人的仪式！姐姐也做过的！”",
      "finalTranslation": "“这可是成人的仪式！\n　当初姐姐也是这么过来的！”",
      "choice": "auto-accepted-submission",
      "reason": "“这可是”对应の的强调，“当初姐姐也是这么过来的”表达姐姐也经历了相同成人仪式，比“姐姐也做过的”更自然。",
      "encodedSize": 50
    }
