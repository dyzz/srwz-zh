  "entries": [
    {
      "id": "battle:10853",
      "file": "corpus/zh/battle/srvc-lines.json",
      "group": "gym",
      "ja": "「俺は二千年も三千年も演習をしている\\n　ギムとは違う！」",
      "before": "“我和演习了两三千年\\n　的吉姆可不一样！”",
      "after": "“我和演习了两三千年\\n　的基姆可不一样！”",
      "online_opinions": [],
      "editorial_status": "reviewed"
    },
    {
      "id": "battle:14466",
      "file": "corpus/zh/battle/srvc-lines.json",
      "group": "turntype-fix",
      "ja": "「これがターンタイプの\\n　モビルスーツの力か！」",
      "before": "“这就是Turn系机体\\n　MS的力量吗！”",
      "after": "“这就是Turn系机体\\n　的力量吗！”",
      "online_opinions": [],
      "editorial_status": "reviewed"
    },
    {
      "id": "story/010/dialogue/01.15/0010",
      "file": "corpus/zh/story-dialogue/stage-010.json",
      "group": "vega",
      "ja": "「とりあえず、ガイゾックとベガは\n　確実に敵だろうぜ！」",
      "before": "“总之，盖佐克和维加肯定是敌人！”",
      "after": "“总之，盖佐克和贝加肯定是敌人！”",
      "online_opinions": [],
      "editorial_status": "reviewed"
    },
    {
      "id": "story/010/dialogue/01.61/0000",
      "file": "corpus/zh/story-dialogue/stage-010.json",
      "group": "vega",
      "ja": "「ガイゾックにベガ…！\n　あいつら、コロニーを落とすのに\n　手を貸しているの！？」",
      "before": "“盖佐克和维加……！\n　他们在帮助殖民卫星坠落吗！？”",
      "after": "“盖佐克和贝加……！\n　他们在帮助殖民卫星坠落吗！？”",
      "online_opinions": [],
      "editorial_status": "reviewed"
    },
    {
      "id": "story/015/dialogue/01.08/0003",
      "file": "corpus/zh/story-dialogue/stage-015.json",
      "group": "keibi",
      "ja": "「あれはオーバーマン、ラッシュロッド。\n　乗っているのは、警備隊隊長の\n　ヤッサバ・ジンだ…！」",
      "before": "“那是超限人，拉什罗德。\n　驾驶它的是警卫队队长，\n　亚萨巴·金……！”",
      "after": "“那是超限人，拉什罗德。\n　驾驶它的是警备队队长，\n　亚萨巴·金……！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/027/dialogue/02.02/0152",
      "file": "corpus/zh/story-dialogue/stage-027.json",
      "group": "amelia",
      "ja": "「んじゃ、ガリアとアメリアの中間の\n　交易ポイントまで頼むぜ」",
      "before": "“那就拜托到加利亚和\n　亚美利加中间的贸易点。”",
      "after": "“那就拜托到加利亚和\n　阿美利亚中间的贸易点。”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/01.21/0000",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「アメリアから新天地を探して\n　こっちに来たってわけね…」",
      "before": "“从亚美利加寻找新天地跑到这边来了啊……”",
      "after": "“从阿美利亚寻找新天地跑到这边来了啊……”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/02.01/0015",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「アメリアから移動してきたムーンレィス、\n　新連邦に弾圧された人々、\n　そして、戦争で家を焼かれた人達…」",
      "before": "“从亚美利加迁移来的月之民、\n　被新联邦镇压的人们、\n　还有在战争中失去家园的人们……”",
      "after": "“从阿美利亚迁移来的月之民、\n　被新联邦镇压的人们、\n　还有在战争中失去家园的人们……”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/02.01/0022",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「こっちのアメリア産のフルーツ、\n　目玉商品になりますよね！」",
      "before": "“这个亚美利加产的水果，\n　会成为主打商品吧！”",
      "after": "“这个阿美利亚产的水果，\n　会成为主打商品吧！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/02.01/0034",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「さあいらっしゃい、いらっしゃい！\n　アメリアから産地直送のフルーツだよ！」",
      "before": "“来啊来啊，欢迎光临！\n　亚美利加产地直送的水果！”",
      "after": "“来啊来啊，欢迎光临！\n　阿美利亚产地直送的水果！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/02.01/0043",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「いらっしゃいませ！\n　アメリアのフルーツはいかがですか！」",
      "before": "“欢迎光临！\n　亚美利加的水果怎么样！”",
      "after": "“欢迎光临！\n　阿美利亚的水果怎么样！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/034/dialogue/02.01/0099",
      "file": "corpus/zh/story-dialogue/stage-034.json",
      "group": "amelia",
      "ja": "「アメリアに降りたムーンレィスも\n　こっちの大陸に来てるからな。\n　その内、シベ鉄ともぶつかるだろうぜ」",
      "before": "“降落在亚美利加的月之民也来到这片大陆了。\n　迟早会和西伯铁冲突吧。”",
      "after": "“降落在阿美利亚的月之民也来到这片大陆了。\n　迟早会和西伯铁冲突吧。”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/052/dialogue/02.01/0029",
      "file": "corpus/zh/story-dialogue/stage-052.json",
      "group": "keibi",
      "ja": "「その制服…\n　シベ鉄の警備隊のものか」",
      "before": "“那套制服……\n　是西伯铁警卫队的吧。”",
      "after": "“那套制服……\n　是西伯铁警备队的吧。”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/061/dialogue/01.05/0009",
      "file": "corpus/zh/story-dialogue/stage-061.json",
      "group": "gym",
      "ja": "「とっととしろよ、ミドガルド。\n　ギムに言われて、お前の手伝いに\n　来てやったんだからな」",
      "before": "“快点啊，米德加尔德。\n　我可是受吉姆之命来帮你的。”",
      "after": "“快点啊，米德加尔德。\n　我可是受基姆之命来帮你的。”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/061/dialogue/01.28/0000",
      "file": "corpus/zh/story-dialogue/stage-061.json",
      "group": "gym",
      "ja": "「ちっ！　ギムの命令でも\n　ディアナ・カウンターの援護なんざ\n　やっぱり気が乗らん！」",
      "before": "“切！就算是吉姆的命令，\n　支援迪安娜回归军这种事果然提不起劲！”",
      "after": "“切！就算是基姆的命令，\n　支援迪安娜回归军这种事果然提不起劲！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/063/dialogue/01.36/0000",
      "file": "corpus/zh/story-dialogue/stage-063.json",
      "group": "vega",
      "ja": "「戦いをやめろ、エルダー！\n　ガイゾックやベガと手を組むのは\n　危険だ！」",
      "before": "“停止战斗吧，伊尔塔！\n　和盖佐克、维加联手是很危险的！”",
      "after": "“停止战斗吧，伊尔塔！\n　和盖佐克、贝加联手是很危险的！”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/063/dialogue/02.01/0056",
      "file": "corpus/zh/story-dialogue/stage-063.json",
      "group": "vega",
      "ja": "「ガイゾックはベガやエルダー、\n　アルデバロンと連合を組んでいる…」",
      "before": "“盖佐克与维加、伊尔塔、\n　阿尔德巴朗组成了联合……”",
      "after": "“盖佐克与贝加、伊尔塔、\n　阿尔德巴朗组成了联合……”",
      "online_opinions": [],
      "editorial_status": "draft"
    },
    {
      "id": "story/063/dialogue/02.02/0112",
      "file": "corpus/zh/story-dialogue/stage-063.json",
      "group": "timewarp",
      "ja": "「出来た…！　出来たぞ！\n　やはり、トリニティエネルギーを使えば、\n　タイムワープが可能になる！」",
      "before": "“成功了……！成功了！\n　果然，使用三位一体能量，\n　就能实现时间跃迁！”",
