      "file": "corpus/zh/story-dialogue/stage-120.json",
      "class": "A",
      "reason": "decided",
      "winner_id": "story/131/dialogue/02.03/0010",
      "before": "“博士！你居然拿枪对着我们！”",
      "after": "“博士！您竟然把枪口对准我们！”",
