      "file": "corpus/zh/story-dialogue/stage-120.json",
      "class": "A",
      "reason": "decided",
      "winner_id": "story/131/dialogue/02.01/0024",
      "before": "“连杀手布彻也因接连失败而感到焦躁。”",
      "after": "“就连杀手布彻也因接连失败而感到焦躁。”",
