@@ -0,0 +1,36 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readableReviewText, reviewSearchText, sameReviewText } from './review-text.ts';
+import { countGameTextCharacters } from './translation-length.ts';
+import { buildCharacterDiff } from './translation-diff-parts.ts';
+
+test('hides native typography while retaining fullwidth text and paragraph boundaries', () => {
+  const raw = '贝克的部下。与<width:0E><space:0C>Ｄｏｖｅ<width:16><space:16>\n一起帮助贝克越狱。';
+  assert.equal(readableReviewText(raw), '贝克的部下。与Ｄｏｖｅ\n一起帮助贝克越狱。');
+  assert.equal(readableReviewText('<WIDTH:0e><SPACE:0c>１２３，ＡＢＣ！'), '１２３，ＡＢＣ！');
+  assert.equal(readableReviewText(raw), readableReviewText(readableReviewText(raw)));
+  assert.ok(raw.includes('<width:0E>'), 'display conversion never mutates its input');
+});
+
+test('preserves variables, icons, other controls and malformed tags', () => {
+  const controls = '$n $N {player} %s <<width:0E>> <<space:0C>> <color:01> <wait:10> <width:F> <width:000> <space:ZZ> <width:0E>>';
+  assert.equal(readableReviewText(controls), controls);
+  assert.equal(readableReviewText('<<width:0E> <space:0C>>'), '<<width:0E> <space:0C>>');
+});
+
+test('ignores typography in editorial differences and unchanged-proposal checks', () => {
+  const raw = '<width:0E><space:0C>ＡＢＣ<width:16><space:16>计划';
+  const clean = 'ＡＢＣ计划';
+  assert.ok(sameReviewText(raw, clean));
+  assert.deepEqual(buildCharacterDiff(readableReviewText(raw), clean), [{ kind: 'same', text: clean }]);
+  assert.equal(sameReviewText(raw, 'ＡＢＣ作战'), false);
+  assert.equal(sameReviewText('$n出发', '$N出发'), false);
+  assert.equal(sameReviewText('甲\n乙', '甲乙'), false);
+});
+
+test('search and visible counts work across injected tag boundaries', () => {
+  const raw = '新<width:0E><space:0C>UN<space:16><width:16>军';
+  assert.equal(reviewSearchText(raw), '新un军');
+  assert.equal(countGameTextCharacters(raw), 4);
+  assert.ok(reviewSearchText(raw).includes(reviewSearchText('新UN军')));
+});
