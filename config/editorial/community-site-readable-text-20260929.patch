+// Presentation only. Keep exported JSON and review base text byte-for-byte intact.
+// Doubled brackets are icon/control notation, not native layout instructions.
+const LAYOUT_TAG = /(?<!<)<(?:width|space):[0-9a-f]{2}>(?!>)/giu;
+
+export function readableReviewText(value: string): string {
+  return value.replace(LAYOUT_TAG, '');
+}
+
+export function sameReviewText(left: string, right: string): boolean {
+  return readableReviewText(left).trim() === readableReviewText(right).trim();
+}
+
+export function reviewSearchText(value: string): string {
+  return readableReviewText(value).trim().toLocaleLowerCase();
+}
