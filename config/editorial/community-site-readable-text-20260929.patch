+import { readableReviewText } from './review-text';
+
+export default function RawLayoutText({ texts }: {
+  texts: Array<{ label: string; value: string }>;
+}) {
+  if (!texts.some(({ value }) => readableReviewText(value) !== value)) return null;
+  return (
+    <details className="raw-layout-text">
+      <summary>查看排版原文</summary>
+      {texts.map(({ label, value }) => (
+        <div key={label}><span>{label}</span><pre>{value}</pre></div>
+      ))}
+    </details>
+  );
+}
