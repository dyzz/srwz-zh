+def complete_weapon_roster(compdata, executable, scoped_rows, full_rows, unit_rows, name_ids):
+    """Freeze the topic's unit roster first, then include every native weapon name.
+
+    Shared names must not recursively pull unrelated main-game units into the
+    topic. Keep one review target per text pointer and retain native slot order.
+    """
+    scoped_owners, _ = weapon_bindings(compdata, executable, scoped_rows, unit_rows)
+    unit_ids = set(name_ids) | {unit for owners in scoped_owners.values() for unit in owners}
+    owners, variants = weapon_bindings(compdata, executable, full_rows, unit_rows, allow_unowned=True)
+    selected_ids = {target for target, units in owners.items() if unit_ids.intersection(units)}
+    # Independently cover both name pointers of every nonempty slot, including
+    # slot 21. A missing export row must fail rather than silently truncate a unit.
+    for unit in range(SLOTS[2]):
+        pointer = struct.unpack_from('<I', compdata, UNITS[0] + unit * UNITS[1])[0] - BASE
+        if f'sd/compdata/{pointer:X}' not in unit_ids:
+            continue
+        for weapon in struct.unpack_from('<21H', compdata, SLOTS[0] + unit * SLOTS[1]):
+            if weapon:
+                for pointer in struct.unpack_from('<2I', compdata, WEAPONS[0] + weapon * WEAPONS[1]):
+                    if f'sd/compdata/{pointer - BASE:X}' not in selected_ids:
+                        raise ValueError(f'SP unit weapon name missing: unit {unit}, weapon {weapon}')
+    scoped_ids = {row['id'] for row in scoped_rows}
+    selected = list(scoped_rows) + [row for row in full_rows if row['id'] in selected_ids - scoped_ids]
+    return (selected,
+            {target: {unit: evidence for unit, evidence in owners[target].items() if unit in unit_ids}
+             for target in selected_ids},
+            variants, {target: len(owners[target]) for target in selected_ids})
