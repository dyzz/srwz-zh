+def bind_native_names(full_rows, selected, native, contracts):
+    """Include source-verified writeback slots even when the old filter omitted them."""
+    bound = {}
+    for section, contract in contracts.items():
+        additions = []
+        existing = {row['id'] for row in selected[section]}
+        for slot in contract['entries']:
+            key = slot['id']
+            if key in bound or key not in full_rows or key not in native:
+                raise ValueError(f'SP name binding missing or duplicated: {key}')
+            row, author = full_rows[key], native[key]
+            for source in (slot, author):
+                if (source['source_text'] != row['source_text'] or
+                        source['source_text_sha256'] != row['source_text_sha256'] or
+                        sha(source['source_text'].encode()) != source['source_text_sha256']):
+                    raise ValueError(f'SP name binding source drift: {key}')
+            if row['category'] not in CATEGORIES[section] or not author.get('translation'):
+                raise ValueError(f'SP name binding category/translation drift: {key}')
+            if not any(loc.get('member') == 'DATA/COMPDATA.BN' and
+                       loc.get('source_offset', loc.get('offset')) == slot['offset']
+                       for loc in row['locations']):
+                raise ValueError(f'SP name binding location drift: {key}')
+            bound[key] = dict(row, corpus_path=NATIVE_NAMES, corpus_id=key)
+            full_rows[key] = bound[key]
+            if key not in existing:
+                additions.append(bound[key])
+        selected[section] = [bound.get(row['id'], row) for row in selected[section]] + additions
+    return bound
