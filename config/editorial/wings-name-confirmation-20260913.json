  "battle_sources": [
    {
      "id": "battle:22204",
      "source": "「双翅、そのような戦い方では」",
      "before": "“双翅，那种战斗方式可不行”"
    },
    {
      "id": "battle:22209",
      "source": "「双翅は私達の大事な子供！　\\n　お前になど！」",
      "before": "“双翅是我们重要的孩子！\\n　岂能交给你！”"
    },
    {
      "id": "battle:23127",
      "source": "「コイツ、もらっていいよね、両翅？」",
      "before": "“这家伙我可以拿走吧，双翅？”"
    },
    {
      "id": "battle:23132",
      "source": "「僕を試してるでしょ！　両翅！」",
      "before": "“你在试探我吧！双翅！”"
    },
    {
      "id": "battle:24030",
      "source": "「双翅…いたずらが過ぎるな…」",
      "before": "“双翅……你太胡闹了……”"
    },
    {
      "id": "battle:24031",
      "source": "「両翅殿、\\n　翅無し共の相手は私が引き受けます」",
      "before": "“双翅大人，\\n　那些无翼者就由我来对付”"
    },
    {
      "id": "battle:24035",
      "source": "「迂闊だぞ、双翅」",
      "before": "“太轻率了，双翅”"
    },
    {
      "id": "battle:24036",
      "source": "「両翅殿、ここはお退がり下さい」",
      "before": "“双翅大人，请您退下”"
    },
    {
      "id": "battle:25186",
      "source": "「戦翅両翅が貴様を倒す！」",
      "before": "“战翅双翅将打倒你！”"
    },
    {
      "id": "battle:25210",
      "source": "「双翅め…やはり子供、非力よな…」",
      "before": "“双翅…果然孩子，无力啊…”"
    },
    {
      "id": "battle:25216",
      "source": "「双翅、いい加減に戦い方を覚えろ！」",
      "before": "“双翅，差不多该学会战斗了！”"
    },
    {
      "id": "battle:25241",
      "source": "「この両翅には効きはせん！」",
      "before": "“对这对双翅无效！”"
    }
  ],
  "overview_sources": [
    {
      "id": "overview:038",
      "ordinal": 38,
      "pointer_offset": "0x10E6C",
      "text_offset": "0x8940",
      "encoded_size_with_terminator": 469,
      "source_text": "　百鬼帝国を一網打尽にするために、敢えて敵の誘いに乗る一\n行。その戦いの場に現れた堕天翅・両翅の攻撃に、チームワー\nクの取れないアクエリオンは窮地に陥る。\n　しかし、誇りのために祖国をも捨てる鉄甲鬼の覚悟に打たれ\nた一行は、百鬼帝国と堕天翅を打ち破るのであった。\n　サンドマンと不動の策の前に敗れた百鬼帝国の鬼達は、全て\n自害して果てる。\n　日本はカイメラの指導の下、新地球連邦に復帰する事が決ま\nるが、ホランドとジャミルは今後は別行動を取る事をタリア達\nに告げるのであった。\n",
      "source_text_sha256": "ddb708c4d9363693c65ed452dde169909ef7a9127218d4fb86ffceee5db01940"
    },
    {
      "id": "overview:078",
      "ordinal": 78,
      "pointer_offset": "0x10F0C",
      "text_offset": "0xD530",
      "encoded_size_with_terminator": 483,
      "source_text": "　スカルムーン連合内の主導権を握るため、地球洪水化作戦を\n敢行するアルデバロン。しかし、ルビーナやテラルとの出会い\nを経て、アフロディアの中には迷いが生じようとしていた。\n　全戦力を挙げて人工太陽を攻撃する一行であったが、敵大部\n隊と堕天翅の出現に苦戦する。その窮地を復活したグランナイ\nツとソルグラヴィオンが救う。\n　デビットの援護もあり、一行は敵の作戦阻止に成功し、堕天\n翅の子供、双翅とアフロディアを捕える。\n　一行が勝利に喜ぶ中、クインシュタインは複雑な表情を浮か\nべるのであった。\n",
      "source_text_sha256": "797f85b6a12fd8787c8bb1cd1ad2540578cf3411340682567a78bac679675320"
    },
    {
      "id": "overview:085",
      "ordinal": 85,
      "pointer_offset": "0x10F28",
      "text_offset": "0xE270",
      "encoded_size_with_terminator": 530,
      "source_text": "　ロゴスのレクイエムにより大打撃を受けるプラント。\n　その頃、オーバーデビルに取り込まれたゲイナーにより、ガ\nウリとサラまでが捕えられてしまっていた。\n　決死の覚悟でオーバーデビルに挑む一行の前に現れる堕天翅\n詩翅と両翅、カイメラとグレン。\n　麗花の叫びに人間の心を取り戻したグレンは、自らを犠牲に\nして両翅を葬る。その姿に勇気を呼び起こされたつぐみの活躍\nでサラとガウリの呪縛も解かれる。\n　サラと仲間達の声に自分を取り戻したゲイナーはシンシアを\n救い、オーバーデビルを撃破する。\n　シルヴィアも詩翅と決別し、戦いを決意するのであった。\n",
      "source_text_sha256": "7eaafc48e1c4873745dfeadef2370d17c070627c768fd8e2763fa731de9b8c16"
    }
  ],
