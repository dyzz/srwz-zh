+    def test_relaid_library_body_uses_its_actual_source_commit_date(self):
+        updates = json.loads((DATA / 'review-translation-updates.json').read_text())
+        target = 'robot/217/DSCR'
+        update = updates['entries'][target]
+        fields, _ = __import__('export_commit_history').library_context()
+        path = 'corpus/zh/library/v0.2-reviewed.json'
+        before = library_field_translations(git_json(update['commit'] + '^', path), fields)
+        after = library_field_translations(git_json(update['commit'], path), fields)
+        self.assertNotEqual(before[target], after[target])
+        self.assertEqual(update['translation'], after[target])
+        self.assertEqual(update['updatedAt'], git('show', '-s', '--format=%cI',
+                                                 update['commit']).strip())
