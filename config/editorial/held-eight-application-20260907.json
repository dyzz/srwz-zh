    {
      "id": "story/117/dialogue/02.01/0101",
      "group_rank": 664,
      "source_ja": "「決めてくれるじゃねえかよ！\n　ミスター・オーバーヒート！」",
      "source_text_sha256": "5d5e3687037348c3410326ed5d9f6af9deff0f6981d82a55c992838b2650ed77",
      "corpus_path": "corpus/zh/story-dialogue/stage-117.json",
      "before": "“真有你的！过热先生！”",
      "final_translation": "“真有你的！Mr.Overheat！”"
    },
    {
      "id": "story/117/dialogue/02.01/0102",
      "group_rank": 664,
      "source_ja": "「そんな暑苦しい名前で\n　ゲイナーを呼ばないでよ！」",
      "source_text_sha256": "b4afed7b6324be0f1c6364e01eed6f505ca48f30fe7c25f537afb1b680a90cd7",
      "corpus_path": "corpus/zh/story-dialogue/stage-117.json",
