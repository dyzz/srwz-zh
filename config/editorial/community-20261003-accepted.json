      "sourceTextSha256": "0e7ce27128695d2002952019e3e84753cc3500f58cfdf4dc01282f9bb27ab660",
      "previousTranslation": "“组合，交叉！”",
      "finalTranslation": "“交叉合体！”",
      "choice": "submitted",
