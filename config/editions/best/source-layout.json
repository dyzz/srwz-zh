  "stage_source_revisions": [
    {
      "id": "story/025/dialogue/01.26/0002",
      "original": "「確かにな。\n　ザフトも接近していた以上、\n　あのままでは泥試合だったな」",
      "best": "「確かにな。\n　ザフトも接近していた以上、\n　あのままでは泥仕合だったな」"
    },
    {
      "id": "story/027/dialogue/01.19/0006",
      "original": "「…少尉さんよ！\n　このまま戦っても泥試合になるだけだ！\n　出直した方がいいぜ！」",
      "best": "「…少尉さんよ！\n　このまま戦っても泥仕合になるだけだ！\n　出直した方がいいぜ！」"
    },
    {
      "id": "story/029/dialogue/02.01/0045",
      "original": "（姉さん、こいつらです…。\n　この悪魔ような３人が俺の生活を\n　メチャクチャにしています…）",
      "best": "（姉さん、こいつらです…。\n　この悪魔のような３人が俺の生活を\n　メチャクチャにしています…）"
    },
    {
      "id": "story/034/dialogue/01.01/0002",
      "original": "「御曹司！　どうやら\n　ムーンレィスは流れ者を雇い、\n　野党紛いの事をしているようです！」",
      "best": "「御曹司！　どうやら\n　ムーンレィスは流れ者を雇い、\n　野盗紛いの事をしているようです！」"
    },
    {
      "id": "story/038/dialogue/02.01/0103",
      "original": "「そうじゃねえだろ！\n　ゲイナーの奴…百戦錬磨のラブハンターに\n　女心を聞きに言ったんだ！」",
      "best": "「そうじゃねえだろ！\n　ゲイナーの奴…百戦錬磨のラブハンターに\n　女心を聞きに行ったんだ！」"
    },
    {
      "id": "story/053/condition/00/03",
      "original": "ヒュドゥエルの撃墜。",
      "best": "ヒュドュエルの撃墜。"
    },
    {
      "id": "story/080/dialogue/02.02/0034",
      "original": "「じゃあ、俺達はどうすればいいんだ？\n　桂に頼んで、時空を修復してもられば\n　いいのか？」",
      "best": "「じゃあ、俺達はどうすればいいんだ？\n　桂に頼んで、時空を修復してもらえば\n　いいのか？」"
    },
    {
      "id": "story/081/dialogue/00.01/0009",
      "original": "「ちょ、ちょっとお嬢さん！\n　こんな時に喧嘩しないてくださいよ！」",
      "best": "「ちょ、ちょっとお嬢さん！\n　こんな時に喧嘩しないでくださいよ！」"
    },
    {
      "id": "story/084/dialogue/02.01/0009",
      "original": "「第八勧界の果てにまで行った者が\n　この世である第三観界に引き戻されると、\n　あのような姿になると言われています」",
      "best": "「第八観界の果てにまで行った者が\n　この世である第三観界に引き戻されると、\n　あのような姿になると言われています」"
    },
    {
      "id": "story/095/dialogue/01.37/0001",
      "original": "「それがわかれば\n　機体を止めるだけではく\n　パイロットを救う事も出来るのか…！」",
      "best": "「それがわかれば\n　機体を止めるだけではなく、\n　パイロットを救う事も出来るのか…！」"
    },
    {
      "id": "story/096/dialogue/02.01/0007",
      "original": "「服を着替えさせる時に一度目を開けて\n　自分は新地球連邦第８８独立機動軍所属、\n　ネオ・ロアノーク大佐だと名乗ったそうよ…」",
      "best": "「服を着替えさせる時に一度目を開けて\n　自分は新地球連邦第８８独立機動群所属、\n　ネオ・ロアノーク大佐だと名乗ったそうよ…」"
    },
    {
      "id": "story/096/dialogue/02.01/0031",
      "original": "「もう一度言うぜ。\n　俺は新地球連邦第８８独立機動軍所属、\n　ネオ・ロアノーク大佐だ」",
      "best": "「もう一度言うぜ。\n　俺は新地球連邦第８８独立機動群所属、\n　ネオ・ロアノーク大佐だ」"
    },
    {
      "id": "story/102/dialogue/01.01/0141",
      "original": "「意外ですわ。\n　グエン様が、あのようなグロテクスな化け物に\n　興味を持たれるなんて」",
      "best": "「意外ですわ。\n　グエン様が、あのようなグロテスクな化け物に\n　興味を持たれるなんて」"
    },
    {
      "id": "story/102/dialogue/01.01/0213",
      "original": "「意外ですわ。\n　グエン様があのようなグロテクスな化け物に\n　興味を持たれるなんて」",
      "best": "「意外ですわ。\n　グエン様があのようなグロテスクな化け物に\n　興味を持たれるなんて」"
    },
    {
      "id": "story/111/dialogue/02.01/0297",
      "original": "「ありがとよ。\n　タルホへのプレンゼントとエウレカを\n　守ってくれてよ…」",
      "best": "「ありがとよ。\n　タルホへのプレゼントとエウレカを\n　守ってくれてよ…」"
    },
    {
      "id": "story/117/dialogue/01.80/0001",
      "original": "「く〜っ！\n　一度、これをやってみかったんだ！」",
      "best": "「く〜っ！\n　一度、これをやってみたかったんだ！」"
    },
    {
      "id": "story/128/dialogue/02.01/0213",
      "original": "「それは俺も同感だ。\n　今、奴らがを大規模な作戦を仕掛けてきたら、\n　対処が出来ないぜ」",
      "best": "「それは俺も同感だ。\n　今、奴らが大規模な作戦を仕掛けてきたら、\n　対処が出来ないぜ」"
    },
    {
      "id": "story/130/dialogue/01.64/0001",
      "original": "「く〜っ！\n　一度、これをやってみかったんだ！」",
      "best": "「く〜っ！\n　一度、これをやってみたかったんだ！」"
    },
    {
      "id": "story/150/dialogue/01.09/0000",
      "original": "「ランド！」",
