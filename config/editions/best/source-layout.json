  "battle_source_aliases": [
    {
      "old_id": "battle:02947",
      "original": "「ったく、次はあてられるんじゃねえぞ！」",
      "best": "「ったく、次は当てられるんじゃねえぞ！」"
    },
    {
      "old_id": "battle:03470",
      "original": "「ちっ！　\\n　アイアンギアーの死角を知ってやがる！」",
      "best": "「ちっ！　\\n　アイアン・ギアーの死角を知ってやがる！」"
    },
    {
      "old_id": "battle:05225",
      "original": "「我々の戦闘力を見せてつけておかんとな！」",
      "best": "「我々の戦闘力を見せつけておかんとな！」"
    },
    {
      "old_id": "battle:05268",
      "original": "「バリアとかいう奴を使えば！」",
      "best": "「バリアとかいうやつを使えば！」"
    },
    {
      "old_id": "battle:05570",
      "original": "「システムの赴くまま共に死す…\\n　それも面白いと思わんか！」",
      "best": "「システムの赴くままに共に死す…\\n　それも面白いと思わんか！」"
    },
    {
      "old_id": "battle:05643",
      "original": "「誰を相手にしているのか…\\n　わかっているのか、ハリー・オードッ！！」",
      "best": "「誰を相手にしているのか\\n　わかっているのか、ハリー・オードッ！！」"
    },
    {
      "old_id": "battle:06697",
      "original": "「そうそう！　\\n　このぐらい、やってくれなきゃな！」",
      "best": "「そうそう！　\\n　このくらい、やってくれなきゃな！」"
    },
    {
      "old_id": "battle:08976",
      "original": "「これ以上、彼ら兄弟の好きにはやらせん！」",
      "best": "「これ以上、お前達兄弟の好きにはやらせん！」"
    },
    {
      "old_id": "battle:10260",
      "original": "「ジロン、もたないよ！早くっ！」",
      "best": "「ジロン、もたないよ！　早くっ！」"
    },
    {
      "old_id": "battle:16087",
      "original": "「やべえ！弾が切れた！」",
      "best": "「やべえ！　弾が切れた！」"
    },
    {
      "old_id": "battle:16797",
      "original": "「うおーっ！　\\n　この、こんなもんでやられるか！」",
      "best": "「うおっ！　\\n　この、こんなもんでやられるか！」"
    },
    {
      "old_id": "battle:16798",
      "original": "「うわーっ！　こんちきしょう！！」",
      "best": "「うわああっ！　こんちきしょう！！」"
    },
    {
      "old_id": "battle:16756",
      "original": "「そんな腕で俺と勝負しようってか、\\n　笑わせるぜ」",
      "best": "「そんな腕で俺と勝負しようってのか、\\n　笑わせるぜ」"
    },
    {
      "old_id": "battle:17690",
      "original": "「これ程度でアークエンジェルは\\n　沈められたりしないわ！」",
      "best": "「この程度でアークエンジェルは\\n　沈められたりしないわ！」"
    },
    {
      "old_id": "battle:18550",
      "original": "「アハハハ！　油断したね！\\n　さっきので終わりと思ったのかい！？」",
      "best": "「アハハハ！　油断したね！」"
    },
    {
      "old_id": "battle:19045",
      "original": "「あんたにジロンをやらせはしないよ！」",
      "best": "「あんたにジロンはやらせないよ！」"
    },
    {
      "old_id": "battle:21097",
      "original": "「な〜んかブルーになっちゃんだよね、\\n　こういうのって…」",
      "best": "「な〜んかブルーになっちゃうんだよね、\\n　こういうのって…」"
    },
    {
      "old_id": "battle:21728",
      "original": "「∀なら、Ｘの兄さんだろ！」",
