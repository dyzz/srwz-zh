  "afterSha256": "9723ee3c1194270b0c8892356895525464f9a6027793720a08a893c04516d67e",
  "changes": [
    {
      "id": "summary/09/000",
      "japanese": "　爆発した人々の不安は暴動へと発展し、",
      "before": "　民众积压的焦虑彻底爆发，最终演变为暴",
      "after": "　民众积压的不安爆发，最终演变成暴动。"
    },
    {
      "id": "summary/09/001",
      "japanese": "そのニュースは無責任な噂と共にＵＮ上を",
      "before": "动；相关消息又裹挟着不负责任的谣言，在",
      "after": "相关消息与不负责任的谣言一同传遍UN，"
    },
    {
      "id": "summary/09/002",
      "japanese": "駆け巡り、さらなる不安をかき立てていった。",
      "before": "UN上四处传播，进一步煽动着人们的不安。",
      "after": "也进一步加深了民众心中原有的不安情绪。"
    },
    {
      "id": "summary/09/003",
      "japanese": "クーデターにより再編された新地球連邦政府は",
      "before": "经政变重组的新地球联邦政府虽派遣军队镇压暴",
      "after": "政变后重新组建的新地球联邦政府派出了军队，"
    },
    {
      "id": "summary/09/004",
      "japanese": "軍を派遣して暴徒を鎮圧するものの、人々の",
      "before": "徒，却无法将",
      "after": "对引发骚乱的民众实施镇压。暴动虽被平息，"
    },
    {
      "id": "summary/09/005",
      "japanese": "心の底に根付いた不安や恐怖までは取り除く",
      "before": "早已扎根在人们心底的不安与恐惧彻底驱",
      "after": "但民众心底根深蒂固的不安与恐惧，仍旧未能"
    },
    {
      "id": "summary/09/006",
      "japanese": "ことは出来なかった。",
      "before": "散。",
      "after": "就此得到彻底的消除。"
    }
  ],
