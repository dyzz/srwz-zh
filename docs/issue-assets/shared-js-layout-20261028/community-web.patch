+import { measure, getScene } from './text-layout/engine.mjs';
+import type { LayoutPreview } from '../app/review-layout-preview';
+
+/** Recompute in-browser with the exact same ESM shipped to the Node adapter. */
+export function previewGeometry(input: LayoutPreview): LayoutPreview & {geometryError?:string} {
+  if (input.text === undefined) return input;
+  try {
+    const scene = input.scene || (input.kind === 'battle' ? 'battle' : 'story');
+    const metrics = getScene(scene);
+    const measured = measure(input.text.replaceAll('\\n', '\n'), scene, {keywordLinks:!!input.keywordLinks});
+    let count=0, truncated=false;
+    const rows=[];
+    for(const row of measured.rows){
+      if(rows.length>=12||count>=600){truncated=true;break;}
+      let glyphs=row.glyphs.filter(g=>g.placeholder||![' ','　'].includes(g.text));
+      if(count+glyphs.length>600){glyphs=glyphs.slice(0,600-count);truncated=true;}
+      count+=glyphs.length;rows.push({glyphs,widthPx:row.occupiedPx});
+    }
+    return {...input,rows,truncated,bodyAdvancePx:metrics.step,contentWidthPx:metrics.widthPx};
+  }catch(error){return {...input,rows:[],geometryError:error instanceof Error?error.message:'无效的预览控制符'};}
+}
