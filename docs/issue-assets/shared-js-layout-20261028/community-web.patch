+test('packaged production modules and profile files retain exact source hashes', () => {
+  const manifest = JSON.parse(readFileSync('tools/text-layout/source-manifest.json', 'utf8'));
+  for (const [path, hash] of Object.entries(manifest)) {
+    if (!path.startsWith('tools/') && !path.startsWith('config/')) continue;
+    const packaged = `tools/text-layout/${path.startsWith('tools/') ? 'srwz' : 'config'}/${path.split('/').at(-1)}`;
+    assert.equal(createHash('sha256').update(readFileSync(packaged)).digest('hex'), hash);
+    if (existsSync(`../srwz-zh/${path}`)) {
+      assert.equal(createHash('sha256').update(readFileSync(`../srwz-zh/${path}`)).digest('hex'), hash, `stale production file: ${path}; run npm run layout:sync`);
+    }
+  }
