+let requestNumber = 0;
+function request(path: string, body: object, token?: string, method = 'POST') {
+  return new Request(`https://example.test/api/${path}`, { method, headers: { 'Content-Type': 'application/json', 'x-real-ip': `192.0.2.${++requestNumber}`, Origin: 'https://example.test', ...(token ? { Cookie: `srwz_review_session=${token}` } : {}) }, body: JSON.stringify(body) });
