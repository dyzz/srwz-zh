+import {layout, type SceneId, type LayoutOptions} from './text-layout/engine.mjs';
+export type BrowserLayoutRecipe = {scene:SceneId;text:string;options:LayoutOptions};
+/** Source envelopes are resolved by the server; physical layout runs here too. */
+export function runBrowserLayout(expected:string, recipe:BrowserLayoutRecipe):string {
+ const result=layout(recipe.text,recipe.scene,recipe.options);
+ if(result.text!==expected) throw new Error('浏览器与后端排版不一致，请刷新页面后重试。');
+ return result.text;
+}
