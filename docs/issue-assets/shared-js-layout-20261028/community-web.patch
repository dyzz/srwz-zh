+"""Copy/check the exact pinned official font; no network or font conversion."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = ROOT.parent / 'srwz-zh'
+DEST = ROOT / 'public/review-assets'
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--check', action='store_true')
+args = parser.parse_args()
+lock = json.loads((SOURCE / 'config/fonts/harmonyos-sans-sc.lock.json').read_text())
+files = [('font', 'harmonyos-sans-sc-regular-297b088424be.ttf'), ('license', 'HarmonyOS-Sans-LICENSE.txt')]
+for key, name in files:
+    target = DEST / name
+    if not args.check:
+        data = (SOURCE / lock[key]['path']).read_bytes()
+        if hashlib.sha256(data).hexdigest() != lock[key]['sha256']:
+            raise SystemExit('Pinned font source hash mismatch: ' + key)
+        DEST.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+    if not target.exists() or hashlib.sha256(target.read_bytes()).hexdigest() != lock[key]['sha256']:
+        raise SystemExit('Preview asset missing or modified; run npm run preview:assets:sync: ' + name)
+for manifest in ['dialogue-frame-native.json', 'battle-caption-native.json']:
+    metadata = json.loads((DEST / manifest).read_text())
+    frame = DEST / metadata['image']
+    if hashlib.sha256(frame.read_bytes()).hexdigest() != metadata['sha256']:
+        raise SystemExit('Native screenshot hash mismatch: ' + manifest)
+print('Preview font/license and native story/battle screenshot hashes match.')
+
+# Body glyphs are extracted from a verified game font snapshot, not rerasterized.
+atlas_source = SOURCE / 'shared/text-layout/assets/native-glyphs.json'
+atlas = json.loads(atlas_source.read_text())
+for name in ['native-glyphs.json', atlas['image']]:
+    source = atlas_source.parent / name
+    target = DEST / name
+    if not args.check:
+        target.write_bytes(source.read_bytes())
+    if not target.exists() or hashlib.sha256(target.read_bytes()).digest() != hashlib.sha256(source.read_bytes()).digest():
+        raise SystemExit('Native glyph preview asset drift: ' + name)
+if hashlib.sha256((DEST / atlas['image']).read_bytes()).hexdigest() != atlas['imageSha256']:
+    raise SystemExit('Native glyph PNG hash mismatch')
+print('Native 24x24 preview atlas SHA-256 matches: ' + atlas['fontDecodedSha256'])
