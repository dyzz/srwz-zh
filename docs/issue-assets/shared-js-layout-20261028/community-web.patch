+"""Site adapter for the exact same shared JS used in browser preview."""
+from pathlib import Path
+import json,subprocess,os
+from srwz.chinese_layout import ChineseLayoutError
+
+def js_core(text,scene,*,action='layout',options=None):
+    path=Path(__file__).parent/'js/cli.mjs'
+    run=subprocess.run([os.environ.get('SRWZ_NODE','node'),str(path)],input=json.dumps(dict(action=action,text=text,scene=scene,options=options or {}),ensure_ascii=False)+'\n',text=True,capture_output=True,check=True,timeout=3)
+    response=json.loads(run.stdout)
+    if not response['ok']:raise ChineseLayoutError(response['error']['message'])
+    return response['result']
