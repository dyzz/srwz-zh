+for(const scene of sceneIds){
+ const s=getScene(scene),text='目标<z>MS-013</z>已锁定。';
+ const result=layout(text,scene,{preserveLineCount:false});
+ assert.ok(result.valid);assert.ok(result.rows.every(r=>r.occupiedPx<=s.widthPx));
+ assert.equal(result.text.replaceAll('\n','').replaceAll('　',''),text);
+ const restore=measure('中<z>A1</z>文',scene).rows[0].glyphs.at(-1);
+ assert.equal(restore.width,s.width);assert.equal(restore.height,s.height);
+}
