        "direction": "auto",
        "light": "auto",
        "scale": 100
      },
      "speaker": "right",
      "name": "梅尔",
      "text": "机战一打几十个小时，谁都不想玩到半路，才发现没翻完，或者文本还得大改嘛。",
      "font": "native",
      "fontSize": 24
    },
