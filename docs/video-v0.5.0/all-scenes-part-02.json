        "direction": "auto",
        "light": "auto",
        "scale": 100
      },
      "speaker": "left",
      "name": "兰德",
      "text": "英文 SRWZ 项目那边，还有一些做 MOD 的朋友，我们也搭过把手。",
      "font": "native",
      "fontSize": 24
    },
    {
