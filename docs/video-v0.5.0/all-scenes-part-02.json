        "direction": "auto",
        "light": "auto",
        "scale": 100
      },
      "speaker": "right",
      "name": "梅尔",
      "text": "有人说，等完整版、正式版再玩。",
      "font": "native",
      "fontSize": 24
    },
    {
      "background": 80,
      "left": {
        "character": 713,
