        "expression": 0,
        "mirror": false,
        "direction": "auto",
        "light": "auto",
        "scale": 100
      },
      "speaker": "left",
      "name": "兰德",
      "text": "不过，本篇初版的文本质量，确实不够好，这个得认。做全了，和做好了，是两回事。",
      "font": "native",
      "fontSize": 24
    },
    {
      "background": 80,
