        "direction": "auto",
        "light": "auto",
        "scale": 100
      },
      "speaker": "right",
      "name": "梅尔",
      "text": "还有这里！驾驶员培养窗口边上，那条黑线也修好了。",
      "font": "native",
      "fontSize": 24
    },
    {
