    "kind": "dialogue",
    "language": "Chinese",
    "setting": {
      "speed": 1.12,
      "vol": 1.0,
      "pitch": 0,
      "emotion": "happy"
    }
  },
  {
    "id": "pun5-20",
    "section": "怕豆沙包",
    "who": "land",
    "text": "解释成“其实喜欢”，豆沙馅就接不上；保留豆沙包，又得知道典故。难就难在这儿。",
    "visual": "P06 左右对比两种取舍，不增加“装糊涂”往返串场。",
    "kind": "voiceover",
    "language": "Chinese",
    "setting": {
