  "entries": [
    {
      "id": "story/067/dialogue/01.01/0000",
      "source_text_sha256": "7ff539c037d0066185fadab02538071bb3857b6bba937890779c3087b476b880",
      "translation": "“戴蘭達那傢伙，真幹得出來……\n　居然在這個時機從內部瓦解地球聯邦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "78d8c7c1f7594fc318cc1236436e247e28f025b41bbd2016e0b29893ef55c4f7",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.01/0001",
      "source_text_sha256": "13096a7a27ecc052989792cab96d8cd2f15da5839db21d32bb9efe1aa84291b5",
      "translation": "“對聯邦來説，\n　覆蓋全世界的UN成了致命傷啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "98f09e9497b4855f8fad43d095896b37c2adb14f6baf2ce2bcfb221cd183f465",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0002",
      "source_text_sha256": "080b5a67a2c89c19997673f6f79f20e0bb59701301e1578e77b0e6c69287f99f",
      "translation": "“恐怕得知真相的市民會引發暴動，\n　搞不好聯邦會分裂成各個國家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f78f5c4f4c75a21bfef06d6e04dbef1f9976efd1ae4ca78bfee633885235b6d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0003",
      "source_text_sha256": "2fb2c6196af9e1891fb001cba6de1b6c41ec3c40a0d07896ae3f6df4dffd4625",
      "translation": "“據説入侵首都的聯邦部隊也已經撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9f0cb62280d6ae4f3a04b009d49e70a5b7ab87c80cde97c8994d65fafbfe99eb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0004",
      "source_text_sha256": "7887d6c28f3a34080f16f93d5d2082d81bbab4d9303d785505d0b3bec980eb01",
      "translation": "“壓箱底的新兵器被札多擊落，\n　後方又鬧成那樣……他們也只能撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "8a3240f0d1ee081b8565302289608c9aaa5a0ca033000ca54737b5ff00998cea",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.01/0005",
      "source_text_sha256": "5a278bbc66c0e04930e55b464607e6ce14c89676240d6562c433b3f39030804a",
      "translation": "“結果，欠了戴蘭達一個人情，真是遺憾。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "c35abc3252ba5c47df4f01c4885ef443fdc08e1fcdf2c26bdad95586fbac192f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.01/0006",
      "source_text_sha256": "4cff539d2c7dd32286a8b1fc479cf08be3722fe0626c4731e183019c80608a7d",
      "translation": "“是嗎……？\n　説不定我們只是被他那場鬧劇利用了而已。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1c2038019fbebad44f1687877753d02a492c41c2c2a83bcca565147503bda0a2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0007",
      "source_text_sha256": "9a64ad0740c07ab82839e230ec765e1cb31197b318c49ef3ac89719534431e13",
      "translation": "“您的意思是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "735bdbaf5248a9281f5539e7111355aca4683dfc8ae35b445bc3c0c580a14c65",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0008",
      "source_text_sha256": "586e80015ddb3c689d5613f9a2152e38ae0345cda1efcd163b0005442d7989b0",
      "translation": "“算了……既然沒有確鑿證據，\n　現在對PLANT表現出敵意太危險了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "0ff1b4ba752c873a427121cde1b0b4d39641d4402e93c3845b70fe53e43c75c2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0009",
      "source_text_sha256": "2310a42adcea49bb2055c361ec8db7c398081676a314390fed4868dc9403490b",
      "translation": "“畢竟，那傢伙可是揭露\n　地球聯邦腐敗的正義之士啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation"
      ],
      "notes": "",
      "zh_hans_sha256": "77c302ecda3cb4e762258b1315d6d01926b234f2bba36a61ffc23fb36095a3ed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0010",
      "source_text_sha256": "d5a353d05a7a90ad2460da9ef97bd4b9974a52e73c3158c3382dec039166a466",
      "translation": "“唉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b645dfa090cf68a5b0cddd4c40395abf9a5924cac386519f0c61743ea17ee7db",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0011",
      "source_text_sha256": "c51b788fcad5ab7041c070a039e24f4d3282b073a2af7d4b81bb07154d9cb92f",
      "translation": "“艦隊返回首都。\n　只要時空控制裝置還在，\n　奇拉姆就沒有完。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": "",
      "zh_hans_sha256": "888b0491da5fc603cd0ee8f71195e7962ac21499ad2fe6938a2e0091fb7b3d18",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.01/0012",
      "source_text_sha256": "79b177a471c7e4b3f247641b1a229b73d98eaa3542a8e7b066a8e7f56dea156f",
      "translation": "“重啓D計劃，\n　掌握時空修復的主導權。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a536c0c805294dc2723f30c684337e3138a6d65ff3f6d8a01b6dc9efde881fed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0013",
      "source_text_sha256": "6c87b3e96cc1890a27b6a9a4e73bf6ad4f2a9e8e68ecbfac1739720eee186257",
      "translation": "“明白。\n　……全艦轉向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e646d19255845f3618aaf6307857327081f040e69c6d68e44a06749a66b556ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.01/0014",
      "source_text_sha256": "e635b83e28e03f2097f76e60f9e8e07e14b95640cae6b5a689e914a61b31cffb",
      "translation": "“雷達有反應！\n　探測到高速接近的機體！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5df3ecbbc781ec45092b9596cdb8bcecdfa7469c1dde0164fe76b666ed1e3d3b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.02/0000",
      "source_text_sha256": "bd9439fecab7a2367089498d88971afe55a2822516dcdc39f2dff71f048ad202",
      "translation": "“是聯邦的追擊部隊嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "10b925f57f9b3547b20167ce671f4e06ab0b162b98f9a07b16a56a6b950bf938",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.02/0001",
      "source_text_sha256": "22c1f4a8eb2176a0eb10c1050badff99fea2d9b9da1b23acb8e1739df2e5c573",
      "translation": "“特務隊的報告中有對應機體！\n　似乎不是聯邦軍！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "e66cec6c9ff12cc0214b9a4ed306ce85cb1c9f485c0f31a8096d33319672f2a2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.02/0002",
      "source_text_sha256": "927c511d49e9ef2cf8afd69e808f809ba91692e7ca2e083ef8387ff5e72ba511",
      "translation": "“……通往太極之路……\n　沒有資格的人絕不能染指。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme",
      "zh_hans_sha256": "c503236f7dc4115ec7fd06b4b909e3f25c46c3eaf760025015afbee692068606",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.03/0000",
      "source_text_sha256": "aa3eb486e69f5d135a2e151c4f6c6d906782628385a7a54bf672b482e8588459",
      "translation": "“那傢伙的目標是時空控制裝置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "83aea27e1738355620a5340fc061314d041da4fcc251567711d2c136643f54ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.03/0001",
      "source_text_sha256": "baa458dda3be77a04232e62e10b21903bb612f2a2de43ada09801bfe7922dead",
      "translation": "“迎擊！\n　無論如何都要守住裝置！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2830d3ac44de28539c51940ec907acb9f7e3fc59d1f8d709380cc6fb5d50e33a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.03/0002",
      "source_text_sha256": "8554aa99bd2ef817b1353185d8af3ccd8876ed85ea5360fccb954bcc2f6c3259",
      "translation": "“太慢了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "02a7487e1d8470b30940f4b8643c01241eb475da114e6a3ed3a5364b494bc542",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.04/0000",
      "source_text_sha256": "bcfaf6a8780ce8a0b39b0f07ed3d07a3fbde4549c9141d27f22a9709ab452fbb",
      "translation": "“時空控制裝置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3eedd31dc17f25776e5da97f5e52bcb9733dbbb519f699013df54b7dd05687bf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.04/0001",
      "source_text_sha256": "35bb9dcc2ca3f90bb9c80fb1ec08a6ea1a216ef05d611f92500b59116d8de91d",
      "translation": "“怎麼會這樣……D計劃……\n　世界……要崩潰了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dae4513476f8c678729eb953396e4ded9146076f937145a37f437b9a01c40fcb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.04/0002",
      "source_text_sha256": "5df8b1011f4de5e456aac375a48ecfabb1763a9c95eede1445ca9652af43d2ba",
      "translation": "“這樣就好。多元世界的框架，\n　又要動搖了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": "",
      "zh_hans_sha256": "64ea51fc3d1f0d21bc4beda331f58f22e2849b61048cb33eef3bcc0b1b4c4fc5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.05/0000",
      "source_text_sha256": "e8b97f78a067353a517588d429c0978a3a9ab46f03b470d53de37a55f50627c5",
      "translation": "“可惡！\n　還是晚了一步嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dbbab15114239050520f58d8d6a73f2cac9c75ed79523880012c4630b4535050",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.05/0001",
      "source_text_sha256": "fa345bca330710063e90e5492a40d9b697b8b5046b54195246ceb20596e52592",
      "translation": "“這下糟了，$n……\n　我們被那傢伙的劇本耍了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "edf1a1ff66d683b10c219766197f6435a490b4dde31ef924f6d9d13aece66572",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.05/0002",
      "source_text_sha256": "489e0398bfc5dcb6e31c359a579b2ec673de8e63ea16b5ceb4816db7250aa247",
      "translation": "“這是怎麼回事，修理工！\n　那傢伙是什麼人！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/repair"
      ],
      "notes": "",
      "zh_hans_sha256": "3068ec57525b67eb9ffd7a38689033912b2f8c46f575b16419b09cbcbb1972e2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.05/0003",
      "source_text_sha256": "61b8f26ff31f590d56d97eb2e98bf19cdd922ae9df955b2b361ccf87408bde69",
      "translation": "“細節回頭再説！\n　我得去追那傢伙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "23c9a12644714d8145d3e4eb891c9f5397758634d6f9a8b393e1ff4f0a2cc88a",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.05/0004",
      "source_text_sha256": "2cfbc90020051a025f90510504ba27a3692845f85d9b8ba47f2a87a8eff83adc",
      "translation": "“喂、喂！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "80293b005946b3ffbc8a523b3a91137dd882629626701ad1398dc9124c1e5a14",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.05/0005",
      "source_text_sha256": "baa890e359677e09f25544386a19974956f370344016080e02372fe6154476cf",
      "translation": "“走了！\n　保重！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f010dcc425d6c2237baa3ff3aa0a876086ca6d3dc5394c034a64fcfff8b80409",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.06/0000",
      "source_text_sha256": "cc80e21543811df6f4577c7cdaf43cfeeafd354d16e4aaf5228ff8c31eb10001",
      "translation": "“切……！\n　那傢伙到底是什麼人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7d9c9ad95b25fc743be8ca49b64be6474c3a346137931a7be283dccbb177896c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0001",
      "source_text_sha256": "b3e49ef801858147fc5827a48c530bd3087cbae53dd2a6c6339266d7427c36de",
      "translation": "“阿姬娜……我也要去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": "",
      "zh_hans_sha256": "7121bda58faa8fd8e9bb7ac6e639a0ff971eb1d3f8ca2cfe2f84392182b3364f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.06/0002",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“誒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13ed62045e04cbf2614c7548e31cfda8826a67aaa0a7c2f1766728d5cb78e0b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0003",
      "source_text_sha256": "516925a32cdf3d062b70e78b72709a66cf7e47360c47d9bcdef0bdfcba903281",
      "translation": "“時空控制裝置已經被毀，\n　D計劃也就等於失敗了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13579ea2d09bd5b57c3c7790303f8e186afe8e5e41cfb1a023280d9e6ee7c24a",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.06/0004",
      "source_text_sha256": "ceb0bd443411beba62ffd675a2926d0a1e06a7e3c33f88382fb2ce88706dcf02",
      "translation": "“這樣一來，\n　上層肯定會再次計劃用特異點修復時空，\n　打算利用我和桂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "technology/singularity"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "d7e40523ceb814de5197e3dec221f6ba88bb7cbe477fccc6835e475f98ac886a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0005",
      "source_text_sha256": "a1c5a0c03f749d675798b28cc3cc7ddcde30779d0e232c2c59ae56dc9b94983a",
      "translation": "“那麼，捕獲桂木桂來維持奇拉姆……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "890a8aa4542c7be6b6e783a43a92068b1dee26986640bf18aa5163b14e5e226d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0006",
      "source_text_sha256": "b0e2cb47a8ed133ebed4c3c9948b5f4f08bf8500ce3903c05f947ac491682a04",
      "translation": "“……我已經不確定那是否正確了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5a1db55692090d8704f52cd416479a5980990ff8b00b50029238f70b6f5432dd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0007",
      "source_text_sha256": "9d9c67071a5a0395347af821900332b19f1ea7142d404bfbdff4a51ca7647895",
      "translation": "“叔叔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "72c74186d0188ece97fa6f1c27744bbb7e406a9e3c100015efe7933d7f6d5e9f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0008",
      "source_text_sha256": "bd56d988846ce5f0d79197782bbcede48ef76c5c79db6b425752d3d01ab6d660",
      "translation": "“所以，我要去見桂。\n　然後重新思考自己該做的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "9c35601f67b521e3b459d62e65da1c835f386e1c7fb8ba8904b56e5b57a72f8e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0009",
      "source_text_sha256": "07906199de3b709275f9f2f73171fd74434efca49c3ca4a5fa2372e60ad93cd7",
      "translation": "“請等一下，叔叔！\n　那我也一起去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "34848d8ab9dd6801e82c4cf393f3e75347497da0e968063f6fcfc859f823ace5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0010",
      "source_text_sha256": "9066a176f031939ceab0f94896e4b95ce736fbae1abcbdc9f0dc85c60d0761be",
      "translation": "“不行。\n　你留在奇拉姆收集情報。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": "",
      "zh_hans_sha256": "12f35b7ebad22ea652e1a514e1ddb3cdbbb53a0683c4249ed4a07673875d8773",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0011",
      "source_text_sha256": "fee1e993e8f11c62de578f259a381d23678f997c356a032a8810bb0b41abc166",
      "translation": "“那個叫蘭德的男人在追的阿薩基姆·杜文……\n　以及新聯邦的混亂……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/rand"
      ],
      "notes": "",
      "zh_hans_sha256": "353758916b8a2c1831c0bf891e6cddee510bb2baf4b0a2792e3d9367d97c7370",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/01.06/0012",
      "source_text_sha256": "83e72f37ec3dacda21614bbd60b7d6328dabd243a6760733dd751d6a98836863",
      "translation": "“事態還會繼續變化。\n　拜託了，阿姬娜。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": "",
      "zh_hans_sha256": "2dbef1e688664557c6dafc4ec28fd5c0b3444a488d9277fbae71f3602b1bc8a3",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/01.07/0000",
      "source_text_sha256": "02a8fff1b99ea6a74b387149486521fd52acbcbb0692217232a058e27506e8fc",
      "translation": "“叔叔……祝您平安……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "47cab1471d933a5dadd25bceba9fbc9c909c524ee7b0a2add6eeb5ef96b356fa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0000",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦號單人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。",
      "zh_hans_sha256": "0af44eb46db3d3641bdd20b655a4ed5138905c0289be28a2437a6f3547c28b1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0001",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦號單人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。",
      "zh_hans_sha256": "0af44eb46db3d3641bdd20b655a4ed5138905c0289be28a2437a6f3547c28b1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0002",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦號單人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。",
      "zh_hans_sha256": "0af44eb46db3d3641bdd20b655a4ed5138905c0289be28a2437a6f3547c28b1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0003",
      "source_text_sha256": "98ce79a651fbcd583d0ccf1c6ac4a47c3bbffee1f99a4ff811f62509cbe38f68",
      "translation": "　　　　　　〜智慧女神號　真和雷的房間〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/ray",
        "people/rey-za-burrel-short",
        "people/shinn",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "77199d5f9557984fe20ac16ea3f5bb8a615c2dbe8fdb1cd194a1ae195e1d6fd8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0004",
      "source_text_sha256": "8e595d9a38189e7afe12e38fbef186e3f22f8555a3088bb9abfdd339ce3d91b2",
      "translation": "“我進來了，真。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "9a2b9d200d2d56bff2fb7595f47f871b9918dae3f07e41d9f6efba002581826b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0005",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0006",
      "source_text_sha256": "34c0770a0cb91502fdd3e8f09a0a2ededb791d51212bd18cbf2cc9c528616f3b",
      "translation": "“一直關在房間裏幹什麼呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "815d82229849a31292035867c5c210a19a37c4b96744c6009e06a5073ddbc2f7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0007",
      "source_text_sha256": "2760886ea21abf6545906eeffd1feb1b64abc24fe85f954e9751024ea18c994b",
      "translation": "“我在做對付自由高達的模擬訓練。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3ef7f2aea467a998315aa663a6d2e8e73122fd869f116b8d158e7b7069316258",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0008",
      "source_text_sha256": "0f7b1ef29e8ba9e684fd3639ca64e1379ab5d0a6a11119af26fd3b67a46d9aa7",
      "translation": "“什麼……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "46c2d3de3bf77345bdd910a35ec1625ad8e308c0fd85ca6be7eec48b99c51916",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0009",
      "source_text_sha256": "0772b822a7067f8d74bcb5a676f0bf3331a5850a67a430dcd863071f0d603358",
      "translation": "“可惡！不管試多少次，\n　它都比我們的攻擊更早進入迴避動作！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": "",
      "zh_hans_sha256": "2ad2bdb4f574361022cbae3c6e480ade4ac431bba63e246e37c338ae97774a13",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0010",
      "source_text_sha256": "0c7d921d9f3a05806fe9e8b953971520ebfad2b88364df66dd8667145bf32460",
      "translation": "“還不止這樣。\n　迴避的同時轉入攻擊，\n　我們連調整姿勢的時間都沒有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": "",
      "zh_hans_sha256": "c747ab16a74a32776d66bae6a89b0804978bb3a8d2fa13a4023dd27d6e98d0f8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0011",
      "source_text_sha256": "2d3df618447f791afa7bca8cb028acee49ec7c7594fb6bd32b289166fa52b36b",
      "translation": "“而且每一擊都准得驚人，\n　一點一點地削弱我們的戰鬥力。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1500d442265dd419e7794e028dcd0e26ce0562b6af4f70aed4a0610a4b42ec03",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0012",
      "source_text_sha256": "65f3726305e44e44949b9ee2c767ac49ba27395055cccb0e609e4f79bf4f9f72",
      "translation": "“可以説遠距離射擊戰根本沒有可乘之機。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/ranged"
      ],
      "notes": "",
      "zh_hans_sha256": "0ee9c6a63ec117cdaf3a8328b6c2eadfece289cb287247e4c942420947ef6091",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0013",
      "source_text_sha256": "9d9139585dd29f99242f77e1857cb09e193455d048c552c8e3ff00c6e3cc389b",
      "translation": "“他的推進器用得也很漂亮，\n　想讓機體怎麼動，就能怎麼動。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8ee238749d3db67a48dc7abab37d8ade465899e885aaa78d4201ab99abbd5ef7",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0014",
      "source_text_sha256": "0024451bb22b8402bca5879a8bcffc42a925c605a89448221817e37a0ada7034",
      "translation": "“自由高達的出力在衝擊高達之上。\n　居然能操控到這種地步……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/impulse-gundam-short。",
      "zh_hans_sha256": "06fc953e763d52674bfacb32f366f457264a6e7e426cbe541260b8d33f048f97",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0015",
      "source_text_sha256": "5aa1b43192a03327a2cb2f71acdffb5e7829d14cca63c9ed1a1889a008e138f0",
      "translation": "“模擬跟自由高達交手……\n　你們到底想幹什麼？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c4edaad164115ae2d7e39ed7fb4d431f71a77def6216936c2671cc70d01ade9b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0016",
      "source_text_sha256": "455aa4d5ddaa646ba8560d75d03cbc1f8ae4abe8995fbfe4d1aadbcb350c7e07",
      "translation": "“因為它很強。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e6e9c00f26df663fa07d313c4369f889337305e6819b7ea2959d301aa6aa03a5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0017",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a9d093ba3ffbf3d293bc0b2362d0b8c8f462bb10566dbe7aba4ee6046667d5bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0018",
      "source_text_sha256": "6bab85dea8f9435feb5ae72ae2935d5ad8fef3c3794508b256389b025751d215",
      "translation": "“自由高達的駕駛員可以説是最強的敵人。\n　連那台毀滅高達都打敗了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/pilot"
      ],
      "notes": "",
      "zh_hans_sha256": "7aa379181326929046b68b5426d235c85a8c8acab61764d27811b7575a667891",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0019",
      "source_text_sha256": "ee05ff80cb0cd1f563e8ca6c622025791622c49ccc1a72b8a0aaf33a3dc96bc8",
      "translation": "“那麼，以它為對手訓練，\n　我覺得是好事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a7d945da2709aca4706ceecf797740ba201b2d783a51055fccbeb3fa459c8693",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0020",
      "source_text_sha256": "0f0fe0934b7a4f9b54c01b3f96cefaaf31b37f1819ff57849aa916fb33392ff7",
      "translation": "“……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4bb76d118de054ea527601b4ad2e04bd9c40f3239de36fd081391b0fbcde34a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0021",
      "source_text_sha256": "8adb2b13a667e51cef815a22d9bd97517e6735d88214084ffcd9d041ae35b54a",
      "translation": "“萬一出事，\n　沒人能打倒它可不行吧？\n　那傢伙完全搞不懂在想什麼。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dad81c35b57e0ec65426eb7101edac2a3c992f2fdcc8910d637d9d32138da031",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0022",
      "source_text_sha256": "b4780912cd6d5a76efb6eb6d602461a46f1091e7c960ca65d2018ae8279ee863",
      "translation": "“真！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "cd3d441131e4fa8e60adafeba63486a889dff9fe83a6d616421bedadc52ee3b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0023",
      "source_text_sha256": "148fe04ef21a7c2f1075b66e907d1e3d62071bd2faf0d207dd9542159256556a",
      "translation": "“我覺得真説得有道理。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "1d9ca53ed382606c050313150ee63d66782452a88a5caba21b7cd27792dd5646",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0024",
      "source_text_sha256": "faeb9df5b81c474f71a2745d66a7a5a72889596b91cfcb01d669a294cc7d1bb8",
      "translation": "“既然自由高達是我們的障礙，\n　總有一天要正面交鋒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5aa9ac5143dd50f4f882c10fdd5e4910911fc64843d0b15765f0ac9516c04116",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0025",
      "source_text_sha256": "8945eed6b44d8ea853b73ca2205ba236321383d2dc692676f4f2627a533e3ca3",
      "translation": "“嘉美尤……$n……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": "",
      "zh_hans_sha256": "2135b34843836a48a1d85955ac4c0e7b7d0515fe119a994e5dc8fd8f7099115d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0026",
      "source_text_sha256": "966d428342628c0a8b416366b990c184f467d1644ba60d27c5c331f178bdfd27",
      "translation": "“自由高達很強。\n　而且，雖然不知道它有什麼打算，\n　但它不是我軍。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "222f2dca4b1243e5300782a6a262bfe125fa3cd1e9dbaf98184b9005460727d4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0027",
      "source_text_sha256": "ab5ea1eb7ac8e7b9e085490b70444e20acfe413feb0f2684b99bd27fd40c5dd9",
      "translation": "“$n小姐説的那種情況，\n　理應被考慮在內。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "99d045943d40691aa424f6d563e3fc85e1c31b303791cb05911a1bbfb5dea6d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0028",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0029",
      "source_text_sha256": "688842b1af0ed5c6d98079ec4753752c376d5a7de2a9bdba6cb480a1ac8a4299",
      "translation": "“即使您曾經和那位駕駛員並肩作戰……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1c228b22ea72b86b2792220fca2917d65f28dece5fa6e2ce312a0c881cc2fcef",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0030",
      "source_text_sha256": "db45a797fc3f61d2d26c81fffdb125e79d07ec2128c13212c672a144732e4249",
      "translation": "“但是，基拉不是敵人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kira"
      ],
      "notes": "",
      "zh_hans_sha256": "d5de2580a0173d14d10a326676d3e9fc0e1d599de8866bf63d465d0d94453470",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0031",
      "source_text_sha256": "0c2acae7a1ad52102f3f18c2f950d70d3fddfd5e0df1d882af29c30ac9b867e8",
      "translation": "“為什麼能這麼説？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "323aba4488a1d330dbea9385054065b0f1980e2c9378fea906664eb1c345efbe",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0032",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0033",
      "source_text_sha256": "2df6457b468ba2510890b3407ab605d702f319b5198f3a85e5ac435ec39bb157",
      "translation": "“海涅因為它而死，\n　你自己也被它擊落了吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "951d19faf0ab4d4dad5417bc46a165e45cce17719cf47f866f7f1a0b04a640ee",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0034",
      "source_text_sha256": "00145b15a67f3560565cc2d88703857f7cbc95b927384dfa172ff14f43d49bae",
      "translation": "“打不打，由上級決定。\n　但現在還不能排除它是敵人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a3828f2854906c56fd638583dcbd31302494340019c244992a593f9ebf4d2aab",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0035",
      "source_text_sha256": "8271af2b15877301226d000f321a0c5a93543e7c51861605033abfcd6b572c0b",
      "translation": "“那麼，\n　我認為我們確實應該為此做好準備。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "87a0b5981417889712772e9a8eba5d4838f5cfa359dd3dda2508d4e8f65a37c7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0036",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0037",
      "source_text_sha256": "243f48a2b42d2827f1ababf0821a8cdc54acdd095c466322c7d54a2a8584bc8a",
      "translation": "“亞斯蘭隊長……如果可以的話，\n　能給我們一些建議嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athrun"
      ],
      "notes": "",
      "zh_hans_sha256": "eeb9ddd30881c22382ef1fe8b86af8659a54e0c7d7d1d714478e23291786b862",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0038",
      "source_text_sha256": "4d847f58a5649b9c7334da972366100d0d916dc5f2783cd64d24add3ea172549",
      "translation": "“算了吧，$n小姐。\n　失敗的經驗沒什麼參考價值。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1eb7f5586288876d2f4d27a97294ba52c0296fce4d845920340ff354db24056e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0039",
      "source_text_sha256": "9cc417b635da35f1c326c7b5ebbe6341a2e5c9432bbed724340e7df8c3a448d2",
      "translation": "“什麼！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c95d600897af56f91bc440c1c8f0e18d9bc8d7d60c01ae5c47accfe8ace44086",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0040",
      "source_text_sha256": "a05dc1d432e3308ae6cc50219b81fa28c55baa4bd18bc1fbcbd59da7fde9404c",
      "translation": "“抱歉，亞斯蘭。\n　我會跟真説的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athrun",
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "5178a55ff5ddaf2069592fec270dad244832b62a685d59fb93001f8815b88859",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0041",
      "source_text_sha256": "6f541c403ddb7ad1ba23949146b4fe32d0f8d33d7e41269fdb30e70566cdf210",
      "translation": "“切……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0a2784865b09c6890005f61570d6c2808d66a02ecc2803133e1c0d7399ecb2ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0042",
      "source_text_sha256": "67c0f811ec86889d339a49b28372db4df417edfc64b344165ec57fe500f079a0",
      "translation": "“……走了啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "729e6cbb441cf5d7d05bd1eda72e54e3913c6a0079e95ba95fec8a076b8569b9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0043",
      "source_text_sha256": "c47821668d1e3eabe996d697485a30095772d74f7ea54889bc424d08852f0e0b",
      "translation": "“……真……可能是我多管閒事，\n　但請讓我説一句……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "bcfa7ebf95b7b891780c265b9d6cdd5d6153a22d591707dd9855a4042713231f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0044",
      "source_text_sha256": "cfaff58bbc771edddaeeaa15678942558ecd30161755e1f4a0d70ade2edbaacd",
      "translation": "“千萬不要帶着仇恨去和那台自由高達戰鬥。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ba837c717457f93576848e83b1f2cdd810bb60ff03fe6c0a59231d369b39ec43",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0045",
      "source_text_sha256": "f1ccba902ce85cafd32c76d84a23291d0ffe238911cc13fb3126a97102e390d3",
      "translation": "“$n小姐……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "809f555b45fdea53ae70129b9ef685f725a70930a5332223e97799fb702bee0d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0046",
      "source_text_sha256": "3fcf9ab0c8106b28114b129fdf58ac57559564d48ddaf940c87a79fdd456f7c3",
      "translation": "“我們該做的不是為史汀娜報仇……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/stella"
      ],
      "notes": "",
      "zh_hans_sha256": "d8edc47ce39e60c5e080b06e18a0938e08926ef49d56e417a00ff8d20de0b5cf",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0047",
      "source_text_sha256": "1c4251b3c877e112879dfb182f7e8c289dd2d16a8278e19526394111e3655030",
      "translation": "“而是為了結束這場戰爭，\n　去打倒那些擴大戰火的人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dabd393cf2a30ab6d730db90a75fc878c966ef02bc2acb2fea870de2b13eff21",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0048",
      "source_text_sha256": "ded12756d4045e6347471a3b8b77f1282aac1497efd90db6986f7e410d0395d0",
      "translation": "“……我知道，嘉美尤……\n　我知道的……所以我……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": "",
      "zh_hans_sha256": "62ab0903b67e90ec03cf6f7632ba0efbaa794b852589330223ed0b5609af95f0",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0049",
      "source_text_sha256": "f0f7f8e67877934c93b1754e54f3108a7a76cf9d7e70307938ac78e12717bfe9",
      "translation": "“我相信你，真。\n　所以下次自由高達出現時，\n　我會把一切都託付給你。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "88e603655f7c6dca8464c5b03c1cbb59cc7a83f43d50bc7bfbf062a8de991de0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/067/dialogue/02.01/0050",
      "source_text_sha256": "acd2b4cdf21097e2c5a1acfdd31cff13b5745c549e12e220175488bbd1853118",
      "translation": "“至於怎麼打倒它，\n　我也有了點頭緒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5811701b3db00e773999f3f5287e8c6a74723de68603f4d82aba4bff16d94c2c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0051",
      "source_text_sha256": "ef7a9b5f6151a13fa5b00e9890aebf04545e6984f19fcd6939b9956b8cbe95dc",
      "translation": "“真的嗎，嘉美尤！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": "",
      "zh_hans_sha256": "10e686f75d66b2c9bd7f50ede341a61808b7a8ee1a49f923e44f52b4e0a27a7d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0052",
      "source_text_sha256": "e81463a516b4ffa42fedd62e5ae1445583bee406ac9d28413aef9c6e22842c99",
      "translation": "“嗯……\n　為此你需要發揮出衝擊高達120%的力量。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": "",
      "zh_hans_sha256": "2e97b14d7001e342bd840fb372f853f567b2a01e90f6d1b7d67e3b55861d252e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/067/dialogue/02.01/0053",
      "source_text_sha256": "20917d66d488568140f9ea227b2830f1f0b6eb64c79825ba3ea2be0b3abcb044",
      "translation": "“衝擊高達120%的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": "",
      "zh_hans_sha256": "56976050b6e449b3821625a79b15e7597f63b4771a8954663145f9b715e9d54f",
      "zh_hant_status": "edited"
    }
  ]
}
