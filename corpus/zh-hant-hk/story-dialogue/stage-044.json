  },
  "entries": [
    {
      "id": "story/044/dialogue/01.01/0000",
      "source_text_sha256": "9089388c49716372a18568c73dea22504538643c46aec510306ce38639344bb4",
      "translation": "“終於要出發去日本了呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b660b363b26996178485782590b671c42ee2ec3b37f62ca22b1136cb8fc53937",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0001",
      "source_text_sha256": "90467eb51859ee95fb1fa3a8ad534cbbb2dedbd0223201efc5adbc9aeb1b1c30",
      "translation": "“來到加利亞已經兩週了……總算可以\n　開始執行議長交給我們的特別任務了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3fcd24cee338ff1635497d1497847c3bbbd3e0c397d4d731b388cdbd4f05583e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0002",
      "source_text_sha256": "91379e3fd631c5d3cc3664f9a9d554eb056f21c3954d00324af7549f11778f22",
      "translation": "“這次向日本求援……\n　聯邦已經把奧布拉到了他們那邊，\n　我們無論如何都得爭取到日本的支持……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/orb"
      ],
      "notes": "",
      "zh_hans_sha256": "4e70049210b82f2efa7bdcbdc050b88d119a5dff9441614063bb1ef2baff18e4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0003",
      "source_text_sha256": "20443f8a93bb00a006991b78d0b1f6fc458d71bc270cd42d1e0ae71ac2ce409a",
      "translation": "“……\n　如果現在的$c再加上日本的戰力，\n　就能組成最強的部隊了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a3da3958bad9c3d2c0226a823ab227fac861e93ab9694783914d2b8fa8630f0b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0004",
      "source_text_sha256": "3fba352a0e5af9fa6036869abd1bea9783d3e803c2556974c3db454a7cf2bde5",
      "translation": "“這可難説……\n　我們暫且不論，\n　但並非所有人都贊同札多。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "701a421bf990dbc3d03aa6ae94990af6b609643e9105756edf8e6c123bad976e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0005",
      "source_text_sha256": "be983e1d9427f1653534c0fe2c04179f8182f854dfdceefb5641ca0290570602",
      "translation": "“雖然表面上維持着部隊的建制，\n　但既然各自的目的不同，\n　説不定哪天就會解散……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a344a9c1a7507286f89ff6e1ec7b3519cb1a4df093d05da02c9b3db55c21ee6f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0006",
      "source_text_sha256": "d291048f3fc558060306cd95c519f4dbbba282553d51ea7ade02dc58916c86fe",
      "translation": "“我們快點出發吧。\n　我也很擔心我們的家變成什麼樣了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "399b7166ca1d471fc3d3e660c1bb93c85f46d485c0b37bc0c7f4ead9a38489ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0007",
      "source_text_sha256": "74ac7d22b9a109b1fe12de8cabea999aa7407640410f6442dd655830b8f7ecb5",
      "translation": "“別那麼着急，花江。而且也別指望\n　現在的日本還跟我們以前在的時候一樣。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d65a309ad0786c90a1189755dc9da0acdeca314a7b75664b9bb47c4d2c932dc0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0008",
      "source_text_sha256": "c89a07c69bc076fe802002fb5d867948c1464e0d1d1be9ddf36e3309f51001dc",
      "translation": "“可那畢竟是我們出生的國家……\n　果然還是會在意啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1158909621a49d4cb5fac57a4954ffd9f7205746cc456c70895a4d46b2326a4a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0009",
      "source_text_sha256": "7716359b9bd533515f658e6225dde93808850e244050f20a801c904c6dc6dc27",
      "translation": "“那個日本夾在PLANT和聯邦之間，\n　這處境真讓人心情複雜……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "4f05ca4268290e49b8677295e00d9ac9835a7140f22bfa0625737073c3ca579c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0010",
      "source_text_sha256": "0625455bc9ec5cbef899f1c4ff4413a836ce7ae5a8dd53e4d918aa36ffc1561c",
      "translation": "“我站哪邊都無所謂，\n　只想早點過上安穩的日子……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "26bd7b9aac6d20519b02605fa7d81cd3e5822a041f3373448399efa706e57a14",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0011",
      "source_text_sha256": "f50a6aee29268b477632af2ff8389617adb7c7408f8e6c5e40495a3c1599423c",
      "translation": "（我們在與蓋佐克和其他敵人作戰時，\n　確實需要後盾……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": "",
      "zh_hans_sha256": "cea7013d700e53d41b797da5715c2c6a52e5ce68edb634e1b9328c95d9e27e58",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0012",
      "source_text_sha256": "999c1075b36c086030a2bb8fee962883b0cd63c4e961991d9dea6edcd6116691",
      "translation": "（但繼續這樣與札多共同行動，\n　真的是最佳選擇嗎……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "8a586cb6525dd3cf7ec4aa84e04c4ce5537f0f5e4f321f3037739499c81da46c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0013",
      "source_text_sha256": "2e3f52570f8e6e4dd1de8fefba4b03440d7a1fef6ce80644467269abca6aaf11",
      "translation": "“目標是傳説中的土地——亞邦！\n　壽司、壽喜燒、藝伎之國呢！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/yapan"
      ],
      "notes": "",
      "zh_hans_sha256": "333e8186fd3ef09306136c81a7278f81492f8926c3739cb39f99059abefa859f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0014",
      "source_text_sha256": "56a728c2dbf8983864a2eb20ffbdd846db87ca582acc4a8ea229a88121f98a0f",
      "translation": "“我們可不是去玩的，塔荷。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-c42b03f788ed"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-c42b03f788ed。",
      "zh_hans_sha256": "c4a0833570f2f8ea667167e8aa5c92815b203a505c846d4df3da4ae88cca08e5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0015",
      "source_text_sha256": "1110e8c127ef4f7f9ca4a153412b2e184038c7374e6e1095c705461add10a02c",
      "translation": "“那我們是去幹什麼的？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "de82d8071fc5b1474a6a6b2066695978831980a266a14d10e48fd3a678baf08d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0016",
      "source_text_sha256": "a60e7e3148e62af8faf81ead61a94f55cd06bfe38363d5ec8c8e35ca9b08d45c",
      "translation": "“那邊的札多和奧干的人暫且不提，\n　我們過去有事要做嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/aeug",
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "e2894467ee808f37d1afe4a52a97b6cb2927bd18b64035623e3919d78f986865",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0017",
      "source_text_sha256": "eb6c11f79dd10ecfb4ee84ecbe4517bc11af9871b43fb08a7527f3d6f695f38b",
      "translation": "“……我怎麼知道。\n　這也是順其自然吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "426ce253f8c6f2be76a9962d98c54bf3cc2c02eba4a864e5fc4ffe2ccbe93a12",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0018",
      "source_text_sha256": "5c99de997ee1854d0e5abf276e8c97f6eab913111ab7b0516e92e0319f044f0b",
      "translation": "（這樣真的好嗎……\n　我有閒工夫隨波逐流地活着嗎……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1f17aee0f95a72f44729a8a4ee0be6f54619d65a2c8de7d9b0bfa2a62204b53a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0019",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0020",
      "source_text_sha256": "3844a16d023b5925e7a1b533a8eeecae74709b099caa26b53aef4b6d3b763344",
      "translation": "“船長……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6f75cceac4321df60edc080e3c1b4d5996dc08ad83876e5d5c6d55d35682a3ff",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0021",
      "source_text_sha256": "8e2292957e9dd77697786be01f41f9430b9b4dfd6888bb983c51dd0654a5b509",
      "translation": "（聯邦軍不知道什麼時候又會盯上荻花。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "21e5f05637b3e093ee726639753e84df81d2dca480292fb2bf60c0441fc26ec5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0022",
      "source_text_sha256": "b555be2a16c4b7e80ff57e553b0d42dda55b1560e42791581127e9d01a1a9091",
      "translation": "（而且，聯邦軍利用新人類到底想幹什麼……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "skill/newtype"
      ],
      "notes": "",
      "zh_hans_sha256": "ee35d6a4f3e21a3b2f3b85502447aa20895a33a3f8349a54f333a9025ff37afc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0023",
      "source_text_sha256": "f37f82c23998be67c720c70713f87fe49b5e1dac9e0f02ca7eaa3d25d296d615",
      "translation": "（根據他們的目的，\n　説不定哪天PLANT也會成為我們的敵人……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "1546f9bdafccf1d27982368aae540e3fbd9813df1c66fe53892fc1c76318fb26",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0024",
      "source_text_sha256": "afc83e375804530a85f137052492061d74e8bb0baf3d20ed5bef50611def2a1c",
      "translation": "“好了，出發吧，科特塞特！\n　目標是亞邦……不，日本！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d054189b475d",
        "place/yapan"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-d054189b475d。",
      "zh_hans_sha256": "1336e9fcdbd7d05ff4c9cb8646b6ad5b59d12b910cb3fb3b6a27ffb9b9a0ba16",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0025",
      "source_text_sha256": "4b6cf4ba2a1e8121a4ff113efba21ea11fa747ed8aa5bcc526d7ee9048058f8c",
      "translation": "“小姐，這樣好嗎？\n　就這麼聽札多的擺佈……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "d6e2dabacfbf6344a905c885c99f76a17cf71f5803ec0af9086c6ba4571a8638",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0026",
      "source_text_sha256": "3ea64df19f6bdbb4ca5ae53918db6ae4d0b72833045cc5e49ea9b025e54099bd",
      "translation": "“沒辦法啊。\n　既然成了被聯邦追捕的人……\n　那就只能大樹底下好乘涼了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "daba9939de288efbb7e135bb0431400c4eb2a985ffa5d4c62e4726ad7a817bea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0027",
      "source_text_sha256": "3709ca683ceec5df3645e767d77d44ceb92da6e83b2a5084272513a7d4620a01",
      "translation": "（雖説是順其自然，\n　但鋼鐵齒輪也站到了反聯邦的立場上……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/iron-gear"
      ],
      "notes": "",
      "zh_hans_sha256": "51de580609ec273505554d6e58bc79179e341844381c16325d6343e955a0280c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0028",
      "source_text_sha256": "8cfdb530df3663b45f479ad55aa3ea4da078f6ad920291b45a08a1ebc0e5795e",
      "translation": "（這樣下去，\n　$c將成為反聯邦勢力的核心……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a4d69b41ac84fa24ff5f0bb8e6a6f040c8999c5d787a81d213253f631e6274c7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0029",
      "source_text_sha256": "935c5581fb16fced1ff4d63a398c06ced21e6533e92a2e231a09ff664c002792",
      "translation": "（如果能指揮這一切，\n　説不定能做到比奪回英格雷薩更多的事。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/ingressa"
      ],
      "notes": "按日文源词绑定统一全局术语：place/ingressa。",
      "zh_hans_sha256": "49ffbcf701f1f757dac08bd1cc6fe9e97aafc4f105d76f0dbb43443456a68601",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0030",
      "source_text_sha256": "115721563390c0f52b2a6c0a92bd834112107e63a4da96bd064e58cf0e039299",
      "translation": "（只要繼續作為$c的一員行動，\n　奇拉姆也不會輕易出手。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": "",
      "zh_hans_sha256": "8188f053228b4bb72996c56f7ddae82b84fcd631b36be003737f15cc93f2fae4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0031",
      "source_text_sha256": "c9ad06120132d9bbc191d6e56ab1ae4c9f4849e60f5826e84b7a5e8e5dc8a414",
      "translation": "（剩下的就是看準時機，\n　把桂帶回埃曼本國就行了。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "13699e7d0d16f772ab693de623bec855ff8058970983440a2a9a10750986b457",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0032",
      "source_text_sha256": "06a6ef7dc3a71e562b1b7f9ce651e910646afe7ec07a7b6eea57c68fed93b418",
      "translation": "“你們倆怎麼了？\n　怎麼都皺着眉頭……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5923785dc5abd0d77eaed40c1aaf851101ddf52222f831be7caf2bcdb9da0d0f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0033",
      "source_text_sha256": "2149da8086ed37fe12cc5c56bc7f5b0d80bf2a610bd06191b4186e1699c0a5b8",
      "translation": "“沒、沒什麼，摩姆……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-431100102afc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-431100102afc。",
      "zh_hans_sha256": "04697c6d5664cfffd852a9d298a7b12efbcec99353acc922a659cffa6a9a9b31",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0034",
      "source_text_sha256": "4d9e191b875bf2f684858167cff30724ed1353d4f946ef038df56ad61bf8c2a1",
      "translation": "“夏雅小姐，\n　雅邦天井的各位都來送我們了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-7e722f885dfc",
        "place/yapan",
        "place/yapans-ceiling"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-7e722f885dfc。按日文源词绑定统一全局术语：place/yapans-ceiling。",
      "zh_hans_sha256": "721463fc8f86e8c0b4140ce21bceda594f784a1ba396987afd13a1e9ee2622dd",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0035",
      "source_text_sha256": "54906c745e0c5e8d586d1f870238f46bf0b105b18732fde8d40fbb1891db7167",
      "translation": "“雖然發生了很多事，\n　但也要在這裏和那些人告別了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c9fa9fc0a3136ec721179392eb93d9b966216cfe2aa37c41ce78a4cc3371bdfa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0036",
      "source_text_sha256": "c3b33bad9fbe8eee6cd38c95e5b951925e7b5edff524ad050e07feb88293eb8d",
      "translation": "“$c的各位，\n　非常感謝你們〜！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ad7bfa57c7ebe9f3d3ebe51a9298d39bba9a6d141b2f7d1068637050f8bafc60",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0037",
      "source_text_sha256": "e7a75925c9553557a90854eed8cece9d0427983e5c491a54d538ce1250f74317",
      "translation": "“祝各位旅途平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6ba20a8296300e506d8831e202fba73d8040119c91790c2b5a3ce720dd254ab8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0038",
      "source_text_sha256": "508d6457fe99d14decc99abfb225f592de88f4efa9873e015759ee22dff91e5c",
      "translation": "“基拿、紀因！\n　高富利隊的各位還有雅甸都，\n　都要保重啊〜！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/adette",
        "people/gain",
        "people/gainer",
        "people/speaker-980ee4d20d74"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-980ee4d20d74。 日文“元気”为普通词（精神、健康或保重），不是人物元气。",
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ],
      "zh_hans_sha256": "b95b30237ecdd5b661d8a8ebd1fa6e3bc73fdbb73c4bc243f93d4fe19fba14b6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0039",
      "source_text_sha256": "a49b8b687891203696ff1a13f698422c57d8b11678fbac637a8afad74fe340bc",
      "translation": "（夏爾蕾大人……祝您旅途平安。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9b551f35363b54e3f6a5574a9707026ec802bfab9a6bbfe2660f580b2393760b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0040",
      "source_text_sha256": "4c3bd35fc64b661dbd2b9c8f3ab55a7aeb5ee6a8cf04b2836193e798dd7b0187",
      "translation": "（艾蕾卡……\n　願你前行的道路充滿光明……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": "",
      "zh_hans_sha256": "7fd2525a8aa3626c6f08e5ffdbfe624562376b4c3ef113b9425bf7a6e467804d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/01.01/0041",
      "source_text_sha256": "51bfbef54b25fd525327d93e206b8b1ed8c395db0666cc338e9ad5fa67021418",
      "translation": "“那麼……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c00b1d43e07be0eeaac12bb740b13482e0aaf4bd450819d3cff223b99b104f9f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0042",
      "source_text_sha256": "f7666e5fd2e303e6d127d32b0032fd30eb6e62f83e498d0a0ceb8ce399d7ca47",
      "translation": "“嗯……\n　$c各艦，啓動。\n　目標日本，早乙女研究所。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2402082d5f805058dd79b38133e4a9a6f7b4cae12a56f2d5eee788548e6f1f01",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.01/0043",
      "source_text_sha256": "dc572e61d6ff95c9abcda34d712d28d87314bcde83997156e9a62c62f671e47a",
      "translation": "“出發！前進〜！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9810968200466dd8de4ea5b6c065396b67535dccc27fa7f810b4a0d92962535e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.02/0000",
      "source_text_sha256": "1c58432c4614d72a36b0e36cd60aebc248b6452e1d25220e19094a63cc4915c9",
      "translation": "“已經走了嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8be62e0bcd6ecfe148f4b860a16044f0433c58c474eb5a66f4441cbee7273c6f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.02/0001",
      "source_text_sha256": "26b2b299cdd6052383ef868546048f3f1cebf9f6fe0335fb0ffd95172566f8c8",
      "translation": "“在這個混亂的世界裏，\n　他們是為了誰，以什麼為目標，\n　又要去往何方呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "719870f7e5ec0f77afa6cba072f05fea27f286c95008353389d169607275e1f8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.02/0002",
      "source_text_sha256": "b47b9c393042dadbc9454d7a2c12dcd17c1eb9d27f513a6b9bf01e5828bf0d28",
      "translation": "“……話説回來，安娜公主殿下呢？\n　好像從剛才就不見人影……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "db00940c7bc92d54639db0aee1743b797641d0a637774a8d6db7a16d72a9ff9a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/01.02/0003",
      "source_text_sha256": "7d8809cc9c0b04a8012cea3e12db2375999ab60aaf811c73b86aa4b2e35b0acc",
      "translation": "“這麼説來……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "52d8bb424c10de9bc386514432b021da2daa50da71e88c4e4d012f99a51d7b6d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0000",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "基拿的房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "d39be5b04af20f8620ef823175b992f3fca4a8a571f4d0682d36325118c55a3f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0001",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "基拿的房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "d39be5b04af20f8620ef823175b992f3fca4a8a571f4d0682d36325118c55a3f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0002",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "基拿的房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "d39be5b04af20f8620ef823175b992f3fca4a8a571f4d0682d36325118c55a3f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0003",
      "source_text_sha256": "4aa52e860ed5549d3b975b4104909c24684734695d9539922ed298c9e12055b3",
      "translation": "　　　　　　〜雅邦天井　基拿的房間〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "place/yapan",
        "place/yapans-ceiling"
      ],
      "notes": "按日文源词绑定统一全局术语：place/yapans-ceiling。",
      "zh_hans_sha256": "72d66a785e59ee7d3434be92ba501fc91dc8fe7f88deabae87a0eabd9414f9d3",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0004",
      "source_text_sha256": "2bc70f64b70bbe40a9e307202356a1e39177bde62a61a68b5b3b90850cc41b9a",
      "translation": "“……嘿，原來KING他們\n　經歷過逃難行動啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": "",
      "zh_hans_sha256": "a4e6b20b6bcfebf2960d8d71814277e612f92b1594e67fe40b383a2cf5c5fa6f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0005",
      "source_text_sha256": "fec8abf8fd6e5a771de670ab66f0db8a6e3871593096a80b41b261fe4ddaa5e4",
      "translation": "“抱歉一直瞞着您，仙茜亞小姐。在卡泰茲時，\n　我也因為這件事捲入了麻煩，沒能和您見面。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "f38cff47db177f4bee04e14e57321b32386108aa17088d360725b1d20e0e4287",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0006",
      "source_text_sha256": "f069d3549336e80bffff1b4f805156d14323d758e8609c0433bc08d3cae460d2",
      "translation": "“不用在意。\n　約會的機會以後還會有吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8d79b1d5c6821f0b3982bb2b9ef2afdc5e6553bf6f8dca28111600b6a1633cd6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0007",
      "source_text_sha256": "4bf9ea51588dee83c8a014a451191191d2ae2c4e8c711dd81994e66f223e892b",
      "translation": "“那您願意和我見面嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e640775ebdc5f47597b45afecf2ff73f1d780afa4c21558ac8f370b6fd84bcaf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0008",
      "source_text_sha256": "65bf3c376a08329f3eb246ddaf7c3bc9357efb9dbd373e20cfd01c0294d65544",
      "translation": "“有機會的話。\n　……對了，既然逃難行動成功了，\n　你們以後就打算一直住在那裏嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": "",
      "zh_hans_sha256": "ed88888d5ba5ff83f7a33d4978a6812c531bb9e501c5d0d077a1e1d140a3faeb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0009",
      "source_text_sha256": "ea2497ab48357144dee2131aae407d7ec83a8be5e81f7a685e8f6878023fad61",
      "translation": "“不……\n　為了我自己的逃難行動，\n　我還要再次踏上旅途。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": "",
      "zh_hans_sha256": "a4020a89daa11136fc27905fcbb2ac0324a871571172f17cb7f06a45157b68fb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0010",
      "source_text_sha256": "867b29fcb7f93412ad9f0d2652921bbf5e471c1360d861acabb33bfbc5496ec8",
      "translation": "“屬於自己的逃難行動嗎……\n　真不錯呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": "",
      "zh_hans_sha256": "672fda13e7b69e7cd2f9c151c38d7a87b1e6ce04e37cb176d604400575c771d1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0011",
      "source_text_sha256": "da4c65a9740388d38c9d2e8aa7cb29ddb96cdd4208bdb27ffec6ca693cab4fae",
      "translation": "“基拿！\n　你還打算在UN上閒聊多久？\n　馬上就要出發了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "1efd85547bee2c51ad80a15a99a3da438c7ded9b59684a81c2c75bc047f3a3bd",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/044/dialogue/02.01/0012",
      "source_text_sha256": "24e9681a802426522c876d31621149356829371b0572cc67a71a46aafc8bb1bd",
      "translation": "“是、是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4f310eaa52f6debaba492e06d870e915836fb33df17205dc11457eb65d943859",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0013",
      "source_text_sha256": "943e220af3606ee96dbc9817dfcc515d25a80bf07bc8cd0a088aac590e48c704",
      "translation": "“剛才那個女人是誰？\n　難道你們住在一起？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f5598924aebd4cfe9c0f721ddaeaad796e155ec76d4d14b57e06c555ce3ca304",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0014",
      "source_text_sha256": "96e8a5e0b0085956ddcd4a0b2be0d778bbd1f57a3d93fd61c18c91d4dd922782",
      "translation": "“怎、怎麼可能！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0ea48ebbbc5974ede98003205af5c4dd8f9f4e9fbaacf949c85c635d0e5163f9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0015",
      "source_text_sha256": "853ba771198c0d1fdb3e755efe85ed2ac08709877dfbc2e495a2789b084e7b0f",
      "translation": "“啊哈哈，KING。\n　祝你一路平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5973d7b1e43a630ed486486f549b6bbd168a89eb67a42bc72f1f27ea8bfbfd83",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/044/dialogue/02.01/0016",
      "source_text_sha256": "ac2f555c377274171bf653d90044eb5704f0c342abc9f56f1d2a04c40bed6451",
      "translation": "“謝謝您，仙茜亞小姐。\n　希望有朝一日能和您見面。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "ac3551c007ed32f9f009891645f00e9d4cf93f47d164748474f969661f3c1634",
      "zh_hant_status": "edited"
    }
  ]
}
