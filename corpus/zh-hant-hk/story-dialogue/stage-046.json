  },
  "entries": [
    {
      "id": "story/046/dialogue/00.01/0000",
      "source_text_sha256": "3c826fff86817b626e4404b3aac2b8656c106a5ff3288ad6e1f25e350cc4c953",
      "translation": "“來了，希德拉元帥！\n　他們就是$c！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-3bf5cd30c935"
      ],
      "notes": "",
      "zh_hans_sha256": "33d7d172c55d49416e5c159163d52706da517a45c283effa20c367493cbe72cd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.01/0001",
      "source_text_sha256": "f47db31870b499557bed10dff5a3c11a051b9b838d2e1001385992cfce610cf0",
      "translation": "“三一萬能俠和機械天使\n　也在那支部隊裏嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/aquarion",
        "unit/getter-robo",
        "user/unit/aquarion"
      ],
      "notes": "",
      "zh_hans_sha256": "ee7b422b7bbf16c4d115c8fc9d075e12895269af186d739bf966cc1e2738e745",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.01/0002",
      "source_text_sha256": "3d0d4a6d532c183cf55260a9d173cd708e6b82986808d252f7279e2520094df8",
      "translation": "“是的！\n　請趕快派出迎擊部隊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "93808e33d0104889065f558e56dd9ecc1e9442b4a41a3c2e71191e4ca1ba7d22",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.01/0003",
      "source_text_sha256": "e1e1f047f1c7fac447d66cdfac545e8b46179451c2ae4896e11b701f8dec08df",
      "translation": "“別慌，獨眼鬼。\n　這座光子力研究所的防備很萬全。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-be29ed800edf",
        "place/photon-power-laboratory"
      ],
      "notes": "",
      "zh_hans_sha256": "2d2561d1de0fc00b1098f9aa7138068f7c23daf530ee8db59bd056d6b357faaf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.01/0004",
      "source_text_sha256": "4e506afa3240de6ae2fb863fcdbed330dac67b3a86e72e3ce29cb3c31fe3c77a",
      "translation": "“光子力研究所沒有動靜！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/photon-power-laboratory"
      ],
      "notes": "",
      "zh_hans_sha256": "ed7ce15da4f6ea107d51911bce48ac1215d2d80b8dd7d5ecdb9eb487e4f4a375",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.01/0005",
      "source_text_sha256": "4cf53658e4a4c74d9ea417436ef4c598260889820017f7f6388d50fde346ca72",
      "translation": "“你是説他們沒有迎擊我們的意思嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "483efab429ca62e640f5d0eda14e239669fe08b0464b8e31274261af67385c1b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.02/0000",
      "source_text_sha256": "82f87a80e4c30c75ad2f8eec2a609f4d8f296d159ba79ba5269314273efb06ac",
      "translation": "“甲兒的雙合體機出擊了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4",
        "system/launch",
        "unit/double-spazer"
      ],
      "notes": "",
      "zh_hans_sha256": "c89d8bc6763e6bd1b70eb6bc33952278147612d7dc026407a383aa7679bcb166",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.02/0001",
      "source_text_sha256": "72187d85f34e03fc80dcf3e3b9658dac948d32e3dee1f77e5681bffff4f2e1af",
      "translation": "“別做魯莽的事，甲兒！\n　先觀察敵人的動向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": "",
      "zh_hans_sha256": "dd022f54e9582bb9ca5ebaf31a9f60a89e8a07d60630ca92cedca7beeb761cfe",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.02/0002",
      "source_text_sha256": "4d070bafed00bc8caf4715ac4111b6fbc55d09a88113336e2b502a434d27c5ee",
      "translation": "“可沒這個閒工夫！\n　再磨蹭下去，\n　研究所就會用那個了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fe86276e02402b4dea96a46959e1986ae4fbc89021201c6fc8c586a7800207cd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.03/0000",
      "source_text_sha256": "187d62c9bad94f6cc5478b227c211a46af1167da7fb10aa832ce95b01a5aaefe",
      "translation": "“這邊也跟上甲兒！\n　智慧女神號，最大戰速！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "49242030facfb7daa75b2950c684f758dc6a47f3b1f9657c15ff2919dd98e2bb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.03/0001",
      "source_text_sha256": "3374ca8ac169ed7a1f2dcc2f19a5077c5a524aef267bdca6a8201f4ed56bc324",
      "translation": "“瞭解！智慧女神號，最大戰速！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "4918baa8c02308ecdf635e25080b4c1a40a99efaffd48f18e9972ebdbabb94bb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.04/0000",
      "source_text_sha256": "f485f865db16046ac44f9934f83abda953286c45d5f4c0587c68914fa5eb898e",
      "translation": "“哼……飛蛾撲火！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0d5751e0279225c2a6db18e4a5709e48405704031109fed7a64b1acc9c858f1c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.04/0001",
      "source_text_sha256": "316cc72b584215d7abe043d124f3e4eb3815d2c593c6e974bff299e43c3210f1",
      "translation": "“屏障發生裝置，\n　以及迎擊系統啓動！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "db4d71bc600b3017928fe2951b951a8f0c0f61c696bb5ca9e5d6936aa3654b0d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0000",
      "source_text_sha256": "9ddf0c7808ce73f1c2ffc295ad30003f94bf9a92ed257057cd9349060a746b62",
      "translation": "“嗚哇啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "16ee36c358b7ca362a9e97cf9b0e69d30c893901b43be746fdbaa21b7675ceaf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0001",
      "source_text_sha256": "368e49e18e42f823bd0b30bd5bc5db739c8934bfca6e7ce1b5581995527bc99e",
      "translation": "“甲兒！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": "",
      "zh_hans_sha256": "9ed00f7675e07597eaf15194e621bd3a268ae75edc5470a6760117ea81a2c13d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0002",
      "source_text_sha256": "62b15c346347191d9d8ea3cf22ff44a989e25ed4b080010b341138a06784f71b",
      "translation": "“爸爸！\n　繼續留在這裏，\n　只會成為迎擊系統的靶子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3871393143a800512889ffe044e02cb340e6f0e3ef0ebead8137492e99f3d74b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0003",
      "source_text_sha256": "2f265df106d467937cf0c83107b8d51c7ff7e054e089eb226f74b9d65aa92e76",
      "translation": "“但是，有那道屏障在，\n　也無法前進……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "54f28e341e745d1b8816eba149b525a2882954a6725a5dd6c609c8c0de03b2fe",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0004",
      "source_text_sha256": "e4dd2faabb2478d30e0455a43746434e5062c27ff6302e4abd335b78ddd1a14b",
      "translation": "“撤退，源五郎！\n　也給智慧女神號和阿卡馬下達指示！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-1bc14eb5d42d",
        "unit/argama",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "777b3562ec1b25736c63a8e4c47d102a48f3c659ed9241b669a3a9db8c74c1ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.05/0005",
      "source_text_sha256": "e1ed47576a0a6bedb124a90bb606bce71171466ffc2d8b5f737cf554a9620fa7",
      "translation": "“瞭解！\n　回收甲兒後，撤退！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": "",
      "zh_hans_sha256": "e3e65a040448adc1548247b9f69e218dbae905c2c899308e0656e2aa7f949d4f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.05/0006",
      "source_text_sha256": "f9e9d98bb03daef9fa937259c781a93788309759adba02abe6cd3fbbfa6cccf7",
      "translation": "“可惡啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a5f3c67bb1c975f5fc9869310c281947ce4ae3f0982e19492074f853d27c14d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.06/0000",
      "source_text_sha256": "225f51391e3865a714df02734486de8bade1ed5da431abc9325e46d60ce86b52",
      "translation": "“哈哈哈哈哈哈！\n　那些傢伙，\n　夾着尾巴逃跑了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "37e80ca3f00c64f2a4cd133ed89d390cdb85564eb7f77cbd54b724536fa548c5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.06/0001",
      "source_text_sha256": "4d15bd61f8678b75b9a1cdfb34bea0a7b389d23c2428bb5f352d3c2f601fb786",
      "translation": "“幹得好，鐵甲鬼。\n　拿佔領的研究所當據點，\n　你這招值得嘉許。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d34010c02035"
      ],
      "notes": "",
      "zh_hans_sha256": "6c3973505678f985c11e30ab9be03a1ad68738d6de911a665250fe9f03a5be71",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.06/0002",
      "source_text_sha256": "9fde857282f406d33dabec9c0c3e77e6bd69c1746a4067512199aec24fb3ea1b",
      "translation": "“這點小計，\n　誰都想得到。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7b852fa9a25b91d93c340941444128c58bdd5be8bf89377961ca190af5b6c90c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.06/0003",
      "source_text_sha256": "cc41d9508d06d5cd7832183228138853780f59f8e4de49e1ca822ac9a9a496d6",
      "translation": "“要誇就誇弓教授吧。\n　是他把研究所的屏障強化到了這個地步。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d97da89d3d05"
      ],
      "notes": "",
      "zh_hans_sha256": "4ccf78b4039f81db476777425780581547c574d17e98f34fb3529b704b8749ca",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/046/dialogue/00.06/0004",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.06/0005",
      "source_text_sha256": "7a832411736336b708d820be615b2dc8dce24377da2e64a5c1306ccda853ae15",
      "translation": "“父親大人……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c1d45d2099e2a9a36607c670cd1c908997d6ffa507b334a6632a22224462ada7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.06/0006",
      "source_text_sha256": "2ff4ece4d51ee0fa943999b381e7430bf0c004eb9aa3c9bdc45f35774e73e7a0",
      "translation": "“儘管來吧，\n　$c。\n　每次都會讓你們有來無回。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4707965ba8e695c6037bcd3800b5ec3a10ff0dc75489ea22e24fdf71762eac8e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/046/dialogue/00.06/0007",
      "source_text_sha256": "3f4e55165eeae9a6546afc2b07125bf7a8d2f3d41847efadd6d77ef751e47be8",
      "translation": "（來吧，三一萬能俠，\n　讓我看看你怎麼破我的計……\n　到那時，真正的戰鬥才算開始……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/getter-robo"
      ],
      "notes": "",
      "zh_hans_sha256": "6c126c7c90672f71fe521fa645a3cdc7b1c00737896ac87dd7560542122d5b38",
      "zh_hant_status": "edited"
    }
  ]
}
