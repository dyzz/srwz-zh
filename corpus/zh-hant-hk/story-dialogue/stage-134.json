  },
  "entries": [
    {
      "id": "story/134/dialogue/01.01/0000",
      "source_text_sha256": "bf2bdf78812574d1fe49ff6643e4b015c6fcdecbfe67b415730bef1dad902632",
      "translation": "“嗚……嗚嗚……嗚……\n　好、好冷……好冷啊，老爸……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1a48a6a002c598a9866e88a864ecb2e6393608ebd2a7c71c44ea5d37cd90c93f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.01/0001",
      "source_text_sha256": "9ed0f93786cbb24d6ffbbbb6041136c45a3b77fcd258bb0607ba6db866f33e16",
      "translation": "“我……我到底怎麼了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "72b7b3ddcd33723f647294d239c18fbbbbeb209a531b2963958f4745d7a01c63",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.01/0002",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.01/0003",
      "source_text_sha256": "ce71512ff68eca9f4f2852d7eba3ad8d885fc7be760ff4d8135bdcbd6142af00",
      "translation": "“你、你這傢伙……！\n　你對我做了什麼……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "019c073594a222af4446155261b20ecf826c91227b4a3aecb2c9d63941cb10c6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.02/0000",
      "source_text_sha256": "a6843859f5e35204a6a0db1ee212abf0fb8aec1b794784d64abb44bb1bde2989",
      "translation": "“咿！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "905522e976145d422e851761e47b6fb6b5c1daa05a83529a3d89805a94c3f962",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.02/0001",
      "source_text_sha256": "21fe8b0b0b016f5f0f0ca2243fc4c4921b4eea34dcd32eb9daefde38444c3733",
      "translation": "“我解除了\n　讓你忘掉恐懼的心理暗示。\n　現在的你，不過是個普通的孩子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b0dbd824c3e1ce2ba1f5b5848c1b32f0b733d1c6f16106a69e494837fbaedd69",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.03/0000",
      "source_text_sha256": "ea9799b8bb217e814e81d94dd4c8919e2a78a7c3d44249ff6840710b4cb670c2",
      "translation": "“住、住手……！\n　快住手啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ef2ca90047eae747b466c4c2579dace56ca75c47ee53de987876fe814b9841c6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.03/0001",
      "source_text_sha256": "a1b33af2f283709a945f3b9734c82e279aef27c188b0aa568988a1327eb79c5c",
      "translation": "“救、救命……！\n　誰來救救我啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f9d7adfb4816091b05b8b1ec675aac18a4740b1f365067ac7c7588c280555e79",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.03/0002",
      "source_text_sha256": "8abbe04ac8c8dd931b74fe11c426619a391eb994eb7c27d8a7d0791cde83d487",
      "translation": "“老爸！爺爺！\n　一太郎哥！大家！\n　快來救我啊——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b7ce1f5c46d1ceaf70bac806cc23dc94820fec38bf5fa61e8a743fb4ee763991",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0000",
      "source_text_sha256": "dcd2cb0ec2ab70c9f86777815f801384cf172a3b8f7b74679309ea063c9fe445",
      "translation": "“嗚……嗚嗚……住手……\n　快住手……\n　好可怕……好可怕啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "324bdba4717f982003556acc8ef9209d634f98cecf3e60bf5e32e3ae9b6aec8d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0001",
      "source_text_sha256": "9b6f7ac1b2dadba37c047e7b2429a70a8ffbf052b7f900a52c86e7366fe7c946",
      "translation": "“一場無人感激的無意義戰鬥……\n　你和你的同伴正是為此犧牲的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "32d4d7c849e0b1f440de4f0b39659be83de72ea45cd8d47a5a18f59c3a425b57",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.04/0002",
      "source_text_sha256": "a5b5c4b3f87a6d1bb99908e7391d363542bfd7e12ef3973fe27b3a0c9e932f03",
      "translation": "“住手……快住手……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "63a2b75219e3495b4132b54ee57ff5fd0467910ab231fa4eaa9e5ff44fe23f9b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0003",
      "source_text_sha256": "c76aec925369cafb40a032470b007f2005cd695fffdf3367ff1c9fabfec2554e",
      "translation": "“你心中的恐懼本是正常的感情。\n　可是，有人抹去了你的恐懼，強迫你去戰鬥。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "52a569da9c7f63caeedec3b2ec4bd5b4f356fbb685adecf37ea6a244e3de059e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0004",
      "source_text_sha256": "66301d41778ae4fd310778ce62631e8b28f66bc4b9325dba940c9092a3a072e5",
      "translation": "“……不……是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "16791eb37705f8d6ba4ca67118af11203c99d1b2f8041bec731250e7f70bf567",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0005",
      "source_text_sha256": "ae2f01f2b030349c2f84e8879803382c7d030b4d171cd0e4bdf857b54edcc7e0",
      "translation": "“不對……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d663574451b546ab09f25498eeb0ffd4174adce7b01cdb7d2baee49198bce723",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0006",
      "source_text_sha256": "954a7e73ffe8540ed569fcbeaff0d973e14dc888d369dca47bdc152c7d9c717d",
      "translation": "“我……我們確實戰鬥了！\n　為了自己珍視的東西！\n　為了地球，為了大家！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7e0b9aaed966c3d204c0cbcb9ed84ae8510975f293a0d7ce05473a8991bc5c9d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.04/0007",
      "source_text_sha256": "fee1cb6c66c300584c98a8becf4d2cd2ab8b9d7cec93fd9dca70fb582f2ef6e3",
      "translation": "“這不是無聊的事！\n　不是無意義的事！\n　我們……我們！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b74a403485545c8ea1ee97f4d2ee300c37de6205d9eddba191a2e19f4cc049e7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.04/0008",
      "source_text_sha256": "f881ed4fa419ad35f1bca8d5f308ec9b534ce0e87af20790be68bf9e4c4a3751",
      "translation": "“沒錯，勝平！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "c359c1d40aae3e60f0c52aec1e0e710b85c7ae9357eb52d10d92405d04e81830",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.05/0000",
      "source_text_sha256": "d1b91bb7ecf43b65e0cbdf7661d2d9e82cc72bc7e0fd45e6fe65335dae970f51",
      "translation": "“宇宙太、惠子……\n　你們沒事嗎……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "977994f25283e800d76ac8249e84e0cae043da2a33e771c4ee7e6e0df69aacb0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.05/0001",
      "source_text_sha256": "5e9deb911a3c08e37452202f7ee5a535267205ed94f1178ae45bdee586c330bf",
      "translation": "“也不是毫髮無傷啦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2528ede35134208788effb464bafcaf93723844992bff8c87c175947d985f322",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.05/0002",
      "source_text_sha256": "249119e5b0ea71491bc4d296b38d0979d23715fe0bcbe0b22de9d1f919f1492a",
      "translation": "“但是，我們必須戰鬥！\n　為了我們珍視的東西！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "78e8d620016cee5e5ef177e553d3bd31ad7d34d85ae52da2166d7e0b7c50ccd8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0000",
      "source_text_sha256": "8a0e92ed176e2edf9d5cc31f8ac76404c99d17c194a83cf5f145236a0ed24653",
      "translation": "“你們心裏的恐懼也被抹掉了嗎？\n　那我就來解除你們身上的束縛吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "04297ddf8564a9c2ea05ea76bb245f99c0fd51f208e069ec982942751c316172",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.06/0001",
      "source_text_sha256": "9e2ff62727ee990d2760ec6208fe2225db995ff2256f694e29845ad38f45a31f",
      "translation": "“住、住手！\n　快住手啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c897d0aebfe69f4f1e9203b84f85f57618a5f254ef5c46fa7c5936e08623bf1f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0002",
      "source_text_sha256": "24b17f449fe6461f8f6557d77e36c4891e3ca41d9616b02bed861d397f04b1d5",
      "translation": "“沒用的。\n　被恐懼支配的你什麼都做不了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3c53f6cd3a7f04ced0772c69602f3b5dfb4230cbf170497d208388e303f501b1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0003",
      "source_text_sha256": "447854cf86d8ce827b39c7511bf3b7dbb4709c8204d301b519c6cab159044a6e",
      "translation": "“勝平！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "c412af988944d43895a8a1523584284c38bdc18653d98f5b3c6b0c84e3d9cffa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0004",
      "source_text_sha256": "ad65f4b3fa7b398d73e542a5add6537400d73448d420ea8949e66b71195a7da5",
      "translation": "“你，難道！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cccb9da86beadb337f5a846376d6ae59400ac9a3f63aeecdb44a6f8226fcb67f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0005",
      "source_text_sha256": "40147369113937f00e3347f6dd1e722c2fb50720207617cbd6fed4ef997943ec",
      "translation": "“怕……好怕……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "955d3e835036999ec147033cfefd9fb4b2c79cf3adcd0ae5bde8eefbc7563768",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.06/0006",
      "source_text_sha256": "4753e2a8f196e38d57a9be22b6c7c7c151a8114be31c12ed86399809a4c5fc6a",
      "translation": "“……但是……濱本、亞紀等人一定……\n　經歷了更加可怕的事……\n　所以……所以啊……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/aki",
        "people/hamamoto"
      ],
      "notes": "按日文源词绑定统一全局术语：people/aki。",
      "zh_hans_sha256": "098a49e9c1d0860d410b5d41ad19556a05c35f3d435b8693b35a006760a14511",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0007",
      "source_text_sha256": "2eb9dab8c965491ecc42c62c5d1651252f04c58e97f10baba875ab24e154cd3a",
      "translation": "“蓋佐克！\n　我怎麼會輸給你這種傢伙！\n　怎麼會輸啊——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": "",
      "zh_hans_sha256": "ff6096c4f260f6d2e2cd9b02376e0e8b203ba04ca7ec55b1ea448aade4c0dbf0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0008",
      "source_text_sha256": "b8b2ef7167095f9c5d18e4778207b84926b7e678b17a62de1c171cab3b2e8cac",
      "translation": "“沒用的。\n　你會死在這裏。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "95ed6acccacf4497bfd7d4505139530987531519f0ced6bd2bbc54c69f204c90",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.06/0009",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a9d093ba3ffbf3d293bc0b2362d0b8c8f462bb10566dbe7aba4ee6046667d5bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.07/0000",
      "source_text_sha256": "3dddbb1ba368bfcfb94ea7308ed76c8feb432197b7709aa1d68490bb1082600d",
      "translation": "“帝皇比亞路！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/king-beal"
      ],
      "notes": "",
      "zh_hans_sha256": "0ac46f9969fe950ab23fa7f05fe7494fadd76ee4e2ae1d003f24e755f9c20653",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.07/0001",
      "source_text_sha256": "1b340fe95cac3b1d82a247d3a95af8c40ed9f46904503bcf23fe104a990d6acc",
      "translation": "“為了保護我們！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7ac32346c217afc616c8233cd18cd603f84ad3e340dfeac304987a2f406f06ba",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.07/0002",
      "source_text_sha256": "d78f4cbdc94b8e561de8f2185ba3db1096976be8ab1a6db2e1d28f02d089c3b9",
      "translation": "“嗚哇啊啊啊！上吧，\n　桑波特合體！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "phrase/zambot-combination"
      ],
      "notes": "按日文源词绑定统一全局术语：phrase/zambot-combination。",
      "zh_hans_sha256": "e62e2eaf0331a139967aaefe1a6b94895a9aa001b4de44cbaca0e675e9d9f20e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.08/0000",
      "source_text_sha256": "ec09880714aee999957da9bfeee4d79d5d289539e271771be2ca4ea55bedc5d6",
      "translation": "“嗚哇啊啊啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2da6cd8654f7e5feea0c642b70df865ee3e03e4be9d4fdc6a151b63b2a2a8aea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0000",
      "source_text_sha256": "64b628d4f073057de6849071558c16c0be98c5708433b0d3ec9a6571f8c8edc1",
      "translation": "“為什麼？\n　為什麼，你還能戰鬥？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fca8ee10154aaf3f078e6069d34d4f5f371f7c976fad507c21ca5932898555e0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0001",
      "source_text_sha256": "b39c3430b030cfedd5e49ecd4dcd32ff176937c6347b45f3c72028a12796a676",
      "translation": "“你懂個屁！\n　像你這種視人命如草芥的傢伙，\n　怎麼可能懂啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "46a62718ea080163459f7dc1cbd72be9215de329f0f371cc3205a5509048319e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0002",
      "source_text_sha256": "96017dd12ded157b646dc384aa635bbbbabdb5b5886573e462603ba2169c2624",
      "translation": "“你能戰鬥嗎，勝平！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "566d23e339f03b6588558937088c575da51bedaadb5fb1190589da7014e704b5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0003",
      "source_text_sha256": "a3a60a8b92f4f68ed3f36a23abeba3ad17da24e6deb3577e7772b11c89c30c7d",
      "translation": "“我是神勝平！\n　怎麼能輸給那種傢伙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "e7b1cc317247ba302dc280095b4660738a9523f06118e9d3dfade938850b3aa4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0004",
      "source_text_sha256": "da4d0fb1a55cb8efae16cf0fae327ed6d95c73459bc9d6a4166944004aef7ec4",
      "translation": "“一太郎哥！\n　比亞路沒事吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/bial-short"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/bial-short。",
      "zh_hans_sha256": "e33b0767e6c670438cc038ceefe9ef1ec6b190d6984b691b382563ff5519c7d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0005",
      "source_text_sha256": "9e55d7892cdba0b64fda8cee2a3ce53d676b88f9ecc79072a682b4c8793e0c2b",
      "translation": "“不用操心這邊！\n　上吧！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "08727385b4ec19bc28033b3c049d31b0a39dc027b2180a8be537aa86f3a11748",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0006",
      "source_text_sha256": "d0321bbbfc92cd4aa50f758d3b2e9306563b615c69013a4f0535048e1491b319",
      "translation": "“徒勞的掙扎。\n　就憑你們能做什麼。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5f56e7c3e19cf9951a61ea46ff51441171aa316d611f395185f43a9d615c0cb5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.09/0007",
      "source_text_sha256": "8f1de3fb8f808a54d6a52aa56a2335ee6a2a5bbadbfc0d7ffd553e66f2a7467f",
      "translation": "“跟你戰鬥的可不只是神家族啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/god-family"
      ],
      "notes": "",
      "zh_hans_sha256": "594af8e65edf9a9b2c7b4e0cac7075b11bb9f67f32638d9c0c9be0c631c2b15d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0000",
      "source_text_sha256": "cea896c3454899e4394cdce951d28f5dc73c432458dbe831f035e40340de3591",
      "translation": "“沒錯，勝平！\n　我們絕不能屈服於那種不理解人心的機械！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "c3bf1e9c0d82f5b6dbec099c7fefaa232686e728254ede4927fe40bb4216523e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0001",
      "source_text_sha256": "97e8e355f692abb33279e5d575f145ed3d037d213f99f29655ddaa783c354307",
      "translation": "“我們也追隨你！\n　追隨克服恐懼而戰鬥的你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cb67e8c224e21a86dc91315ec0ba840f2b27f9e40744af00ec307ea3adf70040",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.10/0002",
      "source_text_sha256": "edeaa52ca6dc8ea8ccb7a65e5d6efd7c14e1488dd52e312667d21dd9d57f3cc8",
      "translation": "“蓋佐克……！\n　就在這裏了結所有的恩怨！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": "",
      "zh_hans_sha256": "7f87a7a167de54b5f038dadbeb3c88ff411f28c6a808eaf82e6ada6caac8ae78",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0003",
      "source_text_sha256": "80db50c2fd65488ea92ee3cc86a05b975a29da5ed9343b206205800f70aa8e09",
      "translation": "“電腦人偶8號！\n　你才是那個在宇宙中散播戰火的禍害，\n　給我認清這一點！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4278f47f1798e3ffa1d2873f1bd8cc1f4bdf7fbd5e98153935f5eabe7153028e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0004",
      "source_text_sha256": "2fe618642b1c2c9eaef0f83b403e1b031b36b946ebfe901bd32effbfebbd3a36",
      "translation": "“勝平，不要輸！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "949edc5c9ec43e73dc508c7aaac74b219ba4b1f99ee4e6a477d76742063e61d5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0005",
      "source_text_sha256": "d03656a9fb4f0f27a3c65a893030c74aaa87c79e3da384625c51e6f32d31f31a",
      "translation": "“我們相信你們！\n　相信你們一定會勝利！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6458112b8586dc387065efc436eaa0c317c6e6ae8539d28e049f6204c95ad88c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0006",
      "source_text_sha256": "c4249c424bfc082de66ab30fa1c3bcd3b3790fd85b62b7e14d5730c91314df5c",
      "translation": "“聽到了嗎，電腦！\n　相信我們的人，\n　可是確實存在的啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6a33cf2f8723f5adee1eee8a27b6a3f3478f4f03305b246c652d12049b283911",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.10/0007",
      "source_text_sha256": "a8ed83d0a3725310f55771eeb3180d6c81e80bf74b7906e11b0733af2ec94f33",
      "translation": "“壞人確實存在……！\n　但是，地球上的好人更多，\n　多得多啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "41bd4569066fe1eaa03e4e80b905d9c201878f7d7bd12ddce75900d0fdb1e51e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0008",
      "source_text_sha256": "58ee9345a4d5e8455d4f5831560dbe877ac30562b483a9f8c84431af2b64c535",
      "translation": "“……守護吾身、司掌死亡者。\n　當侵犯汝機械邦多克者出現之時，\n　復甦吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/bandok"
      ],
      "notes": "",
      "zh_hans_sha256": "7dc46cf3094bdcbbf5a7a8d2eb4a963c5c4486a4ff08b8ebe3bbb232c686cad4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.10/0009",
      "source_text_sha256": "505557a9bb34f318d03d3e62b0caf5b9797701c553bfaad5bd039dabd07089dd",
      "translation": "“此刻，吾解開封印！\n　死亡騎士們的封印！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c12c934f5100a53d307baeed72844085f7fd3b9d5ca8eb5f51004b25b11a0d45",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.11/0000",
      "source_text_sha256": "2784cbd79629ad8365f4f2eaea5a51fcc039e56a81ae22f2a08bafa81fdfe8e7",
      "translation": "“那就是蓋佐克的王牌嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": "",
      "zh_hans_sha256": "0d0e3da559b960bb33a023b60c9932cb88b4d1e0102ced85a9d65381f4831597",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.11/0001",
      "source_text_sha256": "6b72882d6fe1eb42c50d9e5d3805c7265b3186690b2784e49dc59989dddcd085",
      "translation": "“不管出現什麼，現在沒人能阻止我們！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6eb37829fbba9d5f5598e983778f2d000192940102f106ab31be42095f957219",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.11/0002",
      "source_text_sha256": "b065fb5fa915576ebfd77e514d1930ef180e0b86e51d8a2ec9e0ae79220592ad",
      "translation": "“我要上了，蓋佐克！\n　不管你説什麼，我都要戰鬥！\n　為了我珍視的星球！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": "",
      "zh_hans_sha256": "ae1a4435aeaeb7ea61f873f71ae4d58312e9d53deede290aa46450d98a1a6e0f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.12/0000",
      "source_text_sha256": "0e61c559499e96c2732b9286454426cfbc2e996be2df3d6d01c1cfd3f3fcc2b9",
      "translation": "“吾，敗了……\n　你們成為了勝利者……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cd16e01e5fb201e71f75cbd50283b3b8e166c09629e9155d318e54e091e4c981",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.12/0001",
      "source_text_sha256": "33292214324f0c02133d03853fbeb4bbe1d92d0b1a247346e90f111bbe559a47",
      "translation": "“但是，為拯救這顆充滿惡意\n　的星球而賭上性命的意義……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "efe91e67124cf54fb8c404e68d00ba5a0c2888f199f721977085e157d1f542ee",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.12/0002",
      "source_text_sha256": "f208f6b64e508a5ee9eaedc8cfcf2b9502d808bc27ec33bc1e9e39c6549353c2",
      "translation": "“少廢話！\n　輸了就趕緊消失！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e20eca28205c9e28b6605e96fa9246e6c87f0b2fbf08f8adb43a2d35d68a9477",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.12/0003",
      "source_text_sha256": "236ddd560072f718fb754304298ff4dd754712136a1937e68d034b44e00ecfa2",
      "translation": "“你的話，\n　我一點也不想聽！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5f5f4b8d47b5c7aa34c3e97292621854c32536bac80a29f20f6c0c20cbdae0f6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.12/0004",
      "source_text_sha256": "f0fde42744d798b3a172c417c03201cc585dffcae23f6340556bf4ac38f449fb",
      "translation": "“別忘了……你們的戰鬥……\n　沒……有意……義……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bf1dceb662cfffeb83e7b8e897f43bd48d26498310aff4046197a69abf390a94",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.13/0000",
      "source_text_sha256": "3659ed8695b5ff853887a6a296865505aef5d868fbfb1c53549575bacfac26fe",
      "translation": "“怎麼會沒有意義！\n　我們……我們！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c99be8db7a75beedb1d4dd51baa8ad754d3ac4a6d89aedccb1dd5c3cbe3705de",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0001",
      "source_text_sha256": "4973cc459f80e88b5bfe073b48432d2e2e1c77e94bf1bbbc99d71fd3b202aef6",
      "translation": "“……為了否定電腦人偶的話，\n　我們也必須繼續戰鬥下去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6486718bc0314bc3b06a0e3f34ce4a72e03be3233bc71013ff3c8859ad6055f3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0002",
      "source_text_sha256": "e6e1bcf7e96b7841845752a029695ac71c91d19a5812096c2156db3d843bf011",
      "translation": "“想要守護的人們，想要守護的世界……\n　只要這些還在，\n　我們所做的事就應該有意義。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3f6abe5bdc8754ec3d643e08283b3a92b363d00e615cb12af916ab704d29171f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0003",
      "source_text_sha256": "4abd5570928155196280129ea6530eb6a53f52b8750a6c34380124ed8c7299f9",
      "translation": "“我……是這麼相信的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "588041f4e5d7f46464edb608aed735b2fa09932d9e3221c92da56557c8f75898",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0004",
      "source_text_sha256": "b340810eb1a4474b9873750f61fbf3e62de5635fe7871e70a78b3dd288e04206",
      "translation": "“只要那些被莉古絲·克萊茵的歌\n　聲打動的人還在，就還有希望。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "137d0b66ae567d29eb0e3048810116c4d37f472a7dde70bc13fda858ef607451",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.13/0005",
      "source_text_sha256": "1594c17e2758d3aee0d2b79846fa387b72362ced62c5317912cd0eca3c363de4",
      "translation": "“勝平……沒事吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "4c986f1f4a6a16e2be5ece700b7f1e4e76bcfb6eec8a32bf5fb2444f14cd50ba",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0006",
      "source_text_sha256": "446cf0ca8490a2f1939ba7adf989bee2e509ebd3738da4a1ad4c44d108c747d2",
      "translation": "“其實很害怕吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c01c4e0b28dd9f668a9833692f9a478699287d233c5bd217ed86fb8b5464418b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0007",
      "source_text_sha256": "0f40efb9e6040f6ad4511635231300b7b2ed2b9bc3ecbf8f5930fc4b242d23a2",
      "translation": "“嗯……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5c43ab803d2b79422971e50752d28eca6147c74f81930b9a3a763c05882fa9d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0008",
      "source_text_sha256": "048a46b3f214ceb80fe9c26a6cf075d7b7a2017623208535599b797ef1e2a7ca",
      "translation": "“但是，我絕對不想承認那傢伙説的話……\n　所以，才能戰鬥。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "12429626f45e6c9b96c616840978569b19abfcb106ae4717de884ecc6e532d51",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0009",
      "source_text_sha256": "a0669b21eb74125b29c0705678835748528d04aa709f5eedf820736b40f572ea",
      "translation": "“我……今後也會繼續戰鬥。\n　我就是為此才加入$c的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "769c1667d60bea20b6121aaa3e6a6c81d1fb5a6e2125cfd9238a4af1b2c76533",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.13/0010",
      "source_text_sha256": "c793290ba50d607dd3dabf537ee587afa22432a3772f2bc003800c9faf375fe1",
      "translation": "（勝平……\n　你已經找到了足以戰勝恐懼的戰鬥理由。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": "",
      "zh_hans_sha256": "edd62c6437bd097ec6acbd77f564f3a53a3821bbcfa808f974bd1e70eb78cd2b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.13/0011",
      "source_text_sha256": "f132f589bb2058e2a1ed006fc9eeff714438b2b32b38c9909a3d112503918872",
      "translation": "（你已經不是孩子了。\n　是一名獨當一面的戰士了。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ed735f2410b22717b3a557c7b03b3d08bdadc76e1550602b8de11e4a2f47cfea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.14/0000",
      "source_text_sha256": "64e0c7c100c89cb3d3d7137d45fc4837a1eb8c9d5a89f641857a3de6f727adf2",
      "translation": "“爺爺，聽説迪亞娜女王要再次\n　向聯邦軍和同盟發表講話。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "1f0f0580d2d02a88ad192f612db6e7d7812a4ad60ed9fa953afd0425161bb960",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.14/0001",
      "source_text_sha256": "f811246d70160767690cbd78d23401682abdc65d0341dc36f7252db2372b4597",
      "translation": "“把通訊轉給各機。\n　我們也該聽聽。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1b5cab912c7759390a5dd086c0566c2dd418b7ad4a447f2157f780e5402a41cf",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.14/0002",
      "source_text_sha256": "3a1edff48655a95c487413feffd5233ff1a8526374fc1c748fad514bc507522d",
      "translation": "（外星人的威脅已經消除，\n　迪亞娜大人究竟要做什麼……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "772de140af06bb202d132445ce4153e6a2c6ed03b3f7f117258906ce25db3142",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.15/0000",
      "source_text_sha256": "8975b5a0704986fe6251125f7c6050177bb709b88c5b7e5de683c4381bcd4eba",
      "translation": "“還不明白嗎？\n　無人感激的你們的戰鬥是毫無意義的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "602445b0171cf5ee0acad572fe9404af5142682cd717dba6b3e9e0072bd98f8e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.15/0001",
      "source_text_sha256": "64bc4cef1a7c045b13fe9137ce9260904a504a9f02d05bbd6c951bed290821f6",
      "translation": "“我們可不是為了被人誇獎才戰鬥的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "92c3294cf356bf92dfa809746546790b7baa25e2ad23e10e895f1678f630f23e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.15/0002",
      "source_text_sha256": "c4c04866fad9521f6aef936c1b356a8b84e89acc88050ee56ed04e717cf5c8cd",
      "translation": "“沒錯！\n　我們不是被誰強迫，\n　而是憑自己的意志在戰鬥！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "59471dd468f29beae488fcdbd58aa857fabef8376174d7c3b42277b27a3268e5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.15/0003",
      "source_text_sha256": "36255e1088ee2c18deda290ed9a22f634bbfd0914f1a86ee1e6f4a29840378e0",
      "translation": "“我既不會輸給恐懼，也不會輸給你説的話！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8c60fafe3dc039d89e21c37ca90978703ae3c27daef47fb11913e1a6f8fff7d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.15/0004",
      "source_text_sha256": "23aaf612220f782918ddb168d5cd0d8ee0ed02bc5675b9163cd5747cefaa4233",
      "translation": "“看着吧，亞紀、濱本！\n　我絕對不會輸的！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/aki",
        "people/hamamoto"
      ],
      "notes": "按日文源词绑定统一全局术语：people/aki。",
      "zh_hans_sha256": "2889a296b0d4a028bd179cf73297fafd61a7335dbe3ac019b989c7f0ecacf502",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0000",
      "source_text_sha256": "ffd8ccadaa6367a73a6941f27209ca6474e59dab7033d5edb9ebfc06845edd95",
      "translation": "“神家族啊。\n　地球和那時的比亞路星一樣，\n　是充滿惡意的星球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "location/bial-star",
        "organization/god-family"
      ],
      "notes": "按日文源词绑定统一全局术语：location/bial-star。",
      "zh_hans_sha256": "8e22620745c6598efbe127c1f9f5497a77fe4fa20a238b104f72ca32eb9d8b84",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0001",
      "source_text_sha256": "2d8a88b87f6ad760990224a3b6b6f0b871fad83063614d564772e1953a3cb5a9",
      "translation": "“所以就要將人類毀滅嗎！\n　只憑你擅自做出的判斷！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a6ee002740eab69696052df2dc6b6d4fe3e7f20263ac07a32fe53abe205e5382",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.16/0002",
      "source_text_sha256": "f830e56c628374cdd25def6fb3d59527a63e0652597daa7d6316b0d5ea07b40c",
      "translation": "“開什麼玩笑！\n　你以為你是神嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4e4aff62928e51f99c94ad82690e68127d28abdf04fd93fd5f160cf1e48ba73f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0003",
      "source_text_sha256": "24c8d4a87fbacbfac250da7132868db85d0fbe740ebf7d0d00e64c8efc312298",
      "translation": "“你要真是神，\n　就多做點對人有益的事啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e565c08ac57fc63a1da16cb0857b153d603440a08d176bdef0de4ec4fcbb4a20",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.16/0004",
      "source_text_sha256": "e5c7e9108af438f5d6e3f93aed6efaa5a451f4a3ef9edb5824f2d09de095f298",
      "translation": "“吾為了宇宙的和平，\n　決定毀滅地球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "df4704f741b604a34dfc2dda007964e03970cc191bdd3a61ce437710f0294197",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0005",
      "source_text_sha256": "75b03322430faa5dcaa41db5c3534743a2966a914b89b90a6e126d84ffe598b7",
      "translation": "“就憑這種自私的理由，\n　我們怎麼能被毀滅！\n　人類不是蟲子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2bf1bc98db36e797a01c50c4ee1048f9ba1b755e5ce5a86282a8b8fbd1a0cd96",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0006",
      "source_text_sha256": "cd7b515af67d9f56b820eafe91a20839913daa11df4c2d739b58b6c55eb558a4",
      "translation": "“電腦人偶啊。\n　就算那是顆充滿惡意的星球，\n　那也是我們的故鄉。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fe6f1c3a5a42cc7212bd176adfc289d65e009a22d41620168388562737f85fe0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.16/0007",
      "source_text_sha256": "a574758b089acb34a5c36140f05daea14e353e547687779ee5b518bdc60da9db",
      "translation": "“所以，我們要戰鬥！\n　為了讓地球變得更好一點！\n　絕不允許你妨礙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "20a685d6db38206c7846b4d3729ace20ffba2ff94e4bef4867b5214ca9e8a706",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.17/0000",
      "source_text_sha256": "26e3cee84723decb4f6736d0277b19161c6338522b2038c1d7b759d9897a1cd6",
      "translation": "“這裏也有人對人類的惡意視而不見，\n　還在打一場毫無意義的仗嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "632fc202ac77ef360f6d54afc103d70b4939ab193ce4ad91bad836db688348a5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/01.17/0001",
      "source_text_sha256": "3df6c9a6197afc4e586b99794a193c4421c0599e25084259caf1ccd3b232f366",
      "translation": "“真不巧啊，\n　過時的電腦！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "be52cf2adf49ba937189ff375d5dcb8cad933e3ed9c7fbb40380c21439a1370d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.17/0002",
      "source_text_sha256": "2f3ba853c32a30561d8ea6b15879a47d982256c18ac308591dfb662344e482ad",
      "translation": "“不管被傷害、被背叛多少次，\n　我都喜歡人類！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6d76d964ed5bd43fef72114bf1a15c5928498da00f8b0b7ff0225866b42d383f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/01.17/0003",
      "source_text_sha256": "777a27910c007ae73eceb6abf027d828bf4932cc6367c1f33e0a0d38fe74d83b",
      "translation": "“像你這種自以為是的機械，\n　就由我破嵐萬丈來打倒！\n　以照亮地球明天的日輪為誓！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/banjo"
      ],
      "notes": "",
      "zh_hans_sha256": "365cbc2ba2ee8899e4bae614056eebcf249e43bbb0ad0d68f3699e12543d0683",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0000",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太陽號艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ],
      "zh_hans_sha256": "3f8850cbed6d44b848fbc806ab508bb8d7e62551c07e4539d90e5d3c33a1b732",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0001",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太陽號艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ],
      "zh_hans_sha256": "3f8850cbed6d44b848fbc806ab508bb8d7e62551c07e4539d90e5d3c33a1b732",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0002",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太陽號艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ],
      "zh_hans_sha256": "3f8850cbed6d44b848fbc806ab508bb8d7e62551c07e4539d90e5d3c33a1b732",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0003",
      "source_text_sha256": "70a4a3a50c13885247624df1b4be3f9ab1067c1cb97c16347526aa3b75dc2ee2",
      "translation": "“……靠着眾人的協助與寶貴犧牲，\n　地球終於擺脱了外星人的威脅。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0529b70440a6981034002b30a58d1b01849636a0913ebd9ae5b7cc1d7c4836ef",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0004",
      "source_text_sha256": "6e1b02520688dd932a74ab2809067277919476b077f4662145527650586ab746",
      "translation": "“但是，人類或許正在走向毀滅，\n　原因不是外來的敵人，而是內部的敵人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bf698ab3ecfd8623026a8ca01d43a7fc42cc12f4268a79a043a55ca566a93b91",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0005",
      "source_text_sha256": "b9fd8672d926edbd7a032e1f1393a3f2dbf92f3f84251973704fd6b0c284db0a",
      "translation": "“沒錯……就像遠古黑歷史的戰鬥那樣。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history"
      ],
      "notes": "",
      "zh_hans_sha256": "f42711ba1a9f106165b4f1312180bd03f76dfc25a46aa7dec6057229041975dd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0006",
      "source_text_sha256": "2420a26157f5b652bb746fd7eedb733928c0a6461d1c084318d0ca88eb46cd11",
      "translation": "“我在此倡議，召開新聯邦軍、\n　阿普里利烏斯同盟軍與第三勢力的會談。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "organization/new-federation",
        "organization/new-federation-forces"
      ],
      "notes": "嵌套词表子串自动例外：organization/federation-forces, organization/new-federation",
      "zh_hans_sha256": "01054861113fd9176d6ee40bd5d9eeb6b8654dcf3041881b8f3e1a92d7b345cc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0007",
      "source_text_sha256": "9cda47cd1f15e36cf5221ae4244b55250ee93ff272a1d24466647801b604de37",
      "translation": "“如果各方都有各自的主義主張和立場，\n　我希望用語言來交換意見。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "008ffb7d178dc98a40318afd194d497578353e1d5cbcb9395386d86da4dbff8d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0008",
      "source_text_sha256": "faf1728668ff93455afa1d139ab48b1fe7731fd3031308fe229967c287400be2",
      "translation": "“我再説一次。\n　我們或許正因內敵而走向毀滅之路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cb02cfd4906527bbbef0b8a6535ad4916da63c495418e29c79cea06681cf7800",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/134/dialogue/02.01/0009",
      "source_text_sha256": "5422b9689aadb7744a8c86259432bbde56b9623184c1b390fa2b8243374ae1eb",
      "translation": "“為了規避這一事態，我倡議召開會談，\n　互相交換各自的意見。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "本句是避免某事的一般语义，不是战斗系统“回避”。",
      "glossary_exceptions": [
        "system/evasion"
      ],
      "zh_hans_sha256": "238218c6406047d9693343a33fb39daa0d6ced8b40cd182f6be273af1c8ac3f2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/134/dialogue/02.01/0010",
      "source_text_sha256": "4f806f4014359a5309e1d22187c9ebb3db9e0987161eb87bec5e0060bf4a95a0",
      "translation": "“有人揶揄人類是愚蠢的生物。事實上，我們\n　也確實做了被如此評價也無可厚非的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
