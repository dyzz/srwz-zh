  },
  "entries": [
    {
      "id": "story/011/dialogue/01.01/0000",
      "source_text_sha256": "85266a09ef6b22717d3bca51be0890d2855ccd9389f9ff9275c944b612fb06f1",
      "translation": "“嘖！差不多到極限了嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4c4e9b8df6ca0a98df62a7f41af428d3c6915cfaf73d9b1851ffb5d6d80c701b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0001",
      "source_text_sha256": "5e99df9cfaec12b9baf4edd9aa67f6c416e69d2e2a304a7158c52cba1dd8baa5",
      "translation": "“你在做什麼啊！？歸艦命令已經發布了啊！\n　你也應該收到通信了吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8713905cf160a827640ada6a93daafd851fa4bb8cdc74f887d89a66e176b1d01",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0002",
      "source_text_sha256": "3b294a9b0947e170c9aa30598cf2dec3540fec84a048fafd6f486dd4927b4b4d",
      "translation": "“我知道……！\n　但再這樣下去……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "31a4d8e3672887e03d51872168d70856d45c00c8aed72a49b2772b4b7e142057",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0003",
      "source_text_sha256": "af3d98dd5c9e7f84ee14081c181b4c4b8d2ca95d070e0f4485d52528607f0f89",
      "translation": "“智慧女神號馬上就來，\n　要炮擊這傢伙！\n　所以！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "d96bb245b8af3eb5d2ae1a558cf2dc70e0f89df192e5409936901e235fc0425e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.01/0004",
      "source_text_sha256": "7fa56b9d56bf0f003a2da8853d46959e8480e5a595ddd5f498feb08bc1046219",
      "translation": "“光那樣還不夠穩妥！\n　在給它造成重大打擊之前，\n　必須至少先製造一些裂縫……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ba0e645b76f50a67ab88a618ad54cfc16ab0e831f215d7b7c97b9fca64e86651",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0005",
      "source_text_sha256": "f593c906f0592cf0fd87dc2e12403fb7839647a24552f97773988cb69dcf697f",
      "translation": "“……像你這樣的人，\n　為什麼會待在奧布……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/orb"
      ],
      "notes": "",
      "zh_hans_sha256": "bfe48496c0baf6d1ec1f1a12c19e217a432920241cd88eda42eba137d19dee02",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0006",
      "source_text_sha256": "d7ae8dbf5702a27c219685145d6087abeff7605b1e35c5e125366bd278a99064",
      "translation": "“你既然來了那就過來幫忙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8545edb3392037b5b253636db1b95b42dcb122c37d9dbe097f94609f52cf7081",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.01/0007",
      "source_text_sha256": "a5af3fea94500b95ef226fa304cca1c723bc184889fa565ecbc57df1415de961",
      "translation": "“我知道！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "17191ea5178d960341328b426f4ffdb5163cd7b27d8d6805d07d69b5ceff8d31",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.02/0000",
      "source_text_sha256": "85a1db16e79c34dfeeff5b5d9d424f592fa3ed050ccb87492105652ca6af7903",
      "translation": "“能做的都做了……\n　接下來就等智慧女神號了……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "969013d4208b634e924812f468f8d6d0a64c73b7f2ea54d9ac08d29d13d702ef",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.02/0001",
      "source_text_sha256": "82333e22398f88c43599dfa48c354ff48bbe9277dbe961a5b8677bf0617f83ce",
      "translation": "“你的機體還能撤退！\n　剩下的交給我，快退下！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9af9aadfc22a6f72ca8f40c81deac381368abcd15688d3170f136e26acc143e2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.02/0002",
      "source_text_sha256": "fdae4dd964c208a41ef6c1b723cffbb08346d4da203aeaf5a5525674952130b7",
      "translation": "“都到這裏了，還説這種話！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "29d61d016b32cf1dfb627ca9f01d36098d3f3ed541258089c31a20cbdbdf9da8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0000",
      "source_text_sha256": "36b566a7163247033e531d6288bb304727fb69c1d7395068527fe29064cc4b06",
      "translation": "“你想幹什麼！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a5b61a7be7fc4516cc51ba9b5b38c61c92a77c518af335f4d0028178d449e834",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0001",
      "source_text_sha256": "13198a6c996fef9fbbc824581e48aa97edbc7f4ce37d87d3f8f53896dd599abd",
      "translation": "“我要帶你回去！加上衝擊高達的輸出，\n　就算是渣古也能掙脱重力！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short",
        "unit/zaku-generic"
      ],
      "notes": "",
      "zh_hans_sha256": "3814dc0506fa1285504950b3c7337a7fe30e96e92a1eb9b402eff70268f4ba99",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.03/0002",
      "source_text_sha256": "119693d4568962302ffe57853625b38eb35ebfb715259fa55e6f4fed7fd27f2d",
      "translation": "“不行！\n　這樣下去，我們倆都會死！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d63a1faa14a9b326c3a1342bcc0a33d11e204ca02869d056ecabb7f378fd47ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0003",
      "source_text_sha256": "a4f0994412f34d36c3aab7e0e2618dd85d11f0d0d306d48672c0b5f3436a0162",
      "translation": "“但是……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7850a0c56a3a48680fc9966100f8320d21c7116e69a84685fe38e711c4462ce5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0004",
      "source_text_sha256": "f70af677675768a69211ce23b0b204ac163f75bb5e6785a30f6655bb8921c1f6",
      "translation": "“快走！\n　別死在這種地方！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "127016d9cda9cba766f63816bacf5409b54bf5fa1783d5c60f7cbeb26bd3cf95",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0005",
      "source_text_sha256": "2c1f087033cdbc83378b3655cc63c250d4960f7266bed1971bde7f22fb05f181",
      "translation": "“為什麼你總是説這種……\n　這種看破一切的話！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "916202e2d732fe2a5a1ae83b4200aebe136a75529e07148656c6de5e22a996f9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0006",
      "source_text_sha256": "0742e1ffcfdb81bf1894eb6d90192d159065686627270ae029f37b79431375aa",
      "translation": "“……那，我該説什麼好？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3e3106726db90cda1c51125a6b5b85435596931db2b21587bc06e85eb82b4270",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0007",
      "source_text_sha256": "fd85892fc612481c14764c5126ce27284d5040749c4bebc4a17972d0667c0234",
      "translation": "“救我啊，你這混蛋！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2534b220f435435f282e637f7838bf73df241d7dc6b5b0dedc4ee77d997f6f46",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0008",
      "source_text_sha256": "8e9ace97096e953f6770da8a26d59f150ba14d4ed6c6b03b1d22cf226a3db76d",
      "translation": "“……之類的？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5d8232b9eb8d133de5099c103a4950d0fea227aa3b94ea2f1554599ce4f7b629",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0009",
      "source_text_sha256": "bea1b1f36ddc302fdd03dce6c3f2e31eb4a7d05849f85e1dffc4dfc92c87ebec",
      "translation": "“這樣更好嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7ea5da3996869dd5d622acddc2a0d3c72eaa3ed11513e3c86ff09ab6bf7e11cb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0010",
      "source_text_sha256": "6d4df7109c6845b585edac75e64934079fff9a5ea3244f51190c9a71b29d69a5",
      "translation": "“只是打個比方！\n　現在可不是説這種無聊話的時候！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f6776b659a5928aff62c383e711a12129f2275e327480f5dcbcaafe3a525e699",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.03/0011",
      "source_text_sha256": "fb20ce1df869fc22217987123baed4cadb65a095a623b134946828be4cec3864",
      "translation": "“……抱歉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8525e9ab131555152a3f808f54cc39faaa92f9cd4547527d55cba64c38234250",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.04/0000",
      "source_text_sha256": "6f541c403ddb7ad1ba23949146b4fe32d0f8d33d7e41269fdb30e70566cdf210",
      "translation": "“呃……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bee421b9a45e57d29191f18504f862255fcc692826422bb341ed03ee27bb8609",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.04/0001",
      "source_text_sha256": "30bcfcf72e8c6f06a34ed41a876b5a885c5d5bcf0224cd00f1b2863e6712ab07",
      "translation": "（拉力比想像中更大……！\n　這樣下去……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8169f99737cfea7321769d7c0f9858e5bba5a89524df2d7c53a3f4b0bd720288",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.04/0002",
      "source_text_sha256": "a124aff40328c86731c5a09a3de21976dcdd613a03ea4e836ac919027c8924e5",
      "translation": "“保持現在的位置，真！\n　我這就過去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "1407386b8c44592fa68709ace6a1d73ddeefb78b48aaab11bd4c16bfa87ea203",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.05/0000",
      "source_text_sha256": "7e96505b7f1fe670589ba283534f6cb60109a0b267b0c6411f3c9c0c8501e584",
      "translation": "“是嘉美尤嗎……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": "",
      "zh_hans_sha256": "9148d8495b1604cbfbe6ac9a935a73e7ffac1869bace4c47b6e9eb7595df599d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.05/0001",
      "source_text_sha256": "5cbd7784e51dd231c1d0d1214c4b012db1207a4fe3170ec72ca8eb404905dedf",
      "translation": "“你們兩個，快上飛行裝甲！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8f757cdfd4db9fed76881f06c37c4f99e6d47c355fc5fba06abddf39b2779c1f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.06/0000",
      "source_text_sha256": "ecc128c87b706de6b6aa447591ebfb923bf351bbc81c9c57660b05e658e4ce28",
      "translation": "“有了這個，就算是MS也能突入大氣層！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/mobile-suit"
      ],
      "notes": "",
      "zh_hans_sha256": "f9fdef8f7e43fcfcc826808074d2698f153a2ca9e8cca357f2f37198b66a153f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.06/0001",
      "source_text_sha256": "044dd8826b91920a11faf60bf7fff128f66df5f626cd203c9ca0d095e050dd58",
      "translation": "“但是，這樣下去尤尼烏斯7號會……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/unious-seven"
      ],
      "notes": "",
      "zh_hans_sha256": "20479b0b171769e6bbbc75cc0fac1a11b9d95b635e33033e59966887e1b673bc",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.06/0002",
      "source_text_sha256": "74ca12fd3ceaaf0b087c337253bee6e9db5c2671c95ac1aed3d646c2fbd43b73",
      "translation": "“我既不想看着你送死，\n　也不想讓這東西掉到地球上。\n　你看。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2770d7a6cec00fd26d4a5cd6a2d2d697c3ccb4f0edeebef75c7a15da2fa29d5f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0000",
      "source_text_sha256": "1e9500a47e19b7ec995e55d49418a041efd36963d14b9106acfdb348941f8ec1",
      "translation": "“粉碎岩石的訣竅，\n　總之就是先打入楔子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "54bf1cef0b9ff31d5281dd0491701f21979a3209bb924254a05d6ec54f78c152",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0001",
      "source_text_sha256": "d4fc412960d8e5d3974cf611f3e997db54cb210e0be0698c7cb1b92ef77516f5",
      "translation": "“大家都聽到了吧！\n　這個任務由我們來完成！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "93a3951ecefb0ca4de6013c19802b8520c1bbec99ae26db4d80d5f659189a715",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0002",
      "source_text_sha256": "846335d2cdd9d7232d4feda9fbbaecc3934966829b1dc66b67b80e497f2235bc",
      "translation": "“接下來就拜託了，爺爺！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "00a4f7a797f4cbb96c2a90a279b355d3e535b5afe45b51fafa39146db0c1b490",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0003",
      "source_text_sha256": "81020978faeae1c8d3c87684327a49b1902e338e94fd3fb043347e2227cd5c6e",
      "translation": "“一太郎，用離子炮！\n　配合那邊兩艘艦的炮擊，\n　我們也上！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "glossary_exceptions": [
        "place/io"
      ],
      "zh_hans_sha256": "0abfa14010353527366aa6b610c9aec54a921875baadb23e121c5438721c4744",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0004",
      "source_text_sha256": "81876ba54b455603491d101ea9aaa357423d707c8cb1d5a8450d6632f33ab875",
      "translation": "“明白！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1be787bc0a1a2dd556fbde0546f08e44c2dd26a442360c8295fcc0f70580bf12",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0005",
      "source_text_sha256": "9f0e426a78854af946f82123cd5d31b2c8d6af84a822fe74885b186038fc8173",
      "translation": "“拜託了，諸位……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "52454843bedc6cc218dabdd5563de4fbc5da1ed8a611f222c31d18e74890ceed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0006",
      "source_text_sha256": "ffca9c1597e86531112ef1b9fa6755fa3a9906d73200f08d7275ef8c605a0b1e",
      "translation": "“葛拉迪斯艦長！\n　智慧女神號負責左邊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "1bfce7a500dff5d9f6d4db61d1bdb0ebb80bb09dd4be6f3e1de571f11fa0a74e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.07/0007",
      "source_text_sha256": "451272e86b2a1dca7e5ba8d7b672ae9135feaa4021b4d79c6ec4aece9168322d",
      "translation": "“明白！\n　全體注意！啓動唐懷瑟！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "weapon/0506"
      ],
      "notes": "按日文源词绑定统一全局术语：weapon/0506。",
      "zh_hans_sha256": "e2177f00f624df4236058ce7a6362c105d4191e4e4a5dc940a730305792434fa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0008",
      "source_text_sha256": "5e2dded70a8e65dfab1ca6e04a69528f24140f3729f35816a3e926a926676eb2",
      "translation": "“鬥、斗牙！\n　聽説榮耀之星的大家都還沒回到比亞路！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/glory-star",
        "unit/bial-short"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/bial-short。",
      "zh_hans_sha256": "dabc64dbba11675f5c15d496b163b420fc4d22c5f180c1a49456524562c47a23",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.07/0009",
      "source_text_sha256": "748b222ffbd231b27e5323d5f0f0622a728565208ebd58e0d45e93c222e5bb10",
      "translation": "“那些軍人大叔們，\n　難道被捲入墜落了嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0d608a4b7b7ced9c7d19596664e6975c8599d519b185600495c12a2b5bf3b3f7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0010",
      "source_text_sha256": "a495bb7dd2c45e3796c0367ea7f575ccb85a2735820d2eff392c982564e27cf9",
      "translation": "“現在優先粉碎尤尼烏斯7號。\n　搜尋他們的事，之後再説。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/unious-seven"
      ],
      "notes": "",
      "zh_hans_sha256": "17e815ad02de2b96128e700816159cb682c79d5cadfcc5eb21c3872fc87de434",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/011/dialogue/01.07/0011",
      "source_text_sha256": "34055ce1fb7ea2b383410f687ce647732a2eb8242214dd62630a1f82040111e4",
      "translation": "“可惡！現在難道就沒辦法了嗎！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fccea826a2bb9ea4076e2256fcf593c83be046b34aeaeda90fa6ebe0b9ed21fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0012",
      "source_text_sha256": "b016f483a82f2cfcc8707fcfa9c3366fab76e7af1380d4b9306e9148fe75d063",
      "translation": "“瞄準！右舷前方，結構體！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b9c66c9788da57ab1de79844813c6312884dec4b0c55452fcac11902f448ede2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/011/dialogue/01.07/0013",
      "source_text_sha256": "51ed94f098fc30d81d0cc983cf8bb9bc0560f9f23842de0f73d346e5a2af4df5",
      "translation": "“拜託了，葛拉迪斯艦長……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title"
      ],
      "notes": "",
      "zh_hans_sha256": "4971ecb8ecfde9630e5de95381ff41b74c6ee731a04f389365728f0cf2d00c67",
      "zh_hant_status": "edited"
    }
  ]
}
