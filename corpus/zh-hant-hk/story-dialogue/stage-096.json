  },
  "entries": [
    {
      "id": "story/096/dialogue/01.01/0000",
      "source_text_sha256": "7ff539c037d0066185fadab02538071bb3857b6bba937890779c3087b476b880",
      "translation": "“戴蘭達那傢伙，真幹得出來……\n　居然在這個時機從內部瓦解地球聯邦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "78d8c7c1f7594fc318cc1236436e247e28f025b41bbd2016e0b29893ef55c4f7",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/01.01/0001",
      "source_text_sha256": "13096a7a27ecc052989792cab96d8cd2f15da5839db21d32bb9efe1aa84291b5",
      "translation": "“對聯邦來説，\n　覆蓋全世界的UN成了致命傷啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "98f09e9497b4855f8fad43d095896b37c2adb14f6baf2ce2bcfb221cd183f465",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0002",
      "source_text_sha256": "080b5a67a2c89c19997673f6f79f20e0bb59701301e1578e77b0e6c69287f99f",
      "translation": "“恐怕得知真相的市民會引發暴動，\n　搞不好聯邦會分裂成各個國家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f78f5c4f4c75a21bfef06d6e04dbef1f9976efd1ae4ca78bfee633885235b6d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0003",
      "source_text_sha256": "2fb2c6196af9e1891fb001cba6de1b6c41ec3c40a0d07896ae3f6df4dffd4625",
      "translation": "“據説入侵首都的聯邦部隊也已經撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9f0cb62280d6ae4f3a04b009d49e70a5b7ab87c80cde97c8994d65fafbfe99eb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0004",
      "source_text_sha256": "7887d6c28f3a34080f16f93d5d2082d81bbab4d9303d785505d0b3bec980eb01",
      "translation": "“壓箱底的新兵器被札多擊落，\n　後方又鬧成那樣……他們也只能撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "8a3240f0d1ee081b8565302289608c9aaa5a0ca033000ca54737b5ff00998cea",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/01.01/0005",
      "source_text_sha256": "5a278bbc66c0e04930e55b464607e6ce14c89676240d6562c433b3f39030804a",
      "translation": "“結果，欠了戴蘭達一個人情，真是遺憾。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "c35abc3252ba5c47df4f01c4885ef443fdc08e1fcdf2c26bdad95586fbac192f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/01.01/0006",
      "source_text_sha256": "4cff539d2c7dd32286a8b1fc479cf08be3722fe0626c4731e183019c80608a7d",
      "translation": "“是嗎……？\n　説不定我們只是被他那場鬧劇利用了而已。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1c2038019fbebad44f1687877753d02a492c41c2c2a83bcca565147503bda0a2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0007",
      "source_text_sha256": "9a64ad0740c07ab82839e230ec765e1cb31197b318c49ef3ac89719534431e13",
      "translation": "“您的意思是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "735bdbaf5248a9281f5539e7111355aca4683dfc8ae35b445bc3c0c580a14c65",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0008",
      "source_text_sha256": "586e80015ddb3c689d5613f9a2152e38ae0345cda1efcd163b0005442d7989b0",
      "translation": "“算了……既然沒有確鑿證據，\n　現在對PLANT表現出敵意太危險了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "0ff1b4ba752c873a427121cde1b0b4d39641d4402e93c3845b70fe53e43c75c2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0009",
      "source_text_sha256": "2310a42adcea49bb2055c361ec8db7c398081676a314390fed4868dc9403490b",
      "translation": "“畢竟，那傢伙可是揭露\n　地球聯邦腐敗的正義之士啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation"
      ],
      "notes": "",
      "zh_hans_sha256": "77c302ecda3cb4e762258b1315d6d01926b234f2bba36a61ffc23fb36095a3ed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0010",
      "source_text_sha256": "d5a353d05a7a90ad2460da9ef97bd4b9974a52e73c3158c3382dec039166a466",
      "translation": "“唉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b645dfa090cf68a5b0cddd4c40395abf9a5924cac386519f0c61743ea17ee7db",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0011",
      "source_text_sha256": "c51b788fcad5ab7041c070a039e24f4d3282b073a2af7d4b81bb07154d9cb92f",
      "translation": "“讓艦隊返回首都。\n　只要時空控制裝置還在，\n　奇拉姆就不會終結。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": "",
      "zh_hans_sha256": "2d0559958cb30de5b082cb07efe6bbd743294d0b0585530af86ecfb71e6edb91",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0012",
      "source_text_sha256": "79b177a471c7e4b3f247641b1a229b73d98eaa3542a8e7b066a8e7f56dea156f",
      "translation": "“重啓D計劃，\n　掌握時空修復的主導權。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a536c0c805294dc2723f30c684337e3138a6d65ff3f6d8a01b6dc9efde881fed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0013",
      "source_text_sha256": "6c87b3e96cc1890a27b6a9a4e73bf6ad4f2a9e8e68ecbfac1739720eee186257",
      "translation": "“明白。\n　……全艦轉向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e646d19255845f3618aaf6307857327081f040e69c6d68e44a06749a66b556ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.01/0014",
      "source_text_sha256": "e635b83e28e03f2097f76e60f9e8e07e14b95640cae6b5a689e914a61b31cffb",
      "translation": "“雷達有反應！\n　探測到高速接近的機體！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5df3ecbbc781ec45092b9596cdb8bcecdfa7469c1dde0164fe76b666ed1e3d3b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.02/0000",
      "source_text_sha256": "bd9439fecab7a2367089498d88971afe55a2822516dcdc39f2dff71f048ad202",
      "translation": "“是聯邦的追擊部隊嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "10b925f57f9b3547b20167ce671f4e06ab0b162b98f9a07b16a56a6b950bf938",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.02/0001",
      "source_text_sha256": "22c1f4a8eb2176a0eb10c1050badff99fea2d9b9da1b23acb8e1739df2e5c573",
      "translation": "“特務隊的報告中有對應機體！\n　似乎不是聯邦軍！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "e66cec6c9ff12cc0214b9a4ed306ce85cb1c9f485c0f31a8096d33319672f2a2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.02/0002",
      "source_text_sha256": "927c511d49e9ef2cf8afd69e808f809ba91692e7ca2e083ef8387ff5e72ba511",
      "translation": "“……通往太極之路……\n　沒有資格的人絕不能染指。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme",
      "zh_hans_sha256": "c503236f7dc4115ec7fd06b4b909e3f25c46c3eaf760025015afbee692068606",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.03/0000",
      "source_text_sha256": "aa3eb486e69f5d135a2e151c4f6c6d906782628385a7a54bf672b482e8588459",
      "translation": "“那傢伙的目標是時空控制裝置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "83aea27e1738355620a5340fc061314d041da4fcc251567711d2c136643f54ec",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.03/0001",
      "source_text_sha256": "baa458dda3be77a04232e62e10b21903bb612f2a2de43ada09801bfe7922dead",
      "translation": "“迎擊！\n　無論如何都要守住裝置！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2830d3ac44de28539c51940ec907acb9f7e3fc59d1f8d709380cc6fb5d50e33a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.03/0002",
      "source_text_sha256": "8554aa99bd2ef817b1353185d8af3ccd8876ed85ea5360fccb954bcc2f6c3259",
      "translation": "“太慢了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "02a7487e1d8470b30940f4b8643c01241eb475da114e6a3ed3a5364b494bc542",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.04/0000",
      "source_text_sha256": "bcfaf6a8780ce8a0b39b0f07ed3d07a3fbde4549c9141d27f22a9709ab452fbb",
      "translation": "“時空控制裝置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3eedd31dc17f25776e5da97f5e52bcb9733dbbb519f699013df54b7dd05687bf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.04/0001",
      "source_text_sha256": "35bb9dcc2ca3f90bb9c80fb1ec08a6ea1a216ef05d611f92500b59116d8de91d",
      "translation": "“怎麼會這樣……D計劃……\n　世界……要崩潰了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dae4513476f8c678729eb953396e4ded9146076f937145a37f437b9a01c40fcb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.04/0002",
      "source_text_sha256": "5df8b1011f4de5e456aac375a48ecfabb1763a9c95eede1445ca9652af43d2ba",
      "translation": "“這樣就好。多元世界的框架，\n　又要動搖了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": "",
      "zh_hans_sha256": "64ea51fc3d1f0d21bc4beda331f58f22e2849b61048cb33eef3bcc0b1b4c4fc5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0000",
      "source_text_sha256": "b9d607d7e4b9ef09169774bc1fc1d8ca1538012de086e5da2b86202a81806c9d",
      "translation": "“怎麼會……\n　又晚了一步……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a6cb0589506388f32f16391009f4e641e7a17f85ca5de123cd31cb7680621979",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0001",
      "source_text_sha256": "d8efdd7afd2aa4a5ff03b2988cd6bb9ece3a54f470d0842be75c7ee3b2a2da6a",
      "translation": "“$n先生……\n　我們總是慢半拍……\n　這樣下去一切都會來不及的……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7d880ce805f48d4dd9edf1263f1f68c30514222f8fb493fed350fc3e25fbcc86",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0002",
      "source_text_sha256": "e047cd67a113894b901673e7a4560afd0129a709e4343e217e988936f4b66811",
      "translation": "“星3號，請説明情況！\n　那傢伙是什麼人！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/star-3-callsign"
      ],
      "notes": "",
      "zh_hans_sha256": "633827a5f3099fb937e7b6141f20b255f0ee59f95b6cdf9a504c62c42f2840a4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0003",
      "source_text_sha256": "acbf35eb8185c2dd7f9e94ac2e99828c9748a26b9f371a9ac9937e84ac406aaa",
      "translation": "“抱歉。\n　我要去追那個男人……阿薩基姆·杜文！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4e0e9b5d4e6513807191f2256028b640fbbb20b2ff8f41f73db2b7e567c64106",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0004",
      "source_text_sha256": "c3ef34b6db16cea621195f6e19288bdec3739f2c4dee4249a72f43b5c8f529f3",
      "translation": "“詳情請去問$c\n　的$F……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "56bcbd45560607045d39dff849417d12b7c186f653e280f024ff8aad9481be2d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0005",
      "source_text_sha256": "7df58c712fc07a598b5ec3be3dd74adc4adf251397d1252de8a08b74bbbf540b",
      "translation": "“等等！\n　話還沒説完！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "956581e714bcb4dfa655cb34a903b997dcc1c6da52211de5538535cbb4042638",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.05/0006",
      "source_text_sha256": "67c0a0b81d349e62f6b3aa210a2dbc5580d127188963122dece2b06af6244c17",
      "translation": "“那麼，告辭了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "392b6608bde6e90916483a85c70bd85536f12c2654399c6ffd8c1ee726380869",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0000",
      "source_text_sha256": "c2b1f2c2248442ca74f4c3ebe944fac1dea1be3de4863590f49a6e06e56be5fc",
      "translation": "“那個引導我們的女人……\n　叫節子……\n　她到底是什麼人……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/setsuko"
      ],
      "notes": "",
      "zh_hans_sha256": "ca956b786c83083e83c46174fe92a2da54897ffdae6bbce7b3ddc54e894c816b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0001",
      "source_text_sha256": "b3e49ef801858147fc5827a48c530bd3087cbae53dd2a6c6339266d7427c36de",
      "translation": "“阿姬娜……我也要去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": "",
      "zh_hans_sha256": "7121bda58faa8fd8e9bb7ac6e639a0ff971eb1d3f8ca2cfe2f84392182b3364f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/01.06/0002",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“誒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13ed62045e04cbf2614c7548e31cfda8826a67aaa0a7c2f1766728d5cb78e0b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0003",
      "source_text_sha256": "516925a32cdf3d062b70e78b72709a66cf7e47360c47d9bcdef0bdfcba903281",
      "translation": "“時空控制裝置已被破壞，\n　D計劃基本等於失敗了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0d1f8d136197792e2765cd5b9bdfcd8533f50057b43e63bf5c7e6942acf2125c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0004",
      "source_text_sha256": "ceb0bd443411beba62ffd675a2926d0a1e06a7e3c33f88382fb2ce88706dcf02",
      "translation": "“這樣一來，\n　上層肯定會再次計劃用特異點修復時空，\n　打算利用我和桂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "technology/singularity"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "d7e40523ceb814de5197e3dec221f6ba88bb7cbe477fccc6835e475f98ac886a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0005",
      "source_text_sha256": "a1c5a0c03f749d675798b28cc3cc7ddcde30779d0e232c2c59ae56dc9b94983a",
      "translation": "“那麼，捕獲桂木桂來維持奇拉姆……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "890a8aa4542c7be6b6e783a43a92068b1dee26986640bf18aa5163b14e5e226d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0006",
      "source_text_sha256": "b0e2cb47a8ed133ebed4c3c9948b5f4f08bf8500ce3903c05f947ac491682a04",
      "translation": "“……我已經不確定那是否正確了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5a1db55692090d8704f52cd416479a5980990ff8b00b50029238f70b6f5432dd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0007",
      "source_text_sha256": "9d9c67071a5a0395347af821900332b19f1ea7142d404bfbdff4a51ca7647895",
      "translation": "“叔叔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "72c74186d0188ece97fa6f1c27744bbb7e406a9e3c100015efe7933d7f6d5e9f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0008",
      "source_text_sha256": "bd56d988846ce5f0d79197782bbcede48ef76c5c79db6b425752d3d01ab6d660",
      "translation": "“所以，我要去見桂。\n　然後，重新思考自己該做的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "12ab7c6cc04736c148e641fd6bffbc0affa2b577c0deee1ff2a925e859a05efd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0009",
      "source_text_sha256": "07906199de3b709275f9f2f73171fd74434efca49c3ca4a5fa2372e60ad93cd7",
      "translation": "“請等一下，叔叔！\n　那我也一起去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "34848d8ab9dd6801e82c4cf393f3e75347497da0e968063f6fcfc859f823ace5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0010",
      "source_text_sha256": "9066a176f031939ceab0f94896e4b95ce736fbae1abcbdc9f0dc85c60d0761be",
      "translation": "“不行。\n　你留在奇拉姆，\n　收集情報。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": "",
      "zh_hans_sha256": "101ea804dbfae4eb4e0f9a2ed2d1303b5f2f3fc25f3ad09f1bad264f7bef601e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0011",
      "source_text_sha256": "d1269982449982eb1ddf64ff6980cffeac806333d0a71453b38e00c9ad8a6290",
      "translation": "“那個叫節子的\n　駕駛員在追的阿薩基姆·杜文……\n　還有新聯邦的混亂……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/setsuko",
        "system/pilot"
      ],
      "notes": "",
      "zh_hans_sha256": "17cf1b9ba1d0af6fbdbd6589d47150791e9c3f218351b1480902c5bedbc348f8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/01.06/0012",
      "source_text_sha256": "83e72f37ec3dacda21614bbd60b7d6328dabd243a6760733dd751d6a98836863",
      "translation": "“事態還會繼續變化。\n　拜託了，阿姬娜。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": "",
      "zh_hans_sha256": "2dbef1e688664557c6dafc4ec28fd5c0b3444a488d9277fbae71f3602b1bc8a3",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/01.07/0000",
      "source_text_sha256": "02a8fff1b99ea6a74b387149486521fd52acbcbb0692217232a058e27506e8fc",
      "translation": "“叔叔……祝您平安……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "47cab1471d933a5dadd25bceba9fbc9c909c524ee7b0a2add6eeb5ef96b356fa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0000",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使號艦內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。",
      "zh_hans_sha256": "369164781104615d4151b378be6bc89adf8a0901d0b5c58a5b3f6b2f5192246c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0001",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使號艦內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。",
      "zh_hans_sha256": "369164781104615d4151b378be6bc89adf8a0901d0b5c58a5b3f6b2f5192246c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0002",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使號艦內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。",
      "zh_hans_sha256": "369164781104615d4151b378be6bc89adf8a0901d0b5c58a5b3f6b2f5192246c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0003",
      "source_text_sha256": "ceb82647b4201da085f9df9926753603fd0b4a85f904708cc85bd03325dbf420",
      "translation": "　　　　　　　　〜大天使號艦內〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。",
      "zh_hans_sha256": "cc286151db5ccf47d4c7b446889ebbb239c3a0488527a4e964639820f0280e97",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0004",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0005",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0006",
      "source_text_sha256": "64ba9ce5c97d695670604f88b4c33b2d95b807dac25e4008e3633352756fb9cc",
      "translation": "“……還在睡嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1ac724cbbef2f7672d14843d8cd6f4fb8179805303df5edc744f562d94589cf5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0007",
      "source_text_sha256": "b12a8adf0ea18345150b165f067ad7871dd23dd55dae9aed0a6b436f06105243",
      "translation": "“換衣服時他醒過一次，\n　自稱是新地球聯邦第88獨立機動群所屬，\n　尼奧·羅洛古上校……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation",
        "people/neo",
        "people/neo-roanoke-full",
        "rank/colonel"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation, people/neo；按日文源词绑定统一全局术语：rank/colonel。",
      "zh_hans_sha256": "36b78c489aa270d1b678f1acb1f4ea87887cc1404808c1ce99c88d5477bae118",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/096/dialogue/02.01/0008",
      "source_text_sha256": "8c0ac19c51035963500baa3acd1aba544a758cf43e83fe76f91b2be633ad6dfa",
      "translation": "“但是，檢查出的身體數據與本艦\n　數據庫中的記錄100%吻合。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e953508cf96f944f0abe2ddfe7eaa8e82f93471bf854040ac92fe6376cad2f07",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0009",
      "source_text_sha256": "ad666d0053c769eaa7de1ed010e8b367c78f47cac6d4ab8abddf6c8c6f32e866",
      "translation": "“那麼……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "aba2d766935318cb6dbda2826c7713f490c668de0302ce5d9422262cc43386b6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0010",
      "source_text_sha256": "61f88f45d0c1f3ca30bb02fb55b8b471dce3260f7607fc1a7e833edb875de4d2",
      "translation": "“這個人……\n　是我們認識的穆·拉·弗拉格……\n　至少在肉體上是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "08f1597b6e5f065ad1e90bace78d198fd82534af84eacbc325128df61a138f97",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0011",
      "source_text_sha256": "3207b28f00c8af497dd05351ac09244c9f4505d4239e1373f7d134206c3a23d0",
      "translation": "“把弗拉格少校送來的那位‘風暴’先生，\n　應該也知道這件事吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。",
      "zh_hans_sha256": "a233bb4f72095dcad8d5661f619aef72dbff0e6db8ae1086f4997797ca613901",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0012",
      "source_text_sha256": "44f12f5769072caff6f8252e762c9ad1e9a12ef7e57baaad10db2ae1b16a5eed",
      "translation": "“拉米亞斯艦長……\n　那位弗拉格少校是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。",
      "zh_hans_sha256": "ceec4263799b1fd00d4675885a495bb7d34d80bc3ca75fbdca276982b01882ff",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0013",
      "source_text_sha256": "41a0f325c617d98aac587e1bead8360dcb3ce6813b44535f480f1812f4a15d04",
      "translation": "“是這艘大天使號的前乘員。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。",
      "zh_hans_sha256": "a4636a23c3e427066bb1ba5f5d7979f6b7fc9ce7b3b97157c0cb7286da754e1a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0014",
      "source_text_sha256": "1805c38fc4739fb844bbdb8117f2bf72ef6af2072947240e4d00f7e0d9f8a276",
      "translation": "“兩年前……我以為他在前次大戰\n　的最後一場戰鬥中戰死了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "660d02451cbc316d086936af1d5cc2b85489f86e895f3c797dc70763381432b3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0015",
      "source_text_sha256": "7970ad55383330aaa21622f7e1eb3d7a7156b57da46a33518f7dcc8b5fd165be",
      "translation": "（這副神情……\n　看來對艦長而言，他是位特別的男性……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "225bcb5b7d10fbeea0db2a58aed97ad8db34b0a9426f230fd86136dc7afffc01",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0016",
      "source_text_sha256": "c6322fc112b62b84511f4b01cd317ad045c3d8d5d408a83c6eec5d307d1916ee",
      "translation": "“這到底是怎麼回事？\n　剛才説的‘肉體上’是指……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "114bebe63b969cd9a67ef6aa96095c80a38b407456febf0d0800d6c9055c1e25",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0017",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "865d63abd8eb3dd136c31e105c5697e679a2336a4c9049292ceae88f833f0ce6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0018",
      "source_text_sha256": "a68cbf52247551dc60d21b09720a8264f0a748e7e1cf99b5dcafa22c05ea43a5",
      "translation": "“……從剛才起就聽你們\n　在説些莫名其妙的話……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2d82e36bf8ce8a5bb16e6af607c81f2050499c5bcef21561ec10ebf8c2890347",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0019",
      "source_text_sha256": "2a533320e80dfe621ddc078d930b2abceb9f40b7811da212d0a7f2100d96d6ca",
      "translation": "“我什麼時候成少校了？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。",
      "zh_hans_sha256": "f8648b4ce85b6ee8608b70c1ee33579460a3af1afda178ccedd21798635661bf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0020",
      "source_text_sha256": "b6dc7742b2ad9582737e08e26e2c9457706659918ef7dbf2847613ce7857c6f2",
      "translation": "“啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5a0ad6a15c932526c196fc8401e5eb45eb39353596709ece3030640b2051f416",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0021",
      "source_text_sha256": "6c19cfb254a0aa4228e2f909578971fd5ffcedbd9b62e183569ae318eee77f5c",
      "translation": "“我明明説過自己是上校吧。\n　別因為我是俘虜，就隨便給我降級啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/colonel"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/colonel。",
      "zh_hans_sha256": "fe391718c8c63971a01e3b80bfa421aacad1b88452704467274cc77e357867e6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0022",
      "source_text_sha256": "1044a1605b31070f255381281e0cbbf57177c37d93b5feee369dfb141246921d",
      "translation": "“啊……啊啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8ff4924f06b4d895f1f739ed1a3191a5f39b57e11a1de5c65425fdb1d07744d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0023",
      "source_text_sha256": "e4b823aaea8e7e453304649f78eceefa1fef75f5ff032bd4775609df36eb384c",
      "translation": "“什、什麼啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "42e100a8dd9ed03a3ea76ee1a15307995c307b76043d1fd592375f34cc8cd897",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/096/dialogue/02.01/0024",
