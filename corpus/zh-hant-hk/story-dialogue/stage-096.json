      "source_text_sha256": "11123f47daf9904072568f76ffc035373613f6a31c0d547123c576f8fd5c11d2",
      "translation": "“這到底是怎麼回事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e50e38082738c4b6747f5a69504dd5c2ec7bf1034d8b82e1ff953c0962073c6d",
      "zh_hant_status": "draft"
    },
