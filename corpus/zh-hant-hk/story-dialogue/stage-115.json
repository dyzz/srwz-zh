    },
    {
      "id": "story/115/dialogue/02.01/0052",
      "source_text_sha256": "9022c2f9f39e895eaf008b0fd348209a84a3ac6b7bfc1f18163af9edfd29e916",
      "translation": "　　　　　　〜最高評議會議長辦公室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a633b3531e51c7abdae3fe5d807592280b3e81709c3c62fb3b9b565b267d5e1d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0053",
      "source_text_sha256": "1fd4d9892000727f13ab89936d73cd2a4f895bcffbfa7301d1d1d4ed0a782a79",
      "translation": "“戴蘭達議長，\n　P.L.A.N.T.的受損情況如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant",
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "a8f6122df0debeec09685ffacc8f3f4896c878b887c92709ea0ff7a4185b2003",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0054",
      "source_text_sha256": "307577b94082c6d2872f51f020aa74defe71acd79d6a43568dd93087fdf995ad",
      "translation": "“……還是讓你看影像比較快。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "86efd3f2f77748e7ee2e7993d235ab31beaa7ffa91add9414455f7f1d02318fd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0055",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留",
      "zh_hans_sha256": "773975abb70109281b41c57bcbe91d75e7f9ab09eb44d01fb5a9d5340501681a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0056",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留",
      "zh_hans_sha256": "773975abb70109281b41c57bcbe91d75e7f9ab09eb44d01fb5a9d5340501681a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0057",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留",
      "zh_hans_sha256": "773975abb70109281b41c57bcbe91d75e7f9ab09eb44d01fb5a9d5340501681a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0058",
      "source_text_sha256": "1f786858184fbf3503ad4cc51630027a0d508c5b7dfa83d91ba0d8b8f77a16ae",
      "translation": "“……真慘啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "30d39bb419f409f678a19cdbba3c7b4165dad9f9de40c4ab4349314f7211134d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0059",
      "source_text_sha256": "ff0cac1e5045bb9755465c0eabd6282d603402bbd29a5a8f371dc862a7e9a6e4",
      "translation": "“雅努阿里烏斯1到4被直接命中，\n　迪森貝爾7和8因雅努阿里烏斯4的撞擊而崩塌。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9603e8874af9aa654fc6d64079d5a46e0d1028c5a79000bcbaf32e58bdd92277",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0060",
      "source_text_sha256": "de2bb5360ac56d46f3637fa54e32adbe5fdd8cedb6319edcfac6d0cde2ac3930",
      "translation": "“包括二次災害，共計6座殖民衞星毀滅。\n　死傷者超過100萬人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/space-colony-short"
      ],
      "notes": "",
      "zh_hans_sha256": "d467d5627ead1eef57d49a1d06b1e06fb81bb983e1b3d293be51519d59d767c3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0061",
      "source_text_sha256": "6ec8e26965869f3ba9b257605c867a2f799bb2885219044f5a36a28e9eb27a02",
      "translation": "“竟然能用廢棄殖民衞星上布設的力場\n　改變光束的方向，從任何角度狙擊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/space-colony-short"
      ],
      "notes": "",
      "zh_hans_sha256": "cb7d89648c55af546211901cb25fe5e23fb89eac31e5d4c0afb3dee789e2d0f4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0062",
      "source_text_sha256": "1238ae3810fff9c9c28e172fe70e46763799608b4c223d226a03381e0a25d7d5",
      "translation": "“據駐留月球附近的部隊報告，\n　尚未發現第二次發射的跡象。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a99bc5fcd41ee7142ec041ba8b253103762925bb32516546d8a11e687fc02b1a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0063",
      "source_text_sha256": "407fd033a31ff7e8e11ed3856a19c274932f478016b6fde5a126ce01726818d9",
      "translation": "“看來可以認為它無法連射。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f9313938e8cac94cdb00824947ac0d2f710c2692ba424cf71786cb6af0924cbb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0064",
      "source_text_sha256": "3abdee01f7fc6c4619a16403187aca71ed56fdd2362fffd9acd4da05cc29e79a",
      "translation": "“但既然不知道下一次何時會來，\n　必須儘快摧毀它。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ea142b812b937c838c38bc32ca5b0f262e99c89d34488e83d5ec05b3c32caf99",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0065",
      "source_text_sha256": "9e522461c5ef25955a2860a7849c6a1411bf68a91cbf8ea5c20d64084a13d3f3",
      "translation": "“你打算怎麼行動？\n　奧干叛離後，多線作戰形勢嚴峻啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/aeug"
      ],
      "notes": "",
      "zh_hans_sha256": "80d401a072a5029ece44b6e88f941e69cb4876bdfa3a6de92cd2a4bc6c9ce410",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0066",
      "source_text_sha256": "0ca7172c15a0ec837982e62ba5c4fa53ca5496b9a3eb38e54d52ded3abd2acd3",
      "translation": "“出動彌賽亞。\n　也為了藉此吸引捷布利路的注意，\n　我將親赴前線。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ab2e13273d09dc0c79e9e64a97187b9170651817a16bb48095336955270d0b7d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0067",
      "source_text_sha256": "ac8a5fbcb2de1e5cc24fbd268502d03eef01c66ceb3337d9fdea2d205208c5c3",
      "translation": "“決一雌雄的時候到了……我們、LOGOS\n　和新聯邦……勝利者將肩負人類的明天。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/speaker-539973d146a5"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-539973d146a5。",
      "zh_hans_sha256": "d5f01184baecd286b09013c7a91a7009f79af80210b086f8530788d5c049d35c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0068",
      "source_text_sha256": "7a4bde3b0f67c0ca7482aefef68f52075c303511c588c8f982615bb5851b55ef",
      "translation": "“如果我們勝利了呢……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "351fe2b9e8cb3dfa294077e60aa63e5cd229ad75b92bddfa297a166dbdae671e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0069",
      "source_text_sha256": "7787cb01a4a9caa6ea94800dc1fa979ff0a788628fc228fe9f678e065ac807ef",
      "translation": "“為了不再重複這種愚蠢的錯誤，\n　我打算實施那個計劃。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e1a991659fb76fb166443e4568e0fd23fc6efca784f55a1d3d8937c40e6e5fea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0070",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0071",
      "source_text_sha256": "4c06a4c34c661d8df73a7aae671d9bd6f7149a254da0b55dcbaa0e5c57fe8597",
      "translation": "“……明白了。\n　宇宙革命軍的主力離月球最近。\n　先讓宰達行動吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/space-revolutionary-army",
        "people/speaker-f04a695faeed"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-f04a695faeed。",
      "zh_hans_sha256": "d7baa85eaefcea48a646f9fafef29d41915bda791f7c96222d76228335ac892b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0072",
      "source_text_sha256": "f8ee29d93f70731a823a749679c225bb0d5e2fe930747a30fa343b0c399a2246",
      "translation": "“哈曼·卡恩。\n　感謝你成為我的同志。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5b74b7946462c384a2750b23e9acdec782127046afb2c02120259839da919781",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0073",
      "source_text_sha256": "043dacef31084a55bfbf392c0300392565ed2852bb41179f49aea655b464b07d",
      "translation": "“我是憂心人類明天的人。\n　為此，我想採取最合適的行動。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "78f0378116935c7966f2feb5ad9e11efb188251163c89d2d9f2a73ae60c72353",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0074",
      "source_text_sha256": "0af2146f99149a8546ae7f724abe65f6142be436b2f100d13b9c7cd9dcb130c9",
      "translation": "“那麼，告辭了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6f610fd4ae441e3a9fae7ee3a16be3d122bb7a916bdc098c1fb77214692dec25",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0075",
      "source_text_sha256": "a3ca6a1dc55d4b1953c4b7918935f43f2a29d8033e0d9959448f72af94078c8c",
      "translation": "“人類的明天嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c6c9ba0bd9bb6e24c577da4220b58b9972c51ba86f315c000c6de4140c66ee90",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0076",
      "source_text_sha256": "8e3122eb21747fe9584b4115d1645be3123ec1839ba1f3c9b3e7ef9737686268",
      "translation": "“會是一場大戰呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b2331c18f39f113001c588b53dcfe4312a54192301ebb5062134fa2029ca20c9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0077",
      "source_text_sha256": "80957b407e3aad88b8704ce1f2c520720e60dd4a3add988523e959263fecc2b9",
      "translation": "“而且將是最後一戰。\n　……你到今天為止，一直做得很好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c5ccc9d2982aade1e2dfa669f389500930261bce53a329846acd0a33318c49d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0078",
      "source_text_sha256": "765ab3616b297b99fa454b696b7b584f7a3c13ecf002543153faab05cb46286b",
      "translation": "“是、是的……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "90545c10a86d164a8c0b5d0bc2ab4253a5e44980d52e704d6fd0fcf2ce1cb487",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0079",
      "source_text_sha256": "a7ded4261053b3814b92dd61d061d2d269a85d3b24bbb703188f5f8454574461",
      "translation": "“從現在起，世界將由力量來推動。\n　在局勢穩定之前，\n　你到後方好好休息吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "44c3a74bf23abfdd9bfd21b1d80b98f903fc5937399e08d97574cc0604a448d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0080",
      "source_text_sha256": "6e80de93b986dd383629950b9f014842f35ab05ca376c801f7093ec3076e92cd",
      "translation": "“我在月球的自由都市哥白尼準備了房間。\n　在那裏等一段時間。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "927c88e6fbeba682ced80c63b2d896e59d90e0dfb5e3d263307263a22ba103fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0081",
      "source_text_sha256": "7c697d2481f7b9f6fc6e99c079a83a96e63e6e55041de22007bf53f377871b1a",
      "translation": "“議長……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "29495eddc347f16a8991bb4dba7acddc60a0672678b1fa2418b658a50f580681",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0082",
      "source_text_sha256": "401791d6cd71e0f4e6f5778ce66720cd3a615fb0d7a4cd6010875916d962fca0",
      "translation": "（不過再過一段時間，\n　你我便該永遠分別了吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "747ba2331ee54701f5eee8ca8564bd91a3e2a2c6a2bafdce4201584dd5027970",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0083",
      "source_text_sha256": "f5996ea3394360d4b12ef04e36497df85757ad635208810cc5296888f7f0ccd5",
      "translation": "（泰莉亞……\n　我真正的戰鬥即將開始……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-aa16fea188ec"
      ],
      "notes": "",
      "zh_hans_sha256": "bb347cfd6d5f5ee4b26fd3c00049cfd6034e4fae8f204d0d81e8fe7f628460d8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0084",
      "source_text_sha256": "998fef958a12c4e05ccb6f30c58953acf2b9cb0ac95f283389736326ee1f28df",
      "translation": "（你和尼爾他們也要回來。\n　我打算用盡所有力量，\n　挑戰這個世界和命運……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": "",
      "zh_hans_sha256": "1949461bc7b2dcabf7a1abfec1de2afebf3aa7a5aa51c79e70f35069b71a578d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0085",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0086",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0087",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0088",
      "source_text_sha256": "37a2fba3530cb70cd218fcd95a318deb2c233c351410e054863341a6e92e5236",
      "translation": "“……真醜陋……\n　明明都是人類，為何還要彼此仇恨，\n　無休無止地互相殺戮……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "82f1d93ae3c6a85de6623b84ab8b5af96ca0905a27fdee04077f43d23abc51ce",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0089",
      "source_text_sha256": "5d9d7551fffa0c5d1bcf5f6bdf196477cf28146b0fa503fca0e674278a665955",
      "translation": "“那種醜陋的生物連存在都不被允許……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d7d582565a0c197013925882f98d1edf8078d3a7c9c041b53feee0d020ec2350",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0090",
      "source_text_sha256": "34c429d9a68d2d9dfb47fe15d1ae44aad53e2c5ddf90ee16c483c55d9dec637d",
      "translation": "“……創聖之果結實時，\n　亞特蘭提亞將從因果中解放，\n　新世界誕生。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。",
      "zh_hans_sha256": "bda56299826476dcc779737006cfd129f129bb80c8bb9d0ad9576974e2896a17",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0091",
      "source_text_sha256": "76b9a0a6825531788a320cc6c541d2abe66c95388e983ec3d16641810d9ba4b6",
      "translation": "“創聖……新世界的誕生……\n　多麼甘美的迴響……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5056a3a3950967c4a49a94ca9f7005a56fba1d4d0a091afc4bc7a8e502cec475",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0092",
      "source_text_sha256": "617a3f89071d12530c0db953cf68e59d579ec511fb6b4eb6c6918bb531bb71ac",
      "translation": "“只有美麗的靈魂才應被迎入那個新世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7671fb4932c511ed189d92af595cc24af27daa221d86cef16b9276c6b6f631ed",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0093",
      "source_text_sha256": "23a410e59bbc39670878e3e9bca38d3953805930d222a9909b35c004551d6860",
      "translation": "“人類沒有那個資格。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "625d59199e53586715f7bc530350152598f111ab34b3bd5da77bc0705c76ae23",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0094",
      "source_text_sha256": "8c51d27d1c7aa75517c91bf8c54ce54cd946151350dcc7faf1379e6642c3ed66",
      "translation": "“但無翼者在一萬兩千年前的戰鬥中仍在抵抗……\n　與機械天使一起。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/wingless"
      ],
      "notes": "",
      "zh_hans_sha256": "318e242730707b12109dd7a879302542fcb1d7e2911e43329d266c26a8d67d9b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0095",
      "source_text_sha256": "63b440b6b7ebf2b73c93d9bd9c62c49d3451b3e1a60b1b1b8434c5097b154b8f",
      "translation": "“機械天使……機械天使……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "user/unit/aquarion"
      ],
      "notes": "正式词表构建审计修正。",
      "glossary_exceptions": [
        "unit/aquarion"
      ],
      "zh_hans_sha256": "7fd09df6631be0b3149c4bf7c638287392ba69572a1cdf1f83b53a4f71ca19f6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0096",
      "source_text_sha256": "ac273cdb5a1c3a736fc67737be964688660cc53d7423469d2c2d5d1f2330b5b0",
      "translation": "“與它一同對抗我們的力量……\n　其中一股現在正對同樣的無翼者露出獠牙。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/wingless"
      ],
      "notes": "",
      "zh_hans_sha256": "772db4fb5f939edf9751176403fbe945b4a53614e843cde07ce197b2528c6726",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0097",
      "source_text_sha256": "20a69e13f8a9ea358df99bedbfd72e4fd9ad16e0a9b7d46990ae3697ffcf7a0f",
      "translation": "“看看吧，詩翅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sirius-wing"
      ],
      "notes": "",
      "zh_hans_sha256": "5fa5fc60ee9ffb25d04672e5d5dde4549cd069958b84c3398e69580cb57edd41",
      "zh_hant_status": "draft"
    },
