      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "355db5efdd3ec955aead8640a70992c34b97db729742335eed87ecae932e808b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0014",
      "source_text_sha256": "bfae3cb8ecaad8f00abdb7cb610bd944f347cbe3636842fe7d217c639696c85b",
      "translation": "鎮魂曲內部",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "355db5efdd3ec955aead8640a70992c34b97db729742335eed87ecae932e808b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0015",
      "source_text_sha256": "bfae3cb8ecaad8f00abdb7cb610bd944f347cbe3636842fe7d217c639696c85b",
      "translation": "鎮魂曲內部",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "355db5efdd3ec955aead8640a70992c34b97db729742335eed87ecae932e808b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0016",
      "source_text_sha256": "fe7f38da6fa16582cd0de27d8e80da1033523d41588950debf228c01f7f406a2",
      "translation": "　　　　　　　　〜鎮魂曲司令室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "43577ed60e6dd685868db5c1720699f82aec1c1e21bf0f62c7113fac705ee010",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0017",
      "source_text_sha256": "edacf36cca5b225cb94863a11f8fb1fdd61538de392779c157102465f1267340",
      "translation": "“阿普里利烏斯還完好！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "be289fdde16cc13ecc11a8b35cbba8c02861c2dd6bb551c01b3e39dc904bd285",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0018",
      "source_text_sha256": "9735bd74233a226d7e0a802190f10b8fb327364e960a03abfd48881fae14a025",
      "translation": "“看來鎮魂曲的輸出比預定稍顯不足。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5a5f0032e2f7e9af0c031a403542432f9e31bdae75686c607c90e40955754b0e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0019",
      "source_text_sha256": "9875c5bdcc97d7f71fa39c3de73570180b682bd42e4a05e37569d122b8fae366",
      "translation": "“但P.L.A.N.T.方面的損失慘重。\n　包括降下月球的部隊在內，\n　全軍已暫時撤退。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "b48b6891fc9a3d8bbba5a898783b09471c8b8734ca2e0cb853139aaa5619ba3f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0020",
      "source_text_sha256": "93254196bab97b83dc4ae30b5dbd6b858e769f91b396397b5fc1cbc1fdb69ff2",
      "translation": "“不除掉戴蘭達，\n　就不能算勝利！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "0779271906ac1341e94c9eea45df53e6d53e1db2e60226d2eba8297a22d4d770",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0021",
      "source_text_sha256": "b33baed7ad4c72dc211f9cfb572afcf1505e2c5e75c69f2102887a4dbe175ed9",
      "translation": "“趕緊準備再次發射！\n　這次一定要毀滅阿普里利烏斯！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "23f4817525b71b60b0d671532569218ba9815050bc9798aacd54c168dec1edd2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0022",
      "source_text_sha256": "9370eca5ce125552080fffb545fdf606ad587812c73b2ac62461604fad555a91",
      "translation": "“請稍等……\n　考慮到荻花·安迪爾的狀態，\n　連續使用很危險。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f90456b09340e0b0da5882fda883def2a34fa61fa1c24d864a477a65135c727b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0023",
      "source_text_sha256": "9cc417b635da35f1c326c7b5ebbe6341a2e5c9432bbed724340e7df8c3a448d2",
      "translation": "“什麼！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c95d600897af56f91bc440c1c8f0e18d9bc8d7d60c01ae5c47accfe8ace44086",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0024",
      "source_text_sha256": "9ccb5ad5742a50d11dbf5764dd94b13323493dc7c786a29d266adfc12a2f2fdd",
      "translation": "“為了訪問發電設施D.O.M.E.的意志並使用其功能，\n　我們控制了她的精神。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/dome"
      ],
      "notes": "",
      "zh_hans_sha256": "4fa99dffa2c54f20833301b4c49c4813084f55745504238514e31e70b164b90b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0025",
      "source_text_sha256": "03ada3f80adba8243975ec595212b761f1bb43aaa8e02bf3bf6f1d5cd18a225a",
      "translation": "“這我已經聽説了。\n　就算有些不足，\n　事實上鎮魂曲已經啓動。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6afe4b58a281fe82e5079d20a862c5b584a2a162e45dd43c9ebab2be62313ecd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0026",
      "source_text_sha256": "4af48460adde7d114d47595ff2a0f6867e9b07d58cb3406159241afcd35e29f5",
      "translation": "“調整輸出後，\n　立刻再次發動攻擊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c7888d51c0ff3ebca34bbde84d3036139a23d70bac3b856bcce73fc8da10e718",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0027",
      "source_text_sha256": "5dc1222d1166d50d3b1728b4db85839da8e1142d6dc1328e768690f7bef3a57d",
      "translation": "“荻花·安迪爾的精神\n　控制需要非常精密的調整。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "614382e061b497f70a41a5226d8a9d7a9ef73f7604b1314c99a9a55a227fb276",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0028",
      "source_text_sha256": "4f246d7599b9f92eacdcb15795266e1947714f7dcc610897e734e2bb1b185a27",
      "translation": "“如果完全剝奪她的意志，\n　也會扼殺她的感應能力。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c4448c907a2536814f835a75616ebead3dea52b19ed5adbf82a1d95fb58afeb7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0029",
      "source_text_sha256": "9adeffa15d13e3a918e949f2f151331fb219249bf6ed771ce7936cd7b595ce91",
      "translation": "“既然是在此基礎上訪問，\n　過度使用可能導致無法挽回的後果。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1535a36fdc4a2c9b56a8a999698d8b260f41e8aeda56e8b3ad23f8cf3f5197bc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0030",
      "source_text_sha256": "94e1cde237ae76f797933be035705f2a63f0d3f911e1345870c734b4a7ef4b8e",
      "translation": "“唔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "820735ae09d4ed75503b3bd882ce7de621342814099ba3ee01bba576dec73386",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0031",
      "source_text_sha256": "490ee1331ab0fec36a947cf1fbf37334363695bf0d829f810bab5120e9ea9e0e",
      "translation": "“請放心，閣下。\n　這次不過是試射。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3b087b960d069ca770670332679aacfb8b173af7b3421a5bac58ce87e73a3dcb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0032",
      "source_text_sha256": "cf5c905b435e74b23cc8e144df40aaf8eb69e453dee6525d6a4f9c2cd44ca079",
      "translation": "“分析這次獲得的數據後，總有一天可以不\n　依賴新類型人的力量來控制D.O.M.E.。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/newtype",
        "technology/dome"
      ],
      "notes": "",
      "zh_hans_sha256": "951bd082b97aa145812b51961b8fb25111afa2ebf9b1fb943e2ed8bbd76d94f9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0033",
      "source_text_sha256": "904a3a139c5f3589d69edc35515065406795a49dff6e6e39ef4414f79c88304d",
      "translation": "“那需要多少時間？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6b71285bb3ce418f00ea45c43646740172e15fe6c865b3700a1592fca539c820",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0034",
      "source_text_sha256": "1844b301fcda6066b897e18f6e0afc9bd4d88bff4a883b5e316a6ed1cc9ca941",
      "translation": "“請給我十天。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4507871e91d2d09b112d825c418f3a8e2137c0a5082ccb5b2d5c4f4f7a91483b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0035",
      "source_text_sha256": "d923d4244da74ad96acf73a4fdcd16f1fd13eb407697ba206203ac97a2295f8b",
      "translation": "“一週內完成。\n　這是命令。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bff14b5b6f1674ed1e7cbfc5b7c2365aba9eea9e6f42afb2c1d98bf3ad8428d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0036",
      "source_text_sha256": "70cc031ea4d4acf69a103463eb34f13bf23f4e899115ee813fe213c8fe909320",
      "translation": "“遵命。\n　一定在一週內拿出成果。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "10a2e5f1d62f70f0ff2d099205ef3d7188af91ed75b9a79dda4b6f248fb5aa05",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0037",
      "source_text_sha256": "2279ccd8ab45ffd9b6ec4d1fa519c1c51287d3393b1da66104c3e01763e0d7d7",
      "translation": "“戴蘭達那傢伙……\n　現在大概正被鎮魂曲的威力嚇得發抖吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "15b815a770b9ccc9a0e1bba793e6fbb186f92b44c1d04e815dde675b553da1f2",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0038",
      "source_text_sha256": "a5405b29389716702a57db4bf7cc620b795fb0567303e786d11c3efd96f67b74",
      "translation": "“儘管與恐懼和絕望為伴吧。\n　一週後我會讓你見識真正的鎮魂曲。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "19e0791d0f2e7478a16a15352f07ecd35f9281bd7c29a97a8b68fcc8e1fc7445",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0039",
      "source_text_sha256": "9aa103ce68f1e3c9ad6b63fb7b6b222060edd76a4a7b76d9bb5819d12056a851",
      "translation": "“然後下一個就是斯洛哥、\n　杜威和安戴爾！\n　排除他們，我將再次成為地球的盟主！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-96eedf25cbff",
        "people/speaker-e6fa3d02a89f"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-e6fa3d02a89f。按日文源词绑定统一全局术语：people/speaker-96eedf25cbff。",
      "zh_hans_sha256": "606492b114c8d95517452fba19bf2b6e8fc778ecee2f820e550f0aaee4d40cc1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0040",
      "source_text_sha256": "5126542fdd8f8f40ce914f79a7209acba8a31c0d2f10e5799ea6446f482e86ce",
      "translation": "（哥哥……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "627a45515a515e4e70c01caf0dc434432061cee3b52668548daf60e8b490925d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0041",
      "source_text_sha256": "0a0144dff5935ae98d1d9d6f1732be0c9998d83221776491ece36d3577f69008",
      "translation": "（就讓他再做會兒夢吧……\n　也就這一會兒了……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b7ab79b530c82e1e5ba190d40f5f858492ee2221d51dcf30e0649a9d00c8ee09",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/115/dialogue/02.01/0042",
      "source_text_sha256": "209b77cb64c88716d8714fe53e4969c8ffd522041a74f3c23c845dd3453af2d3",
      "translation": "（一週後……\n　那時我們真正的戰鬥才要開始呢……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1784e5a7adb62099a4172bcab295e63771d13249a65b022c506ed3bff5a53a9a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0043",
      "source_text_sha256": "870ce5066e9e3ece17cd5a98ef96478997f850cb60aa20764b861096a99a34b1",
      "translation": "（還真得感謝黑之卡里斯馬\n　告訴我們那個傢伙的存在啊。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。",
      "zh_hans_sha256": "f574941dfc340ec6ad82052121dda58feb5ee53a98cd56eba19503f7a3aa5073",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0044",
      "source_text_sha256": "cfa8d743f7c2c00aca64ed1bf52dc5d835963a4cd8cfc3508ae16c77e08a9982",
      "translation": "（還有，這個多元世界也……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": "",
      "zh_hans_sha256": "6bd9c54b954f802564b35e2550af754ad8973858a27e59215040064fbf0c34a3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/115/dialogue/02.01/0045",
      "source_text_sha256": "a63928cff66210a98ced7bddb52b5253bbaa48686625d39e5011d5d96481c738",
      "translation": "（對命運的復仇……\n　我不會原諒那個奪走我們未來的男人。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f17229ea08f145fa0f910ec0695ddef2752bc7f9c5a1d9d654067c80d43b7805",
      "zh_hant_status": "draft"
    },
    {
