{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hant",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      49
    ],
    "entry_count": 81,
    "unique_source_text_count": 78,
    "translated_entry_count": 81,
    "punctuation_only_entry_count": 3
  },
  "entries": [
    {
      "translation": "“羅渣·史密斯先生呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0000",
      "source_text_sha256": "683a6d4939c4963d59240f39aa47f2aaae1fb2a0ed699b7cf5a6c265b8455326",
      "zh_hans_sha256": "3c0e330ba5269a288de8d8351f53f48382ef8ff5a301748d40dd16854cad811b",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“今天一早就出發了。\n　他説不需要大張旗鼓地送行……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0001",
      "source_text_sha256": "a7c5e5a64ca93e4d9ef615da042a4e0b227fcda8335920eb7d8e635c2eb48640",
      "zh_hans_sha256": "3f74fbf5784b868e1711d30acfad7227606ddfeca85b9148bd1d40bc95d44cae",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“那個人有些與眾不同的講究呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0002",
      "source_text_sha256": "a463e1eb2767930c1462b287835c200276c650e68fe00c73b5e95ed3456a0f1d",
      "zh_hans_sha256": "1bdbd572c300c24bff5dd7bd3c01cd521b92274b59062424af6e07611b7b36e0",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“算是他自己的美學吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0003",
      "source_text_sha256": "33c48e6a244719acd469c98b036c339f2838932d7f24a47544efb884c4e8ff48",
      "zh_hans_sha256": "c00b8037caf8c38dc306d2634aa389bfc727e70ffc3dba20d8b116e62945a373",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“啊——……難得又見到多麗絲小姐，\n　卻馬上又要分別了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0004",
      "source_text_sha256": "84c7a6a4ca7d62de294de554e2b252af5c5ff09e6f3032f858ee1ab0b02850a8",
      "zh_hans_sha256": "b3d6685f0e91f2a517a5cca9bbcf640a2bba5e96242875dec427a9490c426a45",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“説什麼呢，摩姆。\n　同為機械人，不是還有老夫在嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0005",
      "source_text_sha256": "e830335c18f6fbd1de7ca2cf45983f3e897d750f64fd54036a9d6d56e10de694",
      "zh_hans_sha256": "558a85a64e668863b268239a9b2a7526510b96446e9ff0bb082a608cfd0cb73a",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“那麼，上尉……！能幫忙洗衣服、打掃嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "id": "story/049/dialogue/00.01/0006",
      "source_text_sha256": "4ac0788807b6f508570aaf9abd05cd47bb642b14d2c718998ce00f48c1eb307c",
      "zh_hans_sha256": "50244f402123be307959ae626f4a8706758d2bc41dbcd10c26a9fea14e8bc3ea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/00.01/0007",
      "source_text_sha256": "f51a5fd118c9da16ed14b60ef1e7763bf0febca761eab9f969423e52eada2ba8",
      "translation": "“這、這個嘛……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3334bacb5177a5978ad57af0a2b7b0a20cd07226c0f0785b6d0a00ad40d73458",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“布莉基塔她們也要離開，\n　人手不夠了。\n　不願意也得幫忙哦！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0008",
      "source_text_sha256": "f1fb07ac111cf789e553c8e4b54bf0fc6b288dd3bccbb5a6bb9679d4a815c3c4",
      "zh_hans_sha256": "0af6dc4b2a023ba1fbc5d2ffa9ca1bcc3b4ccd13856a6cc922b9797db988fb92",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“好了好了，別吵了。\n　差不多該出發了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0009",
      "source_text_sha256": "89cc774ad9b9b6de20ec9ea0be7749d5bfc6d1f7caead43aa8bb415c15de432d",
      "zh_hans_sha256": "7ad98dc6d0a27ad9e2009da227e150158937901621f80135366b7944d45e22fe",
      "zh_hant_status": "draft"
    },
    {
      "translation": "（只要札多部隊能牽制奇拉姆，\n　我們就能安全前往埃曼……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0010",
      "source_text_sha256": "6003c24ad284410a5ddc6a22803d2431eb95bdb497be447d288e06c07e212b49",
      "zh_hans_sha256": "500b7b6e44e84d978a30a1a269cb7f5b3e89e9d0cfa5549fe13ca06d8d4db119",
      "zh_hant_status": "edited"
    },
    {
      "translation": "（雖然對葛拉迪斯艦長過意不去，\n　但這裏就讓他們當誘餌吧。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0011",
      "source_text_sha256": "7a3d51522e83bc45bdb612ac2c4aac365f4a2cefdf51eb12834a2d2f2c71f904",
      "zh_hans_sha256": "d7641a67d754a9ed8e9e4faa7ca89f5469cd3b20592e08d463e42eca4e9d8d34",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“不過，這樣真的好嗎，\n　小姐？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0012",
      "source_text_sha256": "48b25983a503a6535ec5709bafd6fc05799442718d60563388cc671f7fd02334",
      "zh_hans_sha256": "8ce3f57d74ec5b6113238c201aba88fd71be6ca5abb8f43a697265c97970002f",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“要是繼續和札多在一起，\n　就真的非得跟聯邦軍開戰不可了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0013",
      "source_text_sha256": "bcdf05085901118c47bef1498a4165b97f07959d42fae4df5d56eb2e466f85a2",
      "zh_hans_sha256": "9d3e946c7dbd0374fd36c56713c737407fccd471ab5f83094c705b1f24d63ef3",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“但只要在這裏分開，聯邦軍肯定會追他們，\n　放過我們。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0014",
      "source_text_sha256": "2cbf1e6ccf23b9949bcff4eacd95e6e7df98bf9a1e51b69921a5bc1eca071b3a",
      "zh_hans_sha256": "ac61c8f1578a766c5303b8d6ae9f559a71f2a4dea829a2cef178862cae4dddc7",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“這個嘛……對我們來説，\n　不管聯邦還是札多獲勝，\n　都沒什麼關係……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0015",
      "source_text_sha256": "1934b53f46ef363abe1d2ad8a25fbbf3540db03e0b33ad9ffbaf648663654eee",
      "zh_hans_sha256": "73bdabe04d55b3472d8ddc1724af350ca40748cb276efeac0b9fc1e333078444",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“今後要向格羅瑪學習，\n　好好做搬運生意！\n　畢竟札多不會再給報酬了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0016",
      "source_text_sha256": "6b69bafa4058baf19b7d0f1da69970cfcada71aea83d480f1a9655a8f2f842e6",
      "zh_hans_sha256": "e126150772cf45d8101a828a1a30a0d1393ed922772003ae87ae518578ce3433",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/00.01/0017",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“不用擔心，荻花。\n　我們只要走自己的路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0018",
      "source_text_sha256": "d4aefff588691cd3bf6443c6f1987fa327b13f7c1eeaf5c442098720ca97b576",
      "zh_hans_sha256": "e20355ac98e8c9dd32c8f1ac5c941cf7a8a5b21c236d4f81b4449c7973a34d03",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“可是，和札多一起行動\n　不是更有安全保障嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0019",
      "source_text_sha256": "4d84cd45eab16b8ef89fb2e73b1185412929252333db5edaa48c944cc4389e34",
      "zh_hans_sha256": "93a9645815cc0f36b9d7e0f9040514cad06622f2c8a6c16d4cc9ed3eb1e5bba2",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“……也許吧。\n　但在這看不見明天的世界……\n　我們要自己決定前進的道路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0020",
      "source_text_sha256": "88e5d07980b4822da795010a148f71161d3385cdddfc1537fa5a30310d17dd6a",
      "zh_hans_sha256": "f16b316da1d06f58b3502137919b2125e6328aee83ffcbe1d987b60482635d6a",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“因為和札多一起行動，\n　就不會有那種自由了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0021",
      "source_text_sha256": "4d149a37bf0824533389e37efa1a975093ed89bee0f47441da930e63c3ed4a6d",
      "zh_hans_sha256": "e204ffbc9757ec68783baac5c58bc74a85cef3d708d35a03fc68dbe493146862",
      "zh_hant_status": "edited"
    },
    {
      "translation": "（阿寶上尉……\n　我也打算自己尋找答案。\n　和荻花、夥伴們一起……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "id": "story/049/dialogue/00.01/0022",
      "source_text_sha256": "2f63c4a43fdb46af6cccad9909cac06e880dcd47415499be4ff488cdc196db75",
      "zh_hans_sha256": "4ac1bf58c9b1859e8411376f80fe8c5c7372cc092421340559a67761fd59db48",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“我也贊成那個墨鏡艦長的想法。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0023",
      "source_text_sha256": "36d3494686a2b6411aa1da11e0ccb651135e5c1bf064e202035022baa25edf02",
      "zh_hans_sha256": "3925756f15a9bf68c5148dc2fca92172f6df4854214a1da4742b7f2c544f8d06",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“不愧是前新人類啊。\n　不過……我的直覺也告訴我，\n　這樣下去不會有好事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0024",
      "source_text_sha256": "5a045e75f3459e6d97b64b6f9a06ef88e97305efdbb3e2c9bd18d41db5fffced",
      "zh_hans_sha256": "7200d93794ba6638a9bb66c9f79e10119361bd82e4f07356c3cf491bb7db7fc0",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“這就是月光州脱離的理由嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0025",
      "source_text_sha256": "6125c3ae485aaaf0255009480b640c969df4c634bc43df6ee4efdcd0640af8b9",
      "zh_hans_sha256": "16fc8d4a9d7254f10e1be3ded963960944e1b2912468306d08a54c9c92041d84",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“我討厭在自己毫不知情的時候，\n　事情就被別人決定了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0026",
      "source_text_sha256": "f6391e7132fcd8d1009adb5f85af0ebbc4cdb3b6d743130e4979c5ecc9b84423",
      "zh_hans_sha256": "c06f69e7759a1b4dc8cdc8d8597607b5be25063a78691fe2cd17cf718f20cb4c",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“聽從素未謀面的某人指示，\n　被使喚得團團轉，我已經受夠了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0027",
      "source_text_sha256": "beb2a58d141621a67c939786abec914e97b3adb38a4831573c24429acfb5450b",
      "zh_hans_sha256": "3046f9697d22abd297c883b38785c406c6782e7436874af677e76df803d6d9c6",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“同感！\n　果然自己的路，\n　就該由自己決定！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0028",
      "source_text_sha256": "f208e4b88d1e81c10c422600ecd0147c4f1976ef0056a81beac52cf626fe50e6",
      "zh_hans_sha256": "7275f88e76adc54cf10ae5536d7c04c5703fc515e3efd450057475091f3199f2",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“説得對。\n　……不要哀求，學會爭取！\n　若是如此，終有所獲！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0029",
      "source_text_sha256": "12ac3ec73af98d259cc0a5c7311b1369e678ac9d766d01cb422b555ca01e2ceb",
      "zh_hans_sha256": "a76c0a5f2028ef3a3dda4f9f34c2f516d589c5feee706462f4c09e8cc22e8cd1",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“那就出發吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0030",
      "source_text_sha256": "9b05c557ed3232c23ced7c8801977ec5baf4cce055ead5188d082177d7124fcc",
      "zh_hans_sha256": "94bfcb2415aeb8a506a98caf613110cd9a7c676157b9940fa096b76ee64506aa",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“$c各艦，出發！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0031",
      "source_text_sha256": "62f1afbb149e5509356d69bcf12e2db7c2dcef4a4f622635f4a52c3e8b680abb",
      "zh_hans_sha256": "5a9bf5719c54c4a05c7d4761743da9cdfb6acffe81ad1ad6af4d98f4501a28d4",
      "zh_hant_status": "draft"
    },
    {
      "translation": "（再見了，夥伴……\n　有緣的話，再會吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.02/0000",
      "source_text_sha256": "d1052643eb1f6a8d1735c5f7cc903b567b44a96b5a2e784e1f6a83babde066e8",
      "zh_hans_sha256": "ac7b7123ca439f52a5c65742914bf393b3ffab8e6e4864305189a65adb3d5435",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/00.03/0000",
      "source_text_sha256": "1c58432c4614d72a36b0e36cd60aebc248b6452e1d25220e19094a63cc4915c9",
      "translation": "“走了嗎……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dbd5f709ba86619e3bb2896f3b9ee8b2dd524a7a8fade9bb35595bd784fb6944",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“他們有他們的活法……\n　而我們也有自己的戰鬥。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0001",
      "source_text_sha256": "725e5c8d3facdb2742706e6cd71a2644d675d218041bf91168896ce60cddbcc8",
      "zh_hans_sha256": "fc712f8f0a4b8aaf36c4e23a2d64955ae8d5873989c84692753cd0e02c5f5790",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“是……我們也出發吧。\n　……$c各艦，啓動！\n　目標，加利亞大陸……香港！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0002",
      "source_text_sha256": "057bc4f8a23cf938d904048c519042b84e1c730faa3c0e1e5fffe956470f26da",
      "zh_hans_sha256": "8792aa4582f1a1a1f8a8c33b59551e516ef2fec3e528980dc3a35a60ae091317",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“明白！　各艦，啓動！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0003",
      "source_text_sha256": "dd37603188ab4416a85572a4e38bd41247ea22196e44443ed90846966f9e8d74",
      "zh_hans_sha256": "87afeeb5bb98e215e7b15d1d54519dc0c613be1af43fcc73492af3d8a9969ef1",
      "zh_hant_status": "draft"
    },
    {
      "translation": "（我的戰鬥……既是為了世界，\n　也是為了我自己……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.04/0000",
      "source_text_sha256": "0458001c0afaa46d6ac7a8e744157c58b9318cc7aea27d5f783c94e70bb7f7c5",
      "zh_hans_sha256": "4fcf9af40b47eca9e2442c463f6bf0b12020f8505a8ded33fc62bfdf08f4b743",
      "zh_hant_status": "draft"
    },
    {
      "translation": "（隊長、托比……\n　我會揹負榮耀之星，\n　繼續戰鬥下去……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.04/0001",
      "source_text_sha256": "14d9de5cbeafe082015669a748e63b26cd7c819e0dc0a9e754b054256a38c1f5",
      "zh_hans_sha256": "f999c026be633f72b7c44567769cf98e2cb15ede645d4d21053eaa135082d2b2",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“大哥——！\n　大家——！　要加油啊——！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0000",
      "source_text_sha256": "c9bd202088baf55503f4048cfab2ffa53593cd0bd101c295686eb9a6aa2abb98",
      "zh_hans_sha256": "f49a1cf82cfd48dc5f5b8ee330ec61cff72dafaa3f85d76f49dbc22ce3d66e35",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“姐姐——！\n　大家——！　要保重啊——！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。日文“元気”为普通词“保重”，不是人物元气。",
      "id": "story/049/dialogue/00.05/0001",
      "source_text_sha256": "6202a2d8c17ba3aac29f63b73e8e1dd6cbc414b4b47df89c2f76c257f6054247",
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ],
      "zh_hans_sha256": "01fa1a1bfa724dc7ecb99688b0a0e4e9d0733b0c39032bd1511f22c89f692074",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“戰士們踏上旅途……\n　即使目標各不相同，\n　也要英勇振翅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0002",
      "source_text_sha256": "654157d85c58e5cf240efbb94bc3d96ba954cc17ef3f04929bc42992b79d1ad4",
      "zh_hans_sha256": "9c387bc2b63a7e9293b530c66c5113bf24dd18565a4b488581772ea25ec2d1c4",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“理娜……看得到嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0003",
      "source_text_sha256": "4572ab56497f8e8c6ccc5172b7a78317f5f3aa82d0d30d2b80b3d3ac18c36661",
      "zh_hans_sha256": "4214cd52f6bb035ff38d4865916b74e68730698b7dba4ea1ef32b27f0fb565a0",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“無論哪一支$c，\n　前方都陰雲密佈。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0004",
      "source_text_sha256": "24c9f90fc4aad9ed984dd3aeb016f72f88f072babfd7751ab506f5e099daf669",
      "zh_hans_sha256": "a5eb13d4383bbd99436e87fee515fc71073f8c07bb84d03b61e2400ff6f4a84d",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“怎麼會……！\n　既然已經預見到意外，\n　就應該給他們一些建議！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0005",
      "source_text_sha256": "2cc2881abf17c1d1cbae3ad2a5f0bb29e23fc243399ac7838611c486dda38629",
      "zh_hans_sha256": "89264e733bfd95020582bf54e08b827b00d9810c7eb50b5fdb182370a95c7027",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“……陰雲會喚來風暴，降下雨水……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0006",
      "source_text_sha256": "7fab5ecda6f5ec2dd40934a348090b37579d673b55c1970263aa2782afddb1b8",
      "zh_hans_sha256": "4b5e86a825bc541caed1274dc1e053f0d8f872646049b64ac8c9a7087979d908",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“然而，風會帶來新鮮空氣，\n　雨水會滋潤大地……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0007",
      "source_text_sha256": "0d165c986f4cb9fb35de956b2e5b366b757e9815da17a71557da8fe9fec9f932",
      "zh_hans_sha256": "f88ee7902e45af05fe6b11b55e93a2a5725bc47aeeddd227ffd1b93ca2c11b88",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/00.05/0008",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“咦……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "跨关同源感叹；按上下文分别处理为疑惑、迟疑或震惊。",
      "zh_hans_sha256": "a1108460867960b97c129b4deeb106aa8ca690341bdb7a2a24c9a7a84602bbe9",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“也就是説，不能斷言那一定是凶兆。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0009",
      "source_text_sha256": "2e2e41ad7bd36343473688a9ad12b526160665f9287abedb6df3dc3a2c08a3fb",
      "zh_hans_sha256": "dca197419bfac010c844d3411c20a6f75ad14f29102bcbfd70e8381860d646b3",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“當然，也不能説是吉兆。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0010",
      "source_text_sha256": "98b9fff230679559ab8dc06747cda6d7c5b101c13396a683bd57757d24f735f9",
      "zh_hans_sha256": "2de5a6fbfb93a4a90aea6f9915c7560556562bb197eabc246e1057cac8434080",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“那麼，究竟會怎樣呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0011",
      "source_text_sha256": "867bf402d5b28253030a114192e8b73a04bccd66d2a0f4a3ce94055261c927f4",
      "zh_hans_sha256": "4ca296433c4859f6f25c20a3e6484a9b0851362f7b6dfb7b45d2ecf36c0d6abf",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“美麗地起舞吧，戰士們……\n　遵從自己的內心……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0012",
      "source_text_sha256": "90ffe760aa3933c06993f974ee2915aa99f12335e4ea598531a24e02556a5a47",
      "zh_hans_sha256": "37ca62715947d91a9894992024b02a75fc198e8f0b34b689115f543728aef7bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0000",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球聯邦軍本部　高官用辦公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation",
      "zh_hans_sha256": "a6e843fcccc3d78213042f2dc5c12d9c32de2933aa002031ec71a800e4eb08d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0001",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球聯邦軍本部　高官用辦公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation",
      "zh_hans_sha256": "a6e843fcccc3d78213042f2dc5c12d9c32de2933aa002031ec71a800e4eb08d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0002",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球聯邦軍本部　高官用辦公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation",
      "zh_hans_sha256": "a6e843fcccc3d78213042f2dc5c12d9c32de2933aa002031ec71a800e4eb08d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0003",
      "source_text_sha256": "e8b9727619e821b9ce768729f518750cd6c1caab535d8ea1072bb0ddc485bcb7",
      "translation": "　　　　　〜新地球聯邦軍　高官用辦公室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation",
      "zh_hans_sha256": "c8375a389cca55a367cdff28b80ab7781cad64dcffecc6eaa1da72ccfff74c50",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0004",
      "source_text_sha256": "05b33233869117e586096750f36055503ae9d87548d47a0c760458e216d9af0c",
      "translation": "“……通知就這些，\n　安戴爾·貝魯那魯准將。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": "",
      "zh_hans_sha256": "f3d1e832c299ba3c4862805c217fac7fb84ccac662f7f8c418a4de056e333efa",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0005",
      "source_text_sha256": "d5ec30fb3008da34f41f77def5ccec81991d187f5d4a160f5a919e82bcec8195",
      "translation": "“我成為賢人會議的成員？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0fc3b66cae107e31924cc9a569e5df86fbb56ca657eff6ea4aa17d89fb4b8991",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0006",
      "source_text_sha256": "4d60d896bff3052ecee311a5acde54b50d415557bce21c59b7564ee8ebc036d9",
      "translation": "“這是説賈米托夫和約定之地\n　的三賢人都認可你的功績。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "location/promised-land"
      ],
      "notes": "按日文源词绑定统一全局术语：location/promised-land。",
      "zh_hans_sha256": "71190e3f926ceb00e1ccc60fea1cf0674d509298267ff6ef01eddfc628c74e24",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0007",
      "source_text_sha256": "7485ca23b26e6a91b7496b584a776b1fffd1933104ab4802d635a063ec0e2eaa",
      "translation": "“……明白了。\n　我謹此接受。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8afecc4d427e875b6652d91b74e5fb8de4fc581f374a3990adbfde81464c8fc3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0008",
      "source_text_sha256": "010027e6db2125c8884cdbd93e5e10466967e4db0ff26c1b2bd4d95256b40ac1",
      "translation": "“從今天起，\n　你也將成為決定這個多元世界未來的一員。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": "",
      "zh_hans_sha256": "0c39927b6deff7f34b77eb7d48908f85ff49275bb7e5ff6c86fb378528dfdf65",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0009",
      "source_text_sha256": "78404faad85aa0e0742c9ee92b5bc51ab0117cb5a705ae47e6f7154c83526ffb",
      "translation": "“不過，\n　遲早那些老人也得請他們退場就是了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5e58ecdfa4237d49a2d1db11b78ea6796288b4285317dfac3801231558f36f16",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0010",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0011",
      "source_text_sha256": "14c7b85710346b1ba5cc94b75310f6aa13f517ee6414571fd1f8d7b2378317b4",
      "translation": "“到那時，也期待你的力量。\n　那麼……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "30d28982cffae95d44c7f4cee170c0045d8ab43d9ff5ee178fc0762a42b47b6d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0012",
      "source_text_sha256": "faaa3c02c275bb256bd44a23f873813acb42495cba4e40916512d5d6a689cee6",
      "translation": "“新地球聯邦的幕後支配者，\n　賢人會議……我，將成為其中一員……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation",
      "zh_hans_sha256": "d833bf42562374085249901f06edf1cf9530afbbaf6d535a56a75385ada1fd12",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0013",
      "source_text_sha256": "0c5b75bf64f02a888367c89359da3a95e3224bb54136eaed56795d77fabf2e2a",
      "translation": "“這也許是機會，\n　但也有可能暴露我們的動向……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d02789f65a3ccb7db6b5cfdc0ede924068d0bb53f9c2d3b9e70c11f296680412",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0014",
      "source_text_sha256": "e7ae70d723e0b8fa2fc39c4a22aaefbc96fb6452928bb738ee095502b08c5b56",
      "translation": "“愛你喲〜！\n　安戴爾大人，這裏就用積極思維來應對吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:user-u42。",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "a109748a0610c97859a4aadfb28e32d27c8e77b8df079a6a57cdf77361c27ce5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0015",
      "source_text_sha256": "cbf191f6ba92204a1c1aa770d8d858acde20d3ecb02f0ceb8fa451582b5a3be5",
      "translation": "“……吉耶博士，情況如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。",
      "zh_hans_sha256": "49f1468ad7452be8426353be7a5d6ced80370301e1ac43ae33238df38b2097c4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0016",
      "source_text_sha256": "825fc7fd1d1c16edc2b9eaea1202eca144093d61d481a137ccf8ce73b21f9f78",
      "translation": "“嚯嚯嚯！雷朋和休蘭那邊有報告了。\n　日本的善後工作一切順利喵。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": "采用项目研究过的人名“休兰”。",
      "zh_hans_sha256": "46320bbcb9de4598108bc26cdf84a6794383065bf38f9935818c18d2df5f308c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0017",
      "source_text_sha256": "c0cd93a4c0ab239d5746d461c3cfa2a56836f08428b2a651e6722d8054039f23",
      "translation": "“$c呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8e4ca82af55248039ce2a8764aec74c48ee108bbe07efae3cadb6b751bd9ea42",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0018",
      "source_text_sha256": "fb6cd5e1a206ae74385ce422a43fef5dbde55c0109a431bdbf1943c33cc5cde1",
      "translation": "“嗚嘿嘿！\n　那幫傢伙內訌了喵！\n　這倒是出乎意料，嗯哼哼！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "87128e3a250846dee1d03ae80afbc108a78d996f12544bfc6fec56999ba1edf4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0019",
      "source_text_sha256": "bdb25f5ad6f01d8b3d6755965bd24f69062896f6a02388add00c713021192d4e",
      "translation": "“賈米托夫和捷布利路似乎\n　打算一邊派幻影之痛，\n　另一邊派展翅隊去對付。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/phantom-pain"
      ],
      "notes": "采用项目研究过的人名“吉布利尔”。",
      "zh_hans_sha256": "12af20365b1c21c112b035b50cd8b7b8ce0be410206bf805722689dd7db75213",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0020",
      "source_text_sha256": "07e01372b8c5e4ad2e0cf14b9c283536dcb7a386c911ec2e690330036876cd55",
      "translation": "“立刻通過雷朋，把兩隊的情報\n　發送給雙方的$c……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": "",
      "zh_hans_sha256": "4cad75516ce9933ebc3e2b24ebc3360628309602ef54b7f2fb90819d5d7e59ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0021",
      "source_text_sha256": "074b390b4db68e6104960624178847a9883b9edf1a6da2124be4746e3f9cbf93",
      "translation": "“誒——！我覺得保持沉默更有意思的説……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8e17f8c9368d9da826e2f499aac2c5cf19b9215031e636ea7937afbde25a35a7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0022",
      "source_text_sha256": "3a1bfabeb1cd5f24dbf3c8a9ea0f1aa0ce2d91118dd75d0f958b287d7b2fe210",
      "translation": "“我們不是在鬧着玩！無論是我們還是他們，\n　都是為了世界和平……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9f99965ae907e06e39ee54217a6631145e0f2b05655b14afa5eab1c450d6c0a7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0023",
      "source_text_sha256": "a7c263a54b88411fe4173cdbfed297de52707a270ff78a24dea966e444aece94",
      "translation": "“愛你喲〜！\n　請別那麼生氣嘛，\n　安戴爾·貝魯那魯准將。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": "全文术语定稿：P:user-u42。",
      "zh_hans_sha256": "20efaaa9fd102b7cdf976f4a2bb62e7f54cacd2854134592301addd6e1ec7af7",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0024",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a9d093ba3ffbf3d293bc0b2362d0b8c8f462bb10566dbe7aba4ee6046667d5bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0025",
      "source_text_sha256": "4393563ae12aace2bab5fe446bf4892f8cd35e7a48f80c80cbd79b09db0b782a",
      "translation": "“……明白了。\n　那麼，博士請繼續您的研究吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a836397bd7edcf6b4b183bd3c8adac0775b4fea8585c3ae74863bea0441c4fb4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0026",
      "source_text_sha256": "9a03c245d564c1b67a05f41cf828fa13a18812a83c836987d897d8b243ba4318",
      "translation": "“嗚嘿嘿！\n　那我就恭敬不如從命了喵。\n　告辭了，嗚嚯嚯！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b473f30bedcf4927654545e09eb5be6a507f5332207ee48609cf08e5dd22a606",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/049/dialogue/01.01/0027",
      "source_text_sha256": "261a11f5edf405b7970acb5154e2b90e56bb518669ca1bd47a297b80eb922a0c",
      "translation": "“……拜託您了，吉耶博士。\n　還有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。",
      "zh_hans_sha256": "b789c2ac7f9eeaf271b83c10dad70d4988fa454b6527f55ba5b81c4354b94b22",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/049/dialogue/01.01/0028",
      "source_text_sha256": "1f9bd4fe6cbe9a38e7734a40b8d8bc4bcef2938b2076937aaa2f4507779f9a4a",
      "translation": "“不能輸啊，$c。\n　因為你們，是改變這個混沌世界的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6ee324e9f83f4b5d2193a68051c3c7b33f69265825d9c9919c9699ec31f1b296",
      "zh_hant_status": "draft"
    }
  ]
}
