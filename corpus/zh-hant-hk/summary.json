      "source_text_sha256": "2d6dbc6aa393614df5fe5b66493a02fef60a43cd78dc0026d916a55cfee3df6f",
      "translation": "受此影響，異星人聯合的攻勢，以及地球居民",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/alien-alliance",
        "people/earthnoid"
      ],
      "notes": "与 summary/10/000—006 连读。",
      "zh_hans_sha256": "367239652511af6bf3b71af26612b06d47d5cc020cf7e24910bad204e238edfa",
      "zh_hant_status": "draft"
    },
    {
      "id": "summary/10/005",
      "source_text_sha256": "335fa622af4a5208930c47200b74cd6d62588743d31e7d9fb9e6bd647e874059",
      "translation": "與宇宙居民之間的戰爭愈演愈烈；與此同時，",
      "editorial_status": "draft",
      "glossary_refs": [
        "people/spacenoid"
      ],
      "notes": "与 summary/10/000—006 连读。",
      "zh_hans_sha256": "dca4558edbbdb901320f566325bcb092fd6d13ee8d5bc1f8b6657226f9c20005",
