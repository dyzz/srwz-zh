      "source_text_sha256": "b484ada18e1cf46f0c57e097d56e0b4be1545d6a10e5a0c5fae1dcf60259447d",
      "translation": "各地抗體科拉利安的活動也日益頻繁。",
      "editorial_status": "draft",
      "glossary_refs": [
        "species/antibody-coralian"
      ],
      "notes": "与 summary/10/000—006 连读。",
      "zh_hans_sha256": "0b4bff5dd204cdeb841360a4521955896eab0bb149b222f4ab3ab3777e46e226",
      "zh_hant_status": "draft"
    },
    {
      "id": "summary/11/000",
      "source_text_sha256": "19ce5e4a3f3926530de5ce83cdfa1b9ed56e1728954bb1b4a7b24c971652f6a8",
      "translation": "　人們擔憂世界將迎來終結，卻又無計可施，只能\n因UN上四處流傳的可疑消息而愈發惶恐。",
      "editorial_status": "draft",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "89d7a580fbfce53f8b529d4fe31d1756cbd7d7e3299a91bc230f11b4fd94ef65",
      "zh_hant_status": "draft"
    },
    {
      "id": "summary/11/001",
      "source_text_sha256": "05e2cfbc03f089c7f364edeee6336072b6e6047e20299e3f65065f1ddcb2742d",
      "translation": "　就在世界本身的存續都受到威脅之際，那些企圖\n奪取霸權與未來的人們，即將展開最後的戰爭……",
