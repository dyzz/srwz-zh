      ],
      "notes": "已对照原文复核并完成滚动字幕排版；术语按全局表统一为“提坦斯”。",
      "zh_hans_sha256": "486a87d03cfe2ad3378e72653d57a0b9cd48945ae4eebc973461c283e32dbd28",
      "zh_hant_status": "edited"
