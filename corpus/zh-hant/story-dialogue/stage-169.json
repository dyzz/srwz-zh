    {
      "id": "story/169/dialogue/00.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0003",
      "source_text_sha256": "dcd6dc5dc7a5314743a5b258e4ad4e7957e4e40feeb68fad74997f39b991f868",
      "translation": "“嘉羅德……那套化妝品，\n　你要賣掉嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "b98addb0156ca9c727d927c71f9b903d1c240279119f909766aff8285d9ee859",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0004",
      "source_text_sha256": "ce71684efd8df976e5ced819e52d3db9e6857e67e427e0d6e8f702c8ff578a01",
      "translation": "“算是吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a963f5ee6172f854642f07b978310a3884cb25f0cb77fac2ae45ad78549a83dd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0005",
      "source_text_sha256": "2fb3728c29251f079a927442ab308ef79cbd834f3963cb987cafb3de2ff29c8e",
      "translation": "“那……不是為了送給蒂法才買的嗎……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "48199ad8587fa2343f119aaef095d5adeced7fa4a93e1cc90a9b31d8855ac6f6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0006",
      "source_text_sha256": "17ced1129da95ac43593904336cf82fc7cacecb9511eea42ad7b936062ad4d2a",
      "translation": "“難道說，你……！\n　已經放棄蒂法了嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "d1adf4c74682ca334233c52c718ad1850d9ae42bab71caa5422753aaf86fd4a0",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0007",
      "source_text_sha256": "c6ce997767d61630b5c7a907a2b6d90b9530d30f95c4ca0e785fa34449025200",
      "translation": "“別誤會。\n　賣掉這個，是為了攢錢買去接蒂法時的禮物。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "9808fb3a24c3e7334f9f1cb1f3f99a575ef61fcd2a0f8d76547de8558f377565",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0008",
      "source_text_sha256": "6b3b10ad32f52fb96753592c65db1500cae7d82a8816e624a6d3630b2763331a",
      "translation": "“結果，那套化妝品還是沒送出去啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "57cf8089724dabe70994c1fdc6b422460e04f56eb4a8b47ab87e01276c56defb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0009",
      "source_text_sha256": "ddaa339fa067c34e0e4cd75ff36c05fb1e304ad42e36c2ae187dbe38a6cb8987",
      "translation": "“這東西對蒂法來說好像還太早了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "11979c75a2044715d479df7f064a8083e7927245a370d5699939a8c97b7ea9bf",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0010",
      "source_text_sha256": "104c87899a419745c080e7c16da09a89d53a6a8078492ada1c1cdb1d8bd3f3b5",
      "translation": "“所以，我想換成能讓她立刻高興的東西。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "33b1706246584dd44dc231aef6e1734988382b7a7306a7509c12a4b9980f959e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0011",
      "source_text_sha256": "0c2359bf3d80e6d9ace3e33ed25614564a90f1d694c4d4a0d736cf9696386ab7",
      "translation": "“不愧是嘉羅德！\n　什麼時候都這麼樂觀！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "5d1022ef878356d6c430a07cc3accd87d5fdcbfab121f68bc34b1fc6ded06295",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0012",
      "source_text_sha256": "2d4c338bb3d9406ce727a7ad3b09418d0caa08ec4a05e619ac3adf349a6b9cec",
      "translation": "“就算消沉下去，\n　蒂法也不會回來……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "8213c6304244d6cbe1246fed82aaa8eeb93b544584371eef05a17730afada7b1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0013",
      "source_text_sha256": "cfa45e7a3d19dc706e598bb40fd4942684efd0254dfade5dc4d77dfc096af1a6",
      "translation": "“既然如此，至少心態上要\n　積極地去想蒂法的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "871acbf61fe05b7e8bcb14e1f0acb24512ae830c8c6f6a773b67a21769775134",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0014",
      "source_text_sha256": "cef0aca4304fd1662b85877662b4e6272d1015584006c10b8b82f3978649c0fa",
      "translation": "“這想法真像你的風格，嘉羅德。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "e147bb73672294a5d1f775ed5bd9c763c398ba0f887d0245e5834f21c28c54c4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.01/0015",
      "source_text_sha256": "4165e20d59b15ab0329f9ca74f834b1fb62fb97db5cb6d375a02b0b7828025b2",
      "translation": "“既然這樣，\n　我可以幫你挑選禮物哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f4a200e4854782236926c4aaa6c4a356364251ad2267d5b46c6e827612c2aee6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0016",
      "source_text_sha256": "aa29b050fd16963fb14dc4c5c7cfd921c60ca8b40ac830de9125fea87a970921",
      "translation": "“真的嗎，艾妮爾？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/enil"
      ],
      "notes": "",
      "zh_hans_sha256": "9f093e933fc44db6926a554636d21d6e2077767146f18349639fd625b92d2670",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0017",
      "source_text_sha256": "d043e9581e7c2f99055478fae0fa554e4fdc66c908c6c79f629a04f4e24ca646",
      "translation": "“雖然有點不甘心，\n　但要是能看到你的笑容，\n　我也願意搭把手。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b57ddbc82fbd2f6dc23d5958100c826a254a988879889c9f79913abe0d5ec22b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.01/0018",
      "source_text_sha256": "dcd138660bace053141c6ab50b5e48cbafbbe8bd82e417aab879b01f2e4b9aae",
      "translation": "“謝啦！\n　那，馬上陪我去市場吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2f80a98fa5df266abc9d5b66aee500be00b6a1da37b31ad114fadad1fcf3be3b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0000",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平號娛樂室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": "",
      "zh_hans_sha256": "821bdc3934da9a8f86c877b4dc53cbf5b3b3e7125d4ae1ba467c390c0356632f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0001",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平號娛樂室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": "",
      "zh_hans_sha256": "821bdc3934da9a8f86c877b4dc53cbf5b3b3e7125d4ae1ba467c390c0356632f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0002",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平號娛樂室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": "",
      "zh_hans_sha256": "821bdc3934da9a8f86c877b4dc53cbf5b3b3e7125d4ae1ba467c390c0356632f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0003",
      "source_text_sha256": "b4046ef429986151307f7b7e4a59d19fb6555ea8301b21abac879793269a34c6",
      "translation": "“所以買的就是這束花嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "87fef0a370d9a739def196d65b34b71a76b9f63c48c5041e661dd30ee741de1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0004",
      "source_text_sha256": "68560920b1b9b42862a716031d627422b564703e7031bf531e4a2d0ff30412d8",
      "translation": "“真漂亮！\n　女孩子果然還是喜歡美麗的東西，\n　蒂法一定會高興的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "57169590b7cf96f1c53152745d4a59eb599c92a1c63136b76525e54689b6f934",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.02/0005",
      "source_text_sha256": "752d24e7dba5442fc2366636b1bd724512f976c6c1969ab2c13b09c3dc265c6f",
      "translation": "“可是……在見到蒂法之前，\n　這花不會枯萎嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "10378ccb398827f2695cfb3ea1944d34e732dc647408f581511c0a5d92dc79d0",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.02/0006",
      "source_text_sha256": "803b7a8112df4ef9a263651a4f08dc8f386ac996560a09ac2e8051903050da8b",
      "translation": "“不用擔心。\n　這是為了做成保鮮花才買的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2aa96a7b8790fd349df357cd066231fadabe3c4c16f7045281e338c4b5d76366",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0007",
      "source_text_sha256": "8eca032d370460f71b0078b4ce9d1fd8677decd4fa25bbab86335bd4f6bfb916",
      "translation": "“那是什麼……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "352f01fc229a38715402fac15a26b01739cb88d445904f89048154d8ffde5e65",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0008",
      "source_text_sha256": "a8e9f3fc7a49027a5afcd50f596c860852af4138fd8f1f078bcd0f55811a6a21",
      "translation": "“聽說是一種保存花的方法。\n　這樣見到蒂法的時候，\n　花還能保持盛開的樣子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": "",
      "zh_hans_sha256": "83ba8f26f19dab39e572820ed30786468750a163d0f899273945127ff71c3c0c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.02/0009",
      "source_text_sha256": "636b48cda9459fb8e76832576c54b821324f33a0e5f66c49e06ce3e655daf405",
      "translation": "“然後，你會說吧？\n　‘我的思念，也像這花的美麗一樣，\n　是永恆的’之類的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5c90c7b77936e2d723bd1d914a0823db4fde26ea130097c360a51eddf2d7fb33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0010",
      "source_text_sha256": "2db2211fe7780ea4b53cc1f1c6d027d2d9ec8d6b60a8a377fc98a6692ba40a80",
      "translation": "“笨、笨蛋！那麼難為情的話，\n　怎麼說得出口！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0b15e88d6ae61daf30f40bebf85556c5891fbbf9fa9a7f72d896c66fba6eb35e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0011",
      "source_text_sha256": "422d3e90f50d7cbe045170914fe3d280dfcbe942d6e192358b7a9aeb4e7d75d5",
      "translation": "（那副樣子……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e2fd41fee8a732bc0f566b8d9a8be39c455af94a9ddec6024228441544512266",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0012",
      "source_text_sha256": "bf4d56ca3fe777106f608d1c695d846d91f548c46501aeccdb9617d49b1e5596",
      "translation": "（難道說，嘉羅德……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "7f1bb07802072532ea0dd1891e66ec33a5d536b2a2df324a43215689015f9ef1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/169/dialogue/00.02/0013",
      "source_text_sha256": "53fdd1e3f663b81be7a5fc38856f5ff1b73f73f902e6e500bfb504eeee9689aa",
      "translation": "（他該不會是真打算說吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "24e0f9e177e931d7997d8bf9dbfaf737e5cf3aa5e48eb6e4fd010d922c6bc7e2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0014",
      "source_text_sha256": "83b878e4140e0226f951c012e3d123fc6c61328cf43d01b5c24ee737eff21b2e",
      "translation": "（唉……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f0a0aec34ad271091cc350b983a7fcb55dd84bbff9d25968fb1e889d6a780fc9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/169/dialogue/00.02/0015",
      "source_text_sha256": "4ea1b817a1470687421fe6602821b63b85fea6b5d9bef16de2ae23973b261f4f",
      "translation": "（有點吃醋了呢……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "09cc75b99644cb41ee77093c7764250d0838af2a204c718bc86d3bdd76e67dee",
      "zh_hant_status": "draft"
    },
    {
