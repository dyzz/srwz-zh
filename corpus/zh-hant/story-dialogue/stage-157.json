  "entries": [
    {
      "id": "story/157/dialogue/00.01/0000",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿卡馬艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "31cd95d8b482e75af16756e7ad770ea5cdc72a8df53461f95b52bfd4847fea42",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0001",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿卡馬艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "31cd95d8b482e75af16756e7ad770ea5cdc72a8df53461f95b52bfd4847fea42",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0002",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿卡馬艦橋",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "31cd95d8b482e75af16756e7ad770ea5cdc72a8df53461f95b52bfd4847fea42",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0003",
      "source_text_sha256": "d3d309a4042ee836c8a7f7dece25c1723e85fe89c01ab101bbdcde5b60f7463b",
      "translation": "“這一帶頻繁發生恐怖襲擊？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "34ade2f7c5932886c299c4e6606f42684163f22da5f87839fa5b09519985b4ff",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0004",
      "source_text_sha256": "506ba091f53af6924fe12dc9c6cbe76392dc53f44495c7f302c3c29ee08bb1c6",
      "translation": "“據扎夫特的調查，\n　在街頭和港口等地毫無徵兆地發生爆炸，\n　造成了大量傷亡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "81fc797a02a14bf2eb2bb97fc2c4449ae6e1f25396eed75dba14970d9f71f875",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0005",
      "source_text_sha256": "952f738e6c39fc8a06146c259d7a97f8ca95463b0462aead0caf600a374f8d04",
      "translation": "“不過，既沒有犯案聲明，\n　也沒有發生規律，\n　甚至找不到安放爆炸物的痕跡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "432c296077625a3bd262eae8f028c971b2bf47b71e2af07183a7568cc0841abd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0006",
      "source_text_sha256": "328ea9a06a9a9fcd1efb2f0b5b2c0c22f821460ebc9cc821c28b6fb21f3d3ef0",
      "translation": "“既然看不到犯人的主張，\n　也沒有政治要求，\n　用‘恐怖襲擊’這個詞恐怕不太合適……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d42b40b2af17a0bd00eb1dbd4df28106a7f5d74e5fa88e61dd887616ccef2f0b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0007",
      "source_text_sha256": "0de1f0931d7197fef93ded23d2c90b762bab19dd9082aaa204714802f42c5648",
      "translation": "“而且，既然有使用未知技術的痕跡，\n　很可能是外星人所為。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "00d5cad1be8c5c7251f522f879fba12eb9d995e2cceaacf01c38e24b4c88aa56",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0008",
      "source_text_sha256": "75eca482010f57aea654249818d207c5999d3c90d28c44c1d8380c72858a319f",
      "translation": "“是異星人聯合為了讓社會陷入不安\n　而採取的行動嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/alien-alliance"
      ],
      "notes": "",
      "zh_hans_sha256": "97edc2a8ca55d8d7052e9d4b0fcd0a0a984b19ff059318c222e668fa4cf861fb",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0009",
      "source_text_sha256": "b91f74ae6b1ca387d278ba92ce61934801010428969036d281091e8b5df91e99",
      "translation": "“雖然還不清楚其意圖，\n　但必須調查一番。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7b589729a021be7057be9390b0abf82201b19f54784c7f415e01160eb286c467",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0010",
      "source_text_sha256": "dd2c78bcb96b508c7a18fdf9d9e9428c2ae1deb6eb3a908871c61ec05f6b0318",
      "translation": "“布萊特艦長，帝皇比亞路\n　將負責調查事件並警戒周邊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d",
        "unit/king-beal"
      ],
      "notes": "",
      "zh_hans_sha256": "7d35cc4ffc141adbce13609a757e93aa6f1145b13f164a64b7550fa8ba74f037",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0011",
      "source_text_sha256": "8a1cd76d00d9352c1a04c97ba096d20a9dae975b2f748f6b07415b5d5612a6e6",
      "translation": "“瞭解。\n　我方在與幽谷的補給部隊會合後，\n　將與智慧女神號一同前往直布羅陀。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar",
        "spirit/resupply",
        "system/resupply",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "7cb8217d55420a93086e64f9c96e1716cd810ad771d6beaf1765e53094f838fc",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0012",
      "source_text_sha256": "3d6d9eced8d43e908883d34848dacf56ad9cfc4e5365f55d672682365a9064d2",
      "translation": "“在直布羅陀基地，\n　還安排了與杜蘭朵議長的會談。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal",
        "place/gibraltar"
      ],
      "notes": "",
      "zh_hans_sha256": "6fed1e182476cf79d093a8d5c69017d4a1471441e130f72765b0f747798c9f42",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0013",
      "source_text_sha256": "ec85a81f616c648874e324b863880a9af67080d34fc5623f5a9398ba59d73aea",
      "translation": "“幽谷作為組織正在協助扎夫特。\n　布萊特艦長應該去見見議長。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft",
        "people/speaker-312cbf08471d"
      ],
      "notes": "",
      "zh_hans_sha256": "193a3373ef5f324ee827f7d9645ee0c284154ddf3889f7c5af8585e507c43229",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0014",
      "source_text_sha256": "be86b6664d5c09698fed113e1cb2c71b65c35f84cb5fb914c1e2906f661f4962",
      "translation": "“這邊預計會與外星人交戰。\n　就讓我們以超級機器人為主力來編隊吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8dfc7fd02db96444d52b3cf3bf77d02643bae66262678327823b5a066405856a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0015",
      "source_text_sha256": "bb5a473fd2ce4678ea7a3835105515522add8e786a0e845dd656b5cd61f9c55f",
      "translation": "“那麼，桑波特3、魔神小隊、\n　巨神Σ、格蘭騎士團就編入帝皇比亞路……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/gran-knights",
        "unit/god-sigma",
        "unit/king-beal",
        "unit/zambot-three"
      ],
      "notes": "",
      "zh_hans_sha256": "0e9c52f32f4418771b256c0f47cad13595b9534944f8023f1c093d369ada7347",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0016",
      "source_text_sha256": "36408a450191bb7a576d95143bd0dea02b24f29a2f20cf8ac01dbd2e8e2e3d15",
      "translation": "“這邊則配備幽谷、\n　扎夫特，以及民兵團的羅蘭等人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/militia",
        "organization/zaft",
        "people/loran"
      ],
      "notes": "按日文源词绑定统一全局术语：organization/militia。",
      "zh_hans_sha256": "81f1dd62ed9e338c083a82a36c86917eb7592b1bc184864b96fd68a147c7aebb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0017",
      "source_text_sha256": "29181d733a80b6a2d8fbc296393049978dbac6a7c1f6200047780673d3b8dc53",
      "translation": "“那$n呢，\n　您打算怎麼安排？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13c475fcd6906c541d7af13e8982eae80ca566cba330d33b11f540904d938ee4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0018",
      "source_text_sha256": "fae69fffb77f00d143be41e52735810dbb2862a4d4b54c3eecb86ce472b17699",
      "translation": "“雖然似乎有所恢復，\n　但她的精神狀態仍然不穩定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "695db8f228319ef31a589b833131aca8330a137f6d7e91623312acd87d171666",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0019",
      "source_text_sha256": "37eb741f1eb2393e23e99f00ee7f035f57cf122417d89f15e79b3f4062b62f48",
      "translation": "“雷朋上尉雖然陪在她身邊，\n　但編入哪支部隊，\n　我難以決定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "520c18ee311d3dc4c5ef2b5708f24585a4bc3d3dd95baa08f5b3cd4ab960800d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0020",
      "source_text_sha256": "a1b7adc833c26d4af7364f44475ddda7fde7a03498402f77e7f29c4c5f5b995d",
      "translation": "“不過，現在的她\n　正把悲傷轉化為戰鬥的決心。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "15e4a38420fbedd07603397cee8592feed5d1384fedc196a86d868a9f8f5f6ba",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0021",
      "source_text_sha256": "a734d3a769ca556a7841cb2c6c899986a93077424e76dd8dc9c8bb15e0e543be",
      "translation": "“無論編入哪邊，\n　她都不會迷失自我吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0bbf6e563173d9fcb0e5367c36844c5c29c9d0baf1c8ac7d8cf46aba7a45aa0c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0022",
      "source_text_sha256": "b885050a4b9dde0fa06a4e7e51be21a9cfcd825b8ddb8d99ada130019c6a89da",
      "translation": "“那麼，$n和雷朋上尉的\n　去向就由我來決定吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "ee01c0372b2211ce786fe24dfae898111f4fbc020f13a6e658916a63a7495a34",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0023",
      "source_text_sha256": "3c869185424a1e5ef4cf9348b0ea59f1f518781d0287b9a1f97aafd515bc3807",
      "translation": "“布萊特的選擇”\n“1．讓$n前往直布羅陀基地”\n“2．讓$n負責周邊警戒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d",
        "place/gibraltar"
      ],
      "notes": "",
      "zh_hans_sha256": "90881bdc8320944e55713ec8c2df48395bfd6a9fcdd623f215785c63488fb869",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0024",
      "source_text_sha256": "3bdade783f57918bcc071223e4b03aa044b639deaf07c53b80175a5e9222fe00",
      "translation": "“艾瑪中尉、蕾柯亞少尉和露娜瑪莉亞她們\n　都很擔心她。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/emma",
        "people/lunamaria",
        "people/speaker-2f643283052c"
      ],
      "notes": "按日文源词绑定统一全局术语：people/lunamaria。",
      "zh_hans_sha256": "84bace62b1dbcbd65d41cc0b78c71268fa0d7acda34a9ae3fa6ddb98026b5925",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0025",
      "source_text_sha256": "3cc9ee21108bd8acf95f75416746fa2761e174bf678b4ee7152b6d56c1a123dd",
      "translation": "“因為同為女性，\n　$n的事就交給她們吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2a2cc4c330e0ef2482c006c3b7fb2cc4f92a8d8a664e5709266d5156ab44d012",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0026",
      "source_text_sha256": "e8ea3bb97784680d6504dad80056afb6a412ed47a1859b4d67a67e705b887b24",
      "translation": "“瞭解。\n　那麼，等人員調動完畢後，\n　帝皇比亞路將單獨行動。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/king-beal"
      ],
      "notes": "",
      "zh_hans_sha256": "10267bf27d26523ec71c584e1aa5efefe8b386869e7db132e6a0b280f53f53d9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0027",
      "source_text_sha256": "aaa2ea76163c775b25a3562d4fafe8231f6657c863527702e75e43f20f2bbdfd",
      "translation": "“關於再次會合，\n　我們稍後再議。\n　祝各位平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "85fa407372936a6a7e0569796628cdb5170d4386ad9c4b38a09ec5cee0aef4f3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0028",
      "source_text_sha256": "ab94b728aca822d03143d0b84397c22ab208c5617688f5d2c99b4ae899864490",
      "translation": "“你們也是。\n　請代我向杜蘭朵議長問好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "50bcbc57b81610c55036bb70b4395049109b060545fd917644f4425a747810bf",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0029",
      "source_text_sha256": "5df97b38aa2990499fcbb30bf075347bc22d86b622a045da812813f0cb24961b",
      "translation": "“在直布羅陀基地，還得顧及旁人的眼光。\n　我不想讓她現在考慮戰鬥以外的事情。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar"
      ],
      "notes": "",
      "zh_hans_sha256": "beb15aa2f0f70393df9a807fc9176338a95c9148914d113839370f509e614997",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0030",
      "source_text_sha256": "9c1c2a706736f4708884f4f1eea6dd9aedbadab5767f24d44b74ea9f1e687d2b",
      "translation": "“瞭解。\n　那麼，$n就由我負責照顧吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5d923c2362441d207dffc1904731a2384c1592a5f66bc137f80e6d1fb24a624d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0031",
      "source_text_sha256": "72da4e943b5cabb323ceb6365f9463cc75046439645260dd2171230261f56d74",
      "translation": "“我家老太婆和花江也一直在擔心她呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-61c33479914e"
      ],
      "notes": "",
      "zh_hans_sha256": "a4f71ee5d13adb65111b01bbf1aeed9da1a9e869b8a68025dad8a4c0cda475dc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0032",
      "source_text_sha256": "8b4b3fed563be38b2d717918d47afa2f881f46a901c3758da943cf8f537cf8eb",
      "translation": "“那麼，等人員調動完畢後，\n　阿卡馬和智慧女神號將直接前往直布羅陀基地。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar",
        "unit/argama",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "5cf4c37993f8a8d0632adf3d440e894a992df0acaba5eb5e60022fc799cd7bca",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0033",
      "source_text_sha256": "d3e568533d098efc2eb12c07d44624a01f87aeba52535838199863e28c15c803",
      "translation": "“關於再次會合，我們稍後再議。\n　一有消息就會聯絡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c97b9c17c0374514cf96e957787a200633a78825878fd1cba58f407c5bd26464",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0034",
      "source_text_sha256": "ca1cb84082e789ee6c8712d71a15c986a11ff96cb2aadec9b64efc89c9cd6589",
      "translation": "“請多保重，兵左衛門先生。\n　祝各位平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-ec24b8d9e164"
      ],
      "notes": "",
      "zh_hans_sha256": "9224c1076d666963f423de7615683c55e40108830cae6d645ef58393c7ff3755",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0035",
      "source_text_sha256": "ef62b5d11123aa91b4913ab1e50cab9c9abde461eb91eaecc358150f021db1dc",
      "translation": "“你那邊也是。\n　也請代我向杜蘭朵議長問好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "8ce0349d3bfc2cabbea2186160e0c090a33c045dae616e830f30f5aad4369641",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/157/dialogue/00.01/0036",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "艦內　個人房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "60113d3690f5ffaf600d11c79fd7f3268682f8ac59ebeddd5ac80afa5c50e1fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0037",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "艦內　個人房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "60113d3690f5ffaf600d11c79fd7f3268682f8ac59ebeddd5ac80afa5c50e1fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0038",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "艦內　個人房間",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "60113d3690f5ffaf600d11c79fd7f3268682f8ac59ebeddd5ac80afa5c50e1fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0039",
      "source_text_sha256": "068433cd0c336f1900f64e2bfe73a0eae7e608a3fa61456a69f42dc36d40f641",
      "translation": "“……桌子上有什麼東西嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b041424df433f1fc37fb184abb94c2d6b96db1aa82687b699e7383abf7964936",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0040",
      "source_text_sha256": "ded0089e0e3a273dc97c29d23ee98824e8cfa9e86866362bb54b7e74ecb1a18c",
      "translation": "“給$n的。\n　我們大家一起烤了巧克力曲奇。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "43983f456f16cdc3514827323e68d86ed7fb668f85955b5629e6c45cca799989",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0041",
      "source_text_sha256": "99a7c431891846f8c790f0e2601806778d0752d658b9e6b955b70277f62bd621",
      "translation": "“聽說疲勞的時候吃點甜食比較好，\n　所以多放了些糖。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8b3b5177a3ddf9bd40f9d89004d3df8c2aa90e3410c3c06d9635c6ca0571532a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0042",
      "source_text_sha256": "508e034a55ad61cc7b9b4562d989bcacde897f8f44311ec0c78bf8258246f34e",
      "translation": "“烤了很多，\n　$n也請嚐嚐吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3e8045a34cb5eb2308d6c5aca8be258fc7171e2d948efc4c5ed0ad720985307b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0043",
      "source_text_sha256": "3de888b0f66476583453b8547dd4a644fd504885e94bfa262da0b05e2b31c4e2",
      "translation": "“謝謝大家……\n　那我就不客氣了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ba84a2b6c1324f6c723d06ce56b99e046e92a0f7e643825be4861245052b378a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0044",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“誒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13ed62045e04cbf2614c7548e31cfda8826a67aaa0a7c2f1766728d5cb78e0b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0045",
      "source_text_sha256": "0835e0ab6eb01e1080e3f5e6b3e966b871333c058f6aa049993326bb08a3a1df",
      "translation": "“不甜……？\n　不對……連味道都沒有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "91f9b68024118d64eaf537548532c862d64868b08e2e21fe48f4dbde067eb903",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/157/dialogue/00.01/0046",
      "source_text_sha256": "d22f998bff1fa77f131b4de6c3b9b6eb3c71b77115ece3e7e46c9a9f2d9ba9ad",
      "translation": "“我的舌頭……壞掉了嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1328887ab3566e9776c32d5f3856645faaefdcfb83ef9ebbfa91a9f0413527f4",
      "zh_hant_status": "draft"
    }
  ]
}
