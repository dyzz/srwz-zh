    },
    {
      "id": "story/156/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0003",
      "source_text_sha256": "5d82dba0ed6a87b04573296f59ef64abf292b22bd8b15b829a58a5392982d348",
      "translation": "“不愧是被稱為交易點的地方……\n　各種物資都有啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b1d59af1a6f37d79a16f2ccb477cc81a7f76f95d5ea09eda2e3c4ee6055f95ce",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0004",
      "source_text_sha256": "46fb9ceef72d2b5fd4ad9ec2ad14e71e08d44f49e0f3e36643eeea824fc5ea2f",
      "translation": "“要是有有趣的部件賣，\n　就買下來吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/part"
      ],
      "notes": "",
      "zh_hans_sha256": "22fe93b188350e8a1d734bc2e9618f66e52ee6bc85e7db1af96232c7f3f4dcca",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0005",
      "source_text_sha256": "785090a25032c4b47a3a430c0bfc6610a303331e251a1ad0fb8ba696f748cd5e",
      "translation": "“……你，\n　莫非是奧古的機械師？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ae02da76636b3a036347b58ad42440131b2333fdf704349f25b53313fc9576f5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0006",
      "source_text_sha256": "14dbb2c7b4c475493bd610638802bd07c6d4df5ebe2eefac7be485d1669993a9",
      "translation": "“啊，我是阿斯托納吉·梅德索。\n　阿伽瑪的整備班隊長。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/chief",
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "fd9575af9a9969b24514c42f1bbdeacb2859d6a34bb7faf28bf49c5d01108064",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0007",
      "source_text_sha256": "bcfbb83265bcbf207746799b24de72d7a501a7a6c014bff245be3eb82197efa6",
      "translation": "“這麼說，以後就是旅途中的夥伴了。\n　……我是基德·薩爾薩米爾。\n　和平號的機械師隊長。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-e453576c1081",
        "unit/freeden"
      ],
      "notes": "",
      "zh_hans_sha256": "de592addf1188a084ea8025c400652bf6530895875faa2f265114e6bd9f89cf3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0008",
      "source_text_sha256": "b19fb97371c5fe71e20367d96f897556a6337b7af6b8fb58dc0ad5044c270957",
      "translation": "“那麼，那三臺高達是你負責整備的嗎？\n　真是漂亮啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gundam-generic"
      ],
      "notes": "",
      "zh_hans_sha256": "2128f4b6bf4cecfd4a5291da9c0d3106fdc7ddc2ae2d70feb711a2038c25fcd3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0009",
      "source_text_sha256": "93f8144d3a6fae6cad19d8f5a867fd319c88d5d8ca1f57fc0bddd17995ebeb36",
      "translation": "“嘿嘿……被這麼一說，還挺不好意思的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7a6769024891af9c4d9cab7a2d5796f6ce1184a24f29702b8408ae9d5e6a23d9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0010",
      "source_text_sha256": "abab459c5005b138d734ce492a653efdfb7573d6e67bbc54dca4c2c76eb89da7",
      "translation": "“阿斯托納吉先生！\n　那邊有稀有部件在賣！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/part"
      ],
      "notes": "",
      "zh_hans_sha256": "afe56debf6e90a2a940756ff10dd0e471c94fc145198c035acd8312f317b3fce",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0011",
      "source_text_sha256": "fbb2b4cea7f452cc95b6e1a29b54de46135f6290e6e8d89d0ccb5df55994cb65",
      "translation": "“最好抓緊時間。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c0ba1151ed0a9810a9eb511c14395e5d018137b9533acd5e0e44bbd33f7cc467",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0012",
      "source_text_sha256": "306415461399aa5ebbfe150bd1981bcd930b6ab127844e3cc9065ad24a4b2835",
      "translation": "“鋼鐵齒輪的那個方臉戴眼鏡的人\n　好像也在盯著那部件。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/iron-gear"
      ],
      "notes": "",
      "zh_hans_sha256": "03f10ef3ea8bdfeeb07e31b8947b08afd90955fc948b57ef92c3005aaf3f5653",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0013",
      "source_text_sha256": "65413071ff6e4f07c995ceac1d9c6f5e41f63aed2a6ed972093a12582d7406a5",
      "translation": "“這些人是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "958d4feb8fc58ca567562159d5516e1b06a37aad77a80d716ddf1c57d4e86796",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0014",
      "source_text_sha256": "06e6a8fb0ea379f771ecbabed4757bf92dcfcad60824ae4aa3da9540660a2b0d",
      "translation": "“我和尤蘭都是密涅瓦號的機械師。\n　請多關照。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-2e82cab71317",
        "people/youlan-short",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "3cea2943a9d566d54d80e68ffa457a5687fce30db28a7ab1f8076ee70251fdee",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0015",
      "source_text_sha256": "24fffb5f9fa9584bddd8f72d10a914583cd6d9cedfe4d0b793e58eb335f1cf1e",
      "translation": "“寒暄待會兒再說，維諾！\n　趕緊帶我去看那個稀有部件！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-616aa64fa534",
        "people/vino-short"
      ],
      "notes": "",
      "zh_hans_sha256": "44e24974ce9a9af3a541c027a942f3c1eb6690ba8dc03935ed867409853892d4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.01/0016",
      "source_text_sha256": "8117614390b6799c8f18444e1cabd8a2e502bb3978267faa350ffbea0ebd60aa",
      "translation": "“瞭解，阿斯托納吉先生！\n　那東西多半能用在奧古的MS上！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/mobile-suit"
      ],
      "notes": "",
      "zh_hans_sha256": "48a7e8535d7a6effe6354db53aa59ac77c73966f5ddedd2619ac05ba3d38e21a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0000",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0001",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0002",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": "",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0003",
      "source_text_sha256": "00607c209d9b5758856ffe923b7fa19ad0210b466a39926d73f0e73ad869248c",
      "translation": "“阿斯托納吉先生，這個集裝箱是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b"
      ],
      "notes": "",
      "zh_hans_sha256": "c3274e88fc8b842b86e19190df03d0d83c061b523215e3696c4555de0c3cf1d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0004",
      "source_text_sha256": "f3ed6294bca21900ae32834f9e4055ed4c29c84c09acb026fdeb58632cabd2a3",
      "translation": "“……是在集市上淘到的寶貝。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "41244784995080de6f01a0d418344daa902f12e295eabb365019b4ded8e29a6e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0005",
      "source_text_sha256": "ca6958465d69e4126d4ec1df2f1529a5c227229373a0b5a49bb49173a2ac101e",
      "translation": "“大容量能源包嗎……\n　要是用在光束步槍上，\n　怎麼想都太大了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "part/large-energy-pack",
        "weapon/0121",
        "weapon/0215",
        "weapon/0226"
      ],
      "notes": "",
      "zh_hans_sha256": "2e75ae7d666f5c5191a2e63fc493c90b4f7146a6af1cd818fcca981116869f22",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0006",
      "source_text_sha256": "05efd9c47b982450d034abd576a2de4a75b09b8df5805e094e117f868c9acf44",
      "translation": "“買這種東西，\n　打算幹什麼用？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bf3cf2f754a95955565266f0aab3712ed881ff8b307f6d7e547e9929fc89343f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0007",
      "source_text_sha256": "12f9b92ed036e3c0a73717e3722a25bca6723d48e878af4f825c5bb157a2fedd",
      "translation": "“這個嘛……因為有客人在跟我搶，\n　一時衝動就買下來了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b3330363e4b0121ce7d1c8cac9e0267bdae9cb842b534723918a051a40449b65",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0008",
      "source_text_sha256": "2b4f5ec33b1fd73dc22c9e0066f6d9173f02a07cd51b41b32b043c76008e0e82",
      "translation": "“要是能有控制這麼大能量的電容器，\n　說不定就能找到利用方法了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "83a00e60a6e9e34f11695a612680b3b5268fae279132ca5f8ca2a88323eec399",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/156/dialogue/00.02/0009",
      "source_text_sha256": "bef0a9a99b98bd0b8315aa5e32d30e4f032f4269582fc44a83b0435d5ff5b7e4",
      "translation": "“暫時只能當機庫裡的擺設了……\n　要是被布萊德艦長髮現，\n　肯定要挨一頓臭罵吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d"
      ],
      "notes": "",
      "zh_hans_sha256": "a234500a45b3229230d9849087cc0ab0ec1ea686c69e50dafd4bf26f63c07aa6",
      "zh_hant_status": "draft"
    }
  ]
}
