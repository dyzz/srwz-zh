  "entries": [
    {
      "id": "story/114/dialogue/01.01/0000",
      "source_text_sha256": "6ab7e4f2db3dad54499fdb8337a4c68b21e53e95c248ee10aef4741737f600ad",
      "translation": "“扎夫特的攻擊部隊，\n　已降落到月球表面！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "d84ee076a8e5209f7ab40168815dc32d30c901c4548b255c56c627eedfed7074",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.01/0001",
      "source_text_sha256": "228781f6e9ee64ccff8d622732dca5ecc7ac7021298372fe5c0d8ff5c1d9a882",
      "translation": "“哼，吉布列那傢伙！\n　快點！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "11455df5b0a6fd7af214bf95d4aaac8199b187272133bf0ec791aab0e796841a",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.01/0002",
      "source_text_sha256": "69d5a3a6a01315690eb0c47b509cb492961d41f92e51aa0863f2eefdea724eb0",
      "translation": "“在幹什麼！蒂法·安迪爾還不能接入嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dc469c232fb8b6cc6b322f477d6da7a8a8d3a0ced4388552f6e405aeeebe7afe",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.01/0003",
      "source_text_sha256": "1a53eab74f4d4b2fb4448a3bfea456dd4f75e8062a0a79b3d7d36c87cceb5237",
      "translation": "“請放心，閣下。\n　她的精神已經在我們控制之下了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d691e16ac2bca3f771ffbc6f98001acd57493daa57849bc3978fa138d4b3e6ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/01.01/0004",
      "source_text_sha256": "4e84a8563358b875249d9ef12b92d9837f2c3f2e772fb00f64f87e32245ba85f",
      "translation": "“能量填充也即將完成。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cf26bfcab6826172feec29180653d40ca1ada98cfef6df087b228d2ec55756ae",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/01.01/0005",
      "source_text_sha256": "e20fafc08bd1fa96c75b7140142c6cf2ff1c57feda00c3502841f66262215365",
      "translation": "“好……！\n　杜蘭朵，首先為你奏響安魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "511f3fb802d1ec19741ef867858797a3650440535d81af18d00a9b7cdf064bd8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.01/0006",
      "source_text_sha256": "91e4198a12a29a93acb8bdee3a6eaf5b9df1eae3b9c5def9c7f4f120a55d9343",
      "translation": "“LOGOS那傢伙！\n　打算死守要塞嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:official-logos。",
      "zh_hans_sha256": "899cfe737973623b282483846ab01721e2a8d8d03512fdf2fb894e8400b1eedd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/01.01/0007",
      "source_text_sha256": "c7f4e1f9b7c2883df6495a30d365a2e3c9db59aed2531c9c2daa4b3a844da012",
      "translation": "“等等，伊薩克！\n　那個設施的地下，\n　有巨大的能量反應！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/yzak"
      ],
      "notes": "",
      "zh_hans_sha256": "2a328d25eff856ab018f3e122b155f7140336fcbf4eacf34a3b27c8f48d15c72",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.02/0000",
      "source_text_sha256": "6bfecdeac4e5906df878f6329ac690fcde11b1ca1f6090ea089be2bd71366078",
      "translation": "“中繼站，確認姿態穩定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4e79584ce161317f273ec88758cd9fc258690d641381855eaa67545e3c9e8370",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/01.02/0001",
      "source_text_sha256": "b25af79b9c3d3d5db8be4e1ba835936e471c081706cb79834439868916819229",
      "translation": "“安魂曲，發生器正常運作。\n　距離臨界還有30秒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9bb26e5dd4a340ae16e1e8588f4991a7e20679d1229c60071dc56ccc356d3de6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/01.02/0002",
      "source_text_sha256": "74e37e5d9a530d17b9bacd655ea9af08e8488082fa959fe7181258364fb4d220",
      "translation": "“瞄準，PLANT首都阿普里利烏斯。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "1a3bc16851bab2630915618b90d02ce2625e1cc05a4574b21977da723cbf12c9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/01.02/0003",
      "source_text_sha256": "9c1c66f15e62b49c28746f12d530a4bd1d326f9f21d1e3338a6a50ceee071a02",
      "translation": "“杜蘭朵，就讓我來奏響吧！\n　為你們送葬的安魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": "",
      "zh_hans_sha256": "59781f17f4d3dfc1b872e8730f9a631c1fef5afa8a025aab054546857156b20d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0000",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0001",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0002",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亞特蘭提亞",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "746b6ace5263c6226f4f8099ffc22af3fbec3f3ecb608eb5882d68defd5f42ee",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0003",
      "source_text_sha256": "f2201e4e1a5f2e31aa58d083bb725e488f92841a8d9e669a018360270e83e551",
      "translation": "　　　　　　　　　〜亞特蘭提亞〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4f93cbe18d4e71d274275880f2ca4011f71141597259453e27f8764680032f18",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0004",
      "source_text_sha256": "b91cb444be617dec91315a9c1e007d08ded68dfaf753f24ccfbb485a26592154",
      "translation": "“亞特蘭提亞……美麗之都……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4adf8180afda82e973d10f67d1fec7e0402b4f458dc5a22c4d7223812c0aa8af",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0005",
      "source_text_sha256": "c34ea33f22879168165e3ccaec443d927833c010f5401223cf5cd3abb0ca2d94",
      "translation": "“清風帶著芬芳，輕輕搖動樹梢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1b322c62f91d3fd82a8c99e550809c72e56eb2a13d7e783defef8f41132cb6a7",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0006",
      "source_text_sha256": "a5d2cc803510d973ffb783cd7ec7145b54798b11685f44a4e8e7380d6ecece19",
      "translation": "“妖精們清脆地歡笑……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8137af1cf9c50a5d1ef10a5a2f83a767f1de862434fc236a6e70287c13c04874",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0007",
      "source_text_sha256": "7a75c633ec4ac6e87afcea0a5590b2d3ffabe2e5c99e9e4fa3644f74f279290e",
      "translation": "“絢爛的花朵鋪滿都城。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "96d4981f9c9db9dc8294072500c13adaa61aca8cb15cee527b98116c5bd39142",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0008",
      "source_text_sha256": "785be7ca9d1a2a19f03ebf1c3e156c9de2b84f11c8cbc981402e5c0f6b600e40",
      "translation": "“融入了人命的鐘聲，\n　在銘刻著歷史的牆壁上回響……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ac8ca0ad6fb5972f5c2b46eaa06e4875c560d8d9c048e2d45c525d9ccd985316",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0009",
      "source_text_sha256": "25e126159cb8ffbeb66f94fcdbbfc1c335a814897a21d710d0dcd414040d734a",
      "translation": "“然後，王之陵墓開啟，\n　鮮烈的破滅將覆蓋這個世界。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1d4d8c1f1f5adac9159061aa14b846abdf77abaceee67d06e2dda48c19b42401",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0010",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0011",
      "source_text_sha256": "8e5003573ac98a167e4c2a444a3fccc3d0c97be13cc88c48082a07d3e55fd55a",
      "translation": "“你……似乎也習慣這裡的生活了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4dabf76123b063bb469138caf91cd5ac6c9960af9c65008d67acbb1b9ae6b13c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0012",
      "source_text_sha256": "a182d2773a3d650311510e68b13b94a224ecc3fa23b9c3a34563d9d9780c5985",
      "translation": "“嗯……\n　簡直就像從出生起就在這裡一樣。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "43f3a82ea56f557796fd752b4e42e03dcc1849bc4cd9949d4d2935371cd01cc2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0013",
      "source_text_sha256": "dbf16f439c001293bb301a34e356f5be4a21f2c498fa5b348fcd618f0398f572",
      "translation": "“……你是出生在這裡的。\n　在遙遠的過去，以及現在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "47c0a6eeec117c1119a98d3fbcbed76e50061ef7b488793843ef124becb1378b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0014",
      "source_text_sha256": "3426901439661278ec854e24764a57170cb684af0d5c0183dfe8a90b5c7dfb32",
      "translation": "“作為太陽之翼……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "81987ff9373a3f0b3250cdc72fa8c546ddda4aa9cf80ea7522f89d86114f7581",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0015",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0016",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0017",
      "source_text_sha256": "7280ae46a4e7f3e10df726c7c131fbae2649a7cb1adaf34ea85628764d571e65",
      "translation": "“被那傢伙奪走頭翅，不甘心嗎，音翅？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4cae1173dd246affb69e35c1e26c91d5984ac09a039a369a68625e8cb11544c3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0018",
      "source_text_sha256": "cc834856820c6bb88d01215f754e826b6553384b5698a7a4ce9b969e204fba9d",
      "translation": "“那股不祥的風……\n　不該吹進亞特蘭提亞……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fecad0d7f17438a84d862146cf94c5520d20fcc779f8cc42389f673be7c90ddc",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0019",
      "source_text_sha256": "63dcac5afb68918240b5102e5deed4553e8f06675113f5620b8e9811fc621027",
      "translation": "“……那傢伙交給頭翅處理就好。\n　囚禁我們的無限牢獄之門，\n　很快就要打開了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6efec83645914aeff839c13fa5dddfd1711d016a87154ca747f28a8ef0d62656",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0020",
      "source_text_sha256": "3937137c3141d0896a243c70612ef0d27b165a3e4024fd9f2dffa68e3193d191",
      "translation": "“但是，棲息於次元之壁的那些傢伙的覺醒，\n　難道不會將世界本身引向破滅嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "eaeb1a8f145eb6c5f3451c7e453477f372286b4189be2921ec293b57b61b1308",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0021",
      "source_text_sha256": "55331b61232bc172f17a99f574834046dae9a64998a32a36303aec66eba502c7",
      "translation": "“最近神話平衡的崩潰，\n　就是那個覺醒臨近的證據吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f813a8f5d7b7b7d364828c8a5d1ea4b718c90c6bc8d4634454b15f22a73682f0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0022",
      "source_text_sha256": "06bef260b516fde6747d3babbe176aabd3cf32979dc8049b352fc1e26e6a431a",
      "translation": "“那時，偉大之力將再次降臨。\n　那在一億零兩千年前引發樂園崩潰的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-power"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/great-power。",
      "zh_hans_sha256": "2a830bb6f7062044147064c277fbdccffc320811661ac66559382786c1224fe8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0023",
      "source_text_sha256": "d487f75c0ba13574638d41c2eaa9ad138589a8994d62e555c3461db009f11b87",
      "translation": "“將我們墮天翅族束縛於因果之鏈，\n　幽閉於無限牢獄的樂園崩潰……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel"
      ],
      "notes": "",
      "zh_hans_sha256": "dcd612663c06574d1b6aa19d966dfd996d158e6c0694a454ddcd392a694028ab",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0024",
      "source_text_sha256": "112591494a50beeb69fe0bcb7a42fb46be19ea9e88e0bca2796ea1515979f223",
      "translation": "“那之後，我們經歷了無數歲月。\n　就這樣，冷眼旁觀人世幾度變遷……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1225976310d8579a6f4240513fee17f30b416792a9b3caa2fbc41dbe14d995dc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0025",
      "source_text_sha256": "cc737bc901018e3cb1653b2338eda0a9352152b62a6a49346157a6ae27771076",
      "translation": "“束縛我們的可憎詛咒，連腐朽都不允許，\n　讓我們反覆陷入沉睡與覺醒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d9f85ada7baedce78b92b3fe6ec21a400ce3916744003787bb38b4ba3d325939",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0026",
      "source_text_sha256": "1ac61defd0c26a3cc412cfb8c190384a12ab8cb32140b8744063a93a1c55073c",
      "translation": "“然後，一次又一次與無翼者重複戰鬥。\n　就像每晚上演同一出戲的小丑……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/wingless"
      ],
      "notes": "",
      "zh_hans_sha256": "45447fd19b76ebb5f99c6f7667fd945c267c60da63192f8b81330fa6f12db0ce",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0027",
      "source_text_sha256": "1643c56991e099af76644a3f6c5739f91c9b87142f4040a7fb1347b04e5043b4",
      "translation": "“然後，在樂園崩潰9999萬年後的\n　那場戰鬥中，樂園再次崩潰了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f135a81dd51c5d38db6e0c4aa4d4f3337744b55ce6df6a3cf9e0cd4773c61588",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0028",
      "source_text_sha256": "87ceff63832bf89d8bb947c245b4737df076316b0b85687ff23a72f3019823a6",
      "translation": "“那時，頭翅大人明明已經再次\n　與太陽之翼重逢了才對……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "21b2e5019c4c3cf06ea177d9fb7653970bc99d548491d547fea89b0c6521f317",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0029",
      "source_text_sha256": "9ac52469429e2b4dc73593680e02d588b50ae8cda0a1e2cfbb26582f159cff9d",
      "translation": "“可憎的力量再次出現，\n　將我們鎖入牢獄，\n　甚至奪走了那份記憶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d9611bfab463ec0f76e6bdd23a750b42e02a1e00379b85fffc882016e6bddbfa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0030",
      "source_text_sha256": "7f4e928a1c4c867142adc3e1b5d392822446361e1fce6b44b62a8d46b3ef52da",
      "translation": "“但是，從那時起經過一萬兩千年，\n　終於要迎來變化了。\n　因為那次時空震在因果上撕開了裂痕。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7c9f5afd906e8f9f3e1e11c6187a4a08bcb72f349a2272b18d0cdde1db4868bc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0031",
      "source_text_sha256": "cd89841319c801bedd9bec1ebb7b56d9eedc43fe45eef6a74d5bddf627090670",
      "translation": "“世界崩壞……\n　除了偉大之力之外的存在，\n　竟然能引發時空震……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-power",
        "event/break-the-world"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/great-power。",
      "glossary_exceptions": [
        "people/ray"
      ],
      "zh_hans_sha256": "0f97a65fffdb1a12e6e433b1f01bd0a4cadfe6af760b974ce6730ec0b992657d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0032",
      "source_text_sha256": "ba7b570c866f5f04f5e6f6d1c94f735a1b8767f07750899e2f5336ff479e779e",
      "translation": "“但正是它，為我們指明了創聖之路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "60556af437e82b3a41ac834e4d9f201df8670c4a4ba139dbfd2c5165a22c0d07",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/114/dialogue/02.01/0033",
      "source_text_sha256": "5d7d3187ba7a8c9224f7641b1aa249914e2c7eaa7c226d78c0b9f79705a10059",
      "translation": "“剩下的，只需在生命之樹的花凋零之前，\n　進行神聖授粉，結出創聖之果。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "956f1b227f83c2ab752de1c9ee70298fd0badbc1b782ef0231f5f59dd6f930b6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0034",
      "source_text_sha256": "75d8aea83a334d19589a702e351a0f09a4de6525f0c704af8742fc4f5bfb7fe2",
      "translation": "“而那一天，已經臨近了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "846a0fe25bb36654d1991ccba2d91c2c0b25c270530a4f889c150955473de1e1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0035",
      "source_text_sha256": "5305497a2c6f3cf75a1db35a7ef93d754c394769264fc53b03723f4e298a4c19",
      "translation": "“詩翅……看看無翼者的世界吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sirius-wing",
        "species/wingless"
      ],
      "notes": "",
      "zh_hans_sha256": "9f528fedf0222c6ed8fa5505cecf9ec5ab7f67f9be8cb083979aa98724ce2260",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/114/dialogue/02.01/0036",
      "source_text_sha256": "26d0bc34f0fbe5cee3e2f873b2eea6cc042b481058ffb8f98e7bef2178d9b237",
      "translation": "“今日，他們依舊在奪取同族的性命……\n　連那皎潔的月亮，也被他們變成了戰場……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "35103537f0b68fd9b8736b1d6667e56aad69a3254bf519f3d183df9286e3770a",
      "zh_hant_status": "edited"
    }
  ]
}
