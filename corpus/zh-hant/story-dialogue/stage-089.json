  },
  "entries": [
    {
      "id": "story/089/dialogue/01.01/0000",
      "source_text_sha256": "7b7e2e3145fd9cb76cb7d9c8e655a1fc10b1ce22a90742d98edd0c77d8b7bbd1",
      "translation": "“覺醒了嗎……\n　真正的極限惡魔……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "d82ff7a6edd749beca17f9cbb3f416f126a8a91e07561ee7259e60c264dfb641",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.01/0001",
      "source_text_sha256": "4f0d7ec2b86486960a369e8434ba832348911d4d33cd676af3cd72fed52b44ed",
      "translation": "“嗚哦哦哦！\n　極限惡魔！\n　我能感受到……驚人的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "1466742e0e3c12726179a1a5b07844c5279523c81385d125b1f76a07e30bd5c5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.01/0002",
      "source_text_sha256": "ea900de6f1ad3afa0705ecfae8613d54a1670e0e3acd47435c3e4d2344feb295",
      "translation": "“這簡直是惡魔的能量！\n　呀哈哈哈哈哈哈！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1c288ca1e0d10788caa01b2aafc6e33dc3dd8798399cf27683d634afa46e20cc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.01/0003",
      "source_text_sha256": "88d74e4ad80d89a15ec576bdf0aa5f1f859a977b3caf7f9e6246af8e58c1a028",
      "translation": "“那傢伙！\n　想接觸極限惡魔嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "5a7011f2da06505a70420196b42dd5b9ec7a80f3c532738e0d978dbff4155651",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.01/0004",
      "source_text_sha256": "b45cbbb289cf3c533bdd806abb47b30d1e6332e704af1da3476b913719c2f857",
      "translation": "“我要得到它！\n　將究極之力掌握在我手中！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme",
      "zh_hans_sha256": "fcd7f0ced8bdb8fbff5cd45f4782525b1b701eda467b5266425a6adeaaa6e3a4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.01/0005",
      "source_text_sha256": "5c69dd99788ad5529dabd978767c4194dbb2cdad695e65e0509265375c0c3f33",
      "translation": "“來吧，極限惡魔！\n　賜予我力量！\n　把全部力量都給我！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "63536b5a4f95542cb9012863b3ec692ae3ae8473800decd4fc9e68146d1cdfce",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.02/0000",
      "source_text_sha256": "3c669232c8047d05c18f5e0324af72c5b533caaa4b1b77c924ce3cdf734abb63",
      "translation": "“為什麼！？\n　為什麼毫無反應！\n　還缺了什麼嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "86817a16f24cde41534a751881e1f196bc4607a2a5612a1d0aa291e9b2be5918",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.02/0001",
      "source_text_sha256": "85850b9c43ef18c7f791a16bbc5d5566ee7326708dab50373f958387cae149f9",
      "translation": "“缺的是你的天賦啊，\n　阿斯哈姆〜！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": "",
      "zh_hans_sha256": "ea8b7602b948cc550633087820e62707ed296ab43fde4fa038e30c0077a218d3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.02/0002",
      "source_text_sha256": "eb4259cf3c9e0b99bd32a07d8ed8ee97b6a5d9ac7a60ed7de34ce6c216e822ed",
      "translation": "“唔唔唔！\n　你這混蛋啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d7c9ec8b47a164c6aff572e72a4c63eed5b59798078bcc0629c928fe13c3bcbf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0000",
      "source_text_sha256": "32fbe3305ac31506a37683a5f0386346cd1604a35343168aea00ce61e121cecb",
      "translation": "“哦！回來了嗎，欣希雅！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "a10dea30a63aeba4f67b8774301689eacafa73e74af74ca125b29e2f5df2d5cc",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.03/0001",
      "source_text_sha256": "ee3fa136aa0d3437a73b1e32e14fad2cec9341a336f2e9b3f463255f0e432154",
      "translation": "“那就是欣希雅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "0952d217cc6f42b9a9e4aff243144571ca37065246b19520ae2e702791177a1d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.03/0002",
      "source_text_sha256": "f3c0149b8a440172c159192fb26210057653af3b59405291876f5543744f7117",
      "translation": "“超、極限惡魔也在這裡！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "b57a4806dbdd213ff7a82165ebf5ffe0e42c9de430c5ed795ce08d923ead4948",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.03/0003",
      "source_text_sha256": "55bee78eb7c9db0d4e66d8693f378c8c9e0962b148565de5b0bccdadba4e3dac",
      "translation": "“切！來礙事了嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5e56749af3778343f72c752519e742f0122626ddc3e1f6b9b042ffbf28baac08",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0004",
      "source_text_sha256": "0bbc53ff0bb22a9b4379ec2106850b922e5cfa1df398fd32a2431b093f9d4307",
      "translation": "“阿斯哈姆·布恩！\n　你對基茲大人做了什麼！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": "",
      "zh_hans_sha256": "ce26776e026312d99b4c4824464011f74549785c2355aa36908e9a6bf3cd7872",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0005",
      "source_text_sha256": "6c07c5df4f9868cc218ea510a735010e4a3374f55db613d4de576b4732a4a636",
      "translation": "“閉嘴，突擊丫頭！\n　連那個長著頭髮的都沒攔住，\n　我沒空理你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6e56b3c48207f68ed82423ee7f6740800c1caa3066245733a3e671e0f9240dac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0006",
      "source_text_sha256": "8480de7169c75f3b01097694e220081ec8041426e632cb2cb35854bc1bd0848c",
      "translation": "“你這傢伙！\n　就算是玩笑也絕不原諒！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dab1dc25851b66f9735bc30a2f5855db5d997a903b7ccdceeff846f01e79832c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0007",
      "source_text_sha256": "042b363f38201a3dc87c08fa4530375e486bc0f8d8cb507da6fc5157f7101123",
      "translation": "“本以為你有利用價值才對你客氣，\n　看來是我看走眼了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4f7475b99fc0f3d94ce3d3dd64b0d890194fa3eb87593b250b8dffa755b7489",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.03/0008",
      "source_text_sha256": "b347f425083150b5f4cde36cc578c57407aff910cc6c98c2ab5eeab07db00bd8",
      "translation": "“我不會原諒你的，阿斯哈姆！\n　絕不會讓你傷害基茲大人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": "",
      "zh_hans_sha256": "5045e41e1732ef921086f35f058941ec1067cb01c621665aa5951afcb707e62d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.04/0000",
      "source_text_sha256": "78b196b776261f0da362594090b51e189510fa2672a9a13e94ead534d6a71c6f",
      "translation": "“什麼！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c95d600897af56f91bc440c1c8f0e18d9bc8d7d60c01ae5c47accfe8ace44086",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.04/0001",
      "source_text_sha256": "2438a4919814613e021bd8f9f813f2cfb08c3da258da3ab54e5cfb4e1e8a4a00",
      "translation": "“欣希雅·琳！\n　這裡交給我！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "10927a5466aa42ffb6915835ec43a85fbbc383a6b9eae2953ec1a60b16640a5b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.05/0000",
      "source_text_sha256": "115bf34dcee4eb99aa9c06dd531b9445514a96837e7735a8ccdb400a2a90659e",
      "translation": "“啊……啊啊……好冷……凍僵了……啊啊……\n　我的……列車運行圖……凍住了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d6df35d665bbaf8cfd8f198395785023bb96f8e004959780b399232702d351fa",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.06/0000",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a9d093ba3ffbf3d293bc0b2362d0b8c8f462bb10566dbe7aba4ee6046667d5bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.07/0000",
      "source_text_sha256": "a739c23310201001934d7697089befcc572bb9f5ced156924af1e31a6ed39b2c",
      "translation": "“別、別過來！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3e68ae77e2fbb882de78ddd397b6dddca723789544c8c5ac023a8f3acb386631",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.08/0000",
      "source_text_sha256": "eb8ef602f8b8cf68f4efb84cea0df04b7a2275b258d7d4c9cb77907cbb42dad8",
      "translation": "“不、不要……！\n　我不想變成遠古時代的冰之女王！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f2a85f01f0441dbcc9fb3a12d30a9abdb2c862530d0505e8aca0ed144f97e89e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.09/0000",
      "source_text_sha256": "42c3e13d5661e13006b05cc8dda9509f38ff43f787cf759be886f5cc71e42ae4",
      "translation": "“極限惡魔要吞噬欣希雅嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia",
        "unit/overdevil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "121d3f1e556cfb46393d1f1935e2f71c3dd0a2864a6a942b08a66d3de33e1035",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.09/0001",
      "source_text_sha256": "1044a1605b31070f255381281e0cbbf57177c37d93b5feee369dfb141246921d",
      "translation": "“啊……啊啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8ff4924f06b4d895f1f739ed1a3191a5f39b57e11a1de5c65425fdb1d07744d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.09/0002",
      "source_text_sha256": "5b8c4c949799639091c36256200617e8f9151808d83bbacbdfbff72a784fa05f",
      "translation": "“欣希雅！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "5fc3209552c7e6293a72c663549eaeebf4d3a1cf94d01dcd45ddebd73c53eb2a",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.09/0003",
      "source_text_sha256": "b1e6e33b0e5c9f699be0ff75498961a05571082e23291183ebbed23b11711206",
      "translation": "“為什麼，極限惡魔！\n　為什麼不選我！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "a7b2a6215d4219176386e4d090592f91b5f8e2f5c6a3f65f9626bb21e26b5705",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.09/0004",
      "source_text_sha256": "c5443e258df722c5d1bb11d30312029ab08f9090c74d4d1021f6d5ff01d1e275",
      "translation": "“我真正渴望的東西，\n　難道什麼都得不到嗎！？\n　卡琳的心……還有肯恩的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gain"
      ],
      "notes": "",
      "zh_hans_sha256": "1dbf60a95cdf378658ff5833a89dc72923b2cb9ee1ead543ce85ba53ffa25e08",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.09/0005",
      "source_text_sha256": "f40a32495bd95bccfc3ee73e988296c623ace4cba38161a0701c87cb94276176",
      "translation": "“極限惡魔！\n　為了達成我的目的，我非得到你不可！\n　我一定要得到你啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "2a1bbd065efe9eaf96cae5593f70f04632fc0e1116a8582e947352e651a08fea",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.09/0006",
      "source_text_sha256": "fddf3ef0bee0482072f4bcc3c46253c2e9d33a9712f2e86aa99d73f936b598b0",
      "translation": "“把我！\n　這充滿絕望的靈魂獻給你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bea2ef9534371d7cab414f2ff6fe78f1ed36a0291b5f6da56a7286808ad5dd7b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.09/0007",
      "source_text_sha256": "c3dc284957e0aaf388cbee23c25e821534a1c16724cf99c7aa4cc8c785f186f4",
      "translation": "“所以，求你聽聽吧！聽聽我這個叫阿斯哈姆\n　的可憐人的懇求啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": "",
      "zh_hans_sha256": "e61db78120744f0c6fcc916d858df741ae7b464fe672ef69e55126d048f22898",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.10/0000",
      "source_text_sha256": "fd086d77543090edb1b156cc63e996c273f774c84cae34aa9b2e131b270da154",
      "translation": "“哦哦！哦哦哦哦！！\n　你回應了我的聲音嗎！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "91399431defd2fa06aadaf759ddd7f977b8d17609ed76716909217ae62ae98b5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.10/0001",
      "source_text_sha256": "56f3058d13914771c6fe83591431464f5bfc375124f05a239d77892b2f72deab",
      "translation": "“多米尼達！\n　到我這邊來！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "user/unit/dominator"
      ],
      "notes": "正式词表构建审计修正。",
      "glossary_exceptions": [
        "unit/dominator"
      ],
      "zh_hans_sha256": "7a903fb51ca36323635b8b15340812d18ceeb4fdbafaa452e8e346751c1d7e0f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.11/0000",
      "source_text_sha256": "e20d45027754bb29a4bc7a46620f3fdda34ab51db0a36a96f651b5b4c946e6e7",
      "translation": "“歌唱吧，極限惡魔！\n　讓世界超限凍結！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "412b4baafb0e83d9978012b7200e0cb5f7a21e5203e6ea49f0e5cb5fcb8041bb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.12/0000",
      "source_text_sha256": "4d64fc00fa9767c9c6561a839df385c5385faa62ace78b0ff9421fd6b41a151a",
      "translation": "“不好！\n　阿斯哈姆那傢伙！被極限惡魔吞噬了心靈嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham",
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "7b2b82f7ebfeb6c866be3820c86e6059dc73f0e82d7047e7db3b68684730f91d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.12/0001",
      "source_text_sha256": "95cd0283e4ddc9c458f0bf153ce05916f2fb487473f1be55149f1269a6536acf",
      "translation": "“撤退！\n　放棄阿加托結晶！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/agato-crystal"
      ],
      "notes": "按日文源词绑定统一全局术语：place/agato-crystal。",
      "zh_hans_sha256": "39fb0b5d694500f35cedf48d7dc3f8ce7b890110506f6675fbe80f6b38a8d6b6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.13/0000",
      "source_text_sha256": "4eec674a8127bd1383c2c50a04d9135ae3ce148600f3cfe587717f76c47fe237",
      "translation": "“欣希雅……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ],
      "zh_hans_sha256": "768b7837c78520b8a169d47c5f1ddb88fe86f60e4c5867725c23fc54b5e9afc8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.13/0001",
      "source_text_sha256": "2678ba11fcd6fa6a8f56f294ee5dd4d75aa9c8067e196e255e9e1efbe0f696c7",
      "translation": "“重整態勢！\n　聯絡全世界西伯鐵分公司！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/siberian-railway"
      ],
      "notes": "",
      "zh_hans_sha256": "11748dbdd54bb23b39d6b7421be89722a77b4c71b0607f12a993663e01fe64d4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.14/0000",
      "source_text_sha256": "598667970e0ab7897a24cb4e422f1041d2e246f1b791a4cd9426fecafe8b9798",
      "translation": "“那就是極限惡魔的真正力量……\n　黑歷史中傳頌的破壞軍團的一員……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history",
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "665c8aca9bf2d8404162ac6d590383af6324b0a1e2fcdff41897d2b95c0ecda9",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.14/0001",
      "source_text_sha256": "c4ff3c4ec14b803fcca7fcc63c8b42bcb1d5654e247bafac7bd382a446fd3477",
      "translation": "“墮天翅族、極限惡魔、月之蝶……\n　世界正走向終結……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel",
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "8c8d74d25b55143ed6b1453664a1250fa2a519ed3b8409f99401bad3e6ab1fc1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.14/0002",
      "source_text_sha256": "30825d93bec021916c729a36e48dbacfdd59a8a0fb667951bb446c20c4ceea66",
      "translation": "“那最終顯現的真相……\n　是偉大之力……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-power"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/great-power。",
      "zh_hans_sha256": "06429d4afd5573924ff915b46ee4e686ead223fd523db8a44db3f93c30138abe",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.14/0003",
      "source_text_sha256": "b2a275062f27ab1cac3482b323fb67dc0bc9f3ee15bc600c8c8c2c4a970bc9ea",
      "translation": "“哈哈哈哈哈哈！\n　極限惡魔啊，用暗黑的白夜覆蓋世界吧！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "31b92801b68dd54b76b0ad3c6c8653fa83e6a11b6c39f03c62aff1806e81921e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/01.14/0004",
      "source_text_sha256": "81df574ddba022bdb083e9a5424d6513e42b08923c7fe30b57071e9718cc350d",
      "translation": "“既然你不聽我擺佈，\n　那也無所謂！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5e72eddd18b24fe429bac8547efdc9619dc32c7f4fd273cd95e6378205f20782",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.14/0005",
      "source_text_sha256": "60459efe47cdaae136f20d949449a977aee1d108b03b0c07bfeb67ef8501fb2a",
      "translation": "“但你聽到了我內心的聲音！\n　從今天起我就是你的一部分！\n　與你一同凍結世界！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b1214e5b352017f78a1982f6da99ba65b430d86446cdc1452258c6cc6d6984a1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.14/0006",
      "source_text_sha256": "89952908c62d47fa5290ea420ae4b8ca94dc0f9fe7b830bac0cdd4d29c7a5829",
      "translation": "“哈哈哈哈哈哈！\n　哈哈哈哈哈哈哈哈哈哈！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "58a5feef0b59392bde4e6432f12cc6b2fbe1e1e5549f094554143d7c6c3f1ad2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/01.14/0007",
      "source_text_sha256": "e0151a2223643ec731662523c4b1cf2a795a4c07bc660a1d9615e8fb25bf8b28",
      "translation": "（凱納……好冷……\n　我……快凍僵了……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "4a1ce53d8fec6b713319aafb1152b6fe0da17522c599627d31946e3246ecc896",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/bazaar-venue"
      ],
      "notes": "按日文源词绑定统一全局术语：place/bazaar-venue。",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/bazaar-venue"
      ],
      "notes": "按日文源词绑定统一全局术语：place/bazaar-venue。",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/bazaar-venue"
      ],
      "notes": "按日文源词绑定统一全局术语：place/bazaar-venue。",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0003",
      "source_text_sha256": "3ee7547772f6529e59918b904e2fa4ec469cee1cddbd00be48d214e0799f3cb0",
      "translation": "“你在幹什麼啊，凱納！\n　快回鋼鐵齒輪！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "unit/iron-gear"
      ],
      "notes": "",
      "zh_hans_sha256": "c2379b57825d3a4420bb3e4254b73268b881c4bd8fbd99ed7562367609180be3",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.01/0004",
      "source_text_sha256": "fe0070d6aac54e18c58989839a72dd42281ddd8b0e3a6dddca72d64350fed7f2",
      "translation": "“等一下！\n　這裡的市場……\n　賣好多滑空板！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "item/lifting-board"
      ],
      "notes": "按日文源词绑定统一全局术语：item/lifting-board。",
      "zh_hans_sha256": "4819a383f6e7d9b666499a8dc1697816df54c2de9736c62d98195e64142d4d7c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0005",
      "source_text_sha256": "8a8717de91158c629d36c624b2bae7d38d3f9e11426bf2def3ed8c1c6268efa7",
      "translation": "“喂，世界都出這麼大的事了，\n　你還有閒心逛街啊？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1a537e797b8b95f1c64d189cbf573240f75ac370164f7ce59c2359c2847dda87",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.01/0006",
      "source_text_sha256": "d282bd1994b02a82409576e21358b9544d79ebd53117b85a1340a6229ea4b43e",
      "translation": "“可是……難得蘭頓回來了，\n　想送點什麼禮物……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "55bdcf0a5fe6a0be1cf19a6080c169ef8fabf7d9c6d2c9a9fb861ebe5bad2da1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0007",
      "source_text_sha256": "e5d49b4caf438380c750ba9b6da945325cfbb1a2c7b2ae5b2ab14377ccb322ab",
      "translation": "“就算這樣，你要賣掉那張拉克絲·\n　克萊茵的簽名光碟嗎？太可惜了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6848a6b51489adf3a7bfc9627aa9165e6873ebc96ce7fa7d571850a30dc85141",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.01/0008",
      "source_text_sha256": "6c95e8c7b4744113f81272f91d905ba9508282c71824de5d87b958769158627d",
      "translation": "“反正我已經不需要了……\n　而且蘭頓……好像經歷了痛苦的事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "556eaa76a4172a0828facaeeb9402725ddce0eeef855ab1de282eb04c07d438d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0009",
      "source_text_sha256": "237e78bbf615d2d4de2c12e08514d68dfbf0b3a1a8ee5f77fb49b3072f351d30",
      "translation": "“那傢伙……似乎和那個查爾斯\n　與蕾一起生活了一段時間……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": "",
      "zh_hans_sha256": "8e628ee9613531fc8e8b757c959e00bed8202fdf5df7742795bedf1fac016ed8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0010",
      "source_text_sha256": "c8aff046303351c4041259fa46ca194131ca9c2552740f3db1b807a51e7f419f",
      "translation": "“真夠難受的……\n　雖說是對方挑起的，可最後竟要和他們交戰……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "393d1e8f5f393e58f89ee3b6b83240c537a144564b594c8e7a08871d5516dc1b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0011",
      "source_text_sha256": "1f3643c175b8cddcd475350df4379bb65ab99b0e9c9fbd26a81c1583ef417cbf",
      "translation": "“明白了，凱納大哥。\n　為了安慰小弟，那就另當別論了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "176cf824e8f7588e6303b4f52206ce02b0d889cf7b1ddd6d1a29281e4a974537",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.01/0012",
      "source_text_sha256": "239a4fa4d291a3aa02e5e5f42d2a8c78208786a80599c43da923350ddd93deed",
      "translation": "“貝羅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-542832967a32"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-542832967a32。",
      "zh_hans_sha256": "085c886f79dcd8cb18be1dfabe72d315ea64424a339d2cc6a3ee22c0108d1f4f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0013",
      "source_text_sha256": "c70edc80e3ea0ed987ef4933146d713ffb429d465defc0fa0f8f472b0b831a56",
      "translation": "“但要快！\n　沒時間了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b3ef292a54be01392e56b5e1c98a29623b59e00548f65a88d4406486367cf9b6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.01/0014",
      "source_text_sha256": "b8e888c23a599b26d861e8f6683e28c8fe68df540d41429b992976f883b1bd0e",
      "translation": "“嗯……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a02c45a7a20de7fe4b4a9ee0e2ae5893af92e3c8d746d69e1c183920dd43ed71",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0000",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": "",
      "zh_hans_sha256": "409c7ca826d78277bc5e8a5d3938d00cabfc7da84225e5017a1dd92035327ff3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0001",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": "",
      "zh_hans_sha256": "409c7ca826d78277bc5e8a5d3938d00cabfc7da84225e5017a1dd92035327ff3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0002",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": "",
      "zh_hans_sha256": "409c7ca826d78277bc5e8a5d3938d00cabfc7da84225e5017a1dd92035327ff3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0003",
      "source_text_sha256": "3c6a13387038de99355800be4d14acbae3c7859533037b3115e7eb07b5acb8b1",
      "translation": "“……蘭頓，不介意的話……\n　用這個吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "cf6ea170c0535702a88f131bc46db693eccd8c88fcf1cf71405d4a32eeea6e77",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0004",
      "source_text_sha256": "82c3f87d429c01921bca13947aaff6b9740dc923032fa2f926eaadd1d432a416",
      "translation": "“這麼多《平衡輪》，\n　您從哪弄來的！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "87e29ad77649a92e9c7957f9cf2b0992e6529dbd6809a78f414ea644ea1d05af",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0005",
      "source_text_sha256": "6223f5f809f355f6d474c43278cb1b0da02c09f641de566a1abae997ea411cfc",
      "translation": "“真厲害啊……\n　還有稀有貨呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5c99edc630bcf9a5e7a48a34643b1833ef97975a5a78d5ef548dce5818305e3a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0006",
      "source_text_sha256": "aee969076df6cc6dd52322debec4c7e2743f5af424e09c2e3f593d5013ed905d",
      "translation": "“有點額外收入，\n　就隨手買了些。\n　我不太懂滑空板。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "item/lifting-board"
      ],
      "notes": "按日文源词绑定统一全局术语：item/lifting-board。",
      "zh_hans_sha256": "c670da2b62a81b12b7450a238509a546f011c072d0f807f3d7219ec35a29a7a1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0007",
      "source_text_sha256": "12039308f216d83df3373e97b50c416fae4fb2166ed8dc2984c065305a47ae2e",
      "translation": "“……你是想說，\n　真正的滑空者不裝平衡輪才夠酷嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "item/wheel"
      ],
      "notes": "按日文源词绑定统一全局术语：item/wheel。",
      "zh_hans_sha256": "fbd18c1c3ad390ba5b6e60165c8c99b004d65ef889e5887790defb45358cc1f1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0008",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“誒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13ed62045e04cbf2614c7548e31cfda8826a67aaa0a7c2f1766728d5cb78e0b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0009",
      "source_text_sha256": "f04abd16e4490f59699e05bc5e1da8635c8150c6b758befc1a6349fba5a25aff",
      "translation": "“是我認識的一個人說的……\n　他教了我很多事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fb81a08734558c9eb1082e7e06b995252a44586127b1186b356f8ee3716fe5da",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.02/0010",
      "source_text_sha256": "580168dc8314ae11d204acc020af597606941ec6116d08083235c49ef8ad5479",
      "translation": "“那個人還說過。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "cb9da857cb96fa595d7f6e37ef48c3ae84a23fc0f56babbbc2b19f12c4a173c0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0011",
      "source_text_sha256": "cd3dda26130f11a0e13d9a155d71056f8e5ffcbeafd5ebfa0d8273d0bdc8a2d7",
      "translation": "“流行和別人的眼光都無所謂……\n　有趣就行……滑空就是這樣。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "activity/lifting"
      ],
      "notes": "按日文源词绑定统一全局术语：activity/lifting。",
      "zh_hans_sha256": "6587e291133953cd2c92f471ea5fc98c9d44780f0216ec18fdf219c274808951",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0012",
      "source_text_sha256": "fe199949927915899987769303ceeec7f2d54261a41a4bade0930862699b97d2",
      "translation": "“這樣啊……\n　真像那大叔的風格……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a2c5b70c9ed7c0e3c7af15665e2dc115c0e762c1ff70ec6c089f6a86b0620b28",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0013",
      "source_text_sha256": "6f05bfb9abd2abef44a15376b9be817da4d38362cacbec6fae6ee8d11350c896",
      "translation": "“抱歉，蘭頓……那個……\n　讓你想起那些事了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "f4fcfcc3822c686f3d6bbe437ed97561b22f8ba0f892549285dd3d8721c91cbc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0014",
      "source_text_sha256": "77f73a16458c646e222dc35499ffe18d98e4fa0033d66d97b265e6b110042c2c",
      "translation": "“沒事，凱納大哥。\n　我……壓根就沒想過要忘了他們……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "d29e3ade972f1a816e05a1bdb501f1ab45c232518d21b3b1d0aa0797635f419e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/089/dialogue/02.02/0015",
      "source_text_sha256": "efde30da0f5e80d73ad4d263bf63c70bd0836479ef006fb3df2dfad0296ca812",
      "translation": "“蘭頓……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "d359821d03b3ef4da983c3f4f726d56a351ef019db89c3d13d9b2fae602fb80f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0016",
      "source_text_sha256": "67d25557131d443391540be0586d9ac2cdea0869e163bbc0ebd1a0d40042b06e",
      "translation": "“謝謝你，大哥……\n　我會珍惜這個平衡輪的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "86196c2ff7c46a00b5412ff86496ce4693b138f805501dfa9adca4d5e83925db",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0017",
      "source_text_sha256": "a9e96750f9265366e396d52daf0c91d921788593b7688c1e879409e14c4f7c0f",
      "translation": "（查爾斯先生、蕾女士……\n　等安定下來，我也要學查爾斯先生，\n　試試大號平衡輪……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "item/big-wheel",
        "people/charles",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": "按日文源词绑定统一全局术语：item/big-wheel。",
      "zh_hans_sha256": "0df5d35da19eaa876a1da9c54d8faf5da498578b54ae6c478a9632ce94962b66",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/089/dialogue/02.02/0018",
      "source_text_sha256": "194215cbe2061a7fc6056a4a2b32d2838934547473b7fc37ee80e1dff7e9fb3d",
      "translation": "（爸爸、媽媽……\n　你們教我該怎麼活……\n　我……一定會牢牢記住的……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5cad7050c6db264eee46f2ae8a37794e52369f784b1190d2c90f807cd20e68e6",
      "zh_hant_status": "edited"
    }
  ]
}
