  "entries": [
    {
      "id": "story/153/dialogue/01.01/0000",
      "source_text_sha256": "86484155f88c96eab1a27622753149ced1a132e59bd5b26dcb1555aaa9828784",
      "translation": "“竟然有那麼多極限惡魔！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "38c0eccced28482b4bcd63ad80ffefca7d750a3a065a8fa3f71e691a7c258222",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0001",
      "source_text_sha256": "16b3b8162eea03d8051b0fc9044fb95619385ea46b7557582e9d63bec3913ac5",
      "translation": "“可惡！\n　那些傢伙，怎麼打都打不完，\n　源源不斷地冒出來！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e59065eb016e8fca5768e36bd9ccc379d9eab02c1cabe70e096671014ac4164c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0002",
      "source_text_sha256": "43a938f8ef7861ed699f2748fe100eef5c8f8ae29d7a5588125525999d677667",
      "translation": "“別說喪氣話！\n　再怎麼等，新聯邦和扎夫特也不會來救我們！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "dbbf54e3440877b0ed80e5d2ec58566f76b3c1175db6500ee80a031857b0b96a",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0003",
      "source_text_sha256": "9066757180df4227c354d203efa0f0956b03c37c6c249c1d10945e462ad41741",
      "translation": "“反正，\n　他們肯定在互相殘殺吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2c552e602b5c1edb4182e298c87b8d96873f0181869bd49e98847c6ad48917fc",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0004",
      "source_text_sha256": "41cd713abdb3870b67ecba3fcc552fcaa0bc37d1740cc02af52ad8ea39087a73",
      "translation": "“要是我們被幹掉了，\n　那守護這座城市的人就一個都不剩了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f261bee12043872ae8c9292b4b1866c2ffd5dc347dfa23cea6858fc9aa4da510",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0005",
      "source_text_sha256": "561f7f7085dd1d9988198a8288f119dad30d02b1480005836c99d2e419b50c52",
      "translation": "“不過，那一天……\n　也快到了吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "139f16d5385fc371b293d28642e3a83e4db727b0a6c641884848bd5b07b509c9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0006",
      "source_text_sha256": "4190872a0baa61e650d3b3a5d7f382a87ab0cfd872c6cca585a16e3bf936a76b",
      "translation": "“可惡……可惡啊啊啊！\n　萬丈大哥和羅傑大哥都不在了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/banjo",
        "people/roger"
      ],
      "notes": "",
      "zh_hans_sha256": "caefab7809a97043aa627dceef37aadb637c125eba62d3fd6ee54184a2abd98d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0007",
      "source_text_sha256": "a911b9eab1736913d4184f21dd5abd9d77e4986ad2e65525b06914dcd0d4aa41",
      "translation": "“阿波羅……現在，你們在哪裡……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/apollo"
      ],
      "notes": "",
      "zh_hans_sha256": "91df13ce1d47710c2fa13fdbf25b732186b81fc7378dc58ee08d0c577995ed82",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0008",
      "source_text_sha256": "ec481bad2ca79ea9a55a8ea90a22d9ed8cc3df3436d780dfc8b3a41deb80dd40",
      "translation": "“桂和歐森上尉也消失得無影無蹤了……！\n　難道時空修復失敗了嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "people/olson",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "嵌套词表子串自动例外：people/kei；按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "e3e59f4b3d870dadb14ebe94bd15a5fb350afa39e96ffa35ec9eddfefe9ddeed",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0009",
      "source_text_sha256": "00c9ab241ebb3ed6c248fe6ae0f6dd5241fd2f84e9844c9c06cf65100e37566c",
      "translation": "（克瓦特羅上尉……\n　你離開我們，\n　是因為對人類絕望了嗎……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/quattro",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "ffb1cef3ab08306316a762a5008075b7a2531f95b2cdbde3aa0660e8a258d750",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0010",
      "source_text_sha256": "9d99c29ca0ff6362fc795c9be19777d41fd421a37116da0e7f6f81d7ce2b7201",
      "translation": "（然後，你就要肅清親手葬送了未來的人類\n　嗎……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8887f32be084db32d8e8f7c19e3669ff71b9c191d869c4254144bb1ae694a6d2",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0011",
      "source_text_sha256": "28828577f31cc7f1a3449fed677625f8f028fc4b7fe414908de74cc69747ca8a",
      "translation": "“不行啊，馬林……\n　你到底在幹什麼……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/marin"
      ],
      "notes": "",
      "zh_hans_sha256": "c872e815b699a60785743b723bd2a56d4474e7476639f21e0c34ef297f7d6823",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0012",
      "source_text_sha256": "769317d5504455101177bf8fa12bb16b817fbcd5ca39264e5f47fbd46ba14fbf",
      "translation": "“你不是要拯救地球嗎……\n　那片藍天、大海、大地……\n　還有明天……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c2901077de06b19441cd7d253121af691b1c852d0de61ab5ebf38df8435d5c75",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0013",
      "source_text_sha256": "6345772cd46326020b88142fabbf494ba3af8ec8ba9e75288ec469685729f835",
      "translation": "“難道我們這種生物……\n　根本就不配活在這個世界上嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8b9f9709e796024f8a5cb536aba425b24bba8e596079a3940bf0aaaa4c1dd4c2",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.01/0014",
      "source_text_sha256": "51ef9eebdd2a7a348b0a252edcfc4ac0b90dbbaea8811ee3d36b9dc5962b1cf9",
      "translation": "“才不是……才不是那樣！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9b2f63c316e89569dcc648bdbc3f02432d6d27e84d69be538f80d3aae824af91",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0015",
      "source_text_sha256": "766671a1923435b6d04762099f7469fbc7a3b7d058588b32394a7b0572147c72",
      "translation": "“我們……為什麼會來到這種地方……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0ff8d3764ecc52e90df4ab8411e174fad077bd0415d8cf55152b66e68c367293",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0016",
      "source_text_sha256": "aa0755d93431c23a341a58a2239affcbb709d7a4ff8513a67f89b56f75d44ded",
      "translation": "“我們的世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "32c65a1bec0fdf0b7f75c477e84a47c3e475f1a2b1cd0553ace74286495b1364",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0017",
      "source_text_sha256": "d49400e2466683df8cc2455d76491ae3c90b7b6cece8adc4f6b3ebeefddd099c",
      "translation": "“大家，跟我來！\n　世界還沒有終結！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "15722235b4a5dc57c7649c804708f5fbc1b91d98b9b9484a878429f5d56364c0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.01/0018",
      "source_text_sha256": "c7657afb930fa007ffff385a2d55b9b4ebd6255bb7a7188806f2f834d9327325",
      "translation": "“桑德曼……\n　我們會戰鬥到最後一刻的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sandman"
      ],
      "notes": "",
      "zh_hans_sha256": "b40c00266cfc865b033c8cf4354e1fc5073c37974c5ebfd2141bf61697b9ca1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.02/0000",
      "source_text_sha256": "84febd265dacf7db084c2a74e390d77d6d53bbd1f25450323331febb44795e3a",
      "translation": "“等等！還有東西要來了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d9d286ef11e39ed847f7b32064ef054f8c28489cd3662a868f0807c801a37fdf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.03/0000",
      "source_text_sha256": "733d1e29c6d3508d394f5fcd051a8228a88c6469da693840b185ddcd6db99ca7",
      "translation": "“慢著！還有東西要來了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3fc5430d5f2e9e50ecd74ac8f97f8758528b98e63c56525c97597ccd42fd74f5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.04/0000",
      "source_text_sha256": "8ead4d39673309c01ac6bc832b78f9dffbf76600bd0606120e2204d14300ee89",
      "translation": "“偉大意志……太極……\n　源理之力……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-will",
        "concept/origin-law",
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme；按日文源词绑定统一全局术语：concept/origin-law。按日文源词绑定统一全局术语：concept/great-will。",
      "zh_hans_sha256": "c27c067d634d2dfa3d34a33d45e924b20fd66e9ec08d457462a2383700fb121a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.05/0000",
      "source_text_sha256": "efee1b199eb23c0427c1b17be2edabd8726f7b906e41f43d5fdc5fe1c584eeea",
      "translation": "“呃啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "37adb67cdbe3133ca2afe00b585e63ff7f6e7d9b8ffac4eedf9e21a926cfdd41",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.05/0001",
      "source_text_sha256": "e1bddbc137d4a3a4190543a7ebd116e1bf0a898f52397b70f376fbe5c6d839f0",
      "translation": "“以我們現在的力量……已經……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bdd43c75b549592864d117bf9f0650a8d916d462b453434524d4473b3c753424",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.05/0002",
      "source_text_sha256": "ff618b834654e21c88b6f64902be17c5986e7e930c83bc36add2e167c2d6d29a",
      "translation": "“對不起，隊長、托比……\n　我……已經……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/toby-short",
        "system/chief"
      ],
      "notes": "",
      "zh_hans_sha256": "fb8dccafe6b9d8f77bca6cbec78393ebf619c86fa352df720d92107a3ee5e0fd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.06/0000",
      "source_text_sha256": "9a6c4af8cb15f1f3c13a8610c025efcc46c586afc053d4734b30335fd8f25625",
      "translation": "“可惡！梅兒！\n　你到底跑到哪裡去了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5dce4d366aa5d28af451465dffc213477af18e1efc5602665d2cb11c5c5329b8",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.07/0000",
      "source_text_sha256": "cb3f13653ea5fa258d8f7e8514b2ae7f9cd1b1574754894db4a03b89a42140f1",
      "translation": "“已經……不行了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dcd3b4d7d548291dc372c4a74fa8a36ad0dca80553114e787f75251c3ea25636",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/153/dialogue/01.07/0001",
      "source_text_sha256": "b4fdc5a50ecd227e0d0c1685c8695bf321de1003c38dca6d0121120f2920da9d",
      "translation": "“對不起……艾蕾卡……\n　我們……什麼都沒能守護住……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": "",
      "zh_hans_sha256": "2d9e3a5e47b2aa06f21aff92e5f15a36a9d5f06e34761d9f52c0b960a02d1798",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/153/dialogue/01.07/0002",
      "source_text_sha256": "bca327c2e56d80228847f1527aecbddc2f6c793154cc6dad86bb6c5a49909e50",
      "translation": "“可惡！\n　可惡啊啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b7eed01dbde9fe34ae63b83038d0b84acef8fb2a5654f47a180eae95ec2fddd5",
      "zh_hant_status": "draft"
    }
  ]
}
