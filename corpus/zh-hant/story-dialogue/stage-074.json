  },
  "entries": [
    {
      "translation": "“大家……都平安嗎……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0000",
      "source_text_sha256": "bc01c35ef06488e4d266551d342ec2698ee57367797fad3495c3e97097b48e15",
      "zh_hans_sha256": "cf3c47d85e7663571ddf3eb9bc3c577aaf3bddf9b02f3844f95a10cf62349c1e",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“是、是的——”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0001",
      "source_text_sha256": "64e1f601df61ef7dc3b20e649cad47a689394fe04764ae436b39dda961b274f1",
      "zh_hans_sha256": "a2898b2def7511bda5da78755a06043f00bef5a0ef935256cea57c33a0425b38",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“總算沒事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0002",
      "source_text_sha256": "35e54610d425b100c800d2468f998ef364205276c518fc9c22ef6a698d53826e",
      "zh_hans_sha256": "bf4f30d3947a3b33566ef518ec4564d0ad421eca1e49103e6f0f585c4b98720e",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“這裡……到底是哪裡……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0003",
      "source_text_sha256": "c34486004a9e0d329152f5e8fd851234315a2817a9ba45bba1abad480741e1cf",
      "zh_hans_sha256": "0158c8bc5271f6777b4e8726b2421293421d39b8f43f60d06f3b2997433e9e34",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“看來和那片巨大雲團所在的地方不一樣……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0004",
      "source_text_sha256": "5a6473dc679b1dde74602cbac19cb305e25f248c68156cec263a94d299cdedc5",
      "zh_hans_sha256": "f1abffe008660d24cddb771677f2189afcfc6c72e01512b765c20dbdd21d8cfc",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“當前位置已確認！\n　在遭遇科拉利安的地點以南約100公里！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：species/coralian。",
      "id": "story/074/dialogue/00.01/0005",
      "source_text_sha256": "a18d9773c2b6d8ac7053e841386684a8db7c05b6cca1992fec25f7c15c2e4cc8",
      "zh_hans_sha256": "bdadd19fb4ce1d4bd4041d9c16683038230e788a6e73ed67783d8bd739a3b5d5",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“吉潔特！\n　霍蘭德呢！？\n　大家都平安嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-005b8a1f6524"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：people/speaker-005b8a1f6524。",
      "id": "story/074/dialogue/00.01/0006",
      "source_text_sha256": "c4aa6d548a1f2522511783cac2cffb11ec010ca32f2d139efdd67e8a3582e439",
      "zh_hans_sha256": "db79f800c1ba8415faa1a9c1f533b369b8718fbae1af5e59bdae7e33035a3fc4",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“探測到周圍有反應！\n　所有機體似乎都平安無事！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0007",
      "source_text_sha256": "513e1de72cccecf0253a0a3e9e24242ab6481de12c0a49a2e62ac6017d552c7e",
      "zh_hans_sha256": "956c9d9b1b5c1ab23d9bb38e7f663c21276c39df2e51086b657eff1c2158a762",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“真讓人吃不消……\n　衝進科拉利安後發生轉移，\n　和那時一樣……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：species/coralian。",
      "id": "story/074/dialogue/00.01/0008",
      "source_text_sha256": "d6645997db9770b0ddd417991c42e4823469fa8b624dc3657550be11b6a634de",
      "zh_hans_sha256": "77cae11d24550961b69565625e63eb52889731f5546ccce244cd0291cd54a8a6",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“不過，看來也並非毫無收穫。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0009",
      "source_text_sha256": "0baa7bbe8db791f288f96c0c38e5875c4c161cca2c0ad4d88b0891ce430853a1",
      "zh_hans_sha256": "20765155bb950886b17cc926cce0acfc255093e6135b428b412bef7bcca1f5f0",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“看來，剛才那幅不可思議的景象……\n　大家都看到了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0010",
      "source_text_sha256": "73baaa4b4ad681c34379ef354bc8c1c48a3a3f1ed069497c0b94626e434c2fbb",
      "zh_hans_sha256": "241ed0607ca1fb5b4c38ee6f2ccc422e2b5e1df8899ad70a5cc6f6347af87e19",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“那是深層心理的顯現……？\n　還是現實中發生的事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0011",
      "source_text_sha256": "accef23d4ed464ee65af609da116ac3ba18d6e3c0348313a52c811f6e8d60f97",
      "zh_hans_sha256": "0049fab6c7ac8cbd39ed16ddf52e3bd78a519a23b4222924bc58be2518e6798e",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“蒂法呢！？\n　蒂法在哪裡！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0012",
      "source_text_sha256": "6fee95ecc8f1d091b0e8b2ff7b705656de64d33dd4207cb2184d2a76df512bc8",
      "zh_hans_sha256": "f74fb1bc459a611186d97757627c8e8fabc5d3debe29b393da4146862f9c9f68",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“這、這個……\n　雖然也讓奇多他們幫忙找過了，\n　但艦內沒有她……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0013",
      "source_text_sha256": "5953c2990e4a9c2d8edfb8679c8015c7db64c7dcd8852ddc9b72010652e361b3",
      "zh_hans_sha256": "0a9ca2db192352347e891e976245557ef06d5bdb571888aace8cbd98caaac079",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“怎麼會！\n　她是什麼時候不見的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0014",
      "source_text_sha256": "d213c9289d6a3370dfb41c1b29a7a86bf7e84381ae2987c7b0b2606c770ef350",
      "zh_hans_sha256": "863125ff0ad40d559d94b10284b7a4df3dafe0f200b63d8b6d6b8f21376bc3b8",
      "zh_hant_status": "draft"
    },
    {
      "translation": "“……那時，\n　我確實聽到了蒂法的慘叫……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0015",
      "source_text_sha256": "6600e624464b5b7932ee4b56b75ceeaba38be20b5a2c56dbf0593893008aab41",
      "zh_hans_sha256": "7cd5b82f4b2658b136bdadc50d3cec2b8078315377590b527a6325d037a8cc7d",
      "zh_hant_status": "edited"
    },
    {
      "translation": "“難道在我們被折騰得暈頭轉向時，\n　蒂法被什麼人擄走了嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/074/dialogue/00.01/0016",
      "source_text_sha256": "f7f5b29542d7214d859db580d08625ca40da94dcf33a8831185e3a38287dfcbe",
      "zh_hans_sha256": "5506438df527eb8dec74b67f337865cd23abfc82a56725855ac28a3de0fd0b59",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0000",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "聯邦軍基地內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "8f1023ae8ee8d8757e47623de6c2efd2c20ccbfb40f47962a93a77b56fe95866",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0001",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "聯邦軍基地內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "8f1023ae8ee8d8757e47623de6c2efd2c20ccbfb40f47962a93a77b56fe95866",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0002",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "聯邦軍基地內",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": "",
      "zh_hans_sha256": "8f1023ae8ee8d8757e47623de6c2efd2c20ccbfb40f47962a93a77b56fe95866",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0003",
      "source_text_sha256": "153fd38c4be105a28b7ca0834b04d981394934ea98a2c65a1350ccf89b7c4ee5",
      "translation": "“你那邊進展似乎很順利啊，\n　夏基亞·佛羅斯特。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shagia"
      ],
      "notes": "",
      "zh_hans_sha256": "70c8de82a90a8ff6a219dd0ab30bfebcce30f98ee8a222dc20ecc4292be7fab4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0004",
      "source_text_sha256": "4051795612b3a10f7c60e43722369e2c610f2031203f4fb290249797c9521594",
      "translation": "“感謝情報部的協助。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3027b691a8aea351f32310d73c90e687c2500273a8217812236eb40a5508b355",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0005",
      "source_text_sha256": "75c0d1055d1b681671a0306f20e5e7b50efdf08296d422c940dbf8ffa611a764",
      "translation": "“該道謝的是我才對，\n　多米尼克特務上尉。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "4557027e08a85a2db81edf03c652676ef36989223d97076421c416777119d66f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0006",
      "source_text_sha256": "2aaf815dd28c17291263d57acaa5fc77d1fbd82bf4b8437259562a63d4a02793",
      "translation": "“如果沒有關於那件事的預先情報，\n　綁架蒂法·安迪爾說不定就失敗了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "f44e440ca4d144d57244787e124caa6686a9fa5d9c7e99defb9e1631164f0139",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0007",
      "source_text_sha256": "9326e5c0c395300eaa6dad55d19ad744f90756131c8ea4f9498636170cc30ee0",
      "translation": "“根據此前的調查，在庫特級科拉利安周邊，\n　已有報告指出會出現精神異常的例子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian",
        "species/kute-class"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian、species/kute-class。",
      "zh_hans_sha256": "c1625fe8443dd5c889844b501c4a8078d423856f7fbff4e748a37237d60f9619",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0008",
      "source_text_sha256": "2c2bb4e9c9a736e6c90349f0c4d91b09351683376b5055a480ac4417f2cb4e07",
      "translation": "“今天的幻覺現象，恐怕是尼爾瓦修終式的\n　巴斯庫德危機產生了某種影響所致。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "按用户确认的机体术语统一为“尼尔瓦修终式”。",
      "zh_hans_sha256": "6be7bb5aa1a7b444ac73a10d4588fcc3f4821532792c583b82d93ed9d11ed1ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0009",
      "source_text_sha256": "26db96f6afd1948b87f500e60def325673a9df736d48aaf9864f913fce7442e7",
      "translation": "“那麼安妮莫奈小姐的情況如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/anemone"
      ],
      "notes": "按日文源词绑定统一全局术语：people/anemone。",
      "zh_hans_sha256": "ee8450132aefffe07ef81e8ea239c6ebe0a4449df63d01e95476138d9c58ef26",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0010",
      "source_text_sha256": "e1a44358bf51b510992bd297426347153a31b67de2071ddc36344536c80923d8",
      "translation": "“不必要的打探就免了。\n　作為特務部隊，我們的行動全部屬於機密。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "72cf0dd60dda1eeb6c7874123201ad326af2f249fb8a4b580a8597c74beeca54",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0011",
      "source_text_sha256": "35701008d0eee2b5df6eea2e552fc028b8b060532191da59f38e6529f861b95a",
      "translation": "“失禮了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "34e919330c783689156e1ebedcc509a8a1625383868a226a28daf07c1f3bcd11",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0012",
      "source_text_sha256": "bddd21f07527444a01c8dad03ce19db9276589f5b44c8c95c9a7dcdbf194f5d9",
      "translation": "“不……該道歉的是我。\n　雖然所屬不同，\n　但我剛才對友軍失禮了，在此致歉。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b6885ab30acf30b23e7a14451ad5711fe33b95d322a4b38da272739326e69ab5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0013",
      "source_text_sha256": "1a39588e33486716f009e6394378209a22c70e6938e641f1b6ff137e98c24b91",
      "translation": "“不過，\n　不愧是傳聞中情報部的精銳佛羅斯特兄弟。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/frost-brothers"
      ],
      "notes": "",
      "zh_hans_sha256": "6341967e5ca145924f92654680ca3a04a3051f514512de0019194cf9aea75ab5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0014",
      "source_text_sha256": "c9341aee774d06d5f1d297e918b50956902d8e3bb9da3fbc1c409382a5a70569",
      "translation": "“身處那種局面仍能準確完成任務，\n　其精神意志非同尋常。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6c8f4dcf43c21882bc4e07c0dac2e038f20258e68f3c7598dd99bd1b4f8c7210",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0015",
      "source_text_sha256": "588eacab0a825e1b62b45becdc30f3a0ff82f3b93223128f27821783b1ed4b46",
      "translation": "“小事一樁。\n　是弟弟引導了我。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4e0b8b0d033690634d0d635205c0a091ac3c5d9cb429a92db795ffb9dd10f4d2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0016",
      "source_text_sha256": "1b0160ef8e21b3aadbae17e16e351a75ce792892074fc54523b898211b9ee535",
      "translation": "“我們兄弟無論相隔多遠，\n　都能感知到彼此。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "007154df217daa44aa0fe22371a13042b904e9514ba8e0441c534e6620150773",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0017",
      "source_text_sha256": "00ed604b42a9315ef27a2bc53a604065807edf4fcb87f2f5c28be6e08e8a42b9",
      "translation": "“是、是嗎……雖然不太明白……\n　那麼，我們繼續執行任務。\n　你們接下來打算怎麼辦？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8ad4daf3cac1a21fa229e1f46cc84b052ce60bd3160c68f86277873d0f80c928",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0018",
      "source_text_sha256": "1ea510dac190c210d137cbe0fa3543ff3e14cbc7094bb25c7c598c276f9547de",
      "translation": "“我們的下一個目的地是佐達艾普塔。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5a47801a11b8c0e1b34408d8edf49f395fc6b2324829b9a277e218b571a856ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0019",
      "source_text_sha256": "1b55fe14096722c7530a101accffe1360cd2daa3c68dd31115a23e3a644bc93c",
      "translation": "“祝你們好運。\n　有機會的話，再會了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "25f635d7397d8be824e0fffec0ed15efe4fbbb99343f01503e38ea4515636331",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0020",
      "source_text_sha256": "a7d6c080bfad76a70aa56ac0fe7bc3d7d6e55a63c692e247f1b0f213b799fa86",
      "translation": "“上尉也請保重……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "7d0858c95e69c279a270ae43fd030ca7e891d03a9117631118cbe22aa97be613",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0021",
      "source_text_sha256": "5b9d8187b2f1ef11a628db72ce7aafb43d051033829ca2716603e0f5e7351611",
      "translation": "“……大哥，你剛才可真是低聲下氣啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "af0920e1cb2e5bfd613dde04f3e8d0a40827e45f080343700b14c7fb35b6d6c0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0022",
      "source_text_sha256": "f0c1a6117aa3f9172ed54abc27ae680722d05c2d4b35f984aafeb72706b634b1",
      "translation": "“他是杜威·諾瓦克的親信。\n　給他留個好印象也沒什麼壞處。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。",
      "zh_hans_sha256": "b114fbabab1f99a177a33ed84aeadc6f58fee4055f81e905b62cc53cfc2cf32b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0023",
      "source_text_sha256": "80f7a826500ce9750d1fb73aab82545341b6a056a3f54b5c66903673e6dc368b",
      "translation": "“不過，杜威·諾瓦克似乎對\n　我們的行動有所警惕。得小心點。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。",
      "zh_hans_sha256": "d84d6f6d5691b217f6ac827abb44d54ee8b5fb9743dfba857b1c5bee13c5a515",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0024",
      "source_text_sha256": "6dbb295b43f241e17cdbfc01e792825d6475420a9b3214b20abaab4e15152e63",
      "translation": "“正因為如此，通過合作來表現\n　出順從的姿態也是必要的吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2b94d051ae1fbf14f03fa179af7164a20288e506af701d0464059aeac03afdc4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0025",
      "source_text_sha256": "08e33717856da37584d7f35277ab01ade908e402937ec4354b31d9c6db04a057",
      "translation": "“而且，別看那樣，\n　那位上尉閣下……比我們年長呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "zh_hans_sha256": "50ce44dccab3d06c0e5b51c192aa947ffbdf8486ff2be5c27c2756066a0d9579",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0026",
      "source_text_sha256": "ac3bad60b6848827624a58f49c24905d080dd16e720740ebacf52c8179b71922",
      "translation": "“……這可真看不出來……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1e3dfc5168574789a26e7cd8917a08e127ee8e613f0cf7d4cc932b1628e5d8d0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0027",
      "source_text_sha256": "649cd567946feb35558f1ee537bd6bdb81349e125f246f60c8053535bfa54e0e",
      "translation": "“不過，多虧了他的協助，\n　我們達成了目的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "af7e85a3e1626cdd258eb0aabafc88635a9eb3101ef05a83e35818671cfd8ca5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0028",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0029",
      "source_text_sha256": "8cb4f67aa62a9490f3f1221d3fbfa13d37ad2311ad35bcdb7583eebf9e2d77d2",
      "translation": "“歡迎回來，蒂法·安迪爾。\n　你終於回來了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "3e7eb5facef9f94822ec19dee7995129f58510e2b429feeed917b267de5dade1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0030",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0031",
      "source_text_sha256": "cd9d0c8c82e9283f1b57bc868b067af10d0be37a7fecd7a7fcc529c8bf2050bc",
      "translation": "“眼神裡充滿了意志。\n　你似乎比以前更強了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8746fff81fda9174c35f06324318ce53ec4e6e15f21c4c954292b22d7abd9c10",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0032",
      "source_text_sha256": "0564e099360aaf22078b889e45598c1073df1f8f4503a523e91c8b6d81d6e498",
      "translation": "“給予你那份力量的，\n　是那個少年……嘉羅德·蘭吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "17c66f70ff615a811f0fc5bf5244672a4c5568f4966f829d24441653f2250409",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.01/0033",
      "source_text_sha256": "c3cd86bdca0cf3c80abf18d55bdc91cc2ce3bdf34fd193a1a69e0bb0ab90f3e8",
      "translation": "“你打算拿我怎麼樣？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "30bb006d8f3c16610981d94ff35975a30c5b4bc9089fc464fe9d701fc8f89f33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0034",
      "source_text_sha256": "6e684f0a34561eb84035bf9fa29e4430ff0ade23f5a7f9577d33fc626b3d49a4",
      "translation": "“和之前說的一樣。\n　我們打算向命運復仇。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1433b4d9381b70961bb38686e62f86c35081aafcdb0a05ce0cd1f6cc60d8b8ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0035",
      "source_text_sha256": "a7cc173f5a4afa81aab0e6beda1b172f2d8c9330c272c8e864b6a874796cff60",
      "translation": "“為此需要藉助你的力量。\n　首先有件事想試試……\n　跟我來吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "37386a1987a2ab3d8f1d8bd0017c38d78f8674a9df94d6d89e2944b7d73c2048",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0036",
      "source_text_sha256": "ec56324b1419845d93bec017275f6fbb8a74ab4b2ba4d94ccebce306f0abb1b2",
      "translation": "“在羅蕾萊之海，第十五年的亡靈正在等著你”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a39bff4e9ad929f465926f057de59db9d8c8eb0fcffee051c38a869998c1e0fd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.01/0037",
      "source_text_sha256": "7b31712e7819b56744b988e78ac70c67ad9920100c709bda0ca4532e980f90e7",
      "translation": "“第十五年的亡靈……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "215766d8346f3cfe9989b30b928519201f54c4036afc1004ac97ca4fc8caecd9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0003",
      "source_text_sha256": "0d60438c2f0ecc0c970352152bbabfd46e1d4e81a88d342e110c429e9ac3aa6d",
      "translation": "“不過，沒想到在那場騷動中蒂法會被擄走啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "73c9d18af952e707ff437bde48ec442760166d94f3634171a19389eb8cea1697",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0004",
      "source_text_sha256": "8de02f9811f1eab8f7ca704ec3ff775b3bfa53ad5323448d04880729cc3a4273",
      "translation": "“嘉羅德……他看起來真不好受……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": "",
      "zh_hans_sha256": "04cbcf436d3cfbcc02b9bebebfaab17438c300faa8dbbfe5390bd77de84f36fb",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0005",
      "source_text_sha256": "93d089f379e164312d6b8fba85138bb38013cc7b0df57e955f3b5fb83cb3f6b5",
      "translation": "“擄走蒂法的，\n　肯定是那對死纏爛打的兄弟。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "07a1ab4b140c33403f57e816b9f05e7874fad8ff0c0c990299871ef7d15ef9ae",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0006",
      "source_text_sha256": "2ee78dd9ad95d28e30ffb2831863cb9a6e17a87d149a15eb537672e42555ac8b",
      "translation": "“那是誰啊？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7dafa9dbecbfff9b56e9fb439a35659e63518c036473527a6739b90ece8c9a5c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0007",
      "source_text_sha256": "d97da4a3299a39dc47ca77b85db61a64405f1ed1c1ab5c13c859a6ddc4da4736",
      "translation": "“夏基亞·佛羅斯特和歐爾巴·弗羅斯特……\n　通稱佛羅斯特兄弟。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/frost-brothers",
        "people/olba",
        "people/shagia"
      ],
      "notes": "",
      "zh_hans_sha256": "02d955a4c8cddf63e8113e43a501c9ca3dde5693d556e58286a25ed8bb1b1672",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0008",
      "source_text_sha256": "12a2af6f1607119f7a04bfafdca6fa139ec43b5eb0f4693c2c76f49c1c1da1ee",
      "translation": "“他們是聯邦軍的特工，\n　據說想要新人類，\n　所以盯上了蒂法。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "skill/newtype"
      ],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "8b59c66f3a35dec18aefb8c0096946fdc5758202e9ad64bd6cd85d7dac169973",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0009",
      "source_text_sha256": "55e73baee687404f67584b0655c8f369505ac7380938f7d83b9ce6a1bb5cf406",
      "translation": "“可就算知道是誰幹的，\n　不知道他們在哪兒，也沒法追啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "230f9f9a6fed30cdc00c8e6cf79ed4eeeed7982c8295b44477b40ea78a55fe30",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0010",
      "source_text_sha256": "80069cd53977e32f8e3056c55dab46ecbe8daaff1253b9e936dd525153de4d07",
      "translation": "“喂，明姬……\n　埃曼的情報網不是很厲害嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan"
      ],
      "notes": "",
      "zh_hans_sha256": "06844bd671c3e1d6898657579076579d6db2e0fce5d93f724f85da5677aa5cc1",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0011",
      "source_text_sha256": "0598ea0c54198fe709e853490bef7a941615d51bdfc673cdee5e82be10bf5173",
      "translation": "“嗯，是啊……\n　獲取最新消息的速度，\n　UN根本沒法比。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "54e095894be3625423d5727e58293e966ca15816bee684a84cf1e945f5f21338",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0012",
      "source_text_sha256": "ed5fb4bf2a5baf82800e71706e9579c3b65de2958e9026b1dbb74690e09f457a",
      "translation": "“那就跟其他隊伍也打個招呼吧。\n　問問有沒有人看到過像蒂法的女孩。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "e87f44c440d460ef616084b2fcd6221b2e7f86a2906c9237cac506fccbd0205b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.02/0013",
      "source_text_sha256": "02dbc6977a3dfb2c36061fb4f1960816f585e26a6c84ce27cb8a73098ebbedfe",
      "translation": "“明白了。\n　那我們去這個城市的市場看看吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8d96421999c392e913e32c29a2e130b1e0e3ae9307e9a83fe980d1512b326341",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0014",
      "source_text_sha256": "2af59ea0362d73efd4ad6aeb100d7af7f5d078c0587f733765000198e7777478",
      "translation": "“說不定能搞到情報呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f79c80be7778b953b41ad592a1d1d1256602871f9747ee931452f3fb63382b3b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0015",
      "source_text_sha256": "6b18fb09f697305f65d03e018210e30d856d13c39c80bf1ad13581736d9a94ad",
      "translation": "“那就這麼定了，馬上出發吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f0354bb15d847b4ab34028a599afa296989fd536e592ba6428e7e129f976ea14",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.02/0016",
      "source_text_sha256": "c54a3f6267d628a3113bb66357b5e963ce5828642de9dd6e36a6f24b4dff4b1d",
      "translation": "“可不能把蒂法多留在那對\n　蛇一樣的兄弟身邊一分一秒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "2d9d008917f4ad0050cdbddfb53a168996cc29c441bc4dcdfff170fe06393c8e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0000",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格羅瑪起居室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/glomar-living-room",
        "unit/glomar"
      ],
      "notes": "按日文源词绑定统一全局术语：place/glomar-living-room。",
      "zh_hans_sha256": "26f85f43d2e6b08e51ee90a341ac6a2974599aa2b2ef33240c162202c545565e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0001",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格羅瑪起居室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/glomar-living-room",
        "unit/glomar"
      ],
      "notes": "按日文源词绑定统一全局术语：place/glomar-living-room。",
      "zh_hans_sha256": "26f85f43d2e6b08e51ee90a341ac6a2974599aa2b2ef33240c162202c545565e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0002",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格羅瑪起居室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/glomar-living-room",
        "unit/glomar"
      ],
      "notes": "按日文源词绑定统一全局术语：place/glomar-living-room。",
      "zh_hans_sha256": "26f85f43d2e6b08e51ee90a341ac6a2974599aa2b2ef33240c162202c545565e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0003",
      "source_text_sha256": "8a5da8e46d0e1d118afe95d7fb7564d18ac92ea0cc9850aabb63b52c76c02ad3",
      "translation": "“……那麼，找到蒂法的線索了嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "f738d7fc9c8b48854cc91165f6ae6e3c07561241046a69e86811890ab7e2bd28",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0004",
      "source_text_sha256": "2fa6c1ed940f465bc892b03213d18dff4ec1427ef511be54b11c1c1d0cc2f835",
      "translation": "“沒找到什麼有價值的情報……\n　不過，\n　他們說一有消息就會聯絡這邊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "11075cd11139a338973b169adb9db8f0bac59e2f6b2c3b4a6fbfda4e4da6c617",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0005",
      "source_text_sha256": "a4f20e23b75af8b26207311dd1ef1d897c2658e3bdeb6ac0b80291d544aa3b2c",
      "translation": "“明姬……這張影像光碟是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5dd3ab7de1a580f587c4a0625dd22a0ea5c7d1a809e2ee7cc96ab09ab9f8eab5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0006",
      "source_text_sha256": "9a842d9c83525fc339e3fcbd7722f60d1a95e0d64cb6e7e9202e06a39064866c",
      "translation": "“在市場上弄到的。\n　好像是在一個叫香港的城市賣的，\n　肯定是好東西哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3fe5449cfd4e25b8280f87d1b0999bcfdd91e3d040089264c1c129859c1fe4b5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0007",
      "source_text_sha256": "26eb7bd8b6bdba9367a60c9351081529f44e29a83ba1fcb8a308369a88eb7199",
      "translation": "“你看……這裡還寫著絕密影像呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "055cc8f0d8af3912a82598c19ddf41aa3211e3aa637afbdfecde7e53207d42b6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0008",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "865d63abd8eb3dd136c31e105c5697e679a2336a4c9049292ceae88f833f0ce6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0009",
      "source_text_sha256": "cc7e2d6f421393bb37de010d598b2f95bd2fec7686fd25eb367f0d5e0d0cb921",
      "translation": "“快播放看看吧。\n　我覺得裡面肯定錄了不得了的獨家影像。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9226bc5da2d590243d64ce0f81ab15e66327aae0cd4e6989a2e420e3f0a4b7f1",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0010",
      "source_text_sha256": "a002099f2056989d4f880efa8366fbd19381d729d837021313b2e0659342a36f",
      "translation": "“說不定記錄了傳說中寶藏的所在地呢！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0a105adf84f8a39ad2a300bbd7dad62b6023c677c409d39313ec964daadb70b2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0011",
      "source_text_sha256": "51d93adc95713fbf7ea76196e822e62798c70aeb03c3820628ad0680cdd1d913",
      "translation": "“明姬小姐……\n　那個……那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3dd0e474eaef9ff18442a690881d4645e2f5b13ec98db64f0c359dfbb1750c93",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0012",
      "source_text_sha256": "5f93f2a632205ad1145d94baef8737631242fbbce3c1db562b623d0abb3a58bc",
      "translation": "“怎麼了，大家？\n　對這個影片沒興趣嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "24ecb3eb2bebdfad430c7fb8c3800dfa36ce2f1832b77e2a0cc2bb222aaa2318",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0013",
      "source_text_sha256": "76fddacdadc25fd337175536533865fecc93db99b32c56f81978703a4fdc9eba",
      "translation": "“這個嘛，我們也是男人。\n　不是沒興趣，不過……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "17ec761b35ea632796e3af6eb0fd4edef90f59e47640c123ed4228602c13aa5f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0014",
      "source_text_sha256": "605068900e7571fdda36f4c13edeeac004ec16aa95632a5cbaabbbe09c3d9035",
      "translation": "“托雷斯和薩埃格薩也說過，\n　香港的影片好東西很多。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“萨埃格萨”。",
      "zh_hans_sha256": "e520b6a3c82c099c6d8273cd63d02d24ac0caae9cc1dfd77aa6229bdc00a8f78",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0015",
      "source_text_sha256": "5d7d12ca213aec6780689a85bd46f917f086fca94bd637bb47793e3b86cd0496",
      "translation": "“那倆傢伙……該不會是這\n　方面的發燒友吧……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "85b42f45b856e6cf7bf361416484ee621c33abc63cd2ac09c48a288b1340fca7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0016",
      "source_text_sha256": "6309a85a5a82a5b133965ad3d6fecc1314353df63618202a1457e744b9cd3582",
      "translation": "“總、總之，明姬小姐！\n　那個影片肯定是好東西，\n　別拆封直接轉賣吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d998093c32488e1024e754327eb7972c43ca7aa25b53b517c0edf4e46f4a1bca",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0017",
      "source_text_sha256": "4852e3d385d9e463768964091d6fd13c5351a2b833e53e47f8fb39dd5f652b94",
      "translation": "“……說得也是。\n　還有蒂法的事，\n　現在不是做這種事的時候呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "f2a85befb50c7e26cfa061dea60dade55cc64e93ed4361dc38bd36e0939d0d03",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0018",
      "source_text_sha256": "fe58f7b124b072fbd97523bb3a4c3adf62bded783ef150d17de8ddb91357261d",
      "translation": "“那這個我先保管著。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2dd84509b40b4e3e3627224ada56216ff882f32abbcdc87ed9f7081a7ed22af0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0019",
      "source_text_sha256": "a180db8c1745fd7cd4da8649d2989fdf7b76dd5771bd8222426bb4c987597fb7",
      "translation": "“OK……保管就交給你了，桂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "",
      "zh_hans_sha256": "48fd0389bd1c652c874c06bcae582e6e9d93631ed70d1ab8ce2dfcd8801208bd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0020",
      "source_text_sha256": "1ef5fd183810d37217011830b67c6ba3ace5a76e0b840ff6f42e3c91763c4084",
      "translation": "“桂大人和$n大人……\n　笑得好開心啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei",
      "zh_hans_sha256": "07891464e604c9e6c2927940dddba240bad25892a95d61cca05aa0a307190475",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/074/dialogue/01.03/0021",
      "source_text_sha256": "9bd4aa6efcb74b205ed5d4f62fd668bcb0986a0e4a0019df52806a5f80a2678c",
      "translation": "“不……現在先找蒂法要緊。\n　這個先放一邊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。",
      "zh_hans_sha256": "53a4b85af26793949e874616c6a9813bd2fb0117bd2534e3bab4c484bbda5467",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/074/dialogue/01.03/0022",
      "source_text_sha256": "4fd72f102fc111ed1fbf623956cdedc111a6adff28f688a365058b354824e8dc",
      "translation": "“嗯……無論如何，\n　都得找到那孩子和那對蛇兄弟的線索才行。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "88893e929c6a48b16dcaebde0148aed8456a26c134ea70369fbef07c97481a56",
      "zh_hant_status": "draft"
    }
  ]
}
