  "entries": [
    {
      "id": "story/152/dialogue/01.01/0000",
      "source_text_sha256": "6a5e4a56fb5c59ea6d6960fec5017795e389862e3fb3e7d1371a6f57a476384b",
      "translation": "“不妙！\n　那個女人，打算對司令簇下手嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/command-cluster"
      ],
      "notes": "",
      "zh_hans_sha256": "15e5b2b9dbcd509dbbc0f6fb37f3264fe32852f7c876519827a957c876baf3e7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.01/0001",
      "source_text_sha256": "55e0d60cde46571bb5387d71369129f4fe41e247b5805e5795fb242d411369d9",
      "translation": "“看著吧，$c！\n　我要把那小丫頭變成司令簇！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/command-cluster"
      ],
      "notes": "",
      "zh_hans_sha256": "8c37dc30cae67081102c251e46291fcbd699d7cd3566e8eaaca9c920207b03c6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.02/0000",
      "source_text_sha256": "3f86e85610929f8a3e816b9c14cdb339f8ca23112a3fb5b0ec2ac90e210c3901",
      "translation": "“優萊卡——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": "",
      "zh_hans_sha256": "7bd72f1e05c6f787aed403783cd2cb55a8006126d535a07573d77ae87933b367",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0000",
      "source_text_sha256": "53b1fc7f59eb4b3784b7ef5ad6ea893299d7213b8f507e94a9390bb29ef46666",
      "translation": "“次元邊界線在扭曲！\n　時空崩壞要發生了嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/dimensional-boundary-line"
      ],
      "notes": "按日文源词绑定统一全局术语：technology/dimensional-boundary-line。",
      "zh_hans_sha256": "bb1357d52e5a39c33243d49cdfb048d3c2a986fc9f3d4201a62de13ed57f8b43",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0001",
      "source_text_sha256": "83e1bad000d6dd8db8c44c07596ae8a9515ef516326c263f1b0b96cd5bb8aed5",
      "translation": "“動手吧，桂！\n　只有完成時空修復才能拯救這個世界！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "",
      "zh_hans_sha256": "7358026f0072549cfd3097fadf5591a650665799131aa1ac3ee604ae0a144d6f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0002",
      "source_text_sha256": "b55ebea7231cb279e0c5cc3ccafbecc8452d4ac70ee32a645cf9cd636c1c13a8",
      "translation": "“可是！\n　這裡就是大特異點嗎！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": "",
      "zh_hans_sha256": "cbe56ced80192a79a5c0597071b9a4378fe1576592ae911fa1b128d8968c620e",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0003",
      "source_text_sha256": "94f189eff3649e4fa6ab69f5e3872a83588ba3354ea0f6eae9211edebd662f0d",
      "translation": "“已經沒有猶豫的時間了！\n　這裡確實離大特異點很近！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": "",
      "zh_hans_sha256": "0d56234d3dadba255b7810b126bc2bd176e0a852740d206c4e46334668ead3b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0004",
      "source_text_sha256": "7d14c601b691d42e02e836553d11a21b44a455419936dc191b1516c8a1a2731b",
      "translation": "“但、但是，優萊卡她！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": "",
      "zh_hans_sha256": "a2271c6d1ea04d1e0b4f2f6b890aa7fb22363be9082a9ac69aa34b3c09c6bfe2",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0005",
      "source_text_sha256": "9979a5d6b5f7ac5139dce9c4c2d9fc72bb1319d2bcc38c653631b51e75fedb57",
      "translation": "“蘭頓！\n　集中精神！\n　現在只考慮時空修復！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "073a7285671584e361bbfda024dc845caeaa6907e6402a4722dc55062ac80f11",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0006",
      "source_text_sha256": "8fd61e760b8e701fc670329b6121827ff0e52e96734e2dfce58b3b64477dbcef",
      "translation": "“可是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "592c4b6e2563cabd0c2b4131dd0937d8d366e39fb1b41977d3def0d3fb81c377",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0007",
      "source_text_sha256": "00733cf75a482ef470e0e75e7d383d6975b5cddebf7df8156c65b3f8557eabe5",
      "translation": "“我們所期望的世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6054f1eadf6f3e0409dfb5a95f86a8a7f179f399812056753e320cc91b61cc46",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.03/0008",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "865d63abd8eb3dd136c31e105c5697e679a2336a4c9049292ceae88f833f0ce6",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.04/0000",
      "source_text_sha256": "237a321d2fcfcd31452fe7a4ddd29ad73bd7527b5348f7c0cc47754b59f973de",
      "translation": "“來吧，$c！\n　盡情吸食人類的醜陋、\n　自私和懶惰吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1173e1ea404a07912219439de3ac258f69e34e9763ad337b618f783c471dc912",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.04/0001",
      "source_text_sha256": "d4328836ee259d7f1d8ebe31ac1e98db1720f8e690f8c30f736c1c61071cd5bf",
      "translation": "“黑之卡里斯馬！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。",
      "zh_hans_sha256": "836883142ec744fb0aaf17e8598a6e9371cde3e97f1c84fb8d50f5315443de01",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.04/0002",
      "source_text_sha256": "e3f143f224b67e0c766bda37dae42497467a91bdaa58066d06988abb1772c7d7",
      "translation": "“然後，拉開帷幕吧！\n　新混沌世界的帷幕！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "68d8d1a25d5e652f2431c4e953b0c2a3db7d8de8ce13a6db148c7aa2e00d0a80",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.05/0000",
      "source_text_sha256": "deff9560a8094a34fe0922d02b319b9b5d3b9a528a85e17e906c00bd6198259f",
      "translation": "“啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "7d623780a6a5f3993ce5b6cfbf4d3f57a7aa2fc3616a46b8d5153bd75fafb113",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.05/0001",
      "source_text_sha256": "2c4d081d11f29c822eba964d5cf6b09a95d8ff980fe73584b4110eb01760d361",
      "translation": "“來了！\n　全世界人們的思念都匯聚於此！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2ce00d9bb16e17a1f2ca46182bb51cc5f5e84aed4a286bc9800a22ae3426f759",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.05/0002",
      "source_text_sha256": "e7ca38ab4e5ae33138d5ef412ae9c1f7e4b3476536b0bb3c0a3941ade8222916",
      "translation": "“大家，祈願未來！\n　我們要修復時空！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "76261454d42e62edfe40c01972669f7ab2ebddd1037ff1e3e5612f7886676561",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.05/0003",
      "source_text_sha256": "a7cb3ad22ff9edb19b464a43b7010b0d3f42f65643114090cd75b363935dfe48",
      "translation": "“嗚哇啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "244a192dba34363296ad55c38bf204a5ec3d626d94e774737e26c47314b69f01",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.06/0000",
      "source_text_sha256": "237a321d2fcfcd31452fe7a4ddd29ad73bd7527b5348f7c0cc47754b59f973de",
      "translation": "“來吧，$c！\n　盡情吸食人類的醜陋、\n　自私和懶惰吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1173e1ea404a07912219439de3ac258f69e34e9763ad337b618f783c471dc912",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.06/0001",
      "source_text_sha256": "14e486da63d8f721794eb9a3c05c5e53df836ed6cc325248b2b90d48a51bdac6",
      "translation": "“是黑之卡里斯馬那混蛋嗎！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。",
      "zh_hans_sha256": "c8d475c94ef7b3554b99903cb480ed7416b14e85c4e0b1eb900cee3df8d0df86",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.06/0002",
      "source_text_sha256": "e3f143f224b67e0c766bda37dae42497467a91bdaa58066d06988abb1772c7d7",
      "translation": "“然後，拉開帷幕吧！\n　新混沌世界的帷幕！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "68d8d1a25d5e652f2431c4e953b0c2a3db7d8de8ce13a6db148c7aa2e00d0a80",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0000",
      "source_text_sha256": "efee1b199eb23c0427c1b17be2edabd8726f7b906e41f43d5fdc5fe1c584eeea",
      "translation": "“呃啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "37adb67cdbe3133ca2afe00b585e63ff7f6e7d9b8ffac4eedf9e21a926cfdd41",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0001",
      "source_text_sha256": "d06337b0e61a62cb6c606e75f6f737a1dfc6976440af09c40734ea75daf22347",
      "translation": "“怎麼了，梅爾！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "75f56537c3359a1cc8be767f19708cf6d989ec247b0ec538d53a2819c2a4ce25",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0002",
      "source_text_sha256": "f7402c7ed534ad668f7297ecbe5a588fb6d372b8378d97d82614ac908c871d4f",
      "translation": "“身體……好燙！\n　好燙啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "39d481a973545f88003190684dd55ace1f37ea15396a12096e7a5803366cd253",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0003",
      "source_text_sha256": "2c4d081d11f29c822eba964d5cf6b09a95d8ff980fe73584b4110eb01760d361",
      "translation": "“來了！\n　全世界人們的思念都匯聚於此！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "2ce00d9bb16e17a1f2ca46182bb51cc5f5e84aed4a286bc9800a22ae3426f759",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0004",
      "source_text_sha256": "e7ca38ab4e5ae33138d5ef412ae9c1f7e4b3476536b0bb3c0a3941ade8222916",
      "translation": "“大家，祈願未來！\n　我們要修復時空！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "76261454d42e62edfe40c01972669f7ab2ebddd1037ff1e3e5612f7886676561",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0005",
      "source_text_sha256": "5764c9f99b9e93dc86d04786064a6fd1d0767bc90a6080f6f92903462d62a51a",
      "translation": "“啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "977851bbfb456134aff5810370014bd8712f4b93476f7f94e59c96af3398c577",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/01.07/0006",
      "source_text_sha256": "1a4708d5c82c5542f9be63d46ee9b23f1cd53a720e10b27a012cda7d25bee66c",
      "translation": "“梅——爾——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ace30de540ef2cd30607154a261834031a76d1fdf481bc60aa9a55318eea615d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0000",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0001",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0002",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽瑪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "7f2a36d028735c0e4cd43aa1a5ce6668cc7b92e19b2fbd3f3d0d54270428d379",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0003",
      "source_text_sha256": "b8a4cf0e2cd30c397be08bf3e0226156a205ecb49cc85d1e1e75d0575853b1ed",
      "translation": "（……為什麼會變成這樣呢……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "0bcb71af2e3a84c2b5e86e7c6277833a3723b470e0f79db5b787d000c36d2fdf",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0004",
      "source_text_sha256": "c2286e0282682a3288094e424c90e0959a799e622b69cfdc833ff8e6944d1033",
      "translation": "（是因為全世界的人們都\n　期望這樣的未來嗎……？）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b0a6886ba83125aae9df658f63945fb7fdfd8c044618e2f9653f7bb07002e492",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0005",
      "source_text_sha256": "612133cf4b398afe85874788c9599cfbf0b1f5d6d53eaca83b7c43ad60220756",
      "translation": "（還是說，我的……我們的猶豫把\n　世界引向了無盡的戰爭循環……？）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "ee874f5ac24b010e6a950c6120d322150a3109f1d4cc7c54632b7fb54333c8be",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0006",
      "source_text_sha256": "310178d14b24e00633a1a18cb3604d4159dfd8281fcdc354dda2c9d0fe6a7fc1",
      "translation": "“$n小姐，該出擊了……\n　聽說超限惡魔又出現了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "3b2e06ded3790dfd05254eb32b5843d59ded4a18ba866fec1d3cbd4723e58fa5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0007",
      "source_text_sha256": "c9c016c1501f154a04a0443dd1e13fdab27673659655a8625f38b3ec88327206",
      "translation": "“我知道了……\n　我馬上就去……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3a61e50ae432ba64c0a75d25c71d89307dc7460c65a5c4207f214082551bb325",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0008",
      "source_text_sha256": "9cf616a6005e1536c7b925147fc962373ca4e19956b9bc9d85c971014f235b05",
      "translation": "“$n小姐……你的眼睛又……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c4faa42b457bcebd59bda63c10b0b4960c7b3c884fbf73461d8719da6e6d4c72",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0009",
      "source_text_sha256": "c9a39cbcb4ecb34a8334adaf682e9c071873a62444f64d23a6a83f9447ca2307",
      "translation": "“沒關係……\n　坐上巴爾戈拉，就會好些了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/virgola"
      ],
      "notes": "",
      "zh_hans_sha256": "b3a99de6ec86bdcd03e10c0dd3ad776056ec4c5a1e13cdc33c47d18786946ebd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0010",
      "source_text_sha256": "eeae1ee5dd94b2a96c2f0065fd30085ee3ff5c4431fbeb12eb11f1a63a61fd5d",
      "translation": "“可是……再這樣戰鬥下去的話……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5f131b2d313132c099d42df61b1d30b1906c9c7f0dde17d83362b26989cc1ae0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0011",
      "source_text_sha256": "12688a47d2217109062c5451a61c87f14450cda8caab9080e8c40d4e7e123034",
      "translation": "“但只能戰鬥……\n　在這個永無止境的戰爭世界裡……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8221870533c4b977d6db4f078248c5dd0ca00a60ab3e13423df28f238b290470",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0012",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "鋼鐵齒輪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "c2a62d6027374f1ea9989ee008729ceb8f8b62063631cc5a1fea430010cddb70",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0013",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "鋼鐵齒輪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "c2a62d6027374f1ea9989ee008729ceb8f8b62063631cc5a1fea430010cddb70",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0014",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "鋼鐵齒輪機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。",
      "zh_hans_sha256": "c2a62d6027374f1ea9989ee008729ceb8f8b62063631cc5a1fea430010cddb70",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0015",
      "source_text_sha256": "24fa157f3df3693cd09bbd7f4260c80a5ee6c59d6ece98bdcad2e06cad40359c",
      "translation": "“哈……哈……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "370b3bf2abbebfe03784902dd5a21abea7b22aed2e43f3cc2ea7f865056fe67a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0016",
      "source_text_sha256": "2e391dbd4f439849e39f526651a8de84beae6b54451793ea7df7e0af375b090d",
      "translation": "“你沒事吧，$n？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "fba1d985a97a2607b41e5462dbe398b355b0a9f26cd50f4145100c6e83a7402d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0017",
      "source_text_sha256": "c195112ebee3bdb0ce6a50df83b43c656e4cb7cac8a443707401a38143625a3e",
      "translation": "“累是彼此彼此。\n　而且沃卡加利亞也累積了不少損傷。\n　再出擊就危險了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/walker-gallia"
      ],
      "notes": "本句是对白中的受伤或受损语义，保留自然中文，不强制系统词“伤害”。 用户确认术语定稿。按日文源词绑定统一全局术语：unit/walker-gallia。",
      "glossary_exceptions": [
        "system/damage"
      ],
      "zh_hans_sha256": "3c38dd69705e73de87584b35e7d3a1f236c49ba5ff1a4c99422a86820c591014",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0018",
      "source_text_sha256": "9c2b590f5be8a639048303412ce1e16f5f62b334f3ebc7677e5282587cf0fc1d",
      "translation": "“但必須戰鬥。\n　這就是這個世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4104aa5d9fd949cd683e2a40de82bd2fa67c557b622c2db3e7252c0dae9e81ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0019",
      "source_text_sha256": "715b15ad592e417270165bfe65186b1632215c58bd471088ace6165337e0ca63",
      "translation": "“……為什麼會變成這樣呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "f15e350b42e47c07b3ec65e71e28fdf9940a2769dd46d4eaf2a4a5f33ba7b1b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0020",
      "source_text_sha256": "5153cfb6afb7dbf5d9c06974793efc13ca8aff3d08aa34d07dd38d901a8a5f9a",
      "translation": "“全世界的人們真的期望這樣的未來嗎……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "475c0f60d78d3da7ee22ca0f13318dffe69444145db4da8ec45113dee1281eb5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0021",
      "source_text_sha256": "b1b659e596e7b406b04874a02a8c7c8de882924d79c689cd33a4fac1b4eb812a",
      "translation": "（還是說，是我……\n　我們把世界引向了無盡的戰爭循環……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "33ca02be6253dd6c69efc0893788cb4f50c2d3722d74ae63d73a6b3df3ffb50f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0022",
      "source_text_sha256": "c7776b8a22123c93c6c468d378db1d244e4bd48208807514b7d4d3ba08fcfb30",
      "translation": "（喂，梅爾……告訴我吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4c6684d49e4b8b16fc8a58be700aeab4703d083e26d45f57c7e9450360334776",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0023",
      "source_text_sha256": "284d83aa484f0a5125ed5715bdfb5b732c246707de2921a4dfd4dc445b81f203",
      "translation": "“大家，出擊了！\n　超限惡魔又出現了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": "",
      "zh_hans_sha256": "374fe3bf923078eabc8b24ed7510232c99720f51740a0db92f5edba4c1a4d162",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0024",
      "source_text_sha256": "8113e1100261bb2ba0b71b8b34eb31c019bc344e4d21726f8704bdb9dbce6b29",
      "translation": "“請等一下！\n　再這樣下去真的不行了！\n　大家都到極限了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6de20539aa8bec4459e8cf1a50b072314906adaa95bc6e5409271d6d22964b22",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0025",
      "source_text_sha256": "1a908077ce6532dec25ddf1c4f573ef9507a0efb712c6cb381bdf227324b3304",
      "translation": "“……我去。\n　我得為毀掉世界贖罪……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "46d0e3ad400068f2803e72e7dec6da44fbea576812d119a66c3e68cf920d82e8",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0026",
      "source_text_sha256": "4e27c74c702c0a6b435fa45222ad6cb2c26607f3fb872142c9c2c0bfcc1d14ef",
      "translation": "“$n……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "844ab2dcd2d8f957ea162c9b5cea43a37b49fbd052f1414b7e32532f5eb06935",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/152/dialogue/02.01/0027",
      "source_text_sha256": "42134915402824d56c60b94a9ae9274d4e3ca3207dbbde84852024c76852d512",
      "translation": "“……可惜，看來我果然還是那個\n　THE CRUSHER啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e4381d1135d2c8d8cb575be578f7235883d948cfa04d3a2dc8e38e315925e073",
      "zh_hant_status": "draft"
    }
  ]
}
