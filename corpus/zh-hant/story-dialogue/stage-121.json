    {
      "id": "story/121/dialogue/01.01/0000",
      "source_text_sha256": "4b525e2f791b43b37911b90e6ff31c885aed0fbb77d11e6854972ca96e869d28",
      "translation": "（真……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": "",
      "zh_hans_sha256": "65371511c8481b99a65fbd6b4b25eecf47215a884087b62f83050bad44a9a57b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.01/0001",
      "source_text_sha256": "8770b5816929376a7e378b35300120d9920c7bf226f3210e445742122f9693b5",
      "translation": "（卡繆……大家……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": "",
      "zh_hans_sha256": "c3b8954261be8a8dcc0a7600d2d7fae2a78bebe3b98ba3678e19eeed7d9f6bff",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.01/0002",
      "source_text_sha256": "a191c8b6f27acf23590d28b24e9ac81dd8df4e2acc9bf8646981d26ede414533",
      "translation": "“引擎啟動。\n　我們就這樣升入宇宙，\n　與扎夫特本隊會合。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "d32f45cbea00c3de41247dde0471ed42bf44f8c5f8a52227b945bacfb10d9f67",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.01/0003",
      "source_text_sha256": "37d1bd4a57e324849a0c31de0a33c2058ff1e83b1d62d75cf22df73ac642ce80",
      "translation": "“明白……！\n　密涅瓦號，出擊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/launch",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "ed979fb4a643748b33ee0e7611ad7233c74850968bc4749606e9554fe38d075f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0000",
      "source_text_sha256": "eda2e562ddfbc485fd2ededec4622e4922a0133566da6b455a93aa4ee6ffd880",
      "translation": "“走了啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5c49b2097c8f87155dcd206186db34f5b194f2c7a5073866fa02285b0bf1e1ab",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0001",
      "source_text_sha256": "31327d9352aa2b49f435ff44401de2c5cf42cad524666f6d5e86ae223464f3b0",
      "translation": "“她們自己選擇了自己的道路。\n　我們無法阻止。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b2651926fb3a8d9e09928dc0a0cdcfdadbdba750147613d679a62fdfa4b1681b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0002",
      "source_text_sha256": "720a34d04cb09261118968ffa3cb79b6b7461faf2942069b2d0f7347fe60a6ba",
      "translation": "“但是，\n　說不定我們……也會變成敵人呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1072731b25f3146def6188a2e2237118fa5e83253deeb43034a028e3a96c1a62",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0003",
      "source_text_sha256": "eee0f3377a34a9662cc7cde6721a9a213d9893b72be697d219d67e47368dc9e6",
      "translation": "“希望我們心中對議長的不信任，\n　只是杞人憂天。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "787800c3d49f6f4dfd00ba8c502d9f8f59f7b3103dda49b2088bb529a90318b5",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0004",
      "source_text_sha256": "f85ff6869745235a05ed580a65a01784b26b4e4c947444656f759e7f7f9afe64",
      "translation": "“而且，少了密涅瓦號這份戰力，\n　我們也必須前往月球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "c647f6150882dafb1e00b8e3123649a0db0ba0a0746adfbd9d57dda4d12770c9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0005",
      "source_text_sha256": "24e971bd329714d576024b3fc7bea654745a3ca393922b0a44370048d29b4640",
      "translation": "“月球……LOGOS與骷髏月聯合的據點……\n　再這樣落後一步，\n　就會無法挽回了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:official-logos。",
      "zh_hans_sha256": "e2bf08232b81539aaf1cc609ef333d69cc5a99dcfd6a6c36114e0b0ffd4b24d0",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/121/dialogue/01.02/0006",
      "source_text_sha256": "3b536743bf7699efbe4bced1aea7b163961b3aafdbe41595d2892e072d7af329",
      "translation": "“在那之前，無論如何都必須先擊潰他們……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5dbbe123d847554b36c77eead4297d5e386fe97a07c783fc7f276327aa14ff96",
      "zh_hant_status": "draft"
    }
  ]
