  "entries": [
    {
      "id": "story/051/dialogue/01.01/0000",
      "source_text_sha256": "a27d56538cf9aa51e2770f8a05c302ad8a3bfd1ca6303a574c7ccf75dbd73f6f",
      "translation": "“各隊，向前推進！\n　無論如何也要摧毀那座炮臺，\n　從這裡突破！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1b9823ad4644049add26cdbfc79ef7b7f6594c26a324619b6858cf94c9c2077f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/051/dialogue/01.01/0001",
      "source_text_sha256": "4127a5b5e0f7589c8d0741598fa02cc4931c3d16f5c215fa1e97ad1d21ff5eae",
      "translation": "“菲爾少校！\n　炮臺有能量反應！\n　要來了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。",
      "zh_hans_sha256": "923ea0cd50c0c2347e983bacc3539076f83bbb1ecbd4a9c2ad702aae7b6adc16",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/051/dialogue/01.01/0002",
      "source_text_sha256": "4a922dabe09eb986666efe722936a0c30473f2bfbaa874de9552926a47aa12ae",
      "translation": "“迴避！快！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": "",
      "zh_hans_sha256": "bdcb8341939d12cb49a0bedf0bd6bdeba3f578aa04e52689c8ddb73df4e268ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/051/dialogue/01.02/0000",
      "source_text_sha256": "c87e4f330a482e878622de0781c35b51ce19e4dae52db12df6f8b717be6e924e",
      "translation": "“不、不行！\n　暫時撤退！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c582d1f042fe52c9eac0778ffafab39346f2d4057d04188a2e03b46cac69ee33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/051/dialogue/01.03/0000",
      "source_text_sha256": "209c4a479bf48c24d4515b8810d330a8d376f3387e3063b9ebebc1a0d93e8355",
      "translation": "“迪亞娜回歸軍全機，\n　開始撤退。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/diana-counter",
        "skill/counter"
      ],
      "notes": "按日文源词绑定统一全局术语：faction/diana-counter。",
      "zh_hans_sha256": "5e878dcdb2590efd588bf60801613b5fac8efcd8ae19dbc5f563b09895535340",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/051/dialogue/01.03/0001",
      "source_text_sha256": "f0c1646ed660a7d4d2418af7b4893ac2e295c8b73f93eae0bf97b271ea4cb270",
      "translation": "“不管他們集結多少兵力，\n　都攻不破這裡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "70180c37f2307bc45594434f78c1edd35e26a2cb1133bbb6bbc75f7b013f1edd",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/051/dialogue/01.03/0002",
      "source_text_sha256": "aef3e6f443ec6face08ac3ced34e6490af92697dcce93e81e589c293ca676885",
      "translation": "“只要我們的羅安格林還在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "eaef98082f31dbf095dca2bbfb115d2a35907c81b1eed63c280a2bbab436e96f",
      "zh_hant_status": "edited"
    }
  ]
