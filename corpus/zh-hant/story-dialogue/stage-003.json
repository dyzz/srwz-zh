    "stage_indices": [
      3
    ],
    "entry_count": 36,
    "unique_source_text_count": 36,
    "translated_entry_count": 36,
    "punctuation_only_entry_count": 1
  },
  "entries": [
    {
      "id": "story/003/dialogue/01.01/0000",
      "source_text_sha256": "a61cfd12ed0c57f7fc4a9a7e825c031c56f0137d4355907aa324c19b70da06de",
      "translation": "“那些傢伙是地球聯合的部隊嗎！？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-alliance-short"
      ],
      "notes": "",
      "zh_hans_sha256": "e96a695833e8c8289aeb2251906314a894e90840335326583afb921e6cc50d32",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.01/0001",
      "source_text_sha256": "ac3d0c5f505ef8f2be8ab9b4363d53d8df3edc9f4f5cdd0efd742e6a74463364",
      "translation": "“不、不行了，隊長！\n　再這樣下去我們撐不住了……！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "432dc79631d9659069f3df98d0ed6a062719e72426abddcf821a38db239f46a4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0000",
      "source_text_sha256": "9c095416913fbbd375edb566ccb5c3e79501332d85a222c6ef5c3a8f231c6b60",
      "translation": "“抱歉了……\n　我們也有任務在身。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "42b74a73be8d1762223895dd8e9bd1743c29b5030143a4f66d097828e0b65577",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0001",
      "source_text_sha256": "7ac41c050d737e8dc722ee8f3612f62b32a4448bacd1b36ed7fefa5cf98cd1f5",
      "translation": "“上校，防衛部隊已被徹底壓制。\n　接下來只需回收斯汀他們了。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sting"
      ],
      "notes": "",
      "zh_hans_sha256": "b39c10678562c36392725e7cdbb8e93b0918378ef74ddec56af49d12fadd0e49",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0002",
      "source_text_sha256": "6d4604356088f32f99942485a7fff8d9df9b5b2c0463fc4cc985955e6dfda74d",
      "translation": "“知道了。\n　……那麼，他們能順利得手嗎……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "8aed126b96a7af14980b1e3d73dfa84471857f84b27af487b652ffc0ef019768",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0003",
      "source_text_sha256": "dcbfde0471804ddac7544af5796cccedab7029dcce2a0c058922a7d3d4fc197d",
      "translation": "“他們本就是為這種任務而投入的擴展人。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extended"
      ],
      "notes": "按日文源词绑定采用《高达SEED DESTINY》专名“扩展人”，与《SEED》的“生体CPU”和宇宙世纪“强化人”区分。",
      "zh_hans_sha256": "c52d175d7744b2745b2192759b0495ce18aaf79e591760dfe2022c07a17dafea",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0004",
      "source_text_sha256": "7a2bd29de4b41c49167085f9d7e44cd08684c3a5ca71f6e737cb621ad0763a74",
      "translation": "“只為戰鬥而生的存在……嗎……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "41cc6573636c071f870149f52524a53821d948fc528302a86d44a5cf0fb1840f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0005",
      "source_text_sha256": "c396fbe616ec2be4ac06a2c74289d3993576e824b9662b75587eb21a86ff94d8",
      "translation": "“尼奧·羅阿諾克上校，\n　軍械庫一號方向發現機體！數量為3！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/neo",
        "people/neo-roanoke-full",
        "place/armory-one"
      ],
      "notes": "Neo Roanoke 全名采用阶段术语表定名，并保持三行军事报告结构。\n2026-09-20 社区意见经用户确认，中文表达及关联术语已核对。",
      "zh_hans_sha256": "468bcdedfd1ccd0089f72b5986f3e5b31f58308baa1382ad477de5e33440fe74",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.02/0006",
      "source_text_sha256": "4b9c8a6b50197153c7b046fd1e8349e7c21f95d35326cc33df710096036b540a",
      "translation": "“來了嗎？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "96d4bb96cc32343d6dfc10f1c9d5cadd27be4e9c5492269de11d5ba7a99025b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.03/0000",
      "source_text_sha256": "93f19f0cc8f66038875693dc60fd600503d5f422e1cbd9114f20e6cc90c44293",
      "translation": "“這裡是斯汀，\n　已按計劃奪得3架新型機。\n　現在返航。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sting"
      ],
      "notes": "",
      "zh_hans_sha256": "d0dbf7d5cfd2de414fe7fe2a79576ea403894b0c92b1b4d143a82857e6eef4b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.03/0001",
      "source_text_sha256": "e8ecf38a6f675279db14db3a43ceb23c36d3694273c98d3b695f1980716bb361",
      "translation": "“確認任務成功。\n　辛苦了。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "9f400523770b7860638d3f4134ffe0ccb2a1f144b3141d9dea9b6abfb8009af4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.03/0002",
      "source_text_sha256": "9eba6b7aa57bf10671eccda405189ae6ff87044077676f73d7a727d7fed3bd9d",
      "translation": "“尼奧！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/neo"
      ],
      "notes": "",
      "zh_hans_sha256": "7af93190eae4c5f3a754fe759a091dcc9d5bf04b87e2d7867da2b6140abdfc7b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.03/0003",
      "source_text_sha256": "cd273539104d6544a9d34d51e9c1364655883dba84ad4a697c1eb8af9e0bc8d1",
      "translation": "“幹得好，史黛拉。\n　真是個好孩子。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/stella"
      ],
      "notes": "",
      "zh_hans_sha256": "5242fa68092441ea6132eb96c5965e37635afba7ef41b8726825783edbbaf05c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.03/0004",
      "source_text_sha256": "2b91e7835d95907bbc14c53b93a1d593f4552819fbb3268ffe1d141bb96e0e17",
      "translation": "“現在高興還太早了吧？\n　有礙事的傢伙黏上來了。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c5808b2fc64adbda0bb0e10a80554324a68c1d8f7a32692fd62d74d5b9cce83a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.04/0000",
      "source_text_sha256": "a5c5664e2a7250aecb5c033fdb2253b753123dc0bf15343ff5c66612f5910289",
      "translation": "“那就是扎夫特的新銳戰艦嗎？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": "",
      "zh_hans_sha256": "e648f8926f2903f6f1a1a2fb847bcb265492f7908fd3a2f1ee1bc33cf01d8010",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.04/0001",
      "source_text_sha256": "4941ef0948bba51f1f691559423a6ab9d8b01833a1c24b0208f9dece874228e4",
      "translation": "“原來如此，看來是艘好艦。\n　正因如此，還是把這份樂趣留到以後吧。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "2026-09-20 社区意见经用户确认，中文表达及关联术语已核对。",
      "zh_hans_sha256": "faa9a0c7eec7ef1f7fcbee5fbd0cf650fde9611bf97136576fadc2e1a10fa769",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.04/0002",
      "source_text_sha256": "8cf883edf5c9bf94e54524aaea87a9184fd7d0b39f09c458918b5731520c89cd",
      "translation": "“後撤，艦長！\n　趁對方尚未整頓好陣勢立刻脫離這片宙域！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "4e921ff0e30c11362195e1713bf6e999ac80b8c25b5a376367e5383b4abeba83",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.04/0003",
      "source_text_sha256": "05e48089f70dad4beea75dd71ab1759fc6e1578c35640fe4d1fea08cadd0d98b",
      "translation": "“明白！\n　各機迅速返航！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6f6f54e5ad7d604e491752436c1c3e273797532bc89c8ae6056b1772cd37e58f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0000",
      "source_text_sha256": "4ae84512519d68f69a88100edb821328384460ba5e6d768aa42f2ef2dfae7461",
      "translation": "“庫拉迪斯艦長！\n　敵艦正在撤退！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title"
      ],
      "notes": "",
      "zh_hans_sha256": "9889940859c930941e55613adddecd79576edff7f0f909e8c116cefbc9dc6c7a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0001",
      "source_text_sha256": "f82eaba18cf3728f47a8d71c5f9a2c21dab77eb039c5866c55f55f70234abf8e",
      "translation": "“看來比起與密涅瓦號交戰，\n　他們更重視奪走機體。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "85068831dc7083c6b246bae85fc234d7dba8f045a7071a0aaa71f2a01daee36c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0002",
      "source_text_sha256": "9ca9a16d7c1581e0214afa811e2274a3351b1ab343c60569fe1d352f20a74178",
      "translation": "“他們是地球聯合的部隊嗎……？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-alliance-short"
      ],
      "notes": "",
      "zh_hans_sha256": "c25cd4ddf661098bb6e6f8ea6350e40d241b3fe3f7b8d2933d6f08fe80c82b40",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0003",
      "source_text_sha256": "96dd49deaf5e4215a8ab97c5c88b45165c16de4ffee687d31dcc0738f7dafdf1",
      "translation": "“目前還無法判斷。\n　也可能只是海盜之流……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "de75fa645381a691a350f838814582178649f473c788274d0cbe83bd024d7547",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0004",
      "source_text_sha256": "2a7bc8322dc8c5c86b592fb2cf2d097e090d997a08cae30db7718603feb8814b",
      "translation": "“你打算怎麼辦，艦長？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5672608d80891da27da04ca310a370d99fa0b47f0fea955f230c141ea6c6744d",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0005",
      "source_text_sha256": "c865cbb2e9edea5d1169de4e66a29255f753c6e425ec56094b5a928d30b0cd78",
      "translation": "“本艦將繼續追擊敵艦。\n　議長請儘快下艦。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6260ba7fb7ec41bae5234ebdb38835de6c5366dc6ec9d90676d571f7d56562ce",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0006",
      "source_text_sha256": "ef6e2bf0eef5dfba7bc7fa0de784963cd98da037be237978396b298a4aa018ca",
      "translation": "“……塔麗亞，\n　眼下並不是讓我留下來等待報告的時候。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-aa16fea188ec"
      ],
      "notes": "2026-09-20 社区意见经用户确认，中文表达及关联术语已核对。",
      "zh_hans_sha256": "b95eac84f33f5168b161a8af9ba3b42a499357bb6162ba798aa52f2817673ef9",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0007",
      "source_text_sha256": "a4f0994412f34d36c3aab7e0e2618dd85d11f0d0d306d48672c0b5f3436a0162",
      "translation": "“可是……！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "3d9da3b2fa60c528ed983d6089af55d9fd4b803573985a73bafd180d4f362b07",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0008",
      "source_text_sha256": "bcc24a9de425811d1a5f21fa4c0e755ce5f09f55554c7aaf276a633f27482b70",
      "translation": "“我既有這個權限，也有這份義務。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "e0a9457994dead65a70e87ba1c94d3f48d58910a8682c2851e1f5b1eeb4d6717",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0009",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点演出：将日文七点省略号规范为中文双省略号，语义不变。",
      "zh_hans_sha256": "e35d01d50ee9551b20c840dbc1b0550fc164b0ca65801fbd374e6e0b2df30a33",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0010",
      "source_text_sha256": "f0f33775f6cd85d9582346c16d43f37bf1ee818969327e28aa444515660a7fd0",
      "translation": "“我也隨艦同行。\n　請批准吧。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bf42533c63958f12a652a54e9ad4be7450da96a6a63dcc931d868159daabfadd",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0011",
      "source_text_sha256": "76232b61c6cd573313ff53348388d4819e14b4cce268b7d95c37ceeb9d642db1",
      "translation": "“……我明白了。”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "311a50dc2a40ceaf43ce319b5764bebc095a02f1350f728fc9a785e87a5a8a3c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0012",
      "source_text_sha256": "7b4321fae3d521a8792e13fa350e43059e9ffd6fb58b72ef60031a8b136d16c9",
      "translation": "“通知全員。本艦即刻追擊敵艦。\n　從現在起，目標代號為不明艦1號！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "system/bogey-one"
      ],
      "notes": "正式词表构建审计修正。",
      "zh_hans_sha256": "9047d71d116b676e99b8ef280c1f5fe647dc3a82097b3be6eb4c349f466701ff",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0013",
      "source_text_sha256": "60841bd077fa8bfa14d7ee5c6b53de696d5ecca0013adcba660a85ede773aaa1",
      "translation": "“發佈紅色警戒！\n　全員就位！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "system/condition-red"
      ],
      "notes": "Condition Red 首译为“红色警戒”，列入 proposed 术语供 SEED 系列字幕口径复核。",
      "zh_hans_sha256": "7cea0d171529fd1be46a9853507fb18cfd0e4da5169065e83f95f9e635d4380a",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0014",
      "source_text_sha256": "81876ba54b455603491d101ea9aaa357423d707c8cb1d5a8450d6632f33ab875",
      "translation": "“明白！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "1be787bc0a1a2dd556fbde0546f08e44c2dd26a442360c8295fcc0f70580bf12",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/003/dialogue/01.05/0015",
      "source_text_sha256": "2a3ef4ef038ae3c3c1d677d8c4586bbf700c52e94fc86c0224e54c0414af9a42",
      "translation": "“艦長，那3架投降的未知機體，\n　其駕駛員現在情況如何？”",
      "editorial_status": "reviewed",
