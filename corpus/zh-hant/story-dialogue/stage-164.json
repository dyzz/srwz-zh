    },
    {
      "id": "story/164/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市會場",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b4ddda26e26fd498a50c3530a781e3ce1d357e9f941a1ba4634b217beb88c4ac",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0003",
      "source_text_sha256": "c950029c0eff90e5eaa07c8cf914d7319118409b7921cc24faf3e02ef6ecdc6d",
      "translation": "（艾蕾卡、霍蘭德和補陀落……\n　這其中有著我不知道的事……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/voderac",
        "people/eureka",
        "people/holland"
      ],
      "notes": "按日文源词绑定统一全局术语：organization/voderac。",
      "zh_hans_sha256": "2eaaf14e6a00777dc199f97f042ffa1cc0887003ebef0c2b9ef805ce4a64721b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0004",
      "source_text_sha256": "6845c74b133b5a957707f8da58da856d1427e679317953bc44e07e06c46bf212",
      "translation": "“怎麼了，蘭頓？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "",
      "zh_hans_sha256": "c3a8fe37afaea7bfd5d5d5249b2298fdc7c72886d7428324ba64dc5db3200948",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0005",
      "source_text_sha256": "4cb03fd27ece891530daa89ce560ec7a32b5c82a6b075175b545189eb353dc48",
      "translation": "“不、不……沒什麼！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b00a0cba0868ab06d79bd6eda8fa1e4b2679ba894e46a0ba9fe260806ad28732",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0006",
      "source_text_sha256": "df34e650c36389830099351aff1016fbf5c9e27513f554677c790ce9a7bd3858",
      "translation": "“難得凱納大哥邀請我來集市，我卻發呆，\n　真對不起。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "6c419143d3ecd103c188137eb74a4c282e7a22f865a9453d4a48cfb183d4efec",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0007",
      "source_text_sha256": "7b443fc3377de0c6901f480e93112491db6a0cb15c9336f7c5efcbc513a8da59",
      "translation": "“對了，凱納……\n　你怎麼會找我們一起來？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "8918ac65c88fa5556d8eec58d87d58ed1d1c6619614d669f68ee67ff60071fa5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0008",
      "source_text_sha256": "1c6f4a51eab1115be59a25bd5836c17a7672f55646c1731f3105a28dde187c89",
      "translation": "“嗯……這個我已經用不上了，\n　本來想拿來賣的……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "dc6b9358959420107bee275bf71b95759c04ced4fd683cddac5928ef8c1ba62e",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0009",
      "source_text_sha256": "ef7781c3cffc68e629e92cbb4eb4c407a2c256acce509c5ce50848b1e73909d1",
      "translation": "“這是！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "5ef9c647eb4351f23994b8aeac1f250ccf61f151c7dc55f3f886ca9709431672",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0010",
      "source_text_sha256": "08f88a153a30d7a3513159f96eb1eca56de5d7ee6f44e40df7493ed9bc107cf1",
      "translation": "“這不是《ray=out》的創刊號嗎！\n　這可是相當稀有的東西！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "90b59d9668898cec69edb93233c09063d3b93e6e2e32f727854a4e35ec20c70f",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0011",
      "source_text_sha256": "2e03b0528f8d7ddc96d6200923f38f7b075bcf6083325ce67e6e12024ff0cf86",
      "translation": "“果然還滿值錢的啊。\n　找你們幫我看看，真是找對人了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "c11dabd47fc3248a002161c5aedee53d5bd583595b9ea4fb08fdaaa81cf4388f",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0012",
      "source_text_sha256": "38499776133964324d438affd8b8b4f3baeb1ac10dcc3c86b746db2415727a47",
      "translation": "“凱納大哥，\n　你要把這個賣掉嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": "",
      "zh_hans_sha256": "b04a69a5b0ae03cbca6aba5c6618fabf64b6b470cbce06985f8ebf212634b234",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0013",
      "source_text_sha256": "ef45b7ad9c88ebe443631ba5ef19745f4a721f867447f7963cd5a41354d8b3fe",
      "translation": "“因為買這本書的目的已經達到了。\n　作為交換……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "a2a984f89e6f94546ed0099e359c334b47744ff9d2f705a9e42018e1e3b4843b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0014",
      "source_text_sha256": "7124c2ee0d539a691fc73405e6a84c9dfe0c523e742d5dae857271ba1e2256e5",
      "translation": "“我懂了……！\n　要給莎拉買禮物對吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sara"
      ],
      "notes": "",
      "zh_hans_sha256": "bf506932eb756aee6a4e6de45c2366c8facfdca5942c94fbc2d90f79caf016b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.01/0015",
      "source_text_sha256": "12163753431ac606758fcfa0891507ede6476b76339bffe1c839ae0a4c501aad",
      "translation": "“也、也不是啦……\n　機會難得，我想換個以後可能\n　會升值的寶貝……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "d72f07ebdb6d70168c6acdb7e077cddddba7e750e721b4e20eee0448ae4e189d",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0016",
      "source_text_sha256": "8625a6c8b4997aef11d1861c63440ad13d7e9b50efbe4b2b73e41852e3c97d78",
      "translation": "“OK，交給我們吧！\n　我們幫你挑禮物。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "14ef7f803e02b9374f9547134767f0c6f18cee82ef05116925d94ad4916ca279",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.01/0017",
      "source_text_sha256": "533175f15e9197efb6499bcaec709e01af7d9e6fbe03867eeb2ec9fe814e079e",
      "translation": "“所以說……！\n　不是那樣的啦！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "92fee6af4904c34eb6797312fabcca9f978f0b7ca834db99f45ae08b05b86765",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0000",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "智慧女神號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "6aeb98b5d6d089828d23c074484224ce2d3046ca13633f703ffd3bbbe5a9d74b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0001",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "智慧女神號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "6aeb98b5d6d089828d23c074484224ce2d3046ca13633f703ffd3bbbe5a9d74b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0002",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "智慧女神號機庫",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "6aeb98b5d6d089828d23c074484224ce2d3046ca13633f703ffd3bbbe5a9d74b",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0003",
      "source_text_sha256": "83312d277c012de507fe7152d3d6f9810704fb53d1aaeb05af295ab8a862ee5a",
      "translation": "“那、那個，莎拉……\n　這張唱片，你要不要聽聽看？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sara"
      ],
      "notes": "",
      "zh_hans_sha256": "b4e65819d7ed86316494034672b689067fd3c47ece275cd6392795f4c37395ff",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0004",
      "source_text_sha256": "41bf2872a823aec439a55ddfc4290a986f6990a7e437d371c2edd858870a9cdd",
      "translation": "“拉克絲·克萊茵……？\n　那個PLANT的人氣歌手？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "0c94bf8b8d73d24fe77cf5e69969a5ce35082c3ba22d65b01b39af6105023573",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0005",
      "source_text_sha256": "8b9d091ec1182ed368ab5acb576f172f8f905c13d81039b6fb23684ec4753bc5",
      "translation": "“真的假的！\n　這張碟還有簽名！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "197152fd06c996df421d5c9b7d786e1c3ae2b4b177d81ccebb99ac8965d7454c",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0006",
      "source_text_sha256": "74800adfe1c4e691be9bd2539a92710a265a5396e65213928b4b2ec90985170d",
      "translation": "“你小子……真能搞到這種稀有道具啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "67f9cf947b99272e093d0aa81259a49e27f8a512398c155d45af55bc8336d2f5",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0007",
      "source_text_sha256": "35a42183b9e5081c9dbeed2b4a280d24019753b47f81127bf008074679900bd6",
      "translation": "“還、還好啦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "91d37007bc4da3673576973acffe0016f98a84ca379975831b9c46f25d44a1b4",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0008",
      "source_text_sha256": "9283e3c66429654860919ea3b17afaa67cdf9ae192f1e023bf2ed62e1e2f9786",
      "translation": "（謝謝你，吉潔特……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b36b904f95e25203f8541afbf0ee008552490d3ccf27bddce42c19825988df1c",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0009",
      "source_text_sha256": "486f25c41130eb1aee7eaa82546b141888f99e83ab83fcc12fdb71f8f679ff2c",
      "translation": "“不過，沒興趣。\n　在UN看過，拉克絲·克萊茵走性感路線，\n　我不喜歡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "",
      "zh_hans_sha256": "167e405f0fcc7d9875208478d24bdf749aaf24a6569a9bab920792aaf9f21af3",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0010",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“誒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "13ed62045e04cbf2614c7548e31cfda8826a67aaa0a7c2f1766728d5cb78e0b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0011",
      "source_text_sha256": "2bc0c89b4b420685eb835a1cad48bade8878625898cb6733118e1dc18cb46dc7",
      "translation": "“比起那個，凱納你也來幫忙。\n　要用智慧女神號的材料修補雅邦天井。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "place/yapan",
        "place/yapans-ceiling",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/yapans-ceiling。按日文源词绑定统一全局术语：unit/minerva。",
      "zh_hans_sha256": "ad2c39e65e57bbe340f8e0448b9bc9c41411ca94997673c7a45495be54e30842",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0012",
      "source_text_sha256": "f250eff6d2b563bd1ee1843834b4135ee3a771d795297185008542c9fc4f1751",
      "translation": "（難得的稀有品卻碰了釘子……\n　真不走運……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "41fd2222c970b47471e66c007e544eff1f092028880adb6d7f58ba2e7fc2e970",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0013",
      "source_text_sha256": "1a9fbee62d34b7829c97180ff1ecaddb91976526795e56d0cd06f046828d47f6",
      "translation": "“高富利隊長和貝羅也在等著呢。\n　一起加油吧，凱納。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "people/speaker-542832967a32"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-542832967a32。",
      "zh_hans_sha256": "3886fbe903ead10a4dde1a889c15f5ed4d67ff9405f9155c39777655fe268385",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0014",
      "source_text_sha256": "20114c76c2efcfaed45dd018c42a8fdaa7164fdb47090dc2dbe52fea470d7d8f",
      "translation": "“嗯。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "b18b360d06d8d519ef23f1b457b101631720806265c59ff097354034a327682b",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0015",
      "source_text_sha256": "0e5daeb33bda1f4058e97f1f065d9a9dc7780d631f57d749045643d837a68537",
      "translation": "“……禮物這招雖然沒奏效，\n　他倆的氣氛倒是不錯嘛。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "42c2b8484d0045a5e2232a12a045898e7e5ecae4b45646dfb0f84fa256235ce6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0016",
      "source_text_sha256": "de3f6b035317b7565035b55e4784f85a95990053d312b4f88921a9904bf8869a",
      "translation": "“不過，現在的拉克絲·克萊茵……\n　不受歡迎了嗎？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "bee70d480d01a42ab9620ee14f5516983e36f1f17ef319d91cc0c1d888ebc561",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0017",
      "source_text_sha256": "5edf6558be90cc378cae559a8c73fef95a557a108197cccb4ce3234981e38a33",
      "translation": "“可能是因為形象大變吧。\n　……不過，我倒是不討厭。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "6f5ee83a3e0f4c8b0d56ae9ebf1b1fd8c5512d1e0fbfcdd63808d149ede8e703",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0018",
      "source_text_sha256": "e6c361a878081dc5535cf89ec9674eed46101300c0b9d8d1807510fc2a520db6",
      "translation": "“我也是，我也是！\n　而且她的身材好像也升級了不少！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "aa608ff7da345cff4497cb0b2b79aad240b1dfa064a12c3a65ac6a83e80cebd6",
      "zh_hant_status": "edited"
    },
    {
      "id": "story/164/dialogue/00.02/0019",
      "source_text_sha256": "8910a4854fa35c14b61dc2933946850ccf36cc7e7d8024870b5e2c1ab8a51525",
      "translation": "“大眾評價先不說，\n　在PLANT的人氣好像還是老樣子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": "",
      "zh_hans_sha256": "63446643eb7aa82563490a2d6d58e5d523bb0df5b1fb8d835f6f79369c2778de",
      "zh_hant_status": "draft"
    },
    {
      "id": "story/164/dialogue/00.02/0020",
      "source_text_sha256": "0c5a975051209a0f1a7f79b484081722ed396b20885ed6e23b5f79962a14a64b",
      "translation": "“啊〜啊……雪也看膩了，\n　真想去看拉克絲·克萊茵的演唱會熱鬧一下……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "zh_hans_sha256": "810e670bf628350ed069dc803b5680eb23c4f436b588dfd74d79b541e062f978",
      "zh_hant_status": "draft"
    }
  ]
}
