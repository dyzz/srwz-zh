      "source_text_sha256": "5f5ce160961ea0b1a021e756c18605d1bb7eede88e3ca1cd798ae3d44493ced5",
      "translation": "與搭檔在荒蕪的大地上經營修理店的男人。\n自稱“烈焰”，是個豪爽磊落的熱血漢，\n美中不足的是熱情過頭，讓人有些招架不住。",
      "editorial_status": "final",
      "glossary_refs": [],
      "notes": "将自称译为“烈焰”，并仅使用默认宽度字形；三行保持在24格内，避免右侧裁字。",
      "zh_hans_sha256": "011ca52a19efc8f38936356d99d30600478e089b05acc62d878a23c341d7d254",
      "zh_hant_status": "draft"
    },
