    {
      "id": "menu/Compdata/direct/opening-female-profile",
      "source_text_sha256": "3dd9a8b80522e8f875c320dc6c096783bf98f2e93bfca4fa85f265256878a3c7",
      "translation": "地球聯邦軍士兵，擔任新型機試飛員。\n性格膽怯，遇事總是消極，卻又十分認真，\n總會拼盡全力完成自己的任務。",
      "editorial_status": "final",
      "glossary_refs": [
        "organization/earth-federation-forces"
      ],
      "notes": "按原文三行信息顺序重排，保留性格反差与认真完成任务的核心含义。",
      "zh_hans_sha256": "5828f482949216ce4f7baa76204ac4bb939655456c34d71eeee70bc6d722fb3c",
