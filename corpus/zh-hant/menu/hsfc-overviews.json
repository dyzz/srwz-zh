  "entries": [
    {
      "id": "hsfc-overview:000",
      "translation": "　奧古襲擊月面盧特提姆基地，\n榮耀之星駕駛巴爾戈拉迎擊，\n卻在戰鬥中捲入空間扭曲。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "69972dc0ebefb2fa28e60d47e264ff8ab7a63de7237c28a8b23e8c46805e2aeb",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:001",
      "translation": "　榮耀之星漂入的殖民衛星內，\n爆發了機動戰士爭奪戰。\n真駕駛脈衝高達迎擊入侵者。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "61cc0561b4e4017626e83a89ce8b222d6140d5a897b355e633927361d65a09c3",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:002",
      "translation": "　密涅瓦號捲入剛轉移而來的\n奧古與提坦斯之戰。戰鬥中，\n榮耀之星再次被扭曲吞沒。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7bf0e485996dbe5add712824a2847fd76738d986cec0d72ad6c0a88165635536",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:004",
      "translation": "　貝加星聯合軍與古連泰沙\n在轉移後的世界決戰。戰鬥中，\n新的侵略者又在地球現身。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e6edd5658e63d8c7072a0582623e58a431ad47009daeaa467d152e76024d5438",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:005",
      "translation": "　異星攻擊部隊出現在駿河灣。\n勝平駕駛祖先留下的贊波ACE，\n迎戰焚燒城鎮的侵略者。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "cc4bc5ef9ad9ad38e5ee34085bb95b01f09bfac289ed40d5acad4ace7b176cdc",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:006",
      "translation": "　神秘富豪桑德曼預見澤拉拜亞\n來襲，組建地球戰騎隊。\n眾人毅然挺身迎擊地球的危機。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "25be3d8f5d9ec74cf8220e761841158fc2f395fbc47523a0955422cf7dd1d475",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:007",
      "translation": "　勝平遭到誤解與偏見的指責。\n在父親和鬥志也的鼓勵下，\n他駕駛贊波特3迎戰侵略者。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "dc99a8beb4c05d6b0a17fcd1eb08ff91b808a70c6619263b14b85417e0c195b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:009",
      "translation": "　阻止尤尼烏斯7墜落的戰場上，\n各方勢力齊聚。混戰中，\n榮耀之星再次捲入空間扭曲。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "f1ee758dfa6044bcf80e44f87b9efe88faf7976d4dfaa8357bc922ba1157c70d",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:010",
      "translation": "　軌道電梯攻防戰中，\n桂迫不得已啟動時空震動彈。\n由此，世界迎來了終結。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "744b3e7a57ba163424b8db2ede995906353749bf233c93a05cb8727fdb972974",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:012",
      "translation": "　比特維修公司遇見來自阿美利亞的\n少年卡洛德。雙方聯手迎擊\n覬覦其高達的暴徒。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "a7b998761b4ccb859fd11104d8cc44540fa928d8b7e2781dcbc04f16be7c6471",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:013",
      "translation": "　眾人受該隱委託，協助烏魯古斯克\n大逃亡。蓋納也與神秘超限人\n王者蓋納一同踏上旅程。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "ebdcd14893ae73162b3461bb6fc7778a1ba3cd588356640a51d1655c478d877e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:014",
      "translation": "　西伯利亞鐵路的追兵逼近雅邦天井。\n為迎擊敵人，傳聞中的粗獷團體\n鋼鐵齒輪受邀前來。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "b52e330fd40d2e76ece1334481503e865ca66b570e8a299dcd920e0a55ee9fc3",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:015",
      "translation": "　西伯鐵的亞薩巴賭上尊嚴挑戰。\n蓋納等人各懷決意，\n迎擊亞薩巴的拉修羅德。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7e1975e86dea008dd7736d1fc48638a46461d3f04e256fedebcbd7e71100f675",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:016",
      "translation": "　眾人捲入由空間扭曲現身的\n月光洲與追兵之戰，隨後又被\n戰鬥中產生的扭曲吞沒。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "f2c6b85b2ef83a293ed58ebab8fa4be90349701b43fb809582d3eed7061392a4",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:018",
      "translation": "　眾人因扭曲被拋到阿美利亞，\n陰差陽錯地與月之民交戰。\n羅蘭和白色人偶也被捲入戰火。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "257f18ec0ea9d7c84ab58556eb1abaf8ae4797d9318d095a492a25ec6ac392f1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:019",
      "translation": "　格溫推進與月之民的談判，\n弗羅斯特兄弟卻暗中另有所圖。\n月之女王迪安娜也降臨地球。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "784314c479c3e69e870dc9c9c6f78817775913497bbac40a7430ad67cf095d16",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:020",
      "translation": "　眾人遭遇神秘敵人墮天翅。\n為救被擄走的巴隆，阿波羅登上\n阿克艾里昂，投身宿命之戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e6aafa7b438823103ff2a41000c03b9d8201d12e1e51db93355c1e53bd59de0f",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:021",
      "translation": "　墮天翅頭翅現身阿波羅面前。\n二人接觸時，遙遠世界啟動了\n時空震動彈，世界隨之終結。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "f43537184b86b541395e2e67f7174dcf7f5e5cc72268b14d08eba42b8b74554b",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:022",
      "translation": "　埃曼工廠救起漂流而來的桂。\n得知時空已被破壞、\n新世界由此誕生，桂深感震驚。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "eef5ca7034bc47ee11626adc270aae1247f09ecaa6bb1ec8993f9c6a795ea949",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:023",
      "translation": "　失去記憶的帕拉迪姆城發生神秘\n連環殺人案。羅傑為追尋真相，\n決定與BIG-O一同出發。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "54197a8cbbc8b25404b8377c02e7eec593edae62b10dd1eb4dbcee9c9363e396",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:024",
      "translation": "　過著平凡生活的蘭頓遇見優萊卡。\n經歷新聯邦軍與月光洲的\n戰鬥後，蘭頓決心踏上旅程。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "371ec8b584cbfa190c77c0ece5505748143d6a3b5ea294aa93ff64d2f1b135e1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:025",
      "translation": "　新異星人伊爾塔襲擊太平洋上的\n三位一體城。眾人迎擊之際，\n巨神Σ終於合體成功。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "c6004fe04ada3a621d74f3710c3a1a44384601a60465c9057e1af24074f22902",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:026",
      "translation": "　自治都市福特塞班與月之民對峙。\n受僱前來助陣的和平號，\n終於與卡洛德重逢。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "9fbeff6456249cb643b6b5b490edaf2c61bb75a5ac180ed4961598ff8fb04482",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:027",
      "translation": "　貿易點爆發各方勢力混雜的亂戰。\n這場戰鬥帶來了新的相遇，\n也揭開了新戰鬥的序幕。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "8ddb52db3c4603b86d5a26dd8aa63e0adf4c9b6664df27587ae32c42ec8d9a4a",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:028",
      "translation": "　扎夫特與奧古追擊月光洲，\n戰鬥被蘭頓制止。雙方隨後聯手，\n迎擊突然現身的新聯邦軍。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "d044052cc000428327e1d7265c9cbc4cca781423bd6f701420db4bd32dbd32e2",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:029",
      "translation": "　杜克·弗裡德與眾人在三位一體城\n迎擊異星人聯合。S-1星人馬林也\n怒火中燒，駕駛巴魯迪奧斯戰鬥。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "9bac9095d72691e48c8a0fd479324b1bc828d5251e2ef081196e2e660f3ce00f",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:030",
      "translation": "　奧布與新聯邦結盟，令密涅瓦號和\n阿伽瑪陷入絕境。真發揮出\n驚人力量，化解了危機。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "652ab4c715e46a803072375775f95423c24781e17fbb691dbfd771d83d753acd",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:031",
      "translation": "　奧布正慶祝尤納與卡嘉莉的婚禮，\n拉克絲卻遭暗殺。基拉與大天使號\n為尋求和平離開奧布。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "312792181429b528786d39581d63e64dee8782c7ac6f6cce60644f2ecf4ee605",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:033",
      "translation": "　月之民襲擊開市的格羅瑪號與\n鋼鐵齒輪號。奇拉姆在混戰\n中現身，對桂窮追不捨。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e7749e852dbc4e370e845674514e86b8cafa715146fafd3d67f517ab8d2d12c5",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:034",
      "translation": "　雅邦天井舉行驛傳大賽，\n阿斯哈姆率領聖雷根突然現身。\n眾人與羅傑聯手將其擊退。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "2263b1d9aa102c7937ccd19063b1819f84d5824e3a99f1c7b1afa0946953a8da",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:036",
      "translation": "　勝平在難民中發現香月等人。\n他因反感而獨自暴走，\n卻在戰鬥中重新想起自己的使命。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "29b9f792f36c0593900173fc0ca231d6f2bd5095b0c3b6c4cdb380c47a3e3a91",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:037",
      "translation": "　圍繞卡特茲與月之民交戰時，\n假扮迪安娜的姬艾爾宣告與地球人\n共存，令迪安娜重下決心。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "691c7a7385309dcea77865870edfae8d919a3aa90cb908f574ca1882084155da",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:039",
      "translation": "　西伯鐵的卡西馬爾襲擊會合的眾人。\n眾人苦戰於可怕的超限技，\n最終被蓋納對莎拉的告白所救。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "1c53d8c24a3f26d92bdbacb94add0ad105e62cef77480cc57b0bfadca3e6183f",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:040",
      "translation": "　榮耀之星主動接受阿薩基姆的邀約。\n其力量遠超預料，繼丹澤爾之後，\n托比也在戰鬥中喪命。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "688dafce5586b738137fe870ce46b21ae2ab0cda60500352664df267c02344f1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:041",
      "translation": "　得知阿薩基姆陷入危機，\n比特維修公司出擊救援。重逢後，\n阿薩基姆未多作解釋便離去。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "362b186fa5b69ae09d7a45c3b74de4f501f183ab3f88d44cad82c2d169539c60",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:042",
      "translation": "　西伯鐵為阻止雅邦天井發起決戰。\n獲勝的蓋納決心為了只屬於\n自己的大逃亡繼續旅程。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "fe864c72073852e243cd4f330ec08c4adf0b2e7e1aef56cd49653f17832fdd96",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:043",
      "translation": "　羅傑介入早乙女研究所的百鬼帝國\n與墮天翅之戰。施瓦茨突然現身，\n留下不祥之語後離去。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "171bf08a949629661b6b7bc2400b4c6d27ec7207f53311c382bc4cb86e27d560",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:045",
      "translation": "　光子力研究所被百鬼帝國佔領。\n甲兒駕駛魔神Z，與鐵也憑藉\n雙魔神之力擊敗百鬼帝國。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "cbf27762e2d9403d3b194f3a05a34e7f12c394dc16b63d6f6d6c1b9b5dc6860e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:047",
      "translation": "　眾人為掃清盤踞日本暗處的\n百鬼帝國而戰。勝利之後，\n日本重新加入新地球聯邦。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "d760282eac611b5155c65f646f7c397e138090194b99fab33c9239f49043da63",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:049",
      "translation": "　卡繆與真在香港遇見鳳和史黛拉。\n然而她們隸屬幻痛，\n彼此重逢之處竟是戰場。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "b8dd320fdf56df8fc003af080ff06689a8eb60436bc0992bd52271751b5345f3",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:050",
      "translation": "　攻略羅安格林炮臺之際，\n澤拉拜亞突然來襲。戰後，\n英司因不信任鬥牙而離艦。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "200a2d025a10cb5766e534d8e0bb114da176760bbdf2b0d27465fab0ab69ccef",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:052",
      "translation": "　眾人為保護人們免遭蓋佐克獵殺。\n戰鬥中，重拾羈絆的超重騎士\n從桑德曼手中獲得新力量。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "9d1f96d1ad1a08c2ad0402b9ec1cdf6a0edd6d6ce3b1949dfd26447d49a47d9b",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:053",
      "translation": "　自由高達與大天使號介入眾人與\n幻痛的戰鬥。混亂的戰場上，\n海涅獻出了生命。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "a346a4f32fafd1fc257bb1daf91d53e71095f07e1ea7e5e71cdb0e12ec709639",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:054",
      "translation": "　眾人圍繞研究人體強化的\n羅德尼亞實驗室展開攻防。鳳恢復\n自我後，為保護實驗室葬身火海。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "89adb1e4d16ba6065374477ec477d7a86778decdc64992741b45294bfee8b3c2",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:055",
      "translation": "　茲妮的攻擊令星3號陷入絕境。\n同伴的聲援賦予她力量，\n令她戰勝恐懼並擊敗茲妮。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "a0a6b22e6ed29caa606e6c73aab7ac2b1721988c0300e17800d4205953bb631a",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:056",
      "translation": "　星3號為阿薩基姆的卑劣陷阱落淚。\n悲傷促使加納利·卡弗覺醒，\n新生力量擊退了阿薩基姆。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "38384508312d9cd347f02692742536fc2080565fd5eb11f9a0ac678493152c6c",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:057",
      "translation": "　卡繆從蘿蔔絲號的補給中獲得Z高達。\n花的存在支撐著他，使其擊敗了\n滿懷復仇之火的捷利特。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "28a0512d4c51a0c0d54a7e8df0ec62e1b8e2c2987d2228eea030ab86a06c4858",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:058",
      "translation": "　幻痛襲擊直布羅陀基地。\n在帕普提馬斯·西羅克的威壓下，\n迪安娜迴歸軍發生政變。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "315d1c6b2112fe7b3937e99f51c8683b1eb7d759fbdd118c0804c4df518f307c",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:060",
      "translation": "　眾人為營救迪安娜追趕蘇蕾爾號。\n自由高達在戰鬥中現身，\n並向眾人提出合作。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "272aea600826abc6e56cbc5e1839ad1cb3aa040884df07aa90b964f5a946ff92",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:061",
      "translation": "　蓋佐克把擄走的市民改造成人體炸彈。\n眾人對其暴行憤怒不已，\n但蓋佐克的力量太過強大。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "915ee4f3693d9b2a67394c642fa3bb60e6b657efa2577ffa9caf736700272eb1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:062",
      "translation": "　杜克·弗裡德出現在伊爾塔之戰。\n但他所說的理想，對如今的勝平等人\n而言只是不切實際的空談。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "30129595ffbf862407760579142fca38a74760990626a3e75ad24543903a87b7",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:063",
      "translation": "　眾人得知桑德曼的過去而震驚。\n鬥牙出於好意告知莉露真相，\n衝擊卻令她難以承受。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "b01b65b0aaf93c16eab88178cdf4b04ac47afaf84ec5f5cb667f23e6d91617be",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:065",
      "translation": "　新聯邦軍突然入侵奇拉姆。\n眾人為阻止侵略而戰，\n但混亂中，鳳與史黛拉雙雙喪命。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "613eef0248aa59a045c2db7999b9acef8ab82f15aa68644f6f5da516abd0b383",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:066",
      "translation": "　迪蘭達爾演說引發新地球聯邦政變。\n眾人隨即落入敵人的陷阱，\n迎來了前所未有的巨大危機。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "4ec5bb4cfd72c3bdeeed2381d4ff3a3c874c1ee2dd8b118a53d97bcf9d7678f8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:068",
      "translation": "　眾人與大天使號和昔日夥伴交戰。\n自由高達被擊墜後，眾人才得知\n自己一直遭到他人利用。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "0c09db463b9b3878ec536ff1cc28159732f6bde86151b9e704a4b6d7f50919e5",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:069",
      "translation": "　新聯邦公佈了科拉利安的存在。\n眾人雖察覺其中另有隱情，\n仍為守護城鎮投入戰鬥。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "aefeb92507b1e974d041f23aef5fd23920ff93170502a374fe2c997930d10023",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:071",
      "translation": "　眾人企圖奪取新聯邦的時空控制裝置。\n各方勢力陷入亂戰，時空震動彈\n啟動，再次引發時空破壞。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "497e00f04cb785fbca1ed83b255dba835ee32377e9ca32ad020ad3c56c6e5aa2",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:072",
      "translation": "　決定走獨立道路的眾人遭遇\n科拉利安。接觸帶來的幻覺中，\n蒂法落入了弗羅斯特兄弟手中。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "06d7e2ee6f19d6e7008e5c887511cd2d6825b315f2b8db3e56f207ee511e2328",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:074",
      "translation": "　蒂琺為閃光系統研究被送往佐\n恩達埃普塔。卡洛德救出她後，\n發誓不會再以新力量重蹈覆轍。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "c39e8ea91c7839189c0498e4828552bf9167bdd7f21ab70c249151bbdbe1e636",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:076",
      "translation": "　眾人被不動安排的特訓折騰不休，\n又收到牛劍鬼的挑戰。\n龍馬與阿波羅等人在戰鬥中成長。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "a1b307fa931027415775b20c5dc776600319669f943e6195b2baf5ff377557a0",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:078",
      "translation": "　眾人進入埃曼後被瑪妮莎設計擒獲。\n成功脫逃後，他們意識到自己\n已成為無處容身的局外人。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "aa087adbeba45a0b6b64aa65974df3e5d30262799b1ad8bc79ef13eb5e8bc843",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:080",
      "translation": "　眾人為藏身逃入LFO發掘現場。\n優萊卡在那裡與大地珊瑚融合，\n震驚的蘭頓發動七波。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "535f98f8f77d442ceed0e628999bb1aab5ca16ab10076ef82d83bb210624488e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:082",
      "translation": "　阿薩基姆與茲妮現身，\n揭開真相。梅爾對此震驚不已，\n在憤怒中封閉了自己的內心。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "c1599aa5a4fa3e4c88bd5ef0e73db5cae1455e1c52df34aeb83c8af6088082e8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:083",
      "translation": "　比特維修公司迎擊再次來襲的\n阿薩基姆。重拾羈絆的二人，\n喚醒了鋼獅子沉睡的力量。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "6e78ab050141a58f1f3338973da586a425e99603db753e2a15986a525d2c2af7",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:084",
      "translation": "　卡洛德等人尋找離家出走的蘭頓。\n他們在那裡遇見一對傭兵夫婦，\n並與城中作亂的暴徒交戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "bacfdda5255be385f39592522ca9a6926e0a1ea852a03afbee939090f531945a",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:085",
      "translation": "　桂在羅傑牽線下與昔日好友重逢。\n二人雖因立場不同無法相容，\n仍像過去一樣聯手迎敵。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "b237b458da5037e6e974ad2689872e62bcc0cb95cc671372168e06c8b2485581",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:087",
      "translation": "　月光洲單獨行動，要與查爾斯做個了斷。\n戰鬥中，蘭頓終於與優萊卡重逢，\n兩人確認了彼此的羈絆。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "de19fe4d53dafb098e6230168597f87a0a3ae492495a9362189ecf77f2abe368",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:089",
      "translation": "　向馬林承諾協助的弗裡克原來是誘餌。\n為打破阿弗洛迪亞的陷阱，\n馬林含淚親手擊斃朋友。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "edf4d263a7f923c44ad71817946739bd6759e5a3aefaf9a8ff4987c67086f8b1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:090",
      "translation": "　西伯鐵總裁基茲·蒙特賭上威信，\n企圖殲滅眾人。眾人險勝後，\n眼前卻出現了巨大的超限人。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "c95ed0e42d030ec777adbf2018c1e41a919fa9dea0a631457a583152dc61fa0e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:091",
      "translation": "　蓋納為超越自己接受特訓。\n他憑新力量擊敗超限惡魔，\n但這不過是一個開始。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "c6dbed387102a644943b4a2207876ffb6d9b7c698f287411134c59be58c430b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:094",
      "translation": "　新聯邦軍突然入侵奇拉姆。\n眾人與大天使號聯手阻止侵略，\n卻只能驚訝於昔日夥伴的變化。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7e6f5973fc2c174d701b083accdfed33cc88079f7347f0d5b96ce2209ffd6647",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:097",
      "translation": "　眾人與昔日夥伴正面對峙。\n自由高達被擊墜後，奧爾森告訴\n他們，眾人一直遭到他人利用。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "9f4c09917886db2ead3bfb55aac25600fc55d1d3738084ff250f6d256c8c39d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:098",
      "translation": "　追查杜威動向的眾人遭遇抗體科拉利安。\n戰鬥結束後，霍蘭德說明戰鬥\n目的，並向眾人提出合作。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "6eb0c89747007a7f8dc2232b85480c95b979a052539a5189df56286482197d48",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:100",
      "translation": "　眾人企圖破壞新聯邦的時空控制裝置。\n各方勢力陷入亂戰，時空震動彈\n啟動，再次引發時空破壞。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "ea33c57fe8b57b19d527dc76a726bb6201d80703b5646c4d94494e13fb567dd3",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:101",
      "translation": "　埃曼與奇拉姆襲擊會合後的眾人。\n戰鬥過後，為拯救世界免於時\n空崩壞，三方決定攜手合作。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "cb0149883692b352ee9f32b3d5ecdcd9fbb1fac55555f6f441ac2347109f1f73",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:103",
      "translation": "　迪拉爾賭上尊嚴發起決戰。\n但看見勝平為亞紀被改成人體炸彈\n而憤怒，他的信念遭到重創。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "ba1bd04e5b23a51f7ea151a11c995512cd736d1d0fff512d01a340d3239f9c27",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:104",
      "translation": "　真獲得新力量，阿斯蘭脫離扎夫特，\n基拉則決心投入新的戰鬥。\n三人各自踏上自己堅信的道路。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "feef473eb48f20e91ee260f62f14659c0d2b390ee1e81c46cc0ae0f985515cc1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:106",
      "translation": "　眾人為阻止阿爾德巴朗的地球\n洪水作戰。重拾羈絆的超重騎士\n奮戰之際，太陽超重神降臨。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "8a491669e3c34cb8c68a9b682ab1754a27e3bb9b2da8b4e6e7b8361a51fbd2b4",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:107",
      "translation": "　為查明黑歷史真相，眾人前去營救\n亞瑟與諾爾布。霍蘭德在那裡與\n宿敵、兄長杜威對峙。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "bf324638b62acda5e2161755ded14ddd5021820b2b9851c14c79578b46027d75",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:108",
      "translation": "　眾人為減少戰禍而趕往奧布。\n混亂的戰局中，拉克絲與卡嘉莉\n向世界發佈批判迪蘭達爾的信息。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "8b7645634acb84f4be9e3f61d7f1fdbf83fe33b81d03f735d43a3e6b6c609667",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:109",
      "translation": "　雷本襲擊追趕阿薩基姆的巴爾戈拉。\n奇美拉向震驚的眾人揭示\n真正目的，並正式宣戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "9a1ddb70ab9a1f643f4f1a72a394c2c6434a6fe0b98dd367a133ce775fbc2b95",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:110",
      "translation": "　雷本襲擊追趕阿薩基姆的鋼獅子。\n奇美拉向震驚的眾人揭示\n真正目的，並正式宣戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "3e23bda6468909a99faffecec69389e98a87ed6cc33ca23e3b887ad27519c087",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:111",
      "translation": "　眾人為尋找與科拉利安對話的線索，\n前往補陀落宮。戰鬥中，西利烏斯\n絕望於人類，覺醒為墮天翅。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "d3dd39d2b8fd6e034b4377bffc30104833d6aa9f1a95c14f258b1445c24af518",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:112",
      "translation": "　追擊百鬼帝國要塞的眾人被轉移至\n帕拉迪姆城。他們雖畏懼次元力，\n仍粉碎了百鬼帝國的野心。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e7f41012b3384e81b74475e238d697eadbc9bdb29cf3678701c00fa1b38c5bb8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:113",
      "translation": "　眾人試圖從超限惡魔手中救出蓋納，\n詩翅卻擋在面前。蓋納與同伴\n的熱情最終擊破超限凍結。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "07d8e1be391caa9c39e54c2a3beeb8a7b3cb610a710df3fee52d527b78ec587c",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:117",
      "translation": "　眾人與大天使號一同攻擊鎮魂曲\n中繼站。戰鬥結束後，密涅瓦號\n與雷告別眾人，返回扎夫特。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e7ad46a49c4c39e5a42ace3837a7663712dbb9cf233ce76aea811be428d9620d",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:118",
      "translation": "　眾人在月球D.O.M.E.得知\n黑歷史真相，以及時空破壞形成的\n時間之環。這正是新戰鬥的開端。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "70d6354ffc1a8ee907f040d19eba1c22796053b796dca30e8a8cab17eb195a20",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:119",
      "translation": "　眾人苦戰於風見博士與貝加大王。\n雖在迪拉爾協助下獲勝，\n異星人聯合卻宣佈啟動最終作戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "968e5a95f418f5c586f4090faffa30187a29f560a9d88cedca0f146a0dcfb3e8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:120",
      "translation": "　奇襲月球異星人基地因風見背叛\n而失敗。大天使號解救了陷入\n危機的眾人，雙方由此會合。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "0320d49baea314bd92eb2d90a14c015d828e2b81a3db53fec2689d50311b0178",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:124",
      "translation": "　與哈曼的談判破裂後，眾人試圖破壞\n殖民衛星激光炮。克瓦特羅警惕著\n哈曼隱藏在背後的意圖。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7e264d9b00f9550948112881741c95bb14aa58f7eb4199bc72795cf56a10fcea",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:126",
      "translation": "　眾人在月球D.O.M.E.得知黑歷史\n真相，以及時空破壞形成的時間之環。\n絕望的西利烏斯覺醒為墮天翅。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "5cd8a1e4dbd5daf7843671e23acf01ee295efae54f088ba2e615ed11667ea97b",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:127",
      "translation": "　墮天翅與百鬼帝國襲擊前往\n補陀落宮的眾人。戰鬥中，\n蓋納被超限惡魔吞噬。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "6f6721a73bfe56a9f0dd884c374b601d8e67a476ebec0e1b86e38c9cf4f4f1d1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:128",
      "translation": "　眾人試圖營救被超限惡魔吞噬\n的蓋納。重燃熱情的蓋納，\n終於擊破了超限凍結。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7c063b73d2ddaab44d8a5faadf06724cdbbffdb32c49e71dda58787e2e292d69",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:130",
      "translation": "　眾人迎戰風見博士、貝加大王與\n布萊大帝。雖在迪拉爾協助下獲勝，\n異星人聯合卻宣佈啟動最終作戰。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "7f2e20dec9e8ff84c2d18dc9050dc8d9cd9316dfec704504355dbec788a5dce8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:131",
      "translation": "　眾人擊敗布徹、加根、加特勒\n和修基，徹底摧毀異星人聯合。\n然而暴走的戈瑪正要顯露真正形態。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "952f6374f1c554bf17084b9ced2e75d53b5873d7902fb199772d07720e709a51",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:132",
      "translation": "　眾人為阻止戈瑪奮戰，\n勝平則與蓋佐克之神對峙。\n他憑自己的意志和勇氣擊敗蓋佐克。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "24e695bb06ae3b7284270011b0a60ddbd87c1d73b007b0bd169de0b895344928",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:134",
      "translation": "　阿普里利烏斯同盟軍與新聯邦激戰，\n西羅克與迪蘭達爾先後倒下。\n杜威的最終攻擊隨即開始。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "e9c03ee1de2c50fc4f3596d2affb9f87ed5384c5956bfbd1911edca8b93dc0d8",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:135",
      "translation": "　各方勢力賭上世界未來激烈碰撞。\n眾人雖取得勝利，優萊卡卻化為\n控制科拉利安的司令簇。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "96a8f40bc635d5e94ba61be1e939972e604e605a84fecfa0b743c7f3d2ee54e1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:139",
      "translation": "　眾人受某種意志影響，被轉移至帕拉迪姆城。\n羅傑否定阿薩基姆所說的太極意志，\n並賭上世界與安琪爾談判。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "d3351231d4b6645b32ed17ca04a63b99917e922dde84739255b96a6f45b03f1e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:140",
      "translation": "　眾人為向世界傳達真相而迎戰\n奇美拉。克瓦特羅佔領UN站，\n宣佈為修復時空匯聚全世界的意志。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "85a971a98c27add7d04546f99434abf148e461e023e354ae4380ed4a5b467d97",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:142",
      "translation": "　艾黛爾親自出擊，阻止時空修復。\n眾人在軌道電梯上空，\n賭上世界未來展開最後的戰鬥。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "411c7bf062dd7255c68067b0a60f4828eb6f98ae0088e665483e56e1a9d58b9e",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:150",
      "translation": "　艾黛爾親自出擊，阻止時空修復。\n激戰盡頭得到的，卻是被困在\n無盡戰爭之環中的黑暗世界。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "f42174cdadf8281644324e980a4936169a088c995de585c6ef55b72055108056",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:153",
      "translation": "　眾人各自回應奇美拉雷本\n大尉的請求。他們分成兩隊，\n分別前往太平洋與加利亞大陸。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "5d7a72bd4e73a83a0f89ab71f33cdb38576b1341139895908165b6562d0943f1",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:156",
      "translation": "　與艾黛爾准將會面後，眾人分兵兩路。\n一隊前往直布羅陀基地，\n另一隊則去偵察異星人的動向。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "06a8a202a4eb60d9ab5117f9c27139b1976182f9fec943db6ee5f59f09f6cb30",
      "zh_hant_status": "draft"
    },
    {
      "id": "hsfc-overview:159",
      "translation": "　卡洛德等人厭倦霍蘭德的態度，\n離艦尋找出走的蘭頓。另一邊，\n霍蘭德卻變得越來越煩躁。",
      "editorial_status": "reviewed",
      "zh_hans_sha256": "b9e347729cef73f3e8dbd8e354fbc1e86826d14f9c223c1035a2d54eca63476a",
      "zh_hant_status": "draft"
    }
  ]
}
