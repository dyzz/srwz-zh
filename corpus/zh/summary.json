  "entries": [
    {
      "id": "summary/00/000",
      "source_text_sha256": "9653ce5534a52ba22758f6148570dcab1c1519d38ff21a555dc1c913b26169d5",
      "translation": "　这是一个被称为宇宙世纪的时代。\n　废除了国家并统一于地球联邦政府麾下的人类，\n成功建造出宇宙殖民地，将自己的生活疆域一步步\n拓展向宇宙。\n　\n　然而，这也成了孕育新一轮战争的土壤。诞生于\n宇宙殖民地群“Side　3”的吉翁公国发表脱离地球\n联邦的独立宣言，事态最终发展为“一年战争”。这\n场规模空前的巨大战争带来了惨重的灾祸，也给此\n后的社会留下了深重伤痕。\n　\n　一年战争夺走了总人口的三分之一，最终以地球\n联邦获胜告终，但战火并未就此熄灭。企图将超古\n代文明之力据为己有、进而征服世界的地狱博士发\n动进攻后，人类又接连与其他智慧生命交战：\n以古代迈锡尼人为先祖的迈锡尼帝国、盘踞地底的\n爬虫人类所建立的恐龙帝国，以及来自外宇宙的侵\n略者贝加星联合军。\n　人类以魔神Z、盖塔机器人等超级机器人为主力\n投入战斗，击败了地狱博士与迈锡尼帝国，对恐龙\n帝国和贝加星联合军的战争也即将进入最后阶段。\n　\n　但即便身处战火之中，人类依然无法团结一致。\n　因一年战争而浮出水面的“地球居民”与“宇宙\n移民”之间的宿怨，在战争结束七年之后的当下，\n已然迎来了新的局面。\n　正逐步从内部控制地球联邦军的精英集团“提坦\n斯”，肆无忌惮地压迫宇宙移民。意识到其危险的\n人们则组建反地球联邦组织“奥古”，开始抵抗。\n　\n　当一场战事落幕、新的斗争拉开帷幕之时，一股\n庞大的命运风暴即将悄然吞没整个世界。",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "era/universal-century",
        "event/one-year-war",
        "organization/earth-federation",
        "organization/principality-of-zeon",
        "organization/titans",
        "organization/aeug",
        "organization/mycenae-empire",
        "organization/dinosaur-empire",
        "organization/vega-alliance-force",
        "people/earthnoid",
        "people/spacenoid",
        "people/dr-hell",
        "place/space-colony",
        "place/side-3",
        "species/reptilian-humanity",
        "unit/mazinger-z",
        "unit/getter-robo"
      ],
      "notes": "已对照原文复核并完成滚动字幕排版；术语按全局表统一为“提坦斯”。"
    },
    {
      "id": "summary/01/000",
      "source_text_sha256": "96a20dd29ff832e3d627ee66215421ef5fbb84ee98cdfc3f45717b835fc9396d",
      "translation": "　这是一个地球早已失去往昔文明与自然环境，各\n个地区分别形成自身社会与文化的时代。\n　纵观历史，人类虽失去了许多事物却也不断创造\n出新的东西。\n　\n　特权阶级“伊诺森特”曾掌控北半球最大大陆的\n大部分区域，而这个由他们维系的社会，最终覆灭\n于自己创造的新人类“平民”之手。\n　另一方面，统治其余地区的中央政府虽因十五年\n前第7次宇宙战争引发的灾祸一度濒临崩溃，但正\n逐步恢复统治；与中央政府敌对的宇宙革命军也同\n样在积蓄力量。就连始终坚持不干涉立场的“月之\n民”，也开始为了实现夙愿而采取行动。\n　\n　世界即将迎来剧变，人们却仍在为今日的生计拼\n尽全力。既不知未来将迎来何种命运，亦对过往的\n历史全然不知……",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "event/seventh-space-war",
        "faction/innocent",
        "organization/central-government",
        "organization/space-revolutionary-army",
        "people/civilian",
        "people/moonrace"
      ],
      "notes": "“天真者／平民”存在作品异译，已列入术语人工审核。按日文源词绑定统一全局术语：faction/innocent。"
    },
    {
      "id": "summary/02/000",
      "source_text_sha256": "5a19dd9ed44bc117e0a8d260159c721ec0fdf771e2bb04ee02ade9f5621a5fd2",
      "translation": "　在某个世界的某条时间线上所发生的巨大时空震\n动，击碎了次元的壁垒，无数迥异的世界与时代彼\n此交融，催生出了一个全新的世界。",
      "editorial_status": "draft",
      "glossary_refs": [
        "event/dimensional-shock"
      ],
      "notes": ""
    },
    {
      "id": "summary/02/001",
      "source_text_sha256": "1b57c095ac9153c85e507b253d36a98515a5a9dd139f701cea15cb77f6d41b35",
      "translation": "　然而，人类并没有就此走向灭亡。",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "summary/02/002",
      "source_text_sha256": "c0bec2de690b23dd3a36b5bf5c549fc3ec76a478078ae1430f8d4afd4df88b7e",
      "translation": "　在这场名为“世界崩坏”的时空破坏所造就的\n“多元世界”之内，人类正尝试构筑全新的秩序。",
      "editorial_status": "draft",
      "glossary_refs": [
        "event/break-the-world",
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "summary/03/000",
      "source_text_sha256": "dce242d6f1256af6b8614a569e648466b1cabc711b77565756a4d1e59dfe6231",
      "translation": "　地球联邦、地球联合、中央政府以及塔州联邦，\n组建起一个由各方麾下民众与组织加盟的统一国\n家——“新地球联邦”。其立下纲领，未来将以此\n名号统辖全人类。\n　基于这一立场，它自诩为世界警察开始频频插\n手各地纷争，接连兼并诸多小国。\n　这番举动虽激起多元世界原生国家“奇拉姆”\n的抵触，但两国仍互认对方为友好国度，确认彼\n此是在这个新世界共生共存的邻邦。\n　由此，新地球联邦与奇拉姆的势力范围以阿美\n利亚大陆为中心，覆盖了地球总面积的70%，\n掌握了总人口的75%。",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/earth-alliance",
        "organization/central-government",
        "organization/tower-state-federation",
        "organization/new-earth-federation",
        "organization/chiram",
        "place/multiverse",
        "place/ameria-continent"
      ],
      "notes": "“奇拉姆／阿美利亚大陆”音译待跨剧情复核。"
    },
    {
      "id": "summary/04/000",
      "source_text_sha256": "213df0c83e2885c95bd29dfaa52760eb04ee3ebcc5ec061195a70378260d59be",
      "translation": "　其他地区则在新地球联邦之外，形成了各自独\n立的社会。其中规模最大的，是与奇拉姆大致同\n时成为多元世界一员的“埃曼”。\n　埃曼以加利亚大陆东南部为中心，身处各个地\n区交汇之地，商品与信息在此活跃流通；与此同\n时，埃曼人也派遣商队前往世界各地，从事贸易。",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation",
        "organization/chiram",
        "organization/emaan",
        "place/multiverse",
        "place/gallia-continent"
      ],
      "notes": "“埃曼／加利亚大陆”已查常见译法，仍待跨剧情人工复核。"
    },
    {
      "id": "summary/05/000",
      "source_text_sha256": "82f22ac9fab177c0578e660ee3f1822230ba0c72a5a8b4de04136808c2b934cb",
      "translation": "　凭借埃曼人的活跃，以及以新地球联邦为核心建\n立的全球“信息集中与共享”系统——通称“UN”，\n人类逐渐理解、接纳并适应多元世界，最终建立起\n生活的基础。\n　\n　然而，这个世界对人类而言依旧太过陌生，也太\n不稳定。\n　\n　大气层上空存在一道名为“相克界”的次元壁垒。\n受其阻隔，宇宙与地球之间的往来仅限于相克界较\n为薄弱的加利亚大陆南部，以及太平洋上的特定区\n域。与此同时，小规模时空震动至今仍在不断发生；\n被卷入其中的人，再也没有回来。\n　\n　挥之不去的焦虑促使人们追逐转瞬即逝的享乐。\n多元世界的一切，都如同这个世界本身一样，处在\n动荡不安之中。\n　\n　有人不断追逐笼罩世界的光粒子波；有人跟随埃\n曼商队奔走各地，梦想一夜暴富；也有人为了称霸\n这片乱世，正在暗中磨利自己的獠牙。",
      "editorial_status": "draft",
      "glossary_refs": [
        "event/dimensional-shock",
        "organization/earth-federation",
        "organization/new-earth-federation",
        "organization/emaan",
        "place/multiverse",
        "place/gallia-continent",
        "technology/dimensional-boundary",
        "technology/trapar",
        "system/un-network"
      ],
      "notes": "UN 明确指游戏内信息系统，不译为联合国。"
    },
    {
      "id": "summary/06/000",
      "source_text_sha256": "9bee1b5c603c6d742c4e05a5ddbf5954c84dbfd33a23c1d242cb5cd85f369eb7",
      "translation": "　多元世纪元年（MC.00）。\n　距离世界崩坏已过去约半年……\n　围绕这个新世界，某种无形的力量正一点点开始\n运转。",
      "editorial_status": "draft",
      "glossary_refs": [
        "era/multiversal-century",
        "event/break-the-world"
      ],
      "notes": ""
    },
    {
      "id": "summary/07/000",
      "source_text_sha256": "1e7587032daf0e4b2cc2f55f3b9cae5f4a270dafb1eaef2894641dbcf0baff25",
      "translation": "　新的世界，孕育出新的战争。正因为这里是多元\n世界，这些战争愈发混乱，也即将呈现出更加错综\n复杂的局面。\n　\n　新地球联邦将生活在宇宙中的人类视为敌人，宣\n布对PLANT与月之民采取敌对立场。PLANT与\n月之民起初都希望通过对话解决问题，但面对新联\n邦军的进攻，最终不得不还击。\n　\n　然而，人类不仅要彼此为敌，还必须抵御盖佐克、\n泽拉拜亚、伊尔塔星人、阿尔德巴朗和堕天翅等外\n敌。而在世界的阴影之中，更有新的敌人蠢蠢欲动。\n　\n　就在此时，一些人着眼于世界的未来，准备采取\n下一步行动。新地球联邦、扎夫特、月之民、奇拉\n姆、埃曼，以及……\n　\n　在这片混乱的世界里，人们仍在竭力求生。无法\n活过今天，就不可能迎来明天。即使不知道世界将\n去向何方，人们依旧为了让今日的生命延续至明\n日，各自投身战斗。",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation",
        "organization/new-federation-forces",
        "organization/chiram",
        "organization/emaan",
        "organization/plant",
        "organization/zaft",
        "faction/gaizok",
        "faction/zeravire",
        "faction/elder",
        "faction/aldébaran",
        "people/moonrace",
        "place/multiverse",
        "species/fallen-angel"
      ],
      "notes": "四个外敌势力的音译均保留在术语待审队列。"
    },
    {
      "id": "summary/08/000",
      "source_text_sha256": "76005a5bbba1cb69891cfb51bad6a1b1257fe12fc15b70a1dc8e94b15cc40bc4",
      "translation": "　战斗中启动的另一枚时空震动弹，再次摧毁了次\n元壁垒。这场被称为“第二次崩坏”的时空破坏，不\n仅打乱了逐渐趋于稳定的秩序，甚至改变了大陆的\n形状与天体的运行。",
      "editorial_status": "draft",
      "glossary_refs": [
        "event/dimensional-shock",
        "event/second-break",
        "technology/spacetime-oscillation-bomb"
      ],
      "notes": ""
    },
    {
      "id": "summary/08/001",
      "source_text_sha256": "00fad7710cc07eb66c3386b848ec45e075bda39feb39d7d85840e860ddd7fbf1",
      "translation": "　人们只能再次意识到，自己所在的地方不过是一\n个毫无保障、如泡沫般脆弱的世界。",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "summary/09/000",
      "source_text_sha256": "3aa3d212399ce6821f845fec97436bb5f7a317786cfb0fb16ae1bf85b03c376f",
      "translation": "　民众积压的不安爆发，最终演变成暴动。",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": "与 summary/09/001—006 连读。"
    },
    {
      "id": "summary/09/001",
      "source_text_sha256": "34631aae2cffd432ce1eb461b6d92474f944ae3ebee6ee98c8c848c0e393c14b",
      "translation": "相关消息与不负责任的谣言一同传遍UN，",
      "editorial_status": "draft",
      "glossary_exceptions": [
        "system/un-network"
      ],
      "glossary_refs": [],
      "notes": "与 summary/09/000—006 连读；原文此条的“UN”依中文语序移至 summary/09/002。"
    },
    {
      "id": "summary/09/002",
      "source_text_sha256": "203de57c326cd8b53cf4a515c2b63a41c41c7048ed188eb3a8ea15c4db73abf9",
      "translation": "也进一步加深了民众心中原有的不安情绪。",
      "editorial_status": "draft",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": "与 summary/09/000—006 连读。"
    },
    {
      "id": "summary/09/003",
      "source_text_sha256": "d26aa00a63891dacbaf173e4a8c8241bacdbd6e944f72c48636a5925ae878aac",
      "translation": "政变后重新组建的新地球联邦政府派出了军队，",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "与 summary/09/000—006 连读。"
    },
    {
      "id": "summary/09/004",
      "source_text_sha256": "6e00635226cd87380fb7a7893524b49bf7365abf9e1d8611a8227ff8fdf9b4c9",
      "translation": "对引发骚乱的民众实施镇压。暴动虽被平息，",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": "与 summary/09/000—006 连读。"
    },
    {
      "id": "summary/09/005",
      "source_text_sha256": "1e6b20def629c9b6a5182f00bdeaea7288028b1b10aaaed220a5cf08c757c90c",
      "translation": "但民众心底根深蒂固的不安与恐惧，仍旧未能",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": "与 summary/09/000—006 连读。"
    },
    {
      "id": "summary/09/006",
      "source_text_sha256": "96cd31365543f53d0c98198c2c561df097f09aee9cb1a91b8ebc31ee74f0cc44",
      "translation": "就此得到彻底的消除。",
      "editorial_status": "draft",
      "glossary_refs": [],
      "notes": "与 summary/09/000—006 连读。"
    },
    {
      "id": "summary/10/000",
      "source_text_sha256": "30270961ebc85b8b5802e58cdcfaccdf5fad0a2d7da2e5225b979f322c4629e0",
      "translation": "　此外，第二次崩坏也改变了分隔地球与宇宙的",
      "editorial_status": "draft",
      "glossary_refs": [
        "event/second-break"
      ],
      "notes": "与 summary/10/001—006 连读。"
    },
    {
      "id": "summary/10/001",
      "source_text_sha256": "d5cd567d0bb41436385cb2611b1c7ae2eae3aa9107bd27f63f5f6b4f2761886b",
      "translation": "相克界。",
      "editorial_status": "draft",
      "glossary_refs": [
        "technology/dimensional-boundary"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/10/002",
      "source_text_sha256": "51d67bde00086bb190a82b73067cbcea7e056e6d0d65b88eb34ec57cf6b64b38",
      "translation": "　全世界范围内，相克界的力量都在减弱，",
      "editorial_status": "draft",
      "glossary_refs": [
        "technology/dimensional-boundary"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/10/003",
      "source_text_sha256": "9fa97e7d5611f6934ac2c6ec79be350bab773033c8e5336cea7c258a325b92e4",
      "translation": "取而代之的是光粒子含量增加。",
      "editorial_status": "draft",
      "glossary_refs": [
        "technology/trapar"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/10/004",
      "source_text_sha256": "2d6dbc6aa393614df5fe5b66493a02fef60a43cd78dc0026d916a55cfee3df6f",
      "translation": "受此影响，异星人联合的攻势，以及地球居民",
      "editorial_status": "draft",
      "glossary_refs": [
        "organization/alien-alliance",
        "people/earthnoid"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/10/005",
      "source_text_sha256": "335fa622af4a5208930c47200b74cd6d62588743d31e7d9fb9e6bd647e874059",
      "translation": "与宇宙移民之间的战争愈演愈烈；与此同时，",
      "editorial_status": "draft",
      "glossary_refs": [
        "people/spacenoid"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/10/006",
      "source_text_sha256": "b484ada18e1cf46f0c57e097d56e0b4be1545d6a10e5a0c5fae1dcf60259447d",
      "translation": "各地抗体科拉利安的活动也日益频繁。",
      "editorial_status": "draft",
      "glossary_refs": [
        "species/antibody-coralian"
      ],
      "notes": "与 summary/10/000—006 连读。"
    },
    {
      "id": "summary/11/000",
      "source_text_sha256": "19ce5e4a3f3926530de5ce83cdfa1b9ed56e1728954bb1b4a7b24c971652f6a8",
      "translation": "　人们担忧世界将迎来终结，却又无计可施，只能\n因UN上四处流传的可疑消息而愈发惶恐。",
      "editorial_status": "draft",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "summary/11/001",
      "source_text_sha256": "05e2cfbc03f089c7f364edeee6336072b6e6047e20299e3f65065f1ddcb2742d",
