    {
      "id": "menu/SLPS/09/0003",
      "source_text_sha256": "4f733bcf1a02424dd0d6dfbe6f3064a2e14e4168cee611dd4d18a1d6e4781844",
      "translation": "装备“盾”时可发动“盾牌防御”，\n装备“剑”时可发动“斩切”。\n发动概率由与对手的技量差决定。",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "system/defense",
        "system/skill-stat"
      ],
      "notes": "“切り払い”暂译“斩切”，待与特殊防御术语统一。"
    },
    {
