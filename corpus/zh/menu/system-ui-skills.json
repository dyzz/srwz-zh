      "editorial_status": "reviewed",
      "glossary_refs": ["skill/support-attack"],
      "notes": ""
    },
    {
      "id": "menu/SLPS/09/0009",
      "source_text_sha256": "bcd289655b630e14e843f3504cdabb80b4d45cc8ca24bce7d382500f9bf8d044",
      "translation": "可为相邻小队的队长进行援护攻击。\n每回合最多发动与技能等级相同的次数。",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "skill/support-attack",
        "system/squad",
        "system/level"
