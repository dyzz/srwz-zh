    {
      "id": "menu/SLPS/09/0005",
      "source_text_sha256": "09d37836a6527abc40ef8ed611959b656e2aa328385e6f8e1fed81ccb3398bbe",
      "translation": "随着HP降低，命中率、回避率、\n暴击率和防御力会提高。\n技能等级越高，效果越强。",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "system/accuracy",
        "system/evasion",
        "system/defense",
        "system/level"
      ],
      "notes": ""
    },
    {
      "id": "menu/SLPS/09/0006",
      "source_text_sha256": "194068e0300b74bb7ec135f557cf24727ed96a48f8b1c234f401e843ccb91c8b",
      "translation": "反击",
      "editorial_status": "reviewed",
      "glossary_refs": ["skill/counter"],
      "notes": ""
    },
    {
      "id": "menu/SLPS/09/0007",
      "source_text_sha256": "0860724a07b5c9a69224f03d0df2c24d2d2b3c5dea7efe9cc52555ab658e8eed",
      "translation": "选择反击时，会抢在作为攻击方的\n敌方单位之前发动攻击。\n发动概率由技能等级及与对手的技量差决定。",
      "editorial_status": "reviewed",
      "glossary_refs": [
        "system/unit",
        "system/level",
        "system/skill-stat",
        "system/counterattack"
      ],
      "notes": "按原日文同类描述栏的 23 格已证明行宽包络调整为三行。"
    },
    {
      "id": "menu/SLPS/09/0008",
      "source_text_sha256": "07e1d25071d63fea3fb0cd20b252e15f34db2eb535d2f21be6ed6aa3e84de8f8",
