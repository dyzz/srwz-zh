    {
      "id": "story/123/dialogue/01.01/0000",
      "source_text_sha256": "bed7e559620711294db677f860916207eaf0d44b7bc16cb9a8c03f60d18501c9",
      "translation": "“ZAFT的进攻部队，正在基地周边展开！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0001",
      "source_text_sha256": "228781f6e9ee64ccff8d622732dca5ecc7ac7021298372fe5c0d8ff5c1d9a882",
      "translation": "“哼，吉布利尔那家伙！快点！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0002",
      "source_text_sha256": "69d5a3a6a01315690eb0c47b509cb492961d41f92e51aa0863f2eefdea724eb0",
      "translation": "“在干什么！蒂法·阿迪尔还没能访问吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0003",
      "source_text_sha256": "c707354cf04839e0406586c99d8db6962048e2111f29280e014c9381a61fce7b",
      "translation": "“请放心，阁下。她的精神已经在我们控制之下了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0004",
      "source_text_sha256": "4e84a8563358b875249d9ef12b92d9837f2c3f2e772fb00f64f87e32245ba85f",
      "translation": "“能量填充也即将完成。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0005",
      "source_text_sha256": "e20fafc08bd1fa96c75b7140142c6cf2ff1c57feda00c3502841f66262215365",
      "translation": "“好……！迪兰达尔，先为你奏响镇魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.01/0006",
      "source_text_sha256": "436d48aa0112e38e7240328be1fd27dacb9397a90d24ac0ac73a99ba6d92f905",
      "translation": "“LOGOS！不知道你们想干什么，\n　但我要在这里打倒你们！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:official-logos。"
    },
    {
      "id": "story/123/dialogue/01.01/0007",
      "source_text_sha256": "c7f4e1f9b7c2883df6495a30d365a2e3c9db59aed2531c9c2daa4b3a844da012",
      "translation": "“等等，伊扎克！那个设施地下有巨大的能量反应！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/yzak"
      ],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.02/0000",
      "source_text_sha256": "6bfecdeac4e5906df878f6329ac690fcde11b1ca1f6090ea089be2bd71366078",
      "translation": "“中继站，姿态稳定确认。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.02/0001",
      "source_text_sha256": "b25af79b9c3d3d5db8be4e1ba835936e471c081706cb79834439868916819229",
      "translation": "“镇魂曲，发生器正常运作。距离临界还有30秒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.02/0002",
      "source_text_sha256": "74e37e5d9a530d17b9bacd655ea9af08e8488082fa959fe7181258364fb4d220",
      "translation": "“瞄准，PLANT首都阿普利留斯。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/123/dialogue/01.02/0003",
      "source_text_sha256": "9c1c66f15e62b49c28746f12d530a4bd1d326f9f21d1e3338a6a50ceee071a02",
      "translation": "“来吧，迪兰达尔！为你们奏响镇魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    }
  ]
}
