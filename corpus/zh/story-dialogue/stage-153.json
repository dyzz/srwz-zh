  "entries": [
    {
      "id": "story/153/dialogue/01.01/0000",
      "source_text_sha256": "86484155f88c96eab1a27622753149ced1a132e59bd5b26dcb1555aaa9828784",
      "translation": "“竟然有那么多超限恶魔！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0001",
      "source_text_sha256": "16b3b8162eea03d8051b0fc9044fb95619385ea46b7557582e9d63bec3913ac5",
      "translation": "“可恶！那些家伙，怎么打都打不完，\n　源源不断地冒出来！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0002",
      "source_text_sha256": "43a938f8ef7861ed699f2748fe100eef5c8f8ae29d7a5588125525999d677667",
      "translation": "“别说丧气话！就算等着，\n　新联邦和ZAFT也不会来救援的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0003",
      "source_text_sha256": "9066757180df4227c354d203efa0f0956b03c37c6c249c1d10945e462ad41741",
      "translation": "“反正，他们肯定在互相残杀吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0004",
      "source_text_sha256": "41cd713abdb3870b67ecba3fcc552fcaa0bc37d1740cc02af52ad8ea39087a73",
      "translation": "“要是我们被干掉了，\n　那守护这座城市的人就一个都不剩了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0005",
      "source_text_sha256": "561f7f7085dd1d9988198a8288f119dad30d02b1480005836c99d2e419b50c52",
      "translation": "“不过，那一天……也快到了吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0006",
      "source_text_sha256": "4190872a0baa61e650d3b3a5d7f382a87ab0cfd872c6cca585a16e3bf936a76b",
      "translation": "“可恶……可恶啊啊啊！\n　万丈大哥和罗杰大哥都不在了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/banjo",
        "people/roger"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0007",
      "source_text_sha256": "a911b9eab1736913d4184f21dd5abd9d77e4986ad2e65525b06914dcd0d4aa41",
      "translation": "“阿波罗……现在，你们在哪里……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/apollo"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0008",
      "source_text_sha256": "ec481bad2ca79ea9a55a8ea90a22d9ed8cc3df3436d780dfc8b3a41deb80dd40",
      "translation": "“桂和奥尔森大尉也消失得无影无踪了……！\n　难道时空修复失败了吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "people/olson"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/153/dialogue/01.01/0009",
      "source_text_sha256": "00c9ab241ebb3ed6c248fe6ae0f6dd5241fd2f84e9844c9c06cf65100e37566c",
      "translation": "（克瓦特罗大尉……你离开我们，\n　是因为对人类绝望了吗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/quattro"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0010",
      "source_text_sha256": "9d99c29ca0ff6362fc795c9be19777d41fd421a37116da0e7f6f81d7ce2b7201",
      "translation": "（然后，你要肃清那些封闭未来的人类吗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0011",
      "source_text_sha256": "28828577f31cc7f1a3449fed677625f8f028fc4b7fe414908de74cc69747ca8a",
      "translation": "“不行啊，马林……你到底在干什么……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/marin"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0012",
      "source_text_sha256": "769317d5504455101177bf8fa12bb16b817fbcd5ca39264e5f47fbd46ba14fbf",
      "translation": "“你不是要拯救地球吗……那片蓝天、\n　大海、大地……还有明天……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0013",
      "source_text_sha256": "6345772cd46326020b88142fabbf494ba3af8ec8ba9e75288ec469685729f835",
      "translation": "“我们……\n　是不配活在这个世界上的生物吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0014",
      "source_text_sha256": "51ef9eebdd2a7a348b0a252edcfc4ac0b90dbbaea8811ee3d36b9dc5962b1cf9",
      "translation": "“怎么会……怎么会这样！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0015",
      "source_text_sha256": "766671a1923435b6d04762099f7469fbc7a3b7d058588b32394a7b0572147c72",
      "translation": "“我们……为什么会来到这种地方……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0016",
      "source_text_sha256": "aa0755d93431c23a341a58a2239affcbb709d7a4ff8513a67f89b56f75d44ded",
      "translation": "“我们的世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0017",
      "source_text_sha256": "d49400e2466683df8cc2455d76491ae3c90b7b6cece8adc4f6b3ebeefddd099c",
      "translation": "“大家，跟我来！世界还没有终结！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.01/0018",
      "source_text_sha256": "c7657afb930fa007ffff385a2d55b9b4ebd6255bb7a7188806f2f834d9327325",
      "translation": "“桑德曼……我们会战斗到最后一刻的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sandman"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.02/0000",
      "source_text_sha256": "84febd265dacf7db084c2a74e390d77d6d53bbd1f25450323331febb44795e3a",
      "translation": "“等等！还有东西要来了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.03/0000",
      "source_text_sha256": "733d1e29c6d3508d394f5fcd051a8228a88c6469da693840b185ddcd6db99ca7",
      "translation": "“慢着！还有东西要来了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.04/0000",
      "source_text_sha256": "8ead4d39673309c01ac6bc832b78f9dffbf76600bd0606120e2204d14300ee89",
      "translation": "“伟大的意志……太极……源理之力……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/origin-law",
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme；按日文源词绑定统一全局术语：concept/origin-law。"
    },
    {
      "id": "story/153/dialogue/01.05/0000",
      "source_text_sha256": "efee1b199eb23c0427c1b17be2edabd8726f7b906e41f43d5fdc5fe1c584eeea",
      "translation": "“呃啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.05/0001",
      "source_text_sha256": "e1bddbc137d4a3a4190543a7ebd116e1bf0a898f52397b70f376fbe5c6d839f0",
      "translation": "“以我们现在的力量……已经……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.05/0002",
      "source_text_sha256": "ff618b834654e21c88b6f64902be17c5986e7e930c83bc36add2e167c2d6d29a",
      "translation": "“对不起，队长、托比……我……已经……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/toby-short",
        "system/chief"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.06/0000",
      "source_text_sha256": "9a6c4af8cb15f1f3c13a8610c025efcc46c586afc053d4734b30335fd8f25625",
      "translation": "“可恶！梅尔！你到底跑到哪里去了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.07/0000",
      "source_text_sha256": "cb3f13653ea5fa258d8f7e8514b2ae7f9cd1b1574754894db4a03b89a42140f1",
      "translation": "“已经……不行了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.07/0001",
      "source_text_sha256": "b4fdc5a50ecd227e0d0c1685c8695bf321de1003c38dca6d0121120f2920da9d",
      "translation": "“对不起……优莱卡……\n　我们……什么都没能守护住……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/153/dialogue/01.07/0002",
      "source_text_sha256": "bca327c2e56d80228847f1527aecbddc2f6c793154cc6dad86bb6c5a49909e50",
      "translation": "“可恶！可恶啊啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
