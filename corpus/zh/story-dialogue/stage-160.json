  "entries": [
    {
      "id": "story/160/dialogue/00.01/0000",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0001",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0002",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0003",
      "source_text_sha256": "de583e2b7bb576d71f70d1f97b9918d7922e1afa08079035c9c6967e6a7f9fee",
      "translation": "“兰顿离家出走了……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0004",
      "source_text_sha256": "4ac111b6e6beb5589a306a24392c1182d7a3699fc153112c794a063af373a0d5",
      "translation": "“说是看到冈吉爷爷出去了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-582543553e03"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0005",
      "source_text_sha256": "f11c3e61b1c5d06ffbd53386b4296ad855dedbd1d7cf03321ef978c648f31f74",
      "translation": "“真的吗，老爷子？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0006",
      "source_text_sha256": "a66887f37c5e4424e5666c103012a6c0831ce0c3f60cee3302e86030be904142",
      "translation": "“他说向大家问好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0007",
      "source_text_sha256": "528c3f9239a78ec7587cf2b537434f23b49a228bce04e791c4787163e834da73",
      "translation": "“真是的！那小子……\n　到底要给我们添多少麻烦才甘心啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0008",
      "source_text_sha256": "ae2ad8bd75502eaed66bf43aee5bc1964f8c997d282ae5d85a619eed37fc5f73",
      "translation": "“也不见得。\n　这样倒省了我赶他走的功夫。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0009",
      "source_text_sha256": "ae7935997b94b88233f1763745ed1fa57d5ba3bb30a07c8660b9bd009bb1b576",
      "translation": "“赶他走……？\n　你……原本打算把兰顿赶下月光号吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton",
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0010",
      "source_text_sha256": "4e6851b0474bd772c4ed19f83fe866a5139dd4bad7ec3962efdb1cd25a98197b",
      "translation": "“那小子就是个毫无用处的废物。\n　差不多也该到赶他走的时候了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0011",
      "source_text_sha256": "28b639bf2b2be64e98b09cc21bb23f17d58414f6c68d92e53bf053b115ccd60a",
      "translation": "“尼尔瓦修也没被带走。\n　就这么放着不管好了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/nirvash"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0012",
      "source_text_sha256": "c46a06de7d67785cf3aac7d4429ae06be643e1c1bbfbf2e522e72b8a5e3a868c",
      "translation": "“真是无情啊……\n　连去找一起旅行过来的同伴的意思都没有吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0013",
      "source_text_sha256": "c9551889f323f4955a8e23a4a8c455e5ba818cb9b946a201679d686109b61823",
      "translation": "“明明就像是你把兰顿赶出去的一样……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0014",
      "source_text_sha256": "07780849ea7548ebc470fe405b618cb0acb97a46b17eab6c37fbeef5508b199e",
      "translation": "“喂，四眼……\n　有话想说就给我说清楚……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0015",
      "source_text_sha256": "900675bf4cbcb94aee8ddc73d2d02ab3f2402acec59228b62ad682275c336c6d",
      "translation": "“就是因为你这副乱发脾气的样子，\n　兰顿才会离开的！\n　你难道不明白吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0016",
      "source_text_sha256": "781d05c7b4233e1d624790b25d2eb0908bce18aa6921a0a4ca498d7229ee4c97",
      "translation": "“那家伙平时确实得意忘形……！\n　但就算这样，被你那样乱发脾气，\n　谁也受不了啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0017",
      "source_text_sha256": "4cc9c44f137c7a337e0de296fe8a6a9d1a4e442c3b462da8a0ceec2870fcb633",
      "translation": "“臭小鬼……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0018",
      "source_text_sha256": "0597d611d1dd735db1d7c20417f45fb7b6c5b44b84b08a4bda3585111d608735",
      "translation": "“霍兰德……\n　我一直认为你是个配得上当领袖的男人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0019",
      "source_text_sha256": "09758aa224785cd90f253263a11f3aa0c240a449721d5c3b23d522d90e20f97b",
      "translation": "“但是，最近的你不对劲。\n　连一直憧憬你的兰顿都对你幻灭了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0020",
      "source_text_sha256": "9db43179677a33a6e3d45149e2ce029e5ba4464cf0d0459ca02c7c7c8f07a8b5",
      "translation": "“不了解情况的外人别乱说话！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0021",
      "source_text_sha256": "d7f596767ca0bfa51a6290766871d2ba9bd557f51efe3875a0af81863dcbe776",
      "translation": "“外人……！\n　这样竖起墙壁的，\n　不正是你自己吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0022",
      "source_text_sha256": "cc7583f78ca35ace8a691e952e5fa64b82eec11a3a0cf95311a2238e8c40dde8",
      "translation": "“适可而止吧！\n　我们可是把你们当作同伴才帮忙的，但是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0023",
      "source_text_sha256": "d19084b7b441d0ac68d00bc5d08ef06b5b2bf4fdf4810516b5ac71b6d871b975",
      "translation": "“你们却什么都不跟我们说，\n　只是把我们当士兵使唤吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0024",
      "source_text_sha256": "4cb380bbaae6c3a6a55771710a530a4cd0d03c49b0e181db73b32b88bfa5ba4a",
      "translation": "“要是不满意的话，\n　你们也给我滚！\n　像那小子一样！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0025",
      "source_text_sha256": "e751f9c8ed4c75c402564ce1973702a38ac449079e425792b339c56fb10c54e5",
      "translation": "“这话我可不能当作没听见。\n　这句话……我原封不动地还给你。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0026",
      "source_text_sha256": "5e2815772dd28d25c6ae3e58a32ff75b12c933f997c1137af44a8ac7803181d5",
      "translation": "“啧……看来跟你们也就到今天为止了……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0027",
      "source_text_sha256": "3b73a8832d937d2e58f6deb0f114551b99d70e2fe7665666f532d172d7838978",
      "translation": "“霍兰德……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0028",
      "source_text_sha256": "7ab97b633d88c79149adc7af330571db7d415f99dbf4553da22f9ebbdc9fa49b",
      "translation": "“看来我即使在局外人当中，\n　也是个更不合群的家伙。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0029",
      "source_text_sha256": "bfe2324d888838083a98fd2e8e5c7889043075eb9842a5df5204ad937931e36d",
      "translation": "“如果你们无法容忍我的做法，\n　月光洲就到此为止了。\n　我要跟你们分头行动。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/gekkostate"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0030",
      "source_text_sha256": "52584772d7fe6f546598debc194ca49bd911f8e85170ad396c70bef04f6bd5d4",
      "translation": "“等等，霍兰德！\n　别冲动！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0031",
      "source_text_sha256": "9c6a75903ac17c9f3a2d44a8cb717b490593ed6e81a9bfcc3a550077905d5ae2",
      "translation": "“是啊，领袖！\n　在这种四周都是敌人的情况下，\n　光靠我们自己是撑不下去的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0032",
      "source_text_sha256": "966c0d3c0a8028e8e4ccf9565774eafa051aa60615be60cac9694d4164ce39c0",
      "translation": "“吵死了！\n　我们本来就不靠任何人走到今天的！\n　只是回到原点而已！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0033",
      "source_text_sha256": "f0c5890a858263a1884f87f9af812f7b50f0f02af6ac58a10f93ed414dceb40e",
      "translation": "“霍兰德……你……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0034",
      "source_text_sha256": "04dbe720289c52f8d20b02e565e107609eb089274a6f946ccdc8086a72431af0",
      "translation": "“到此为止吧，霍兰德。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0035",
      "source_text_sha256": "aeb95d49d264a5ac9803847873ba3baa96f323b50df09c459f34fe06776e05a6",
      "translation": "“贾米尔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0036",
      "source_text_sha256": "0cc539d7d64da8b0c78143b4103bd1b6373cff6401f189f793954ed8e6ecb703",
      "translation": "“为了一个不在这里的人吵架，\n　也真是愚蠢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0037",
      "source_text_sha256": "cea08c3794433c025fba2bd0fa691e251b7bd4de14b6f1781fb657cbbbb706e5",
      "translation": "“总之，这个问题等兰顿回来再说吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0038",
      "source_text_sha256": "cf3236449c2cee2c85f5cdaccac9b259b84374da2cbc7f7a939995db2bf0595a",
      "translation": "“那我们就去找兰顿吧！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0039",
      "source_text_sha256": "47a3617f6b1e9db28dd581e7824b9069a4d09f80ba093aa857244f9183f88457",
      "translation": "“但是，\n　让$c全体出动不是很危险吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0040",
      "source_text_sha256": "f872239a67015a7b98936ae8e3376b2f22c78c48107783e193b10fa5a8246797",
      "translation": "“艾露琪小姐说得对。\n　这里派少数人的别动队去搜索才是上策吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/elchi"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0041",
      "source_text_sha256": "54c427e02162482e03dd541644afc2a466bb9ea8995ee5842976be3dba137ff8",
      "translation": "“我去吧。\n　在这里陪某个不高兴的人可真是受够了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0042",
      "source_text_sha256": "caff6bbfe856d2d22efb3f7f6b56e9d197f7294e93f5a9473e1c12302e8489e6",
      "translation": "“吉隆去的话，我也去！\n　兰顿还陪我玩过，得还这个人情！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/jiron",
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0043",
      "source_text_sha256": "a0a2f899b697376bb9a9555687337bed94b0bf7f3a54ddc67367ac798f847fa2",
      "translation": "“我也一起去。\n　奥格斯机动灵活，正适合这种任务。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0044",
      "source_text_sha256": "661ef8ba82c12f291fd860749a16e4cf2cb403112f99d416ce5e8acb65927006",
      "translation": "“可是，桂……你……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0045",
      "source_text_sha256": "68136e4a407ca1ffe907db76ebd8a14fae1bb9a9881a1cf93e19aa62c439fd48",
      "translation": "“别担心，蜜姆晶。奇拉姆和埃曼他们\n　不会想到奇点会一个人在外面晃悠的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "organization/emaan",
        "people/speaker-b53c8981fe43",
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0046",
      "source_text_sha256": "e09fdbec650b805e1524f984cb0ce5b9c83a801a8d55ded6cc9a52a0c4aec7b9",
      "translation": "“我也去！\n　找到那家伙之后的说得就交给我吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/persuade"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0047",
      "source_text_sha256": "1116b862a6566a3d744917622b566c856f44db3596a12eb7e7747d122b0fb60c",
      "translation": "“盖纳大哥也来帮忙吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0048",
      "source_text_sha256": "986afb21ad65f4fdd9eb1f4491defcb649076cadaec18f4d71863177c73bff7d",
      "translation": "“我知道。我也是这么打算的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0049",
      "source_text_sha256": "babfbc9aaf6d18574b5460ea77232b6d4280924790c3fd5aa943ae75d47d4714",
      "translation": "“等等，盖纳。你留下来看家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0050",
      "source_text_sha256": "37bb70102c34f0ab2d73476adc98f925f89ba6b8e013776a72053f1c855d0ccf",
      "translation": "“为什么……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0051",
      "source_text_sha256": "46f8f2709f41a69e093098fd963b2c280a0983c1cc910a45cbce693f851eb91c",
      "translation": "“离家出走的少年由我去找。……这段时间，\n　你就负责陪霍兰德吧。能学到很多东西哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland",
        "people/speaker-749ca4675490"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0052",
      "source_text_sha256": "c19b5b5c9a517af192fcc860494820b68ec7ca0f225429359795deb8f14247a8",
      "translation": "“学习……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0053",
      "source_text_sha256": "8b555cf8503fdd8ea49a73c8d3ecac970507b88b0fb8f8d29770410111ccfb65",
      "translation": "“没错。从年轻领袖身上好好学学吧，盖纳。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0054",
      "source_text_sha256": "a34f5faa00b9b699266945ffba19ebc6e163cb24825e411fb38dadb4b32e29bc",
      "translation": "“切……说得好像很懂似的……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0055",
      "source_text_sha256": "dc6f4387d80abde0839cbb22f5a2c847cd09f625e7aede401c068239c19f2f9b",
      "translation": "“搜索队是该隐、桂、\n　吉隆和琪露，还有卡洛德吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gain",
        "people/garrod",
        "people/jiron",
        "people/kei",
        "people/speaker-662e27566286"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0056",
      "source_text_sha256": "a9fda5bc1248a1e80b346a64259820108d037b9bf22ed708458a0f435559ea0d",
      "translation": "“喂，亲爱的……我们也去吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0057",
      "source_text_sha256": "1c03e9c5d5b4a862c629b864c0aaab5a6de9e6a59911e7d331c422c12fee73d5",
      "translation": "“嗯……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0058",
      "source_text_sha256": "82398d66812a3a5d83614dab9517e6d7216056d808c14944d2b9a07f2c0ace44",
      "translation": "“$n的选择”\n“1．去找兰顿”\n“2．留下来看家”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0059",
      "source_text_sha256": "2b32de2041c84b2101f9f05f71c5d110b48a025d4698d82f4b2e02a3848855f6",
      "translation": "“是啊……跟那个阴沉的领袖喝酒也没意思。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0060",
      "source_text_sha256": "5ecae08256f271055cdcf8796c77672b54ba0d56fa1a86311a39a520c8f09c08",
      "translation": "“从兰顿离开故乡小镇时起就有缘分。\n　我们也去找那家伙吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0061",
      "source_text_sha256": "d7de0dad7f45cfcdb870502e6fc0b944ef03fd7ef841bd2327866b94af65df69",
      "translation": "“了解，了解！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0062",
      "source_text_sha256": "555bac19150305644a3adf9f7f5ef52360cb97c58064fd86b6b8b02acdbf1d0c",
      "translation": "“就是这么回事。雷本，你也一起来吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0063",
      "source_text_sha256": "20e3f858771f1f9a37f6ae222e7017048980e5328f6c9dc85249d3e94f41541b",
      "translation": "“我也要去吗……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0064",
      "source_text_sha256": "7c4c67f90fe71856112929f52dc347269467dede9e15fadd4e059abd9e97bab6",
      "translation": "“好不容易离开了军队。\n　跟我们一起去享受自由吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0065",
      "source_text_sha256": "2ae4de3cb926aeb96cbb9c5853961b88ff6c7044ef92ef17953728fcf34a0c4f",
      "translation": "“$n先生！我们可不是去玩的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0066",
      "source_text_sha256": "e49d2e3a1573303920277cf5a4702b952b91d098440399dc98a30ecaa5469872",
      "translation": "“我知道。会好好找到兰顿回来的，别担心。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0067",
      "source_text_sha256": "185f596161e90876b72b9a7623132a82953fb825407fb4466e1f87f2272d3428",
      "translation": "“那么，盖纳，这边就拜托你了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0068",
      "source_text_sha256": "0be212a2f56d3cd17c7f793f2acda5c7948e937c51d12e89e921ea1c3b6a59ac",
      "translation": "“嗯……兰顿的事就交给你们了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0069",
      "source_text_sha256": "111d4516e591b2c7a7e367efb9a1abead6524114b347e5beef7b56748ac6ae4e",
      "translation": "“既然决定了，就赶紧出发吧！\n　趁兰顿还没走远，把他找回来。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0070",
      "source_text_sha256": "bad06011683e37db4942226e9f9183466893b8a4291142ac0f0b52c24eed0130",
      "translation": "“那么，出发吧。\n　踏上寻找离家出走少年的自由之旅。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-749ca4675490"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0071",
      "source_text_sha256": "566e1c42c87fb8850f5e4e86dab27c8ab886c95c95d162da715a01c8faa1bb74",
      "translation": "“……切……多管闲事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0072",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0073",
      "source_text_sha256": "1de21bd93a3b79eb24c1ed6f247f6588a21629a51de268700c336f0121430f39",
      "translation": "“既然该隐要去，我还是留下来的好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gain"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0074",
      "source_text_sha256": "04ea500311bc5c3d4e9a182d241ee1f41ba29320d60f8f33309697510bb76cdd",
      "translation": "“光靠贾米尔一个人照顾霍兰德太辛苦了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland",
        "people/speaker-73fc8638fc0c"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0075",
      "source_text_sha256": "8544972b56727c2a6b60ebbc631c943251d8b0e04d961781b7252e3f143bd690",
      "translation": "“切……！随你怎么说，修理屋……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/repair"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0076",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0077",
      "source_text_sha256": "910697d66e0928ec58b874bcbfc7c6cbec7db5d96c06d03d3d993e21422767cf",
      "translation": "“小心点，卡洛德。我们会等你的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0078",
      "source_text_sha256": "7ee5ec4ca6bc61b8c8a45dd1b1803493409665b167a4680d2332d0c117edb4cd",
      "translation": "“交给我吧。我不在的时候，蒂珐就拜托了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0079",
      "source_text_sha256": "111d4516e591b2c7a7e367efb9a1abead6524114b347e5beef7b56748ac6ae4e",
      "translation": "“既然决定了，就赶紧出发吧！\n　趁兰顿还没走远，把他找回来。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0080",
      "source_text_sha256": "bad06011683e37db4942226e9f9183466893b8a4291142ac0f0b52c24eed0130",
      "translation": "“那么，出发吧。\n　踏上寻找离家出走少年的自由之旅。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-749ca4675490"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0081",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0082",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0083",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0084",
      "source_text_sha256": "036ec0b90c4634828e9c6af8c2b3562fda243625676c00bef6836a48ecfd856e",
      "translation": "白鸟号　舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0085",
      "source_text_sha256": "036ec0b90c4634828e9c6af8c2b3562fda243625676c00bef6836a48ecfd856e",
      "translation": "白鸟号　舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0086",
      "source_text_sha256": "036ec0b90c4634828e9c6af8c2b3562fda243625676c00bef6836a48ecfd856e",
      "translation": "白鸟号　舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0087",
      "source_text_sha256": "f778253304c6e78249360fc9d1272a3ae139867acb963a055c1fd70d05a47b38",
      "translation": "“像这样交谈也是久违了呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0088",
      "source_text_sha256": "ce0cdcc41b3a9e9f254d774e27ea5a42a7f911656c420bb0c688f4b9dd82dec3",
      "translation": "“就算我们这边没那个意思，\n也强行侵入线路，\n还是老一套的做法呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0089",
      "source_text_sha256": "4993a4478bcc835efb2e290341aaddc8b7a1a8a68ecd11d65961f33fa01a4b73",
      "translation": "“那么，军队的大人物\n找我们这种小保镖有什么事？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0090",
      "source_text_sha256": "a5439622c0dbdacf4823df8076a8f9196ef4c65fa556ffaf13762a86d112de50",
      "translation": "“保镖吗……\n工作还够吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0091",
      "source_text_sha256": "a8c06dd5589e860293a21b27220886e5fa66450fc7ee991445b0081b764f4410",
      "translation": "“还算过得去吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0092",
      "source_text_sha256": "2cc2cc6ccaca8810e6a5c10a2a10f9bcd9f79158788beb67589fa3df47880b70",
      "translation": "“那么，希望你能接受我的委托。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0093",
      "source_text_sha256": "2dc40207673d79f88aecb9f63516986c4faaeb1d2553d637bfcf8941c9419838",
      "translation": "“是要我们回归军队吗？\n……如果是那样，答案已经决定了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0094",
      "source_text_sha256": "b196db7dbba0d0975d6fe2e16709825f8137da60ebc9d37d885cdd2e1f4b092f",
      "translation": "“我拒绝。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0095",
      "source_text_sha256": "33c8bc44c12ccb4a3a6acf92290f68cd98956437accbe6e4f519df931b5feb05",
      "translation": "“是吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0096",
      "source_text_sha256": "91771eb5f945499309465976da606cafe7c977b631c282a8ac201c82022cad04",
      "translation": "“轻松自在的保镖营生才适合我。\n事到如今哪还能回去当那种死板的军人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0097",
      "source_text_sha256": "fbe0c70ad008c1324186b43e5628ea0cef21ac0daafb0ff6c105d564b1e2cc4b",
      "translation": "“而且，还能和老婆悠闲地过日子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0098",
      "source_text_sha256": "ad3ea12081973e84daba98cdb3c08871b488ea15717ca10c928b6ad17c1ce8b3",
      "translation": "“就是这样，\n能请你放弃吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0099",
      "source_text_sha256": "9919095d5c690b5c4376d3db688b7051addc6f688702c047701b8fb13e5b5344",
      "translation": "“我可以让你和霍兰德做个了断……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0100",
      "source_text_sha256": "2c14695761acce97720d1dec9e204faff8fc54d3b24c2ac15ef81f9445ea90a8",
      "translation": "“！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0101",
      "source_text_sha256": "c42f1d284c5165471cc6ea1fc433a2d358afc71d37ebd6d88703135fdb32b9f5",
      "translation": "“即便如此，你也不愿意吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0102",
      "source_text_sha256": "ddd3c4a9c902f39eb12c248913f6f5dafd49a0361201ae14c5fc0e04b7256aa8",
      "translation": "“……不要乞求，要去争取。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0103",
      "source_text_sha256": "c94ccfcf03ec660a57817ec08db27dcb953efaaf7cd0f4eec6ae4be93be484d4",
      "translation": "“如此，方能获得。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0104",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0105",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0106",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0107",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0108",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0109",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0110",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0111",
      "source_text_sha256": "94eaa0f3d226bec143db84422bc8ad718de49f2d27fde48405346dc96176784e",
      "translation": "“……嗯……那么，金现在在南美洲啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0112",
      "source_text_sha256": "59c448502a271d2d66a145911a6e967c948cb791d4e7abc8dbb5bf96c77f9747",
      "translation": "“不过，只要有UN，\n就能像这样和辛西娅小姐进行\nOverman对战了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia",
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0113",
      "source_text_sha256": "1e133be93402b31ee1dc0681862b17802b22ee3a6318e8b63261f68a356aa4bc",
      "translation": "“只是接收状态还是那么差，\n看不到你的脸，真是遗憾。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0114",
      "source_text_sha256": "ef485b54d862210c7a464520c4ebb422215b70742149112e4672f66fc195239f",
      "translation": "“其实啊，金……\n我现在也在南美洲呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0115",
      "source_text_sha256": "ac258703cd54205e7879754dd3fc713ca929454550ee478ea8e520493d460750",
      "translation": "“真是好巧……！\n上次在卡兹的时候也是这样……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0116",
      "source_text_sha256": "a53abe4349c227b18dd4b6325de220e6b9e5f1f32d1774b04f6a215ceaa46cf7",
      "translation": "“不过，南美洲那么大，\n恐怕没法像上次那样约会了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0117",
      "source_text_sha256": "f60457e53aeb31e1be87a75b48b3d641d25197b7b76b09391317acdbacc68e5b",
      "translation": "“那时真是对不起……\n因为各种事情，结果还是放了你鸽子……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0118",
      "source_text_sha256": "723d48b09367a600e6a437f53b71c3f48fd1c3ed8bd3dd417e275bae3fbb5c45",
      "translation": "“算了，不用在意。\n……不过，要是运气好能见面的话，\n可得补偿我上次的哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0119",
      "source_text_sha256": "3f6dc6a477c71e35c62c21dbf2a54a2193f4d7ba75c78466b11551f16e0f5b9b",
      "translation": "“乐意之至！\n我会祈祷能见到你的，辛西娅·莱恩。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": ""
    },
    {
      "id": "story/160/dialogue/00.01/0120",
      "source_text_sha256": "7bd78fd906f73c93235520cbee81d555bfb86cadc3ccefff4dfd137980e90b25",
      "translation": "“我也这么想哦，金……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
