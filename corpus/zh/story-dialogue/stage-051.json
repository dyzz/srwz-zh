    {
      "id": "story/051/dialogue/01.01/0000",
      "source_text_sha256": "a27d56538cf9aa51e2770f8a05c302ad8a3bfd1ca6303a574c7ccf75dbd73f6f",
      "translation": "“各队，向前推进！\n　无论如何也要摧毁那座炮台，突破这里！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/051/dialogue/01.01/0001",
      "source_text_sha256": "4127a5b5e0f7589c8d0741598fa02cc4931c3d16f5c215fa1e97ad1d21ff5eae",
      "translation": "“菲尔少佐！炮台有能量反应！要来了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/051/dialogue/01.01/0002",
      "source_text_sha256": "4a922dabe09eb986666efe722936a0c30473f2bfbaa874de9552926a47aa12ae",
      "translation": "“回避！快！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": ""
    },
    {
      "id": "story/051/dialogue/01.02/0000",
      "source_text_sha256": "c87e4f330a482e878622de0781c35b51ce19e4dae52db12df6f8b717be6e924e",
      "translation": "“不、不行！暂时撤退！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/051/dialogue/01.03/0000",
      "source_text_sha256": "209c4a479bf48c24d4515b8810d330a8d376f3387e3063b9ebebc1a0d93e8355",
      "translation": "“迪安娜回归军全机，开始撤退。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/diana-counter",
        "skill/counter"
      ],
      "notes": "按日文源词绑定统一全局术语：faction/diana-counter。"
    },
    {
      "id": "story/051/dialogue/01.03/0001",
      "source_text_sha256": "f0c1646ed660a7d4d2418af7b4893ac2e295c8b73f93eae0bf97b271ea4cb270",
      "translation": "“无论集结多少战力，都无法突破这里。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/051/dialogue/01.03/0002",
      "source_text_sha256": "aef3e6f443ec6face08ac3ced34e6490af92697dcce93e81e589c293ca676885",
      "translation": "“只要我们的罗恩格林还在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
