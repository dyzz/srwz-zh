{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hans",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      134
    ],
    "entry_count": 105,
    "unique_source_text_count": 103,
    "translated_entry_count": 105,
    "punctuation_only_entry_count": 2
  },
  "entries": [
    {
      "id": "story/134/dialogue/01.01/0000",
      "source_text_sha256": "bf2bdf78812574d1fe49ff6643e4b015c6fcdecbfe67b415730bef1dad902632",
      "translation": "“呜……呜呜……呜……。\n　好、好冷……好冷啊，老爸……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.01/0001",
      "source_text_sha256": "9ed0f93786cbb24d6ffbbbb6041136c45a3b77fcd258bb0607ba6db866f33e16",
      "translation": "“我……我到底变成什么样了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.01/0002",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.01/0003",
      "source_text_sha256": "ce71512ff68eca9f4f2852d7eba3ad8d885fc7be760ff4d8135bdcbd6142af00",
      "translation": "“你、你这家伙……！\n　你对我做了什么……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.02/0000",
      "source_text_sha256": "a6843859f5e35204a6a0db1ee212abf0fb8aec1b794784d64abb44bb1bde2989",
      "translation": "“咿！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.02/0001",
      "source_text_sha256": "21fe8b0b0b016f5f0f0ca2243fc4c4921b4eea34dcd32eb9daefde38444c3733",
      "translation": "“我解除了施加在你身上的、让你忘记恐惧\n　的暗示。现在的你，不过是个普通的孩子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.03/0000",
      "source_text_sha256": "ea9799b8bb217e814e81d94dd4c8919e2a78a7c3d44249ff6840710b4cb670c2",
      "translation": "“住、住手……！快住手啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.03/0001",
      "source_text_sha256": "a1b33af2f283709a945f3b9734c82e279aef27c188b0aa568988a1327eb79c5c",
      "translation": "“救、救命……！谁来救救我啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.03/0002",
      "source_text_sha256": "8abbe04ac8c8dd931b74fe11c426619a391eb994eb7c27d8a7d0791cde83d487",
      "translation": "“老爸！爷爷！一哥！\n　大家！快来救我啊——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0000",
      "source_text_sha256": "dcd2cb0ec2ab70c9f86777815f801384cf172a3b8f7b74679309ea063c9fe445",
      "translation": "“呜……呜呜……住手……。\n　快住手……。好可怕……好可怕啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0001",
      "source_text_sha256": "9b6f7ac1b2dadba37c047e7b2429a70a8ffbf052b7f900a52c86e7366fe7c946",
      "translation": "“一场无人感激的无意义战斗……。\n　你和你的同伴正是为此牺牲的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0002",
      "source_text_sha256": "a5b5c4b3f87a6d1bb99908e7391d363542bfd7e12ef3973fe27b3a0c9e932f03",
      "translation": "“住手……快住手……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0003",
      "source_text_sha256": "c76aec925369cafb40a032470b007f2005cd695fffdf3367ff1c9fabfec2554e",
      "translation": "“你心中的恐惧是理所当然的情感。\n　但是，你被消除了它，被迫去战斗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0004",
      "source_text_sha256": "66301d41778ae4fd310778ce62631e8b28f66bc4b9325dba940c9092a3a072e5",
      "translation": "“……不……是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0005",
      "source_text_sha256": "ae2f01f2b030349c2f84e8879803382c7d030b4d171cd0e4bdf857b54edcc7e0",
      "translation": "“不对……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0006",
      "source_text_sha256": "954a7e73ffe8540ed569fcbeaff0d973e14dc888d369dca47bdc152c7d9c717d",
      "translation": "“我……我们确实战斗了！\n　为了自己珍视的东西！为了地球，为了大家！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0007",
      "source_text_sha256": "fee1cb6c66c300584c98a8becf4d2cd2ab8b9d7cec93fd9dca70fb582f2ef6e3",
      "translation": "“这不是无聊的事！\n　不是无意义的事！我们……我们！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.04/0008",
      "source_text_sha256": "f881ed4fa419ad35f1bca8d5f308ec9b534ce0e87af20790be68bf9e4c4a3751",
      "translation": "“没错，胜平！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.05/0000",
      "source_text_sha256": "d1b91bb7ecf43b65e0cbdf7661d2d9e82cc72bc7e0fd45e6fe65335dae970f51",
      "translation": "“宇宙太、惠子……。你们没事吗……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.05/0001",
      "source_text_sha256": "5e9deb911a3c08e37452202f7ee5a535267205ed94f1178ae45bdee586c330bf",
      "translation": "“也不是毫发无伤啦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.05/0002",
      "source_text_sha256": "249119e5b0ea71491bc4d296b38d0979d23715fe0bcbe0b22de9d1f919f1492a",
      "translation": "“但是，我们必须战斗！\n　为了我们珍视的东西！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0000",
      "source_text_sha256": "8a0e92ed176e2edf9d5cc31f8ac76404c99d17c194a83cf5f145236a0ed24653",
      "translation": "“你们也被消除了恐惧吗。那么，\n　我就把你们从那个诅咒中解放出来吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0001",
      "source_text_sha256": "9e2ff62727ee990d2760ec6208fe2225db995ff2256f694e29845ad38f45a31f",
      "translation": "“住、住手！快住手啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0002",
      "source_text_sha256": "24b17f449fe6461f8f6557d77e36c4891e3ca41d9616b02bed861d397f04b1d5",
      "translation": "“没用的。被恐惧支配的你什么都做不了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0003",
      "source_text_sha256": "447854cf86d8ce827b39c7511bf3b7dbb4709c8204d301b519c6cab159044a6e",
      "translation": "“胜平！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0004",
      "source_text_sha256": "ad65f4b3fa7b398d73e542a5add6537400d73448d420ea8949e66b71195a7da5",
      "translation": "“你，难道！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0005",
      "source_text_sha256": "40147369113937f00e3347f6dd1e722c2fb50720207617cbd6fed4ef997943ec",
      "translation": "“好害……怕……好可怕啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0006",
      "source_text_sha256": "4753e2a8f196e38d57a9be22b6c7c7c151a8114be31c12ed86399809a4c5fc6a",
      "translation": "“……但是……滨本和亚纪她们一定……经历\n　了更可怕的事……。所以……所以啊……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/aki",
        "people/hamamoto"
      ],
      "notes": "按日文源词绑定统一全局术语：people/aki。"
    },
    {
      "id": "story/134/dialogue/01.06/0007",
      "source_text_sha256": "2eb9dab8c965491ecc42c62c5d1651252f04c58e97f10baba875ab24e154cd3a",
      "translation": "“盖佐克！我怎么会输给你这种人！\n　怎么会输啊——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0008",
      "source_text_sha256": "b8b2ef7167095f9c5d18e4778207b84926b7e678b17a62de1c171cab3b2e8cac",
      "translation": "“没用的。你会死在这里。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.06/0009",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.07/0000",
      "source_text_sha256": "3dddbb1ba368bfcfb94ea7308ed76c8feb432197b7709aa1d68490bb1082600d",
      "translation": "“帝皇比亚路！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/king-beal"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.07/0001",
      "source_text_sha256": "1b340fe95cac3b1d82a247d3a95af8c40ed9f46904503bcf23fe104a990d6acc",
      "translation": "“为了保护我们！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.07/0002",
      "source_text_sha256": "d78f4cbdc94b8e561de8f2185ba3db1096976be8ab1a6db2e1d28f02d089c3b9",
      "translation": "“呜哇啊啊啊！上吧，桑波特合体！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.08/0000",
      "source_text_sha256": "ec09880714aee999957da9bfeee4d79d5d289539e271771be2ca4ea55bedc5d6",
      "translation": "“呜哇啊啊啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0000",
      "source_text_sha256": "64b628d4f073057de6849071558c16c0be98c5708433b0d3ec9a6571f8c8edc1",
      "translation": "“为什么？为什么，你还能战斗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0001",
      "source_text_sha256": "b39c3430b030cfedd5e49ecd4dcd32ff176937c6347b45f3c72028a12796a676",
      "translation": "“你懂个屁！像你这种视人命如草芥的家伙，\n　怎么可能懂啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0002",
      "source_text_sha256": "96017dd12ded157b646dc384aa635bbbbabdb5b5886573e462603ba2169c2624",
      "translation": "“你能战斗吗，胜平！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0003",
      "source_text_sha256": "a3a60a8b92f4f68ed3f36a23abeba3ad17da24e6deb3577e7772b11c89c30c7d",
      "translation": "“我是神胜平！怎么能输给那种家伙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0004",
      "source_text_sha256": "da4d0fb1a55cb8efae16cf0fae327ed6d95c73459bc9d6a4166944004aef7ec4",
      "translation": "“一哥！比亚尔没事吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0005",
      "source_text_sha256": "9e55d7892cdba0b64fda8cee2a3ce53d676b88f9ecc79072a682b4c8793e0c2b",
      "translation": "“不用操心这边！上吧！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0006",
      "source_text_sha256": "d0321bbbfc92cd4aa50f758d3b2e9306563b615c69013a4f0535048e1491b319",
      "translation": "“徒劳的挣扎。就凭你们能做什么。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.09/0007",
      "source_text_sha256": "8f1de3fb8f808a54d6a52aa56a2335ee6a2a5bbadbfc0d7ffd553e66f2a7467f",
      "translation": "“跟你战斗的可不只是神家族啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/god-family"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0000",
      "source_text_sha256": "cea896c3454899e4394cdce951d28f5dc73c432458dbe831f035e40340de3591",
      "translation": "“没错，胜平君！\n　我们绝不能屈服于那种不理解人心的机械！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0001",
      "source_text_sha256": "97e8e355f692abb33279e5d575f145ed3d037d213f99f29655ddaa783c354307",
      "translation": "“我们也追随你！追随克服恐惧而战斗的你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0002",
      "source_text_sha256": "edeaa52ca6dc8ea8ccb7a65e5d6efd7c14e1488dd52e312667d21dd9d57f3cc8",
      "translation": "“盖佐克……！就在这里了结所有的恩怨！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0003",
      "source_text_sha256": "80db50c2fd65488ea92ee3cc86a05b975a29da5ed9343b206205800f70aa8e09",
      "translation": "“电脑人偶8号！你才是那个在宇宙中\n　散播战火的祸害，给我认清这一点！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0004",
      "source_text_sha256": "2fe618642b1c2c9eaef0f83b403e1b031b36b946ebfe901bd32effbfebbd3a36",
      "translation": "“胜平，不要输！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0005",
      "source_text_sha256": "d03656a9fb4f0f27a3c65a893030c74aaa87c79e3da384625c51e6f32d31f31a",
      "translation": "“我们相信你！相信你们的胜利！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0006",
      "source_text_sha256": "c4249c424bfc082de66ab30fa1c3bcd3b3790fd85b62b7e14d5730c91314df5c",
      "translation": "“听到了吗，电脑！\n　相信我们的人，可是确实存在的啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0007",
      "source_text_sha256": "a8ed83d0a3725310f55771eeb3180d6c81e80bf74b7906e11b0733af2ec94f33",
      "translation": "“坏人确实有……！但是，\n　地球上也同样有很多好人，比坏人更多啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0008",
      "source_text_sha256": "58ee9345a4d5e8455d4f5831560dbe877ac30562b483a9f8c84431af2b64c535",
      "translation": "“……守护吾身、司掌死亡者。\n　当侵犯汝机械邦多克者出现之时，复苏吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/bandok"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.10/0009",
      "source_text_sha256": "505557a9bb34f318d03d3e62b0caf5b9797701c553bfaad5bd039dabd07089dd",
      "translation": "“此刻，吾解开封印！死亡骑士们的封印！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.11/0000",
      "source_text_sha256": "2784cbd79629ad8365f4f2eaea5a51fcc039e56a81ae22f2a08bafa81fdfe8e7",
      "translation": "“那就是盖佐克的王牌吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.11/0001",
      "source_text_sha256": "6b72882d6fe1eb42c50d9e5d3805c7265b3186690b2784e49dc59989dddcd085",
      "translation": "“不管出现什么，现在没人能阻止我们！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.11/0002",
      "source_text_sha256": "b065fb5fa915576ebfd77e514d1930ef180e0b86e51d8a2ec9e0ae79220592ad",
      "translation": "“上吧，盖佐克！不管你说什么，\n　我都要战斗！为了我珍视的星球！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.12/0000",
      "source_text_sha256": "0e61c559499e96c2732b9286454426cfbc2e996be2df3d6d01c1cfd3f3fcc2b9",
      "translation": "“吾，败了……。你们成为了胜利者……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.12/0001",
      "source_text_sha256": "33292214324f0c02133d03853fbeb4bbe1d92d0b1a247346e90f111bbe559a47",
      "translation": "“但是，为拯救这颗充满恶意\n　的星球而赌上性命的意义……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.12/0002",
      "source_text_sha256": "f208f6b64e508a5ee9eaedc8cfcf2b9502d808bc27ec33bc1e9e39c6549353c2",
      "translation": "“少废话！输了就赶紧消失！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.12/0003",
      "source_text_sha256": "236ddd560072f718fb754304298ff4dd754712136a1937e68d034b44e00ecfa2",
      "translation": "“你的话，我一点也不想听！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.12/0004",
      "source_text_sha256": "f0fde42744d798b3a172c417c03201cc585dffcae23f6340556bf4ac38f449fb",
      "translation": "“别忘了……。你们的战斗……\n　毫……无意……义……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0000",
      "source_text_sha256": "3659ed8695b5ff853887a6a296865505aef5d868fbfb1c53549575bacfac26fe",
      "translation": "“怎么会没有意义！我们……我们！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0001",
      "source_text_sha256": "4973cc459f80e88b5bfe073b48432d2e2e1c77e94bf1bbbc99d71fd3b202aef6",
      "translation": "“……为了否定电脑人偶的话，\n　我们也必须继续战斗下去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0002",
      "source_text_sha256": "e6e1bcf7e96b7841845752a029695ac71c91d19a5812096c2156db3d843bf011",
      "translation": "“想要守护的人们，想要守护的世界……。\n　只要这些还在，我们所做的事就应该有意义。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0003",
      "source_text_sha256": "4abd5570928155196280129ea6530eb6a53f52b8750a6c34380124ed8c7299f9",
      "translation": "“我……是这么相信的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0004",
      "source_text_sha256": "b340810eb1a4474b9873750f61fbf3e62de5635fe7871e70a78b3dd288e04206",
      "translation": "“希望是有的。只要还有被拉克丝\n　·克莱因的歌声打动的人在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0005",
      "source_text_sha256": "1594c17e2758d3aee0d2b79846fa387b72362ced62c5317912cd0eca3c363de4",
      "translation": "“胜平……没事吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0006",
      "source_text_sha256": "446cf0ca8490a2f1939ba7adf989bee2e509ebd3738da4a1ad4c44d108c747d2",
      "translation": "“其实很害怕吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0007",
      "source_text_sha256": "0f40efb9e6040f6ad4511635231300b7b2ed2b9bc3ecbf8f5930fc4b242d23a2",
      "translation": "“嗯……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0008",
      "source_text_sha256": "048a46b3f214ceb80fe9c26a6cf075d7b7a2017623208535599b797ef1e2a7ca",
      "translation": "“但是，我绝对不想承认那家伙说\n　的话……。……所以，才能战斗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0009",
      "source_text_sha256": "a0669b21eb74125b29c0705678835748528d04aa709f5eedf820736b40f572ea",
      "translation": "“我……今后也会战斗。\n　因为为此我才在$c啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0010",
      "source_text_sha256": "c793290ba50d607dd3dabf537ee587afa22432a3772f2bc003800c9faf375fe1",
      "translation": "（胜平君……。\n　你找到了足以超越恐惧的战斗意义。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kappei"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.13/0011",
      "source_text_sha256": "f132f589bb2058e2a1ed006fc9eeff714438b2b32b38c9909a3d112503918872",
      "translation": "（你已经不是孩子了。是一名合格的战士了。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.14/0000",
      "source_text_sha256": "64e0c7c100c89cb3d3d7137d45fc4837a1eb8c9d5a89f641857a3de6f727adf2",
      "translation": "“爷爷，听说迪安娜女王为了与联邦军结盟，\n　要再次发送消息。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.14/0001",
      "source_text_sha256": "f811246d70160767690cbd78d23401682abdc65d0341dc36f7252db2372b4597",
      "translation": "“接通各机的线路。我们也该听听。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.14/0002",
      "source_text_sha256": "3a1edff48655a95c487413feffd5233ff1a8526374fc1c748fad514bc507522d",
      "translation": "（外星人的威胁已经消除，\n　迪安娜大人究竟要做什么……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.15/0000",
      "source_text_sha256": "8975b5a0704986fe6251125f7c6050177bb709b88c5b7e5de683c4381bcd4eba",
      "translation": "“还不明白吗？\n　无人感激的你们的战斗是毫无意义的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.15/0001",
      "source_text_sha256": "64bc4cef1a7c045b13fe9137ce9260904a504a9f02d05bbd6c951bed290821f6",
      "translation": "“我们可不是为了被人夸奖才战斗的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.15/0002",
      "source_text_sha256": "c4c04866fad9521f6aef936c1b356a8b84e89acc88050ee56ed04e717cf5c8cd",
      "translation": "“没错！我们不是被谁强迫，\n　而是凭自己的意志在战斗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.15/0003",
      "source_text_sha256": "36255e1088ee2c18deda290ed9a22f634bbfd0914f1a86ee1e6f4a29840378e0",
      "translation": "“我既不会输给恐惧，也不会输给你说的话！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.15/0004",
      "source_text_sha256": "23aaf612220f782918ddb168d5cd0d8ee0ed02bc5675b9163cd5747cefaa4233",
      "translation": "“看着吧，亚纪、滨本！我绝对不会输的！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/aki",
        "people/hamamoto"
      ],
      "notes": "按日文源词绑定统一全局术语：people/aki。"
    },
    {
      "id": "story/134/dialogue/01.16/0000",
      "source_text_sha256": "ffd8ccadaa6367a73a6941f27209ca6474e59dab7033d5edb9ebfc06845edd95",
      "translation": "“神家族啊。地球和那时的比亚尔星一样，\n　是充满恶意的星球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/god-family"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0001",
      "source_text_sha256": "2d8a88b87f6ad760990224a3b6b6f0b871fad83063614d564772e1953a3cb5a9",
      "translation": "“所以就要毁灭吗！凭你独断的判断！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0002",
      "source_text_sha256": "f830e56c628374cdd25def6fb3d59527a63e0652597daa7d6316b0d5ea07b40c",
      "translation": "“开什么玩笑！你以为你是神吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0003",
      "source_text_sha256": "24c8d4a87fbacbfac250da7132868db85d0fbe740ebf7d0d00e64c8efc312298",
      "translation": "“要是神的话，就做点更有益于人类的事啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0004",
      "source_text_sha256": "e5c7e9108af438f5d6e3f93aed6efaa5a451f4a3ef9edb5824f2d09de095f298",
      "translation": "“吾为了宇宙的和平，决定毁灭地球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0005",
      "source_text_sha256": "75b03322430faa5dcaa41db5c3534743a2966a914b89b90a6e126d84ffe598b7",
      "translation": "“就凭这种自私的理由，\n　我们怎么能被毁灭！人类不是虫子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0006",
      "source_text_sha256": "cd7b515af67d9f56b820eafe91a20839913daa11df4c2d739b58b6c55eb558a4",
      "translation": "“电脑人偶啊。就算那是颗充满恶意的星球，\n　那也是我们的故乡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.16/0007",
      "source_text_sha256": "a574758b089acb34a5c36140f05daea14e353e547687779ee5b518bdc60da9db",
      "translation": "“所以，我们要战斗！\n　为了让地球变得更好一点！绝不允许你妨碍！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.17/0000",
      "source_text_sha256": "26e3cee84723decb4f6736d0277b19161c6338522b2038c1d7b759d9897a1cd6",
      "translation": "“这里也有对人类的恶意视而不见，\n　进行无意义战斗的人吗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.17/0001",
      "source_text_sha256": "3df6c9a6197afc4e586b99794a193c4421c0599e25084259caf1ccd3b232f366",
      "translation": "“真不巧啊，过时的电脑！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.17/0002",
      "source_text_sha256": "2f3ba853c32a30561d8ea6b15879a47d982256c18ac308591dfb662344e482ad",
      "translation": "“不管被伤害、被背叛多少次，\n　我都喜欢人类！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/01.17/0003",
      "source_text_sha256": "777a27910c007ae73eceb6abf027d828bf4932cc6367c1f33e0a0d38fe74d83b",
      "translation": "“像你这种自以为是的机械，就由我破岚\n　万丈来打倒！以照亮地球明天的太阳为誓！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/banjo"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0000",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太阳号舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ]
    },
    {
      "id": "story/134/dialogue/02.01/0001",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太阳号舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ]
    },
    {
      "id": "story/134/dialogue/02.01/0002",
      "source_text_sha256": "8102e19278f182d9a54561c34fed7051bb8347c80f44bc7754470f039d59222c",
      "translation": "太阳号舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/soleil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ]
    },
    {
      "id": "story/134/dialogue/02.01/0003",
      "source_text_sha256": "70a4a3a50c13885247624df1b4be3f9ab1067c1cb97c16347526aa3b75dc2ee2",
      "translation": "“……在众多人的协助和宝贵的牺牲下，\n　地球从外星人的威胁中被拯救了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0004",
      "source_text_sha256": "6e1b02520688dd932a74ab2809067277919476b077f4662145527650586ab746",
      "translation": "“但是，人类或许不是毁于外敌，\n　而是毁于内敌。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0005",
      "source_text_sha256": "b9fd8672d926edbd7a032e1f1393a3f2dbf92f3f84251973704fd6b0c284db0a",
      "translation": "“没错……就像远古黑历史的战斗那样。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history"
      ],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0006",
      "source_text_sha256": "2420a26157f5b652bb746fd7eedb733928c0a6461d1c084318d0ca88eb46cd11",
      "translation": "“我在此呼吁，为新联邦军、阿普里利乌\n　斯同盟军以及第三势力设立会谈的场所。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "organization/new-federation",
        "organization/new-federation-forces"
      ],
      "notes": "嵌套词表子串自动例外：organization/federation-forces, organization/new-federation"
    },
    {
      "id": "story/134/dialogue/02.01/0007",
      "source_text_sha256": "9cda47cd1f15e36cf5221ae4244b55250ee93ff272a1d24466647801b604de37",
      "translation": "“如果各方都有各自的主义主张和立场，\n　我希望用语言来交换意见。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0008",
      "source_text_sha256": "faf1728668ff93455afa1d139ab48b1fe7731fd3031308fe229967c287400be2",
      "translation": "“我再说一次。\n　我们或许正因内敌而走向毁灭之路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0009",
      "source_text_sha256": "5422b9689aadb7744a8c86259432bbde56b9623184c1b390fa2b8243374ae1eb",
      "translation": "“为了避免这一点，\n　我提议设立一个交换彼此意愿的场所。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "本句是避免某事的一般语义，不是战斗系统“回避”。",
      "glossary_exceptions": [
        "system/evasion"
      ]
    },
    {
      "id": "story/134/dialogue/02.01/0010",
      "source_text_sha256": "4f806f4014359a5309e1d22187c9ebb3db9e0987161eb87bec5e0060bf4a95a0",
      "translation": "“有人揶揄人类是愚蠢的生物。事实上，\n　我们也确实做了被如此评价也无可厚非的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/134/dialogue/02.01/0011",
      "source_text_sha256": "256872a8ac627bf0edf7a7356b1a744296dad7a35fbd7146fa41468eaaf0bf2a",
      "translation": "“但我相信人类能够克服这种业障，将人类\n　的明天托付给各组织领导者的贤明判断。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
