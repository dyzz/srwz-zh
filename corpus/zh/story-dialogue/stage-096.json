  },
  "entries": [
    {
      "id": "story/096/dialogue/01.01/0000",
      "source_text_sha256": "7ff539c037d0066185fadab02538071bb3857b6bba937890779c3087b476b880",
      "translation": "“迪兰达尔那家伙，真干得出来……\n　居然选在这个时机从内部瓦解地球联邦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0001",
      "source_text_sha256": "13096a7a27ecc052989792cab96d8cd2f15da5839db21d32bb9efe1aa84291b5",
      "translation": "“对联邦而言，\n　覆盖全世界的UN成了致命伤啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0002",
      "source_text_sha256": "080b5a67a2c89c19997673f6f79f20e0bb59701301e1578e77b0e6c69287f99f",
      "translation": "“恐怕得知真相的市民会引发暴动，\n　搞不好联邦会分裂成各个国家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0003",
      "source_text_sha256": "2fb2c6196af9e1891fb001cba6de1b6c41ec3c40a0d07896ae3f6df4dffd4625",
      "translation": "“入侵首都的联邦部队也已经撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0004",
      "source_text_sha256": "7887d6c28f3a34080f16f93d5d2082d81bbab4d9303d785505d0b3bec980eb01",
      "translation": "“被ZAFT用王牌新兵器打掉，\n　后方又闹成那样……也只能撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0005",
      "source_text_sha256": "5a278bbc66c0e04930e55b464607e6ce14c89676240d6562c433b3f39030804a",
      "translation": "“结果，欠了迪兰达尔一个人情，真是遗憾。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0006",
      "source_text_sha256": "4cff539d2c7dd32286a8b1fc479cf08be3722fe0626c4731e183019c80608a7d",
      "translation": "“是吗……？\n　说不定我们只是被他那场闹剧利用了而已。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0007",
      "source_text_sha256": "9a64ad0740c07ab82839e230ec765e1cb31197b318c49ef3ac89719534431e13",
      "translation": "“您这话的意思是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0008",
      "source_text_sha256": "586e80015ddb3c689d5613f9a2152e38ae0345cda1efcd163b0005442d7989b0",
      "translation": "“算了……既然没有确凿证据，\n　现在对PLANT表现出敌意太危险了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0009",
      "source_text_sha256": "2310a42adcea49bb2055c361ec8db7c398081676a314390fed4868dc9403490b",
      "translation": "“毕竟，\n　他可是揭露地球联邦腐败的正义之士啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0010",
      "source_text_sha256": "d5a353d05a7a90ad2460da9ef97bd4b9974a52e73c3158c3382dec039166a466",
      "translation": "“唉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0011",
      "source_text_sha256": "c51b788fcad5ab7041c070a039e24f4d3282b073a2af7d4b81bb07154d9cb92f",
      "translation": "“让舰队返回首都。只要时空控制装置还在，\n　奇拉姆就不会终结。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0012",
      "source_text_sha256": "79b177a471c7e4b3f247641b1a229b73d98eaa3542a8e7b066a8e7f56dea156f",
      "translation": "“重启D计划，掌握时空修复的主导权。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0013",
      "source_text_sha256": "6c87b3e96cc1890a27b6a9a4e73bf6ad4f2a9e8e68ecbfac1739720eee186257",
      "translation": "“明白。……全舰转向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.01/0014",
      "source_text_sha256": "e635b83e28e03f2097f76e60f9e8e07e14b95640cae6b5a689e914a61b31cffb",
      "translation": "“雷达有反应！探测到高速接近本舰的机体！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.02/0000",
      "source_text_sha256": "bd9439fecab7a2367089498d88971afe55a2822516dcdc39f2dff71f048ad202",
      "translation": "“是联邦的追击部队吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.02/0001",
      "source_text_sha256": "22c1f4a8eb2176a0eb10c1050badff99fea2d9b9da1b23acb8e1739df2e5c573",
      "translation": "“特务队的报告中有该机体记录！\n　似乎不是联邦军！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.02/0002",
      "source_text_sha256": "927c511d49e9ef2cf8afd69e808f809ba91692e7ca2e083ef8387ff5e72ba511",
      "translation": "“……通往太极之路……\n　没有资格的人绝不能染指。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme"
    },
    {
      "id": "story/096/dialogue/01.03/0000",
      "source_text_sha256": "aa3eb486e69f5d135a2e151c4f6c6d906782628385a7a54bf672b482e8588459",
      "translation": "“他的目标是时空控制装置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.03/0001",
      "source_text_sha256": "baa458dda3be77a04232e62e10b21903bb612f2a2de43ada09801bfe7922dead",
      "translation": "“迎击！无论如何都要守住装置！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.03/0002",
      "source_text_sha256": "8554aa99bd2ef817b1353185d8af3ccd8876ed85ea5360fccb954bcc2f6c3259",
      "translation": "“太慢了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.04/0000",
      "source_text_sha256": "bcfaf6a8780ce8a0b39b0f07ed3d07a3fbde4549c9141d27f22a9709ab452fbb",
      "translation": "“时空控制装置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.04/0001",
      "source_text_sha256": "35bb9dcc2ca3f90bb9c80fb1ec08a6ea1a216ef05d611f92500b59116d8de91d",
      "translation": "“怎么会这样……D计划……\n　世界……要崩溃了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.04/0002",
      "source_text_sha256": "5df8b1011f4de5e456aac375a48ecfabb1763a9c95eede1445ca9652af43d2ba",
      "translation": "“这样就好。多元世界的框架，\n　又要动摇了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0000",
      "source_text_sha256": "b9d607d7e4b9ef09169774bc1fc1d8ca1538012de086e5da2b86202a81806c9d",
      "translation": "“怎么会……又晚了一步……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0001",
      "source_text_sha256": "d8efdd7afd2aa4a5ff03b2988cd6bb9ece3a54f470d0842be75c7ee3b2a2da6a",
      "translation": "“$n先生……我们总是慢半拍……\n　这样下去一切都会来不及的……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0002",
      "source_text_sha256": "e047cd67a113894b901673e7a4560afd0129a709e4343e217e988936f4b66811",
      "translation": "“星3号，请说明情况！那家伙是什么人！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/star-3-callsign"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0003",
      "source_text_sha256": "acbf35eb8185c2dd7f9e94ac2e99828c9748a26b9f371a9ac9937e84ac406aaa",
      "translation": "“抱歉。我要去追那个男人……\n　阿萨基姆·杜文！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0004",
      "source_text_sha256": "c3ef34b6db16cea621195f6e19288bdec3739f2c4dee4249a72f43b5c8f529f3",
      "translation": "“详情请去问$c\n　的$F……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0005",
      "source_text_sha256": "7df58c712fc07a598b5ec3be3dd74adc4adf251397d1252de8a08b74bbbf540b",
      "translation": "“等等！话还没说完！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.05/0006",
      "source_text_sha256": "67c0a0b81d349e62f6b3aa210a2dbc5580d127188963122dece2b06af6244c17",
      "translation": "“那么，告辞了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0000",
      "source_text_sha256": "c2b1f2c2248442ca74f4c3ebe944fac1dea1be3de4863590f49a6e06e56be5fc",
      "translation": "“那个引导我们的女人……\n　叫节子……她到底是什么人……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/setsuko"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0001",
      "source_text_sha256": "b3e49ef801858147fc5827a48c530bd3087cbae53dd2a6c6339266d7427c36de",
      "translation": "“雅典娜……我也去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0002",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0003",
      "source_text_sha256": "516925a32cdf3d062b70e78b72709a66cf7e47360c47d9bcdef0bdfcba903281",
      "translation": "“时空控制装置已被破坏，\n　D计划基本等于失败了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0004",
      "source_text_sha256": "ceb0bd443411beba62ffd675a2926d0a1e06a7e3c33f88382fb2ce88706dcf02",
      "translation": "“这样一来，上层恐怕会再次计划用\n　特异点修复时空，打算利用我和桂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "technology/singularity"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/096/dialogue/01.06/0005",
      "source_text_sha256": "a1c5a0c03f749d675798b28cc3cc7ddcde30779d0e232c2c59ae56dc9b94983a",
      "translation": "“那么，捕获桂木桂，维持奇拉姆的存续……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/096/dialogue/01.06/0006",
      "source_text_sha256": "b0e2cb47a8ed133ebed4c3c9948b5f4f08bf8500ce3903c05f947ac491682a04",
      "translation": "“……我已经不确定那是否正确了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0007",
      "source_text_sha256": "9d9c67071a5a0395347af821900332b19f1ea7142d404bfbdff4a51ca7647895",
      "translation": "“叔叔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0008",
      "source_text_sha256": "bd56d988846ce5f0d79197782bbcede48ef76c5c79db6b425752d3d01ab6d660",
      "translation": "“所以，我要去见桂。\n　然后，重新思考自己该做的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/096/dialogue/01.06/0009",
      "source_text_sha256": "07906199de3b709275f9f2f73171fd74434efca49c3ca4a5fa2372e60ad93cd7",
      "translation": "“请等一下，叔叔！那我也一起去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0010",
      "source_text_sha256": "9066a176f031939ceab0f94896e4b95ce736fbae1abcbdc9f0dc85c60d0761be",
      "translation": "“不行。你留在奇拉姆，收集情报。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0011",
      "source_text_sha256": "d1269982449982eb1ddf64ff6980cffeac806333d0a71453b38e00c9ad8a6290",
      "translation": "“那个叫节子的驾驶员在追的阿萨基姆\n　·德温……还有新联邦的混乱……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/setsuko",
        "system/pilot"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.06/0012",
      "source_text_sha256": "83e72f37ec3dacda21614bbd60b7d6328dabd243a6760733dd751d6a98836863",
      "translation": "“事态还会继续变化。拜托了，雅典娜。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/01.07/0000",
      "source_text_sha256": "02a8fff1b99ea6a74b387149486521fd52acbcbb0692217232a058e27506e8fc",
      "translation": "“叔叔……祝您平安……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0000",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使舰内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。"
    },
    {
      "id": "story/096/dialogue/02.01/0001",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使舰内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。"
    },
    {
      "id": "story/096/dialogue/02.01/0002",
      "source_text_sha256": "c95fdfa0f90872f9b0c077733f9af209af76ae276e61e32b0d8b1c3aee85aa7f",
      "translation": "大天使舰内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。"
    },
    {
      "id": "story/096/dialogue/02.01/0003",
      "source_text_sha256": "ceb82647b4201da085f9df9926753603fd0b4a85f904708cc85bd03325dbf420",
      "translation": "〜大天使舰内〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。"
    },
    {
      "id": "story/096/dialogue/02.01/0004",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0005",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0006",
      "source_text_sha256": "64ba9ce5c97d695670604f88b4c33b2d95b807dac25e4008e3633352756fb9cc",
      "translation": "“……还在睡吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0007",
      "source_text_sha256": "b12a8adf0ea18345150b165f067ad7871dd23dd55dae9aed0a6b436f06105243",
      "translation": "“换衣服时他醒过一次，\n　自称是新地球联邦第88独立机动军所属，\n　尼奥·罗阿诺克上校……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation",
        "people/neo",
        "people/neo-roanoke-full",
        "rank/colonel"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation, people/neo；按日文源词绑定统一全局术语：rank/colonel。"
    },
    {
      "id": "story/096/dialogue/02.01/0008",
      "source_text_sha256": "8c0ac19c51035963500baa3acd1aba544a758cf43e83fe76f91b2be633ad6dfa",
      "translation": "“但是，检查出的身体数据与本舰\n　数据库中的记录100%吻合。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0009",
      "source_text_sha256": "ad666d0053c769eaa7de1ed010e8b367c78f47cac6d4ab8abddf6c8c6f32e866",
      "translation": "“那么……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0010",
      "source_text_sha256": "61f88f45d0c1f3ca30bb02fb55b8b471dce3260f7607fc1a7e833edb875de4d2",
      "translation": "“这个人……是我们认识的穆·拉·弗拉加……\n　至少在肉体上是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0011",
      "source_text_sha256": "3207b28f00c8af497dd05351ac09244c9f4505d4239e1373f7d134206c3a23d0",
      "translation": "“把弗拉加少校送来的那位‘风暴’先生，\n　应该也知道这件事吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。"
    },
    {
      "id": "story/096/dialogue/02.01/0012",
      "source_text_sha256": "44f12f5769072caff6f8252e762c9ad1e9a12ef7e57baaad10db2ae1b16a5eed",
      "translation": "“拉米亚斯舰长……那位弗拉加少校是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。"
    },
    {
      "id": "story/096/dialogue/02.01/0013",
      "source_text_sha256": "41a0f325c617d98aac587e1bead8360dcb3ce6813b44535f480f1812f4a15d04",
      "translation": "“是这艘大天使的前乘员。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/archangel。"
    },
    {
      "id": "story/096/dialogue/02.01/0014",
      "source_text_sha256": "1805c38fc4739fb844bbdb8117f2bf72ef6af2072947240e4d00f7e0d9f8a276",
      "translation": "“两年前……我以为他在前次大\n　战的最后一场战斗中战死了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0015",
      "source_text_sha256": "7970ad55383330aaa21622f7e1eb3d7a7156b57da46a33518f7dcc8b5fd165be",
      "translation": "（这副神情……看来对舰长而言，\n　他是位特别的男性……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0016",
      "source_text_sha256": "c6322fc112b62b84511f4b01cd317ad045c3d8d5d408a83c6eec5d307d1916ee",
      "translation": "“这到底是怎么回事？\n　刚才说的‘肉体上’是指……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0017",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0018",
      "source_text_sha256": "a68cbf52247551dc60d21b09720a8264f0a748e7e1cf99b5dcafa22c05ea43a5",
      "translation": "“……从刚才起就听你们\n　在说些莫名其妙的话……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0019",
      "source_text_sha256": "2a533320e80dfe621ddc078d930b2abceb9f40b7811da212d0a7f2100d96d6ca",
      "translation": "“我什么时候成少校了？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。"
    },
    {
      "id": "story/096/dialogue/02.01/0020",
      "source_text_sha256": "b6dc7742b2ad9582737e08e26e2c9457706659918ef7dbf2847613ce7857c6f2",
      "translation": "“啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0021",
      "source_text_sha256": "6c19cfb254a0aa4228e2f909578971fd5ffcedbd9b62e183569ae318eee77f5c",
      "translation": "“我说过我是上校吧，好好听着。\n　别因为是俘虏就随便给我降级啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/colonel"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/colonel。"
    },
    {
      "id": "story/096/dialogue/02.01/0022",
      "source_text_sha256": "1044a1605b31070f255381281e0cbbf57177c37d93b5feee369dfb141246921d",
      "translation": "“啊……啊啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0023",
      "source_text_sha256": "e4b823aaea8e7e453304649f78eceefa1fef75f5ff032bd4775609df36eb384c",
      "translation": "“什、什么啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0024",
      "source_text_sha256": "71009d4c61c201f0169b62b312ba39f250323b2bd03b3c2e58fa711b5b30be73",
      "translation": "“一见钟情了，美人小姐？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0025",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0026",
      "source_text_sha256": "a7d0b5d4a234f326650f4850c433626ad7d0749ccf19eb8a7789a834f7bd9948",
      "translation": "“走掉了啊……我……\n　说了什么不好的话吗……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0027",
      "source_text_sha256": "db165784093ecd348c927094a282d622bea34fed6354862bd6d387a48ef031c1",
      "translation": "“穆先生……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0028",
      "source_text_sha256": "f070ed24c33ca76eb917de00bf1eb8a949c06b6bb637f5e6f790825cd032607b",
      "translation": "“穆是谁……？难道是在说我？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0029",
      "source_text_sha256": "ff07098e175f3c5b8fba8492ba88c7671de6d92bb6480347cfeff0643053c29b",
      "translation": "“这家伙……没有记忆吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0030",
      "source_text_sha256": "54c36c003014208ecd21ebda4e916140547e69043778346f41f335c3163e0c2b",
      "translation": "“说话真不客气。……嘛，\n　我的过去是有点模糊不清……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0031",
      "source_text_sha256": "36db42b656d3cb581c62193da1d97117f3bdd719ccf97dea784a046b7e121d0a",
      "translation": "“再说一遍。我是新地球联邦第88独\n　立机动军所属，尼奥·罗阿诺克上校。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation",
        "people/neo",
        "people/neo-roanoke-full",
        "rank/colonel"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation, people/neo；按日文源词绑定统一全局术语：rank/colonel。"
    },
    {
      "id": "story/096/dialogue/02.01/0032",
      "source_text_sha256": "07758f9e6362f6965bc0c710934aaf31d1dabd74f6d29f98077b71865298ddfd",
      "translation": "“什么穆啊、弗拉加少校的，我完全听不懂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "rank/major"
      ],
      "notes": "按日文源词绑定统一全局术语：rank/major。"
    },
    {
      "id": "story/096/dialogue/02.01/0033",
      "source_text_sha256": "11123f47daf9904072568f76ffc035373613f6a31c0d547123c576f8fd5c11d2",
      "translation": "“这到底是怎么回事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0034",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0035",
      "source_text_sha256": "160066675d0f1cbaa2581c5febb66610f82946e0bada630ee3a81bd2eb0cab5c",
      "translation": "（作为精神控制研究的副产品，\n　存在记忆植入技术……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/096/dialogue/02.01/0036",
      "source_text_sha256": "f675282a02c9d881247860f67e4ad965c9d0575292ea127baa8fce6bd4b9e0ac",
      "translation": "（这个男人……\n　被植入了作为尼奥·罗阿诺克的记忆吗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/neo",
        "people/neo-roanoke-full"
      ],
      "notes": "嵌套词表子串自动例外：people/neo"
    }
  ]
}
