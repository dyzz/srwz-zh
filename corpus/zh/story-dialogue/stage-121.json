      "source_text_sha256": "4b525e2f791b43b37911b90e6ff31c885aed0fbb77d11e6854972ca96e869d28",
      "translation": "（真……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.01/0001",
      "source_text_sha256": "8770b5816929376a7e378b35300120d9920c7bf226f3210e445742122f9693b5",
      "translation": "（卡缪……大家……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.01/0002",
      "source_text_sha256": "a191c8b6f27acf23590d28b24e9ac81dd8df4e2acc9bf8646981d26ede414533",
      "translation": "“引擎启动。我们就这样升入宇宙，\n　与ZAFT本队会合。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.01/0003",
      "source_text_sha256": "37d1bd4a57e324849a0c31de0a33c2058ff1e83b1d62d75cf22df73ac642ce80",
      "translation": "“明白……！密涅瓦，出击！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/launch",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/121/dialogue/01.02/0000",
      "source_text_sha256": "eda2e562ddfbc485fd2ededec4622e4922a0133566da6b455a93aa4ee6ffd880",
      "translation": "“走了啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.02/0001",
      "source_text_sha256": "31327d9352aa2b49f435ff44401de2c5cf42cad524666f6d5e86ae223464f3b0",
      "translation": "“她们自己选择了自己的道路。\n　我们无法阻止。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.02/0002",
      "source_text_sha256": "720a34d04cb09261118968ffa3cb79b6b7461faf2942069b2d0f7347fe60a6ba",
      "translation": "“但是，说不定我们……也会变成敌人呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.02/0003",
      "source_text_sha256": "eee0f3377a34a9662cc7cde6721a9a213d9893b72be697d219d67e47368dc9e6",
      "translation": "“希望我们心中对议长的不信任，\n　只是杞人忧天。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/121/dialogue/01.02/0004",
      "source_text_sha256": "f85ff6869745235a05ed580a65a01784b26b4e4c947444656f759e7f7f9afe64",
      "translation": "“而且，\n　我们必须以没有密涅瓦的战力前往月球。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/121/dialogue/01.02/0005",
      "source_text_sha256": "24e971bd329714d576024b3fc7bea654745a3ca393922b0a44370048d29b4640",
      "translation": "“月球……LOGOS与骷髅月联合的据点……\n　再这样落后一步，就会无法挽回了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:official-logos。"
    },
    {
      "id": "story/121/dialogue/01.02/0006",
      "source_text_sha256": "3b536743bf7699efbe4bced1aea7b163961b3aafdbe41595d2892e072d7af329",
      "translation": "“在那之前，无论如何都必须先击溃他们……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
