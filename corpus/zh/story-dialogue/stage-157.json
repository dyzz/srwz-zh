  "entries": [
    {
      "id": "story/157/dialogue/00.01/0000",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿伽玛舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0001",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿伽玛舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0002",
      "source_text_sha256": "8237e0b96f18e4a762c1bba65f7fdeb05b7716948871c3107c0a12399e929a8e",
      "translation": "阿伽玛舰桥",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0003",
      "source_text_sha256": "d3d309a4042ee836c8a7f7dece25c1723e85fe89c01ab101bbdcde5b60f7463b",
      "translation": "“这一带频繁发生恐怖袭击？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0004",
      "source_text_sha256": "506ba091f53af6924fe12dc9c6cbe76392dc53f44495c7f302c3c29ee08bb1c6",
      "translation": "“据ZAFT的调查，在街头和港口等地\n毫无征兆地发生爆炸，\n造成了大量伤亡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0005",
      "source_text_sha256": "952f738e6c39fc8a06146c259d7a97f8ca95463b0462aead0caf600a374f8d04",
      "translation": "“不过，既没有犯案声明，\n也没有发生规律，甚至找不到\n安放爆炸物的痕迹。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0006",
      "source_text_sha256": "328ea9a06a9a9fcd1efb2f0b5b2c0c22f821460ebc9cc821c28b6fb21f3d3ef0",
      "translation": "“既然看不到犯人的主张，\n也没有政治要求，\n用‘恐怖袭击’这个词恐怕不太合适……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0007",
      "source_text_sha256": "0de1f0931d7197fef93ded23d2c90b762bab19dd9082aaa204714802f42c5648",
      "translation": "“而且，既然有使用未知技术的痕迹，\n很可能是外星人所为。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0008",
      "source_text_sha256": "75eca482010f57aea654249818d207c5999d3c90d28c44c1d8380c72858a319f",
      "translation": "“是异星人联合为了让社会陷入不安\n而采取的行动吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/alien-alliance"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0009",
      "source_text_sha256": "b91f74ae6b1ca387d278ba92ce61934801010428969036d281091e8b5df91e99",
      "translation": "“意图虽然不明，\n但有必要进行调查。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0010",
      "source_text_sha256": "dd2c78bcb96b508c7a18fdf9d9e9428c2ae1deb6eb3a908871c61ec05f6b0318",
      "translation": "“布莱德舰长，帝皇比亚路\n将负责调查事件并警戒周边。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d",
        "unit/king-beal"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0011",
      "source_text_sha256": "8a1cd76d00d9352c1a04c97ba096d20a9dae975b2f748f6b07415b5d5612a6e6",
      "translation": "“了解。\n我方在与奥古的补给部队会合后，\n将与密涅瓦一同前往直布罗陀。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar",
        "spirit/resupply",
        "system/resupply",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0012",
      "source_text_sha256": "3d6d9eced8d43e908883d34848dacf56ad9cfc4e5365f55d672682365a9064d2",
      "translation": "“在直布罗陀基地，\n还预定与迪兰达尔议长进行会谈。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal",
        "place/gibraltar"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0013",
      "source_text_sha256": "ec85a81f616c648874e324b863880a9af67080d34fc5623f5a9398ba59d73aea",
      "translation": "“奥古作为组织正在协助ZAFT。\n布莱德舰长应该去见见议长。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft",
        "people/speaker-312cbf08471d"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0014",
      "source_text_sha256": "be86b6664d5c09698fed113e1cb2c71b65c35f84cb5fb914c1e2906f661f4962",
      "translation": "“这边预计会与外星人交战。\n就让我们以超级机器人为主力来编队吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0015",
      "source_text_sha256": "bb5a473fd2ce4678ea7a3835105515522add8e786a0e845dd656b5cd61f9c55f",
      "translation": "“那么，赞波特3、魔神小队、\n巨神西格玛、格兰骑士团\n就编入帝皇比亚路……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/gran-knights",
        "unit/god-sigma",
        "unit/king-beal",
        "unit/zambot-three"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0016",
      "source_text_sha256": "36408a450191bb7a576d95143bd0dea02b24f29a2f20cf8ac01dbd2e8e2e3d15",
      "translation": "“这边则配备奥古、ZAFT，\n以及米利夏的罗兰等人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft",
        "people/loran"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0017",
      "source_text_sha256": "29181d733a80b6a2d8fbc296393049978dbac6a7c1f6200047780673d3b8dc53",
      "translation": "“$n君\n打算怎么办？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0018",
      "source_text_sha256": "fae69fffb77f00d143be41e52735810dbb2862a4d4b54c3eecb86ce472b17699",
      "translation": "“虽然有所恢复，\n但她的精神状态仍然不稳定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0019",
      "source_text_sha256": "37eb741f1eb2393e23e99f00ee7f035f57cf122417d89f15e79b3f4062b62f48",
      "translation": "“雷本大尉虽然陪在她身边，\n但编入哪支部队，\n我难以决定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0020",
      "source_text_sha256": "a1b7adc833c26d4af7364f44475ddda7fde7a03498402f77e7f29c4c5f5b995d",
      "translation": "“不过，现在的她\n正把悲伤转化为战斗的决心。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0021",
      "source_text_sha256": "a734d3a769ca556a7841cb2c6c899986a93077424e76dd8dc9c8bb15e0e543be",
      "translation": "“无论编入哪边，\n她都不会迷失自我吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0022",
      "source_text_sha256": "b885050a4b9dde0fa06a4e7e51be21a9cfcd825b8ddb8d99ada130019c6a89da",
      "translation": "“那么，$n和雷本大尉的\n去向就由我来决定吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben",
        "people/speaker-12eb2b5facdc"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0023",
      "source_text_sha256": "3c869185424a1e5ef4cf9348b0ea59f1f518781d0287b9a1f97aafd515bc3807",
      "translation": "“布莱德的选择”\n“1．让$n前往直布罗陀基地”\n“2．让$n负责周边警戒”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d",
        "place/gibraltar"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0024",
      "source_text_sha256": "3bdade783f57918bcc071223e4b03aa044b639deaf07c53b80175a5e9222fe00",
      "translation": "“爱玛中尉、蕾柯亚少尉和露娜玛丽亚她们\n都很担心她。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/emma",
        "people/lunamaria",
        "people/speaker-2f643283052c"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0025",
      "source_text_sha256": "3cc9ee21108bd8acf95f75416746fa2761e174bf678b4ee7152b6d56c1a123dd",
      "translation": "“因为同为女性，\n$n的事就交给她们吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0026",
      "source_text_sha256": "e8ea3bb97784680d6504dad80056afb6a412ed47a1859b4d67a67e705b887b24",
      "translation": "“了解。\n那么，等人员调动完毕后，\n帝皇比亚路将单独行动。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/king-beal"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0027",
      "source_text_sha256": "aaa2ea76163c775b25a3562d4fafe8231f6657c863527702e75e43f20f2bbdfd",
      "translation": "“关于再次会合，\n我们稍后再议。\n祝各位平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0028",
      "source_text_sha256": "ab94b728aca822d03143d0b84397c22ab208c5617688f5d2c99b4ae899864490",
      "translation": "“你们也是。\n请代我向迪兰达尔议长问好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0029",
      "source_text_sha256": "5df97b38aa2990499fcbb30bf075347bc22d86b622a045da812813f0cb24961b",
      "translation": "“直布罗陀基地周围也有耳目。\n我不想让她现在考虑\n战斗以外的事情。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0030",
      "source_text_sha256": "9c1c2a706736f4708884f4f1eea6dd9aedbadab5767f24d44b74ea9f1e687d2b",
      "translation": "“了解。\n那么，$n君就由我负责照顾吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0031",
      "source_text_sha256": "72da4e943b5cabb323ceb6365f9463cc75046439645260dd2171230261f56d74",
      "translation": "“老太婆和花江她们\n也一直在担心她呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-61c33479914e"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0032",
      "source_text_sha256": "8b4b3fed563be38b2d717918d47afa2f881f46a901c3758da943cf8f537cf8eb",
      "translation": "“那么，等人员调动完毕后，\n阿伽玛和密涅瓦将\n直接前往直布罗陀基地。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/gibraltar",
        "unit/argama",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0033",
      "source_text_sha256": "d3e568533d098efc2eb12c07d44624a01f87aeba52535838199863e28c15c803",
      "translation": "“关于再次会合，我们稍后再议。\n一有消息就会联络。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0034",
      "source_text_sha256": "ca1cb84082e789ee6c8712d71a15c986a11ff96cb2aadec9b64efc89c9cd6589",
      "translation": "“请多保重，兵左卫门先生。\n祝各位平安。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-ec24b8d9e164"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0035",
      "source_text_sha256": "ef62b5d11123aa91b4913ab1e50cab9c9abde461eb91eaecc358150f021db1dc",
      "translation": "“你那边也是。\n　也请代我向迪兰达尔议长问好。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0036",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "舰内　个人房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0037",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "舰内　个人房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0038",
      "source_text_sha256": "8050498fc512c9f46d261388041a63ce6e6e1e6fdb38f7bcb63bda801fe13447",
      "translation": "舰内　个人房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0039",
      "source_text_sha256": "068433cd0c336f1900f64e2bfe73a0eae7e608a3fa61456a69f42dc36d40f641",
      "translation": "“……桌子上有什么东西吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0040",
      "source_text_sha256": "ded0089e0e3a273dc97c29d23ee98824e8cfa9e86866362bb54b7e74ecb1a18c",
      "translation": "“给$n的。\n　我们大家一起烤了巧克力曲奇。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0041",
      "source_text_sha256": "99a7c431891846f8c790f0e2601806778d0752d658b9e6b955b70277f62bd621",
      "translation": "“听说疲劳的时候吃点甜食比较好，\n　所以多放了些糖。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0042",
      "source_text_sha256": "508e034a55ad61cc7b9b4562d989bcacde897f8f44311ec0c78bf8258246f34e",
      "translation": "“烤了很多，\n　$n也请尝尝吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0043",
      "source_text_sha256": "3de888b0f66476583453b8547dd4a644fd504885e94bfa262da0b05e2b31c4e2",
      "translation": "“谢谢大家……\n　那我就不客气了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0044",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0045",
      "source_text_sha256": "0835e0ab6eb01e1080e3f5e6b3e966b871333c058f6aa049993326bb08a3a1df",
      "translation": "“不甜……？\n　不对……连味道都没有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/157/dialogue/00.01/0046",
      "source_text_sha256": "d22f998bff1fa77f131b4de6c3b9b6eb3c71b77115ece3e7e46c9a9f2d9ba9ad",
      "translation": "“我的舌头……坏掉了吗……”",
