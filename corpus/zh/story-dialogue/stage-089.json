    ],
    "entry_count": 81,
    "unique_source_text_count": 77,
    "translated_entry_count": 81,
    "punctuation_only_entry_count": 1
  },
  "entries": [
    {
      "id": "story/089/dialogue/01.01/0000",
      "source_text_sha256": "7b7e2e3145fd9cb76cb7d9c8e655a1fc10b1ce22a90742d98edd0c77d8b7bbd1",
      "translation": "“觉醒了吗……真正的超限恶魔……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.01/0001",
      "source_text_sha256": "4f0d7ec2b86486960a369e8434ba832348911d4d33cd676af3cd72fed52b44ed",
      "translation": "“呜哦哦哦！超限恶魔！\n　我能感受到……惊人的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.01/0002",
      "source_text_sha256": "ea900de6f1ad3afa0705ecfae8613d54a1670e0e3acd47435c3e4d2344feb295",
      "translation": "“这简直是恶魔的能量！呀哈哈哈哈哈哈！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.01/0003",
      "source_text_sha256": "88d74e4ad80d89a15ec576bdf0aa5f1f859a977b3caf7f9e6246af8e58c1a028",
      "translation": "“那家伙！想接触超限恶魔吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.01/0004",
      "source_text_sha256": "b45cbbb289cf3c533bdd806abb47b30d1e6332e704af1da3476b913719c2f857",
      "translation": "“我要得到它！\n　将究极之力掌握在我手中！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme"
    },
    {
      "id": "story/089/dialogue/01.01/0005",
      "source_text_sha256": "5c69dd99788ad5529dabd978767c4194dbb2cdad695e65e0509265375c0c3f33",
      "translation": "“来吧，超限恶魔！赐予我力量！\n　把全部力量都给我！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.02/0000",
      "source_text_sha256": "3c669232c8047d05c18f5e0324af72c5b533caaa4b1b77c924ce3cdf734abb63",
      "translation": "“为什么！？为什么毫无反应！\n　还缺了什么吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.02/0001",
      "source_text_sha256": "85850b9c43ef18c7f791a16bbc5d5566ee7326708dab50373f958387cae149f9",
      "translation": "“缺的是你的品味啊，阿斯哈姆君～！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.02/0002",
      "source_text_sha256": "eb4259cf3c9e0b99bd32a07d8ed8ee97b6a5d9ac7a60ed7de34ce6c216e822ed",
      "translation": "“唔唔！你这混蛋！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0000",
      "source_text_sha256": "32fbe3305ac31506a37683a5f0386346cd1604a35343168aea00ce61e121cecb",
      "translation": "“哦！回来了吗，辛西娅！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.03/0001",
      "source_text_sha256": "ee3fa136aa0d3437a73b1e32e14fad2cec9341a336f2e9b3f463255f0e432154",
      "translation": "“那就是辛西娅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.03/0002",
      "source_text_sha256": "f3c0149b8a440172c159192fb26210057653af3b59405291876f5543744f7117",
      "translation": "“超、超限恶魔也在这里！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0003",
      "source_text_sha256": "55bee78eb7c9db0d4e66d8693f378c8c9e0962b148565de5b0bccdadba4e3dac",
      "translation": "“切！来碍事了吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0004",
      "source_text_sha256": "0bbc53ff0bb22a9b4379ec2106850b922e5cfa1df398fd32a2431b093f9d4307",
      "translation": "“阿斯哈姆·布恩！\n　你对基兹大人做了什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0005",
      "source_text_sha256": "6c07c5df4f9868cc218ea510a735010e4a3374f55db613d4de576b4732a4a636",
      "translation": "“闭嘴，突击娘！\n　连个毛丫头都拦不住你，我没空理你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0006",
      "source_text_sha256": "8480de7169c75f3b01097694e220081ec8041426e632cb2cb35854bc1bd0848c",
      "translation": "“你这家伙！就算是玩笑也绝不原谅！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0007",
      "source_text_sha256": "042b363f38201a3dc87c08fa4530375e486bc0f8d8cb507da6fc5157f7101123",
      "translation": "“本以为你有利用价值才对你客气，\n　看来是我看走眼了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.03/0008",
      "source_text_sha256": "b347f425083150b5f4cde36cc578c57407aff910cc6c98c2ab5eeab07db00bd8",
      "translation": "“我不会原谅你的，阿斯哈姆！\n　绝不会让你伤害基兹大人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.04/0000",
      "source_text_sha256": "78b196b776261f0da362594090b51e189510fa2672a9a13e94ead534d6a71c6f",
      "translation": "“什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.04/0001",
      "source_text_sha256": "2438a4919814613e021bd8f9f813f2cfb08c3da258da3ab54e5cfb4e1e8a4a00",
      "translation": "“辛西娅·雷恩！这里交给我！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.05/0000",
      "source_text_sha256": "115bf34dcee4eb99aa9c06dd531b9445514a96837e7735a8ccdb400a2a90659e",
      "translation": "“啊……啊啊……好冷……冻僵了……啊啊……\n　我的……钻石……冻住了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.06/0000",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.07/0000",
      "source_text_sha256": "a739c23310201001934d7697089befcc572bb9f5ced156924af1e31a6ed39b2c",
      "translation": "“别、别过来！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.08/0000",
      "source_text_sha256": "eb8ef602f8b8cf68f4efb84cea0df04b7a2275b258d7d4c9cb77907cbb42dad8",
      "translation": "“不、不要……！\n　我不想变成远古时代的冰之女王！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0000",
      "source_text_sha256": "42c3e13d5661e13006b05cc8dda9509f38ff43f787cf759be886f5cc71e42ae4",
      "translation": "“超限恶魔要吞噬辛西娅吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia",
        "unit/overdevil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.09/0001",
      "source_text_sha256": "1044a1605b31070f255381281e0cbbf57177c37d93b5feee369dfb141246921d",
      "translation": "“啊……啊啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0002",
      "source_text_sha256": "5b8c4c949799639091c36256200617e8f9151808d83bbacbdfbff72a784fa05f",
      "translation": "“辛西娅！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.09/0003",
      "source_text_sha256": "b1e6e33b0e5c9f699be0ff75498961a05571082e23291183ebbed23b11711206",
      "translation": "“为什么，超限恶魔！为什么不选我！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0004",
      "source_text_sha256": "c5443e258df722c5d1bb11d30312029ab08f9090c74d4d1021f6d5ff01d1e275",
      "translation": "“我真正想要的东西，什么都得不到吗！？\n　卡琳的心……该隐的力量也是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gain"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0005",
      "source_text_sha256": "f40a32495bd95bccfc3ee73e988296c623ace4cba38161a0701c87cb94276176",
      "translation": "“超限恶魔！为了我的目的，\n　我需要你！我想要你啊！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0006",
      "source_text_sha256": "fddf3ef0bee0482072f4bcc3c46253c2e9d33a9712f2e86aa99d73f936b598b0",
      "translation": "“把我！这充满绝望的灵魂献给你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.09/0007",
      "source_text_sha256": "c3dc284957e0aaf388cbee23c25e821534a1c16724cf99c7aa4cc8c785f186f4",
      "translation": "“所以！听听这个叫阿斯哈姆\n　的可怜男人的声音吧！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.10/0000",
      "source_text_sha256": "fd086d77543090edb1b156cc63e996c273f774c84cae34aa9b2e131b270da154",
      "translation": "“哦哦！哦哦哦哦！！\n　你回应了我的声音吗！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.10/0001",
      "source_text_sha256": "56f3058d13914771c6fe83591431464f5bfc375124f05a239d77892b2f72deab",
      "translation": "“多米尼达！到我这边来！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "user/unit/dominator"
      ],
      "notes": "正式词表构建审计修正。",
      "glossary_exceptions": [
        "unit/dominator"
      ]
    },
    {
      "id": "story/089/dialogue/01.11/0000",
      "source_text_sha256": "e20d45027754bb29a4bc7a46620f3fdda34ab51db0a36a96f651b5b4c946e6e7",
      "translation": "“歌唱吧，超限恶魔！\n　让世界OverFreeze！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.12/0000",
      "source_text_sha256": "4d64fc00fa9767c9c6561a839df385c5385faa62ace78b0ff9421fd6b41a151a",
      "translation": "“不好！阿斯哈姆那家伙！\n　被超限恶魔吞噬了心灵吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.12/0001",
      "source_text_sha256": "95cd0283e4ddc9c458f0bf153ce05916f2fb487473f1be55149f1269a6536acf",
      "translation": "“撤退！放弃阿加托的结晶！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.13/0000",
      "source_text_sha256": "4eec674a8127bd1383c2c50a04d9135ae3ce148600f3cfe587717f76c47fe237",
      "translation": "“辛西娅……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/089/dialogue/01.13/0001",
      "source_text_sha256": "2678ba11fcd6fa6a8f56f294ee5dd4d75aa9c8067e196e255e9e1efbe0f696c7",
      "translation": "“重整态势！联系全世界西伯铁分公司！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/siberian-railway"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0000",
      "source_text_sha256": "598667970e0ab7897a24cb4e422f1041d2e246f1b791a4cd9426fecafe8b9798",
      "translation": "“那就是超限恶魔的真正力量……\n　黑历史中传颂的破坏军团的一员……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0001",
      "source_text_sha256": "c4ff3c4ec14b803fcca7fcc63c8b42bcb1d5654e247bafac7bd382a446fd3477",
      "translation": "“堕天翅、超限恶魔、月之蝶……\n　世界正走向终结……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0002",
      "source_text_sha256": "30825d93bec021916c729a36e48dbacfdd59a8a0fb667951bb446c20c4ceea66",
      "translation": "“那最终显现的真相……是巨大的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0003",
      "source_text_sha256": "b2a275062f27ab1cac3482b323fb67dc0bc9f3ee15bc600c8c8c2c4a970bc9ea",
      "translation": "“哈哈哈哈哈哈！超限恶魔啊，\n　用暗黑的白夜覆盖世界吧！！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0004",
      "source_text_sha256": "81df574ddba022bdb083e9a5424d6513e42b08923c7fe30b57071e9718cc350d",
      "translation": "“既然你不听我摆布，那也无所谓！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0005",
      "source_text_sha256": "60459efe47cdaae136f20d949449a977aee1d108b03b0c07bfeb67ef8501fb2a",
      "translation": "“但你听到了我内心的声音！从今天起我\n　就是你的一部分！与你一同冻结世界！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0006",
      "source_text_sha256": "89952908c62d47fa5290ea420ae4b8ca94dc0f9fe7b830bac0cdd4d29c7a5829",
      "translation": "“哈哈哈哈哈哈！哈哈哈哈哈哈哈哈哈哈！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/01.14/0007",
      "source_text_sha256": "e0151a2223643ec731662523c4b1cf2a795a4c07bc660a1d9615e8fb25bf8b28",
      "translation": "（盖纳……好冷……我……快冻僵了……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "巴扎会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "巴扎会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "巴扎会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0003",
      "source_text_sha256": "3ee7547772f6529e59918b904e2fa4ec469cee1cddbd00be48d214e0799f3cb0",
      "translation": "“你在干什么啊，盖纳！快回钢铁齿轮！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "unit/iron-gear"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0004",
      "source_text_sha256": "fe0070d6aac54e18c58989839a72dd42281ddd8b0e3a6dddca72d64350fed7f2",
      "translation": "“等一下！这里的市场……卖好多滑板！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0005",
      "source_text_sha256": "8a8717de91158c629d36c624b2bae7d38d3f9e11426bf2def3ed8c1c6268efa7",
      "translation": "“你这家伙……世界大事当前，\n　还悠闲地购物吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0006",
      "source_text_sha256": "d282bd1994b02a82409576e21358b9544d79ebd53117b85a1340a6229ea4b43e",
      "translation": "“可是……难得兰顿回来了，\n　想送点什么礼物……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0007",
      "source_text_sha256": "e5d49b4caf438380c750ba9b6da945325cfbb1a2c7b2ae5b2ab14377ccb322ab",
      "translation": "“就算这样，你要卖掉那张拉克丝·\n　克莱因的签名光盘吗？太可惜了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0008",
      "source_text_sha256": "6c95e8c7b4744113f81272f91d905ba9508282c71824de5d87b958769158627d",
      "translation": "“反正我已经不需要了……\n　而且兰顿……好像经历了痛苦的事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0009",
      "source_text_sha256": "237e78bbf615d2d4de2c12e08514d68dfbf0b3a1a8ee5f77fb49b3072f351d30",
      "translation": "“那家伙……似乎和那个查尔斯\n　与雷一起生活了一段时间……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0010",
      "source_text_sha256": "c8aff046303351c4041259fa46ca194131ca9c2552740f3db1b807a51e7f419f",
      "translation": "“真够呛……虽然是被算计的，\n　但还是要和他们战斗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0011",
      "source_text_sha256": "1f3643c175b8cddcd475350df4379bb65ab99b0e9c9fbd26a81c1583ef417cbf",
      "translation": "“明白了，盖纳大哥。\n　为了安慰小弟，那就另当别论了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0012",
      "source_text_sha256": "239a4fa4d291a3aa02e5e5f42d2a8c78208786a80599c43da923350ddd93deed",
      "translation": "“贝罗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0013",
      "source_text_sha256": "c70edc80e3ea0ed987ef4933146d713ffb429d465defc0fa0f8f472b0b831a56",
      "translation": "“但要快！没时间了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.01/0014",
      "source_text_sha256": "b8e888c23a599b26d861e8f6683e28c8fe68df540d41429b992976f883b1bd0e",
      "translation": "“嗯……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0000",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0001",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0002",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0003",
      "source_text_sha256": "3c6a13387038de99355800be4d14acbae3c7859533037b3115e7eb07b5acb8b1",
      "translation": "“……兰顿，不介意的话……用这个吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0004",
      "source_text_sha256": "82c3f87d429c01921bca13947aaff6b9740dc923032fa2f926eaadd1d432a416",
      "translation": "“这么多《轮》，您从哪弄来的！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0005",
      "source_text_sha256": "6223f5f809f355f6d474c43278cb1b0da02c09f641de566a1abae997ea411cfc",
      "translation": "“真厉害啊……还有稀有货呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0006",
      "source_text_sha256": "aee969076df6cc6dd52322debec4c7e2743f5af424e09c2e3f593d5013ed905d",
      "translation": "“有点额外收入，就随手买了些。\n　我不太懂滑板。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0007",
      "source_text_sha256": "12039308f216d83df3373e97b50c416fae4fb2166ed8dc2984c065305a47ae2e",
      "translation": "“……真正的边境骑手，\n　不装轮子才叫酷吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0008",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0009",
      "source_text_sha256": "f04abd16e4490f59699e05bc5e1da8635c8150c6b758befc1a6349fba5a25aff",
      "translation": "“一个熟人的话。教会我很多东西的人……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0010",
      "source_text_sha256": "580168dc8314ae11d204acc020af597606941ec6116d08083235c49ef8ad5479",
      "translation": "“那个人还说过。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0011",
      "source_text_sha256": "cd3dda26130f11a0e13d9a155d71056f8e5ffcbeafd5ebfa0d8273d0bdc8a2d7",
      "translation": "“流行和别人的眼光都无所谓……\n　有趣就行……滑板就是这样。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0012",
      "source_text_sha256": "fe199949927915899987769303ceeec7f2d54261a41a4bade0930862699b97d2",
      "translation": "“这样啊……真像那大叔的风格……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0013",
      "source_text_sha256": "6f05bfb9abd2abef44a15376b9be817da4d38362cacbec6fae6ee8d11350c896",
      "translation": "“抱歉，兰顿……那个……\n　让你想起那些事了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0014",
      "source_text_sha256": "77f73a16458c646e222dc35499ffe18d98e4fa0033d66d97b265e6b110042c2c",
      "translation": "“没关系，盖纳大哥。\n　我……从没打算忘记他们……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0015",
      "source_text_sha256": "efde30da0f5e80d73ad4d263bf63c70bd0836479ef006fb3df2dfad0296ca812",
      "translation": "“兰顿……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0016",
      "source_text_sha256": "67d25557131d443391540be0586d9ac2cdea0869e163bbc0ebd1a0d40042b06e",
      "translation": "“谢谢你，大哥……我会珍惜这个轮的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0017",
      "source_text_sha256": "a9e96750f9265366e396d52daf0c91d921788593b7688c1e879409e14c4f7c0f",
      "translation": "（查尔斯先生、雷先生……等安定下来，\n　我也要像查尔斯先生那样用大轮试试……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/089/dialogue/02.02/0018",
      "source_text_sha256": "194215cbe2061a7fc6056a4a2b32d2838934547473b7fc37ee80e1dff7e9fb3d",
      "translation": "（爸爸、妈妈……你们教我的生活方式……\n　我……绝不会忘记的……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
