  "entries": [
    {
      "id": "story/163/dialogue/00.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0003",
      "source_text_sha256": "c950029c0eff90e5eaa07c8cf914d7319118409b7921cc24faf3e02ef6ecdc6d",
      "translation": "（优莱卡、霍兰德和补陀落……\n　那里有我不知道的什么……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/voderac",
        "people/eureka",
        "people/holland"
      ],
      "notes": "按日文源词绑定统一全局术语：organization/voderac。"
    },
    {
      "id": "story/163/dialogue/00.01/0004",
      "source_text_sha256": "6845c74b133b5a957707f8da58da856d1427e679317953bc44e07e06c46bf212",
      "translation": "“怎么了，兰顿？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0005",
      "source_text_sha256": "4cb03fd27ece891530daa89ce560ec7a32b5c82a6b075175b545189eb353dc48",
      "translation": "“不、不……没什么！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0006",
      "source_text_sha256": "df34e650c36389830099351aff1016fbf5c9e27513f554677c790ce9a7bd3858",
      "translation": "“难得盖纳大哥邀请我来集市，\n　我却发呆，真对不起。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0007",
      "source_text_sha256": "7b443fc3377de0c6901f480e93112491db6a0cb15c9336f7c5efcbc513a8da59",
      "translation": "“话说，盖纳……你为啥叫我们出来？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0008",
      "source_text_sha256": "1c6f4a51eab1115be59a25bd5836c17a7672f55646c1731f3105a28dde187c89",
      "translation": "“嗯……\n　我想把这个已经不需要的东西卖掉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0009",
      "source_text_sha256": "ef7781c3cffc68e629e92cbb4eb4c407a2c256acce509c5ce50848b1e73909d1",
      "translation": "“这是！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0010",
      "source_text_sha256": "08f88a153a30d7a3513159f96eb1eca56de5d7ee6f44e40df7493ed9bc107cf1",
      "translation": "“这不是《ray=out》的创刊号吗！\n　这可是相当稀有的东西！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0011",
      "source_text_sha256": "2e03b0528f8d7ddc96d6200923f38f7b075bcf6083325ce67e6e12024ff0cf86",
      "translation": "“果然是有价值的东西啊。\n　让你们看看真是太好了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0012",
      "source_text_sha256": "38499776133964324d438affd8b8b4f3baeb1ac10dcc3c86b746db2415727a47",
      "translation": "“盖纳大哥，你要把这个卖掉吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0013",
      "source_text_sha256": "ef45b7ad9c88ebe443631ba5ef19745f4a721f867447f7963cd5a41354d8b3fe",
      "translation": "“因为买这本书的目的已经达到了。\n　作为交换……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0014",
      "source_text_sha256": "7124c2ee0d539a691fc73405e6a84c9dfe0c523e742d5dae857271ba1e2256e5",
      "translation": "“我懂了……！要给莎拉买礼物对吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sara"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0015",
      "source_text_sha256": "12163753431ac606758fcfa0891507ede6476b76339bffe1c839ae0a4c501aad",
      "translation": "“也、也不是那样……只是难得来一趟，\n　想换点以后会升值的宝贝……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0016",
      "source_text_sha256": "8625a6c8b4997aef11d1861c63440ad13d7e9b50efbe4b2b73e41852e3c97d78",
      "translation": "“OK，包在我身上！我们帮你找礼物。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.01/0017",
      "source_text_sha256": "533175f15e9197efb6499bcaec709e01af7d9e6fbe03867eeb2ec9fe814e079e",
      "translation": "“所以说……！不是那样的啦！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0000",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/163/dialogue/00.02/0001",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/163/dialogue/00.02/0002",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "统一舰内地点名“机库”。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/163/dialogue/00.02/0003",
      "source_text_sha256": "83312d277c012de507fe7152d3d6f9810704fb53d1aaeb05af295ab8a862ee5a",
      "translation": "“那、那个，莎拉……要不要听听这张碟？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sara"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0004",
      "source_text_sha256": "41bf2872a823aec439a55ddfc4290a986f6990a7e437d371c2edd858870a9cdd",
      "translation": "“拉克丝·克莱因……？\n　那个PLANT的人气歌手？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0005",
      "source_text_sha256": "8b9d091ec1182ed368ab5acb576f172f8f905c13d81039b6fb23684ec4753bc5",
      "translation": "“真的假的！这张碟还有签名！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0006",
      "source_text_sha256": "74800adfe1c4e691be9bd2539a92710a265a5396e65213928b4b2ec90985170d",
      "translation": "“你小子……真能搞到这种稀有道具啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0007",
      "source_text_sha256": "35a42183b9e5081c9dbeed2b4a280d24019753b47f81127bf008074679900bd6",
      "translation": "“还、还行吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0008",
      "source_text_sha256": "9283e3c66429654860919ea3b17afaa67cdf9ae192f1e023bf2ed62e1e2f9786",
      "translation": "（谢谢你，基杰特……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0009",
      "source_text_sha256": "486f25c41130eb1aee7eaa82546b141888f99e83ab83fcc12fdb71f8f679ff2c",
      "translation": "“不过，没兴趣。在UN看过，\n　拉克丝·克莱因走性感路线，我不喜欢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0010",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0011",
      "source_text_sha256": "2bc0c89b4b420685eb835a1cad48bade8878625898cb6733118e1dc18cb46dc7",
      "translation": "“比起那个，盖纳你也来帮忙。\n　要用密涅瓦的材料修补雅邦天井。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "place/yapan",
        "place/yapans-ceiling",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/yapans-ceiling。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/163/dialogue/00.02/0012",
      "source_text_sha256": "f250eff6d2b563bd1ee1843834b4135ee3a771d795297185008542c9fc4f1751",
      "translation": "（难得的稀有品却碰了钉子……真不走运……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0013",
      "source_text_sha256": "1a9fbee62d34b7829c97180ff1ecaddb91976526795e56d0cd06f046828d47f6",
      "translation": "“高富力队长和贝罗也在等着呢。\n　一起加油吧，盖纳。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "people/speaker-542832967a32"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-542832967a32。"
    },
    {
      "id": "story/163/dialogue/00.02/0014",
      "source_text_sha256": "20114c76c2efcfaed45dd018c42a8fdaa7164fdb47090dc2dbe52fea470d7d8f",
      "translation": "“嗯。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0015",
      "source_text_sha256": "0e5daeb33bda1f4058e97f1f065d9a9dc7780d631f57d749045643d837a68537",
      "translation": "“……礼物虽然没成，但气氛不错嘛。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0016",
      "source_text_sha256": "de3f6b035317b7565035b55e4784f85a95990053d312b4f88921a9904bf8869a",
      "translation": "“不过，现在的拉克丝·克莱因……\n　不受欢迎了吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0017",
      "source_text_sha256": "5edf6558be90cc378cae559a8c73fef95a557a108197cccb4ce3234981e38a33",
      "translation": "“可能是因为形象大变吧。……\n　不过，我倒是不讨厌。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0018",
      "source_text_sha256": "e6c361a878081dc5535cf89ec9674eed46101300c0b9d8d1807510fc2a520db6",
      "translation": "“我也是，我也是！身材也大幅升级了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0019",
      "source_text_sha256": "8910a4854fa35c14b61dc2933946850ccf36cc7e7d8024870b5e2c1ab8a51525",
      "translation": "“大众评价先不说，\n　在PLANT的人气好像还是老样子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/163/dialogue/00.02/0020",
      "source_text_sha256": "0c5a975051209a0f1a7f79b484081722ed396b20885ed6e23b5f79962a14a64b",
      "translation": "“啊~啊……雪也看腻了，真想去看\n　拉克丝·克莱因的演唱会热闹一下……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
