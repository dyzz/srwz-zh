  },
  "entries": [
    {
      "id": "story/044/dialogue/01.01/0000",
      "source_text_sha256": "9089388c49716372a18568c73dea22504538643c46aec510306ce38639344bb4",
      "translation": "“终于要出发去日本了呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0001",
      "source_text_sha256": "90467eb51859ee95fb1fa3a8ad534cbbb2dedbd0223201efc5adbc9aeb1b1c30",
      "translation": "“来到加利亚已经两周了……\n　总算可以开始执行议长交给我们的特别任务了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0002",
      "source_text_sha256": "91379e3fd631c5d3cc3664f9a9d554eb056f21c3954d00324af7549f11778f22",
      "translation": "“向日本请求协助……既然联邦已经吞并\n　了奥布，我们必须不惜一切代价成功……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/orb"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0003",
      "source_text_sha256": "20443f8a93bb00a006991b78d0b1f6fc458d71bc270cd42d1e0ae71ac2ce409a",
      "translation": "“……如果现在的$c再加上\n　日本的战力，就能组成最强的部队了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0004",
      "source_text_sha256": "3fba352a0e5af9fa6036869abd1bea9783d3e803c2556974c3db454a7cf2bde5",
      "translation": "“这可难说……我们暂且不论，\n　但并非所有人都赞同ZAFT”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0005",
      "source_text_sha256": "be983e1d9427f1653534c0fe2c04179f8182f854dfdceefb5641ca0290570602",
      "translation": "“虽然表面上维持着部队的建制，但既然各\n　自的目的不同，说不定哪天就会解散……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0006",
      "source_text_sha256": "d291048f3fc558060306cd95c519f4dbbba282553d51ea7ade02dc58916c86fe",
      "translation": "“我们快点出发吧。\n　我也很担心我们的家变成什么样了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0007",
      "source_text_sha256": "74ac7d22b9a109b1fe12de8cabea999aa7407640410f6442dd655830b8f7ecb5",
      "translation": "“别那么着急，花江。而且也别指望现\n　在的日本还跟我们以前在的时候一样”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0008",
      "source_text_sha256": "c89a07c69bc076fe802002fb5d867948c1464e0d1d1be9ddf36e3309f51001dc",
      "translation": "“可那毕竟是我们出生的国家……\n　果然还是会在意啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0009",
      "source_text_sha256": "7716359b9bd533515f658e6225dde93808850e244050f20a801c904c6dc6dc27",
      "translation": "“那个日本夹在PLANT和联邦之间，\n　这处境真让人心情复杂……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0010",
      "source_text_sha256": "0625455bc9ec5cbef899f1c4ff4413a836ce7ae5a8dd53e4d918aa36ffc1561c",
      "translation": "“我站哪边都无所谓，\n　只想早点过上安稳的日子……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0011",
      "source_text_sha256": "f50a6aee29268b477632af2ff8389617adb7c7408f8e6c5e40495a3c1599423c",
      "translation": "（我们在与盖佐克和其他敌人作战时，\n　确实需要后盾……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "faction/gaizok"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0012",
      "source_text_sha256": "999c1075b36c086030a2bb8fee962883b0cd63c4e961991d9dea6edcd6116691",
      "translation": "（但继续这样与ZAFT共同行动，\n　真的是最佳选择吗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0013",
      "source_text_sha256": "2e3f52570f8e6e4dd1de8fefba4b03440d7a1fef6ce80644467269abca6aaf11",
      "translation": "“目标是传说中的土地——雅邦！\n　寿司、寿喜烧、艺伎之国呢！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/yapan"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0014",
      "source_text_sha256": "56a728c2dbf8983864a2eb20ffbdd846db87ca582acc4a8ea229a88121f98a0f",
      "translation": "“我们可不是去玩的，塔荷”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-c42b03f788ed"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-c42b03f788ed。"
    },
    {
      "id": "story/044/dialogue/01.01/0015",
      "source_text_sha256": "1110e8c127ef4f7f9ca4a153412b2e184038c7374e6e1095c705461add10a02c",
      "translation": "“那我们是去干什么的？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0016",
      "source_text_sha256": "a60e7e3148e62af8faf81ead61a94f55cd06bfe38363d5ec8c8e35ca9b08d45c",
      "translation": "“那边的ZAFT和奥古的人暂且不提，\n　我们过去有事要做吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/aeug",
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0017",
      "source_text_sha256": "eb6c11f79dd10ecfb4ee84ecbe4517bc11af9871b43fb08a7527f3d6f695f38b",
      "translation": "“……我怎么知道。这也是顺其自然吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0018",
      "source_text_sha256": "5c99de997ee1854d0e5abf276e8c97f6eab913111ab7b0516e92e0319f044f0b",
      "translation": "（这样真的好吗……\n　我有闲工夫随波逐流地活着吗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0019",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0020",
      "source_text_sha256": "3844a16d023b5925e7a1b533a8eeecae74709b099caa26b53aef4b6d3b763344",
      "translation": "“船长……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0021",
      "source_text_sha256": "8e2292957e9dd77697786be01f41f9430b9b4dfd6888bb983c51dd0654a5b509",
      "translation": "（联邦军不知道什么时候又会盯上蒂珐）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0022",
      "source_text_sha256": "b555be2a16c4b7e80ff57e553b0d42dda55b1560e42791581127e9d01a1a9091",
      "translation": "（而且，联邦军利用新人类到底想干什么……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "skill/newtype"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0023",
      "source_text_sha256": "f37f82c23998be67c720c70713f87fe49b5e1dac9e0f02ca7eaa3d25d296d615",
      "translation": "（根据他们的目的，说不定哪天\n　PLANT也会成为我们的敌人……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0024",
      "source_text_sha256": "afc83e375804530a85f137052492061d74e8bb0baf3d20ed5bef50611def2a1c",
      "translation": "“好了，出发吧，科特塞特！\n　目标是雅邦……不，日本！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d054189b475d",
        "place/yapan"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-d054189b475d。"
    },
    {
      "id": "story/044/dialogue/01.01/0025",
      "source_text_sha256": "4b6cf4ba2a1e8121a4ff113efba21ea11fa747ed8aa5bcc526d7ee9048058f8c",
      "translation": "“小姐，这样好吗？\n　就这么听ZAFT的摆布……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0026",
      "source_text_sha256": "3ea64df19f6bdbb4ca5ae53918db6ae4d0b72833045cc5e49ea9b025e54099bd",
      "translation": "“没办法啊。既然成了被联邦追捕的人……\n　那就只能大树底下好乘凉了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0027",
      "source_text_sha256": "3709ca683ceec5df3645e767d77d44ceb92da6e83b2a5084272513a7d4620a01",
      "translation": "（虽说是顺其自然，\n　但钢铁齿轮也站到了反联邦的立场上……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/iron-gear"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0028",
      "source_text_sha256": "8cfdb530df3663b45f479ad55aa3ea4da078f6ad920291b45a08a1ebc0e5795e",
      "translation": "（这样下去，\n　$c将成为反联邦势力的核心……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0029",
      "source_text_sha256": "935c5581fb16fced1ff4d63a398c06ced21e6533e92a2e231a09ff664c002792",
      "translation": "（如果能指挥这一切，\n　说不定能做到比夺回英格莱萨更多的事）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/ingressa"
      ],
      "notes": "按日文源词绑定统一全局术语：place/ingressa。"
    },
    {
      "id": "story/044/dialogue/01.01/0030",
      "source_text_sha256": "115721563390c0f52b2a6c0a92bd834112107e63a4da96bd064e58cf0e039299",
      "translation": "（只要继续作为$c的一员行动，\n　奇拉姆也不会轻易出手）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0031",
      "source_text_sha256": "c9ad06120132d9bbc191d6e56ab1ae4c9f4849e60f5826e84b7a5e8e5dc8a414",
      "translation": "（剩下的就是看准时机，\n　把桂带回埃曼本国就行了）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/044/dialogue/01.01/0032",
      "source_text_sha256": "06a6ef7dc3a71e562b1b7f9ce651e910646afe7ec07a7b6eea57c68fed93b418",
      "translation": "“你们俩怎么了？一脸严肃的表情……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0033",
      "source_text_sha256": "2149da8086ed37fe12cc5c56bc7f5b0d80bf2a610bd06191b4186e1699c0a5b8",
      "translation": "“没、没什么，摩姆……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-431100102afc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-431100102afc。"
    },
    {
      "id": "story/044/dialogue/01.01/0034",
      "source_text_sha256": "4d9e191b875bf2f684858167cff30724ed1353d4f946ef038df56ad61bf8c2a1",
      "translation": "“夏伊亚小姐，雅邦天井的各位都来送我们了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-7e722f885dfc",
        "place/yapan",
        "place/yapans-ceiling"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-7e722f885dfc。按日文源词绑定统一全局术语：place/yapans-ceiling。"
    },
    {
      "id": "story/044/dialogue/01.01/0035",
      "source_text_sha256": "54906c745e0c5e8d586d1f870238f46bf0b105b18732fde8d40fbb1891db7167",
      "translation": "“虽然发生了很多事，\n　但也要在这里和那些人告别了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0036",
      "source_text_sha256": "c3b33bad9fbe8eee6cd38c95e5b951925e7b5edff524ad050e07feb88293eb8d",
      "translation": "“$c的各位，非常感谢你们~！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0037",
      "source_text_sha256": "e7a75925c9553557a90854eed8cece9d0427983e5c491a54d538ce1250f74317",
      "translation": "“祝各位旅途平安”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0038",
      "source_text_sha256": "508d6457fe99d14decc99abfb225f592de88f4efa9873e015759ee22dff91e5c",
      "translation": "“盖纳、该隐！高利队的各位还有亚蒂特，\n　都要保重啊~！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/adette",
        "people/gain",
        "people/gainer",
        "people/speaker-980ee4d20d74"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-980ee4d20d74。 日文“元気”为普通词（精神、健康或保重），不是人物元气。",
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ]
    },
    {
      "id": "story/044/dialogue/01.01/0039",
      "source_text_sha256": "a49b8b687891203696ff1a13f698422c57d8b11678fbac637a8afad74fe340bc",
      "translation": "（夏尔蕾大人……祝您旅途平安）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0040",
      "source_text_sha256": "4c3bd35fc64b661dbd2b9c8f3ab55a7aeb5ee6a8cf04b2836193e798dd7b0187",
      "translation": "（优莱卡……愿你前行的道路充满光明……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0041",
      "source_text_sha256": "51bfbef54b25fd525327d93e206b8b1ed8c395db0666cc338e9ad5fa67021418",
      "translation": "“那么……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0042",
      "source_text_sha256": "f7666e5fd2e303e6d127d32b0032fd30eb6e62f83e498d0a0ceb8ce399d7ca47",
      "translation": "“嗯……$c各舰，启动。\n　目标日本，早乙女研究所”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.01/0043",
      "source_text_sha256": "dc572e61d6ff95c9abcda34d712d28d87314bcde83997156e9a62c62f671e47a",
      "translation": "“出发！前进~！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.02/0000",
      "source_text_sha256": "1c58432c4614d72a36b0e36cd60aebc248b6452e1d25220e19094a63cc4915c9",
      "translation": "“已经走了吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.02/0001",
      "source_text_sha256": "26b2b299cdd6052383ef868546048f3f1cebf9f6fe0335fb0ffd95172566f8c8",
      "translation": "“在这个混乱的世界里，他们是为了谁，\n　以什么为目标，又要去往何方呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.02/0002",
      "source_text_sha256": "b47b9c393042dadbc9454d7a2c12dcd17c1eb9d27f513a6b9bf01e5828bf0d28",
      "translation": "“……话说回来，安娜公主殿下呢？\n　好像从刚才就不见人影……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/01.02/0003",
      "source_text_sha256": "7d8809cc9c0b04a8012cea3e12db2375999ab60aaf811c73b86aa4b2e35b0acc",
      "translation": "“这么说来……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0000",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0001",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0002",
      "source_text_sha256": "ffd3bb0e60d167931d579d18b966958f8afd36c8f2608bc2f972363afeb7e2df",
      "translation": "盖纳的房间",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0003",
      "source_text_sha256": "4aa52e860ed5549d3b975b4104909c24684734695d9539922ed298c9e12055b3",
      "translation": "〜雅邦天井　盖纳的房间〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "place/yapan",
        "place/yapans-ceiling"
      ],
      "notes": "按日文源词绑定统一全局术语：place/yapans-ceiling。"
    },
    {
      "id": "story/044/dialogue/02.01/0004",
      "source_text_sha256": "2bc70f64b70bbe40a9e307202356a1e39177bde62a61a68b5b3b90850cc41b9a",
      "translation": "“……嘿，原来金他们进行过大逃亡啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0005",
      "source_text_sha256": "fec8abf8fd6e5a771de670ab66f0db8a6e3871593096a80b41b261fe4ddaa5e4",
      "translation": "“对不起瞒着您，辛西娅小姐。\n　在卡泰兹的时候也因此卷入麻烦，没能见到您”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/044/dialogue/02.01/0006",
      "source_text_sha256": "f069d3549336e80bffff1b4f805156d14323d758e8609c0433bc08d3cae460d2",
      "translation": "“不用在意。约会的机会以后还会有吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0007",
      "source_text_sha256": "4bf9ea51588dee83c8a014a451191191d2ae2c4e8c711dd81994e66f223e892b",
      "translation": "“那您愿意和我见面吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0008",
      "source_text_sha256": "65bf3c376a08329f3eb246ddaf7c3bc9357efb9dbd373e20cfd01c0294d65544",
      "translation": "“有机会的话。……比起这个，既然大逃亡\n　成功了，你们以后就一直住在那儿了吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0009",
      "source_text_sha256": "ea2497ab48357144dee2131aae407d7ec83a8be5e81f7a685e8f6878023fad61",
      "translation": "“不……为了我自己的大逃亡，\n　我还要再次踏上旅途”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0010",
      "source_text_sha256": "867b29fcb7f93412ad9f0d2652921bbf5e471c1360d861acabb33bfbc5496ec8",
      "translation": "“属于自己的大逃亡吗……真不错呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/exodus"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0011",
      "source_text_sha256": "da4c65a9740388d38c9d2e8aa7cb29ddb96cdd4208bdb27ffec6ca693cab4fae",
      "translation": "“盖纳！你还要在UN聊到什么时候！\n　要出发了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gainer",
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0012",
      "source_text_sha256": "24e9681a802426522c876d31621149356829371b0572cc67a71a46aafc8bb1bd",
      "translation": "“是、是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0013",
      "source_text_sha256": "943e220af3606ee96dbc9817dfcc515d25a80bf07bc8cd0a088aac590e48c704",
      "translation": "“刚才那个女人是谁？难道你们住在一起？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0014",
      "source_text_sha256": "96e8a5e0b0085956ddcd4a0b2be0d778bbd1f57a3d93fd61c18c91d4dd922782",
      "translation": "“怎、怎么可能！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0015",
      "source_text_sha256": "853ba771198c0d1fdb3e755efe85ed2ac08709877dfbc2e495a2789b084e7b0f",
      "translation": "“啊哈哈，金。祝你旅途平安”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/044/dialogue/02.01/0016",
      "source_text_sha256": "ac2f555c377274171bf653d90044eb5704f0c342abc9f56f1d2a04c40bed6451",
      "translation": "“谢谢您，辛西娅小姐。\n　希望有朝一日能再相见”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    }
  ]
}
