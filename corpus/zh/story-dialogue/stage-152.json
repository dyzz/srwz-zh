  "entries": [
    {
      "id": "story/152/dialogue/01.01/0000",
      "source_text_sha256": "6a5e4a56fb5c59ea6d6960fec5017795e389862e3fb3e7d1371a6f57a476384b",
      "translation": "“不妙！那个女人，打算对司令簇下手吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/command-cluster"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.01/0001",
      "source_text_sha256": "55e0d60cde46571bb5387d71369129f4fe41e247b5805e5795fb242d411369d9",
      "translation": "“看着吧，$c！\n　我要把那小丫头捧成司令簇！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/command-cluster"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.02/0000",
      "source_text_sha256": "3f86e85610929f8a3e816b9c14cdb339f8ca23112a3fb5b0ec2ac90e210c3901",
      "translation": "“优莱卡——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0000",
      "source_text_sha256": "53b1fc7f59eb4b3784b7ef5ad6ea893299d7213b8f507e94a9390bb29ef46666",
      "translation": "“次元边界线在扭曲！\n　时空崩坏要发生了吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/dimensional-boundary-line"
      ],
      "notes": "按日文源词绑定统一全局术语：technology/dimensional-boundary-line。"
    },
    {
      "id": "story/152/dialogue/01.03/0001",
      "source_text_sha256": "83e1bad000d6dd8db8c44c07596ae8a9515ef516326c263f1b0b96cd5bb8aed5",
      "translation": "“动手吧，桂！\n　只有完成时空修复才能拯救这个世界！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0002",
      "source_text_sha256": "b55ebea7231cb279e0c5cc3ccafbecc8452d4ac70ee32a645cf9cd636c1c13a8",
      "translation": "“可是！这里就是大奇点吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0003",
      "source_text_sha256": "94f189eff3649e4fa6ab69f5e3872a83588ba3354ea0f6eae9211edebd662f0d",
      "translation": "“已经没有犹豫的时间了！\n　这里确实离大奇点很近！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0004",
      "source_text_sha256": "7d14c601b691d42e02e836553d11a21b44a455419936dc191b1516c8a1a2731b",
      "translation": "“但、但是，优莱卡她！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0005",
      "source_text_sha256": "9979a5d6b5f7ac5139dce9c4c2d9fc72bb1319d2bcc38c653631b51e75fedb57",
      "translation": "“兰顿！集中精神！现在只考虑时空修复！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0006",
      "source_text_sha256": "8fd61e760b8e701fc670329b6121827ff0e52e96734e2dfce58b3b64477dbcef",
      "translation": "“可是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0007",
      "source_text_sha256": "00733cf75a482ef470e0e75e7d383d6975b5cddebf7df8156c65b3f8557eabe5",
      "translation": "“我们所期望的世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.03/0008",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.04/0000",
      "source_text_sha256": "237a321d2fcfcd31452fe7a4ddd29ad73bd7527b5348f7c0cc47754b59f973de",
      "translation": "“来吧，$c！\n　尽情吸食人类的丑陋、自私和懒惰吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.04/0001",
      "source_text_sha256": "d4328836ee259d7f1d8ebe31ac1e98db1720f8e690f8c30f736c1c61071cd5bf",
      "translation": "“黑之卡里斯马！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。"
    },
    {
      "id": "story/152/dialogue/01.04/0002",
      "source_text_sha256": "e3f143f224b67e0c766bda37dae42497467a91bdaa58066d06988abb1772c7d7",
      "translation": "“然后，拉开帷幕吧！新混沌世界的帷幕！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.05/0000",
      "source_text_sha256": "deff9560a8094a34fe0922d02b319b9b5d3b9a528a85e17e906c00bd6198259f",
      "translation": "“啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.05/0001",
      "source_text_sha256": "2c4d081d11f29c822eba964d5cf6b09a95d8ff980fe73584b4110eb01760d361",
      "translation": "“来了！全世界人们的思念都汇聚于此！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.05/0002",
      "source_text_sha256": "e7ca38ab4e5ae33138d5ef412ae9c1f7e4b3476536b0bb3c0a3941ade8222916",
      "translation": "“大家，祈愿未来！我们要修复时空！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.05/0003",
      "source_text_sha256": "a7cb3ad22ff9edb19b464a43b7010b0d3f42f65643114090cd75b363935dfe48",
      "translation": "“呜哇啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.06/0000",
      "source_text_sha256": "237a321d2fcfcd31452fe7a4ddd29ad73bd7527b5348f7c0cc47754b59f973de",
      "translation": "“来吧，$c！\n　尽情吸食人类的丑陋、自私和懒惰吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.06/0001",
      "source_text_sha256": "14e486da63d8f721794eb9a3c05c5e53df836ed6cc325248b2b90d48a51bdac6",
      "translation": "“是黑之卡里斯马那混蛋吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。"
    },
    {
      "id": "story/152/dialogue/01.06/0002",
      "source_text_sha256": "e3f143f224b67e0c766bda37dae42497467a91bdaa58066d06988abb1772c7d7",
      "translation": "“然后，拉开帷幕吧！新混沌世界的帷幕！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0000",
      "source_text_sha256": "efee1b199eb23c0427c1b17be2edabd8726f7b906e41f43d5fdc5fe1c584eeea",
      "translation": "“呃啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0001",
      "source_text_sha256": "d06337b0e61a62cb6c606e75f6f737a1dfc6976440af09c40734ea75daf22347",
      "translation": "“怎么了，梅尔！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0002",
      "source_text_sha256": "f7402c7ed534ad668f7297ecbe5a588fb6d372b8378d97d82614ac908c871d4f",
      "translation": "“身体……好烫！好烫啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0003",
      "source_text_sha256": "2c4d081d11f29c822eba964d5cf6b09a95d8ff980fe73584b4110eb01760d361",
      "translation": "“来了！全世界人们的思念都汇聚于此！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0004",
      "source_text_sha256": "e7ca38ab4e5ae33138d5ef412ae9c1f7e4b3476536b0bb3c0a3941ade8222916",
      "translation": "“大家，祈愿未来！我们要修复时空！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0005",
      "source_text_sha256": "5764c9f99b9e93dc86d04786064a6fd1d0767bc90a6080f6f92903462d62a51a",
      "translation": "“啊啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/01.07/0006",
      "source_text_sha256": "1a4708d5c82c5542f9be63d46ee9b23f1cd53a720e10b27a012cda7d25bee66c",
      "translation": "“梅——尔——！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0000",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0001",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0002",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/argama"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0003",
      "source_text_sha256": "b8a4cf0e2cd30c397be08bf3e0226156a205ecb49cc85d1e1e75d0575853b1ed",
      "translation": "（……为什么会变成这样呢……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0004",
      "source_text_sha256": "c2286e0282682a3288094e424c90e0959a799e622b69cfdc833ff8e6944d1033",
      "translation": "（是因为全世界的人们都\n　期望这样的未来吗……？）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0005",
      "source_text_sha256": "612133cf4b398afe85874788c9599cfbf0b1f5d6d53eaca83b7c43ad60220756",
      "translation": "（还是说，我的……我们的犹豫把\n　世界引向了无尽的战争循环……？）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0006",
      "source_text_sha256": "310178d14b24e00633a1a18cb3604d4159dfd8281fcdc354dda2c9d0fe6a7fc1",
      "translation": "“$n小姐，该出击了……\n　听说超限恶魔又出现了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0007",
      "source_text_sha256": "c9c016c1501f154a04a0443dd1e13fdab27673659655a8625f38b3ec88327206",
      "translation": "“我知道了……我马上就去……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0008",
      "source_text_sha256": "9cf616a6005e1536c7b925147fc962373ca4e19956b9bc9d85c971014f235b05",
      "translation": "“$n小姐……你的眼睛又……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0009",
      "source_text_sha256": "c9a39cbcb4ecb34a8334adaf682e9c071873a62444f64d23a6a83f9447ca2307",
      "translation": "“没关系……坐上巴尔戈拉，\n　我就会冷静下来……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/virgola"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0010",
      "source_text_sha256": "eeae1ee5dd94b2a96c2f0065fd30085ee3ff5c4431fbeb12eb11f1a63a61fd5d",
      "translation": "“可是……再这样战斗下去的话……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0011",
      "source_text_sha256": "12688a47d2217109062c5451a61c87f14450cda8caab9080e8c40d4e7e123034",
      "translation": "“但只能战斗……\n　在这个永无止境的战争世界里……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0012",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "钢铁齿轮机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0013",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "钢铁齿轮机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0014",
      "source_text_sha256": "a57b4bfd1d38a74d992de658b04b364f00dd5d91c13aa6fb7ccbf01a56447320",
      "translation": "钢铁齿轮机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/iron-gear"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/152/dialogue/02.01/0015",
      "source_text_sha256": "24fa157f3df3693cd09bbd7f4260c80a5ee6c59d6ece98bdcad2e06cad40359c",
      "translation": "“哈……哈……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0016",
      "source_text_sha256": "2e391dbd4f439849e39f526651a8de84beae6b54451793ea7df7e0af375b090d",
      "translation": "“你没事吧，$n？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0017",
      "source_text_sha256": "c195112ebee3bdb0ce6a50df83b43c656e4cb7cac8a443707401a38143625a3e",
      "translation": "“累是彼此彼此。而且沃卡加利亚也累\n　积了不少损伤。再出击就危险了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/walker-gallia"
      ],
      "notes": "本句是对白中的受伤或受损语义，保留自然中文，不强制系统词“伤害”。 用户确认术语定稿。按日文源词绑定统一全局术语：unit/walker-gallia。",
      "glossary_exceptions": [
        "system/damage"
      ]
    },
    {
      "id": "story/152/dialogue/02.01/0018",
      "source_text_sha256": "9c2b590f5be8a639048303412ce1e16f5f62b334f3ebc7677e5282587cf0fc1d",
      "translation": "“但必须战斗。这就是这个世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0019",
      "source_text_sha256": "715b15ad592e417270165bfe65186b1632215c58bd471088ace6165337e0ca63",
      "translation": "“……为什么会变成这样呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0020",
      "source_text_sha256": "5153cfb6afb7dbf5d9c06974793efc13ca8aff3d08aa34d07dd38d901a8a5f9a",
      "translation": "“全世界的人们真的期望这样的未来吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0021",
      "source_text_sha256": "b1b659e596e7b406b04874a02a8c7c8de882924d79c689cd33a4fac1b4eb812a",
      "translation": "（还是说，是我……\n　我们把世界引向了无尽的战争循环……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0022",
      "source_text_sha256": "c7776b8a22123c93c6c468d378db1d244e4bd48208807514b7d4d3ba08fcfb30",
      "translation": "（喂，梅尔……告诉我吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0023",
      "source_text_sha256": "284d83aa484f0a5125ed5715bdfb5b732c246707de2921a4dfd4dc445b81f203",
      "translation": "“大家，出击了！超限恶魔又出现了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0024",
      "source_text_sha256": "8113e1100261bb2ba0b71b8b34eb31c019bc344e4d21726f8704bdb9dbce6b29",
      "translation": "“请等一下！再这样下去真的不行了！\n　大家都到极限了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0025",
      "source_text_sha256": "1a908077ce6532dec25ddf1c4f573ef9507a0efb712c6cb381bdf227324b3304",
      "translation": "“……我去。我得为毁掉世界赎罪……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0026",
      "source_text_sha256": "4e27c74c702c0a6b435fa45222ad6cb2c26607f3fb872142c9c2c0bfcc1d14ef",
      "translation": "“$n……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/152/dialogue/02.01/0027",
      "source_text_sha256": "42134915402824d56c60b94a9ae9274d4e3ca3207dbbde84852024c76852d512",
      "translation": "“……可惜，\n　看来我果然还是那个破坏者啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
