  "entries": [
    {
      "id": "story/074/dialogue/01.01/0000",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "联邦军基地内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0001",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "联邦军基地内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0002",
      "source_text_sha256": "b6c59836661a18306cd7b2c26ac834d68e4c22cba2a8efd8024fcc8c6f180932",
      "translation": "联邦军基地内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0003",
      "source_text_sha256": "153fd38c4be105a28b7ca0834b04d981394934ea98a2c65a1350ccf89b7c4ee5",
      "translation": "“你那边进展似乎很顺利啊，夏基亚·弗罗斯特”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shagia"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0004",
      "source_text_sha256": "4051795612b3a10f7c60e43722369e2c610f2031203f4fb290249797c9521594",
      "translation": "“感谢情报部的协助”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0005",
      "source_text_sha256": "75c0d1055d1b681671a0306f20e5e7b50efdf08296d422c940dbf8ffa611a764",
      "translation": "“该道谢的是我才对，多米尼克特务大尉”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0006",
      "source_text_sha256": "2aaf815dd28c17291263d57acaa5fc77d1fbd82bf4b8437259562a63d4a02793",
      "translation": "“如果没有关于那件事的预先情报，\n　绑架蒂珐·阿迪尔说不定就失败了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.01/0007",
      "source_text_sha256": "9326e5c0c395300eaa6dad55d19ad744f90756131c8ea4f9498636170cc30ee0",
      "translation": "“根据此前的调查，在库特级柯拉利安周边，\n　已有报告指出会出现精神异常的例子”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0008",
      "source_text_sha256": "2c2bb4e9c9a736e6c90349f0c4d91b09351683376b5055a480ac4417f2cb4e07",
      "translation": "“今天的幻觉现象，恐怕是那个加上the \n　END的巴斯库德危机产生了某种影响所致”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究词条规定的the END大小写。"
    },
    {
      "id": "story/074/dialogue/01.01/0009",
      "source_text_sha256": "26db96f6afd1948b87f500e60def325673a9df736d48aaf9864f913fce7442e7",
      "translation": "“那么安妮莫奈小姐的情况如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/anemone"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0010",
      "source_text_sha256": "e1a44358bf51b510992bd297426347153a31b67de2071ddc36344536c80923d8",
      "translation": "“不必要的打探就免了。\n　作为特务部队，我们的行动全部属于机密”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0011",
      "source_text_sha256": "35701008d0eee2b5df6eea2e552fc028b8b060532191da59f38e6529f861b95a",
      "translation": "“失礼了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0012",
      "source_text_sha256": "bddd21f07527444a01c8dad03ce19db9276589f5b44c8c95c9a7dcdbf194f5d9",
      "translation": "“不……该道歉的是我。虽然所属不同，\n　但怠慢了友军礼节，我在此致歉”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0013",
      "source_text_sha256": "1a39588e33486716f009e6394378209a22c70e6938e641f1b6ff137e98c24b91",
      "translation": "“不过，不愧是传闻中情报部的精锐弗罗斯特兄弟”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/frost-brothers"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0014",
      "source_text_sha256": "c9341aee774d06d5f1d297e918b50956902d8e3bb9da3fbc1c409382a5a70569",
      "translation": "“能在那种情况下准确执行任务，\n　真是非同寻常的精神力”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0015",
      "source_text_sha256": "588eacab0a825e1b62b45becdc30f3a0ff82f3b93223128f27821783b1ed4b46",
      "translation": "“小事一桩。是弟弟引导了我”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0016",
      "source_text_sha256": "1b0160ef8e21b3aadbae17e16e351a75ce792892074fc54523b898211b9ee535",
      "translation": "“我们兄弟无论相隔多远，都能感知到彼此”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0017",
      "source_text_sha256": "00ed604b42a9315ef27a2bc53a604065807edf4fcb87f2f5c28be6e08e8a42b9",
      "translation": "“是、是吗……虽然不太明白……那么，\n　我们继续执行任务。你们接下来打算怎么办？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0018",
      "source_text_sha256": "1ea510dac190c210d137cbe0fa3543ff3e14cbc7094bb25c7c598c276f9547de",
      "translation": "“我们的下一个目的地是宗达艾普塔”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0019",
      "source_text_sha256": "1b55fe14096722c7530a101accffe1360cd2daa3c68dd31115a23e3a644bc93c",
      "translation": "“祝你们好运。有机会的话，再会了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0020",
      "source_text_sha256": "a7d6c080bfad76a70aa56ac0fe7bc3d7d6e55a63c692e247f1b0f213b799fa86",
      "translation": "“大尉也请保重……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0021",
      "source_text_sha256": "5b9d8187b2f1ef11a628db72ce7aafb43d051033829ca2716603e0f5e7351611",
      "translation": "“……大哥，你刚才可真是低声下气啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0022",
      "source_text_sha256": "f0c1a6117aa3f9172ed54abc27ae680722d05c2d4b35f984aafeb72706b634b1",
      "translation": "“他是杜威·诺瓦克的亲信。\n　给他留个好印象也没什么坏处”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/074/dialogue/01.01/0023",
      "source_text_sha256": "80f7a826500ce9750d1fb73aab82545341b6a056a3f54b5c66903673e6dc368b",
      "translation": "“不过，杜威·诺瓦克似乎对我们的行动有所警惕。\n　得小心点”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/074/dialogue/01.01/0024",
      "source_text_sha256": "6dbb295b43f241e17cdbfc01e792825d6475420a9b3214b20abaab4e15152e63",
      "translation": "“正因为如此，\n　通过合作来表现出顺从的姿态也是必要的吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0025",
      "source_text_sha256": "08e33717856da37584d7f35277ab01ade908e402937ec4354b31d9c6db04a057",
      "translation": "“而且，别看那样，那位大尉阁下……比我们年长呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0026",
      "source_text_sha256": "ac3bad60b6848827624a58f49c24905d080dd16e720740ebacf52c8179b71922",
      "translation": "“……看不出来啊，那个……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0027",
      "source_text_sha256": "649cd567946feb35558f1ee537bd6bdb81349e125f246f60c8053535bfa54e0e",
      "translation": "“不过，多亏了他的协助，我们达成了目的”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0028",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0029",
      "source_text_sha256": "8cb4f67aa62a9490f3f1221d3fbfa13d37ad2311ad35bcdb7583eebf9e2d77d2",
      "translation": "“欢迎回来，蒂珐·阿迪尔。你终于回来了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.01/0030",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0031",
      "source_text_sha256": "cd9d0c8c82e9283f1b57bc868b067af10d0be37a7fecd7a7fcc529c8bf2050bc",
      "translation": "“眼神里充满了意志。你似乎比以前更强了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0032",
      "source_text_sha256": "0564e099360aaf22078b889e45598c1073df1f8f4503a523e91c8b6d81d6e498",
      "translation": "“给予你那份力量的，\n　是那个少年……卡洛德·兰吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0033",
      "source_text_sha256": "c3cd86bdca0cf3c80abf18d55bdc91cc2ce3bdf34fd193a1a69e0bb0ab90f3e8",
      "translation": "“你打算拿我怎么样？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0034",
      "source_text_sha256": "6e684f0a34561eb84035bf9fa29e4430ff0ade23f5a7f9577d33fc626b3d49a4",
      "translation": "“和之前说的一样。我们打算向命运复仇”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0035",
      "source_text_sha256": "a7cc173f5a4afa81aab0e6beda1b172f2d8c9330c272c8e864b6a874796cff60",
      "translation": "“为此需要借助你的力量。\n　首先有件事想试试……跟我来吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0036",
      "source_text_sha256": "ec56324b1419845d93bec017275f6fbb8a74ab4b2ba4d94ccebce306f0abb1b2",
      "translation": "“在罗蕾莱之海，第十五年的亡灵正在等着你”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.01/0037",
      "source_text_sha256": "7b31712e7819b56744b988e78ac70c67ad9920100c709bda0ca4532e980f90e7",
      "translation": "“第十五年的亡灵……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0003",
      "source_text_sha256": "0d60438c2f0ecc0c970352152bbabfd46e1d4e81a88d342e110c429e9ac3aa6d",
      "translation": "“不过，没想到在那场骚动中蒂珐会被掳走啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.02/0004",
      "source_text_sha256": "8de02f9811f1eab8f7ca704ec3ff775b3bfa53ad5323448d04880729cc3a4273",
      "translation": "“卡洛德……他消沉得很厉害啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0005",
      "source_text_sha256": "93d089f379e164312d6b8fba85138bb38013cc7b0df57e955f3b5fb83cb3f6b5",
      "translation": "“掳走蒂珐的，肯定是那对死缠烂打的兄弟”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.02/0006",
      "source_text_sha256": "2ee78dd9ad95d28e30ffb2831863cb9a6e17a87d149a15eb537672e42555ac8b",
      "translation": "“那是谁啊？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0007",
      "source_text_sha256": "d97da4a3299a39dc47ca77b85db61a64405f1ed1c1ab5c13c859a6ddc4da4736",
      "translation": "“夏基亚·弗罗斯特和奥尔巴·弗罗斯特……\n　通称弗罗斯特兄弟”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/frost-brothers",
        "people/olba",
        "people/shagia"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0008",
      "source_text_sha256": "12a2af6f1607119f7a04bfafdca6fa139ec43b5eb0f4693c2c76f49c1c1da1ee",
      "translation": "“他们是联邦军的特工，\n　据说想要新人类，所以盯上了蒂珐”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces",
        "skill/newtype"
      ],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.02/0009",
      "source_text_sha256": "55e73baee687404f67584b0655c8f369505ac7380938f7d83b9ce6a1bb5cf406",
      "translation": "“不过，就算知道了犯人，\n　不知道他们在哪儿的话也没法追啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0010",
      "source_text_sha256": "80069cd53977e32f8e3056c55dab46ecbe8daaff1253b9e936dd525153de4d07",
      "translation": "“喂，蜜姆晶……埃曼的情报网不是很厉害吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0011",
      "source_text_sha256": "0598ea0c54198fe709e853490bef7a941615d51bdfc673cdee5e82be10bf5173",
      "translation": "“嗯，是啊……获取最新消息的速度，\n　UN根本没法比”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0012",
      "source_text_sha256": "ed5fb4bf2a5baf82800e71706e9579c3b65de2958e9026b1dbb74690e09f457a",
      "translation": "“那就跟其他队伍也打个招呼吧。\n　问问有没有人看到过像蒂珐的女孩”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.02/0013",
      "source_text_sha256": "02dbc6977a3dfb2c36061fb4f1960816f585e26a6c84ce27cb8a73098ebbedfe",
      "translation": "“明白了。那我们去这个城市的市场看看吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0014",
      "source_text_sha256": "2af59ea0362d73efd4ad6aeb100d7af7f5d078c0587f733765000198e7777478",
      "translation": "“说不定能搞到情报呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0015",
      "source_text_sha256": "6b18fb09f697305f65d03e018210e30d856d13c39c80bf1ad13581736d9a94ad",
      "translation": "“那就这么定了，马上出发吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.02/0016",
      "source_text_sha256": "c54a3f6267d628a3113bb66357b5e963ce5828642de9dd6e36a6f24b4dff4b1d",
      "translation": "“可不能把蒂珐多留在那对\n　蛇一样的兄弟身边一分一秒”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.03/0000",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格罗玛客厅",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/glomar"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0001",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格罗玛客厅",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/glomar"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0002",
      "source_text_sha256": "a5513d8d9afe0bd765d6864ffd47c96fa1594fd2aed0cf3a050bff1fec03e163",
      "translation": "格罗玛客厅",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/glomar"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0003",
      "source_text_sha256": "8a5da8e46d0e1d118afe95d7fb7564d18ac92ea0cc9850aabb63b52c76c02ad3",
      "translation": "“……那么，找到蒂珐的线索了吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.03/0004",
      "source_text_sha256": "2fa6c1ed940f465bc892b03213d18dff4ec1427ef511be54b11c1c1d0cc2f835",
      "translation": "“没有特别显眼的情报……不过，\n　他们说一有消息就会联系我们这边”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0005",
      "source_text_sha256": "a4f20e23b75af8b26207311dd1ef1d897c2658e3bdeb6ac0b80291d544aa3b2c",
      "translation": "“蜜姆晶……这张影像光盘是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0006",
      "source_text_sha256": "9a842d9c83525fc339e3fcbd7722f60d1a95e0d64cb6e7e9202e06a39064866c",
      "translation": "“在市场上弄到的。\n　好像是在一个叫香港的城市卖的，肯定是好东西哦”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0007",
      "source_text_sha256": "26eb7bd8b6bdba9367a60c9351081529f44e29a83ba1fcb8a308369a88eb7199",
      "translation": "“你看……这里还写着绝密影像呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0008",
      "source_text_sha256": "2111541678522eae5706ce93525b6bcda94daa4467cb2e66586cf9329a1f8024",
      "translation": "“那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0009",
      "source_text_sha256": "cc7e2d6f421393bb37de010d598b2f95bd2fec7686fd25eb367f0d5e0d0cb921",
      "translation": "“快播放看看吧。\n　我觉得里面肯定录了不得了的独家影像”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0010",
      "source_text_sha256": "a002099f2056989d4f880efa8366fbd19381d729d837021313b2e0659342a36f",
      "translation": "“说不定记录了传说中宝藏的所在地呢！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0011",
      "source_text_sha256": "51d93adc95713fbf7ea76196e822e62798c70aeb03c3820628ad0680cdd1d913",
      "translation": "“蜜姆晶小姐……那个……那是……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0012",
      "source_text_sha256": "5f93f2a632205ad1145d94baef8737631242fbbce3c1db562b623d0abb3a58bc",
      "translation": "“怎么了，大家？对这个视频没兴趣吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0013",
      "source_text_sha256": "76fddacdadc25fd337175536533865fecc93db99b32c56f81978703a4fdc9eba",
      "translation": "“这个嘛，我们也是男人。不是没兴趣，不过……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0014",
      "source_text_sha256": "605068900e7571fdda36f4c13edeeac004ec16aa95632a5cbaabbbe09c3d9035",
      "translation": "“托雷斯和三枝也说过，香港的视频好东西很多”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“三枝”。"
    },
    {
      "id": "story/074/dialogue/01.03/0015",
      "source_text_sha256": "5d7d12ca213aec6780689a85bd46f917f086fca94bd637bb47793e3b86cd0496",
      "translation": "“那俩家伙……该不会是宅男吧……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0016",
      "source_text_sha256": "6309a85a5a82a5b133965ad3d6fecc1314353df63618202a1457e744b9cd3582",
      "translation": "“总、总之，蜜姆晶小姐！\n　那个视频肯定是好东西，别拆封直接转卖吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0017",
      "source_text_sha256": "4852e3d385d9e463768964091d6fd13c5351a2b833e53e47f8fb39dd5f652b94",
      "translation": "“……说得也是。还有蒂珐的事，\n　现在不是做这种事的时候呢”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.03/0018",
      "source_text_sha256": "fe58f7b124b072fbd97523bb3a4c3adf62bded783ef150d17de8ddb91357261d",
      "translation": "“那这个我先保管着”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0019",
      "source_text_sha256": "a180db8c1745fd7cd4da8649d2989fdf7b76dd5771bd8222426bb4c987597fb7",
      "translation": "“OK……保管就交给你了，桂”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": ""
    },
    {
      "id": "story/074/dialogue/01.03/0020",
      "source_text_sha256": "1ef5fd183810d37217011830b67c6ba3ace5a76e0b840ff6f42e3c91763c4084",
      "translation": "“桂大人和$n大人……笑得好开心啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/074/dialogue/01.03/0021",
      "source_text_sha256": "9bd4aa6efcb74b205ed5d4f62fd668bcb0986a0e4a0019df52806a5f80a2678c",
      "translation": "“不……现在先找蒂珐要紧。这个先放一边”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的《机动新世纪高达X》人名“蒂珐”。"
    },
    {
      "id": "story/074/dialogue/01.03/0022",
      "source_text_sha256": "4fd72f102fc111ed1fbf623956cdedc111a6adff28f688a365058b354824e8dc",
      "translation": "“嗯……无论如何，\n　都得找到那孩子和那对蛇兄弟的线索才行”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
