      "id": "story/059/dialogue/01.01/0044",
      "source_text_sha256": "704e2abe698873074e66626c9398fb02a473f7e187ad00556b1641e0204e0340",
      "translation": "阿伽玛单人房",
      "editorial_status": "draft",
