  "entries": [
    {
      "id": "story/067/dialogue/01.01/0000",
      "source_text_sha256": "7ff539c037d0066185fadab02538071bb3857b6bba937890779c3087b476b880",
      "translation": "“迪兰达尔那家伙，真干得出来……\n　居然在这个时机从内部瓦解地球联邦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0001",
      "source_text_sha256": "13096a7a27ecc052989792cab96d8cd2f15da5839db21d32bb9efe1aa84291b5",
      "translation": "“对联邦来说，\n　覆盖全世界的UN成了致命伤啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0002",
      "source_text_sha256": "080b5a67a2c89c19997673f6f79f20e0bb59701301e1578e77b0e6c69287f99f",
      "translation": "“恐怕得知真相的市民会引发暴动，\n　搞不好联邦会分裂成各个国家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0003",
      "source_text_sha256": "2fb2c6196af9e1891fb001cba6de1b6c41ec3c40a0d07896ae3f6df4dffd4625",
      "translation": "“据说入侵首都的联邦部队也已经撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0004",
      "source_text_sha256": "7887d6c28f3a34080f16f93d5d2082d81bbab4d9303d785505d0b3bec980eb01",
      "translation": "“被ZAFT用王牌新兵器击落，\n　后方又闹成那样……也只能撤退了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0005",
      "source_text_sha256": "5a278bbc66c0e04930e55b464607e6ce14c89676240d6562c433b3f39030804a",
      "translation": "“结果，欠了迪兰达尔一个人情，真是遗憾。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0006",
      "source_text_sha256": "4cff539d2c7dd32286a8b1fc479cf08be3722fe0626c4731e183019c80608a7d",
      "translation": "“是吗……？\n　说不定我们只是被他那场闹剧利用了而已。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0007",
      "source_text_sha256": "9a64ad0740c07ab82839e230ec765e1cb31197b318c49ef3ac89719534431e13",
      "translation": "“您的意思是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0008",
      "source_text_sha256": "586e80015ddb3c689d5613f9a2152e38ae0345cda1efcd163b0005442d7989b0",
      "translation": "“算了……既然没有确凿证据，\n　现在对PLANT表现出敌意太危险了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0009",
      "source_text_sha256": "2310a42adcea49bb2055c361ec8db7c398081676a314390fed4868dc9403490b",
      "translation": "“毕竟，那家伙可是揭露\n　地球联邦腐败的正义之士啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0010",
      "source_text_sha256": "d5a353d05a7a90ad2460da9ef97bd4b9974a52e73c3158c3382dec039166a466",
      "translation": "“唉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0011",
      "source_text_sha256": "c51b788fcad5ab7041c070a039e24f4d3282b073a2af7d4b81bb07154d9cb92f",
      "translation": "“让舰队返回首都。\n　只要时空控制装置还在，奇拉姆就不会终结。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0012",
      "source_text_sha256": "79b177a471c7e4b3f247641b1a229b73d98eaa3542a8e7b066a8e7f56dea156f",
      "translation": "“重启D计划，掌握时空修复的主导权。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0013",
      "source_text_sha256": "6c87b3e96cc1890a27b6a9a4e73bf6ad4f2a9e8e68ecbfac1739720eee186257",
      "translation": "“明白。……全舰转向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.01/0014",
      "source_text_sha256": "e635b83e28e03f2097f76e60f9e8e07e14b95640cae6b5a689e914a61b31cffb",
      "translation": "“雷达有反应！探测到高速接近的机体！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.02/0000",
      "source_text_sha256": "bd9439fecab7a2367089498d88971afe55a2822516dcdc39f2dff71f048ad202",
      "translation": "“是联邦的追击部队吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.02/0001",
      "source_text_sha256": "22c1f4a8eb2176a0eb10c1050badff99fea2d9b9da1b23acb8e1739df2e5c573",
      "translation": "“特务队的报告中有对应机体！\n　似乎不是联邦军！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.02/0002",
      "source_text_sha256": "927c511d49e9ef2cf8afd69e808f809ba91692e7ca2e083ef8387ff5e72ba511",
      "translation": "“……通往太极之路……\n　没有资格的人不能触碰。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme"
    },
    {
      "id": "story/067/dialogue/01.03/0000",
      "source_text_sha256": "aa3eb486e69f5d135a2e151c4f6c6d906782628385a7a54bf672b482e8588459",
      "translation": "“那家伙的目标是时空控制装置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.03/0001",
      "source_text_sha256": "baa458dda3be77a04232e62e10b21903bb612f2a2de43ada09801bfe7922dead",
      "translation": "“迎击！无论如何都要守住装置！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.03/0002",
      "source_text_sha256": "8554aa99bd2ef817b1353185d8af3ccd8876ed85ea5360fccb954bcc2f6c3259",
      "translation": "“太慢了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.04/0000",
      "source_text_sha256": "bcfaf6a8780ce8a0b39b0f07ed3d07a3fbde4549c9141d27f22a9709ab452fbb",
      "translation": "“时空控制装置！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.04/0001",
      "source_text_sha256": "35bb9dcc2ca3f90bb9c80fb1ec08a6ea1a216ef05d611f92500b59116d8de91d",
      "translation": "“怎么会这样……D计划……\n　世界……要崩溃了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.04/0002",
      "source_text_sha256": "5df8b1011f4de5e456aac375a48ecfabb1763a9c95eede1445ca9652af43d2ba",
      "translation": "“这样就好。多元世界的框架，\n　又要动摇了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0000",
      "source_text_sha256": "e8b97f78a067353a517588d429c0978a3a9ab46f03b470d53de37a55f50627c5",
      "translation": "“可恶！还是晚了一步吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0001",
      "source_text_sha256": "fa345bca330710063e90e5492a40d9b697b8b5046b54195246ceb20596e52592",
      "translation": "“这下糟了，$n……\n　我们被那家伙的剧本耍了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0002",
      "source_text_sha256": "489e0398bfc5dcb6e31c359a579b2ec673de8e63ea16b5ceb4816db7250aa247",
      "translation": "“这是怎么回事，修理屋！\n　那家伙是什么人！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/repair"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0003",
      "source_text_sha256": "61b8f26ff31f590d56d97eb2e98bf19cdd922ae9df955b2b361ccf87408bde69",
      "translation": "“详细情况下次再说！我要去追他！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0004",
      "source_text_sha256": "2cfbc90020051a025f90510504ba27a3692845f85d9b8ba47f2a87a8eff83adc",
      "translation": "“喂、喂！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.05/0005",
      "source_text_sha256": "baa890e359677e09f25544386a19974956f370344016080e02372fe6154476cf",
      "translation": "“告辞了！保重！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0000",
      "source_text_sha256": "cc80e21543811df6f4577c7cdaf43cfeeafd354d16e4aaf5228ff8c31eb10001",
      "translation": "“切……！那家伙到底是什么人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0001",
      "source_text_sha256": "b3e49ef801858147fc5827a48c530bd3087cbae53dd2a6c6339266d7427c36de",
      "translation": "“雅典娜……我也要去。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0002",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0003",
      "source_text_sha256": "516925a32cdf3d062b70e78b72709a66cf7e47360c47d9bcdef0bdfcba903281",
      "translation": "“时空控制装置已被破坏，\n　D计划基本等于失败了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0004",
      "source_text_sha256": "ceb0bd443411beba62ffd675a2926d0a1e06a7e3c33f88382fb2ce88706dcf02",
      "translation": "“这样一来，上层肯定会再次计划用\n　奇点修复时空，打算利用我和桂。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "technology/singularity"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/067/dialogue/01.06/0005",
      "source_text_sha256": "a1c5a0c03f749d675798b28cc3cc7ddcde30779d0e232c2c59ae56dc9b94983a",
      "translation": "“那么，捕获桂木桂来维持奇拉姆……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/067/dialogue/01.06/0006",
      "source_text_sha256": "b0e2cb47a8ed133ebed4c3c9948b5f4f08bf8500ce3903c05f947ac491682a04",
      "translation": "“……我不知道那是否正确了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0007",
      "source_text_sha256": "9d9c67071a5a0395347af821900332b19f1ea7142d404bfbdff4a51ca7647895",
      "translation": "“叔叔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0008",
      "source_text_sha256": "bd56d988846ce5f0d79197782bbcede48ef76c5c79db6b425752d3d01ab6d660",
      "translation": "“所以，我要去见桂。\n　然后重新思考自己该做的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei"
      ],
      "notes": "嵌套词表子串自动例外：people/kei"
    },
    {
      "id": "story/067/dialogue/01.06/0009",
      "source_text_sha256": "07906199de3b709275f9f2f73171fd74434efca49c3ca4a5fa2372e60ad93cd7",
      "translation": "“请等一下，叔叔！那我也一起去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0010",
      "source_text_sha256": "9066a176f031939ceab0f94896e4b95ce736fbae1abcbdc9f0dc85c60d0761be",
      "translation": "“不行。你留在奇拉姆收集情报。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0011",
      "source_text_sha256": "fee1e993e8f11c62de578f259a381d23678f997c356a032a8810bb0b41abc166",
      "translation": "“那个叫兰德的男人在追的阿萨基姆·杜温……\n　以及新联邦的混乱……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/rand"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.06/0012",
      "source_text_sha256": "83e72f37ec3dacda21614bbd60b7d6328dabd243a6760733dd751d6a98836863",
      "translation": "“事态还会继续变化。拜托了，雅典娜。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athena"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/01.07/0000",
      "source_text_sha256": "02a8fff1b99ea6a74b387149486521fd52acbcbb0692217232a058e27506e8fc",
      "translation": "“叔叔……祝您平安……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0000",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦单人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。"
    },
    {
      "id": "story/067/dialogue/02.01/0001",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦单人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。"
    },
    {
      "id": "story/067/dialogue/02.01/0002",
      "source_text_sha256": "d71f73df9d34d9158b4292fba65cb46fb6b8e70fa5e38de5bfdcfa55e0fb935d",
      "translation": "密涅瓦单人房",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/minerva-private-room",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：place/minerva-private-room。"
    },
    {
      "id": "story/067/dialogue/02.01/0003",
      "source_text_sha256": "98ce79a651fbcd583d0ccf1c6ac4a47c3bbffee1f99a4ff811f62509cbe38f68",
      "translation": "〜密涅瓦　真和雷的房间〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/ray",
        "people/rey-za-burrel-short",
        "people/shinn",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0004",
      "source_text_sha256": "8e595d9a38189e7afe12e38fbef186e3f22f8555a3088bb9abfdd339ce3d91b2",
      "translation": "“我进来了，真。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0005",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0006",
      "source_text_sha256": "34c0770a0cb91502fdd3e8f09a0a2ededb791d51212bd18cbf2cc9c528616f3b",
      "translation": "“一直关在房间里干什么呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0007",
      "source_text_sha256": "2760886ea21abf6545906eeffd1feb1b64abc24fe85f954e9751024ea18c994b",
      "translation": "“为了打倒自由高达的模拟训练。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0008",
      "source_text_sha256": "0f7b1ef29e8ba9e684fd3639ca64e1379ab5d0a6a11119af26fd3b67a46d9aa7",
      "translation": "“什么……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0009",
      "source_text_sha256": "0772b822a7067f8d74bcb5a676f0bf3331a5850a67a430dcd863071f0d603358",
      "translation": "“可恶！不管试多少次，\n　它都比我们的攻击更早进入回避动作！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0010",
      "source_text_sha256": "0c7d921d9f3a05806fe9e8b953971520ebfad2b88364df66dd8667145bf32460",
      "translation": "“还不止这样。回避的同时转入攻击，\n　我们连调整姿势的时间都没有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0011",
      "source_text_sha256": "2d3df618447f791afa7bca8cb028acee49ec7c7594fb6bd32b289166fa52b36b",
      "translation": "“而且那攻击精准无比。\n　确实在逐步剥夺我们的战斗力。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0012",
      "source_text_sha256": "65f3726305e44e44949b9ee2c767ac49ba27395055cccb0e609e4f79bf4f9f72",
      "translation": "“可以说远距离射击战根本没有可乘之机。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/ranged"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0013",
      "source_text_sha256": "9d9139585dd29f99242f77e1857cb09e193455d048c552c8e3ff00c6e3cc389b",
      "translation": "“推进器的操作也很出色。\n　随心所欲地操控机体。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0014",
      "source_text_sha256": "0024451bb22b8402bca5879a8bcffc42a925c605a89448221817e37a0ada7034",
      "translation": "“自由高达的出力在脉冲高达之上。\n　居然能操控到这种地步……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/impulse-gundam-short。"
    },
    {
      "id": "story/067/dialogue/02.01/0015",
      "source_text_sha256": "5aa1b43192a03327a2cb2f71acdffb5e7829d14cca63c9ed1a1889a008e138f0",
      "translation": "“与自由高达的战斗模拟……\n　到底是为了什么？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0016",
      "source_text_sha256": "455aa4d5ddaa646ba8560d75d03cbc1f8ae4abe8995fbfe4d1aadbcb350c7e07",
      "translation": "“因为它很强。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0017",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0018",
      "source_text_sha256": "6bab85dea8f9435feb5ae72ae2935d5ad8fef3c3794508b256389b025751d215",
      "translation": "“自由高达的驾驶员可以说是最强的敌人。\n　连那台毁灭高达都打败了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/pilot"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0019",
      "source_text_sha256": "ee05ff80cb0cd1f563e8ca6c622025791622c49ccc1a72b8a0aaf33a3dc96bc8",
      "translation": "“那么，以它为对手训练，我觉得是好事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0020",
      "source_text_sha256": "0f0fe0934b7a4f9b54c01b3f96cefaaf31b37f1819ff57849aa916fb33392ff7",
      "translation": "“……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0021",
      "source_text_sha256": "8adb2b13a667e51cef815a22d9bd97517e6735d88214084ffcd9d041ae35b54a",
      "translation": "“万一出事，没人能打倒它可不行吧？\n　那家伙完全搞不懂在想什么。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0022",
      "source_text_sha256": "b4780912cd6d5a76efb6eb6d602461a46f1091e7c960ca65d2018ae8279ee863",
      "translation": "“真！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0023",
      "source_text_sha256": "148fe04ef21a7c2f1075b66e907d1e3d62071bd2faf0d207dd9542159256556a",
      "translation": "“我觉得真说得有道理。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0024",
      "source_text_sha256": "faeb9df5b81c474f71a2745d66a7a5a72889596b91cfcb01d669a294cc7d1bb8",
      "translation": "“既然自由高达是我们的障碍，\n　总有一天要正面交锋。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0025",
      "source_text_sha256": "8945eed6b44d8ea853b73ca2205ba236321383d2dc692676f4f2627a533e3ca3",
      "translation": "“卡缪……$n……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0026",
      "source_text_sha256": "966d428342628c0a8b416366b990c184f467d1644ba60d27c5c331f178bdfd27",
      "translation": "“自由高达很强。而且，\n　虽然不知道它有什么打算，但它不是我军。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0027",
      "source_text_sha256": "ab5ea1eb7ac8e7b9e085490b70444e20acfe413feb0f2684b99bd27fd40c5dd9",
      "translation": "“$n先生说的那种情况，\n　理应被考虑在内。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0028",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0029",
      "source_text_sha256": "688842b1af0ed5c6d98079ec4753752c376d5a7de2a9bdba6cb480a1ac8a4299",
      "translation": "“就算你曾经和它并肩作战过……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0030",
      "source_text_sha256": "db45a797fc3f61d2d26c81fffdb125e79d07ec2128c13212c672a144732e4249",
      "translation": "“但是，基拉不是敌人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kira"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0031",
      "source_text_sha256": "0c2acae7a1ad52102f3f18c2f950d70d3fddfd5e0df1d882af29c30ac9b867e8",
      "translation": "“为什么能这么说？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0032",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0033",
      "source_text_sha256": "2df6457b468ba2510890b3407ab605d702f319b5198f3a85e5ac435ec39bb157",
      "translation": "“海涅因为它而死，你自己也被它击落了吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0034",
      "source_text_sha256": "00145b15a67f3560565cc2d88703857f7cbc95b927384dfa172ff14f43d49bae",
      "translation": "“战斗判断是上级的事，\n　但不能断言它不是敌人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0035",
      "source_text_sha256": "8271af2b15877301226d000f321a0c5a93543e7c51861605033abfcd6b572c0b",
      "translation": "“那么，我认为我们确实应该为此做好准备。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0036",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0037",
      "source_text_sha256": "243f48a2b42d2827f1ababf0821a8cdc54acdd095c466322c7d54a2a8584bc8a",
      "translation": "“阿斯兰队长……如果可以的话，\n　能给我们一些建议吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athrun"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0038",
      "source_text_sha256": "4d847f58a5649b9c7334da972366100d0d916dc5f2783cd64d24add3ea172549",
      "translation": "“算了吧，$n先生。\n　失败的经验没什么参考价值。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0039",
      "source_text_sha256": "9cc417b635da35f1c326c7b5ebbe6341a2e5c9432bbed724340e7df8c3a448d2",
      "translation": "“什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0040",
      "source_text_sha256": "a05dc1d432e3308ae6cc50219b81fa28c55baa4bd18bc1fbcbd59da7fde9404c",
      "translation": "“抱歉，阿斯兰。我会跟真说的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/athrun",
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0041",
      "source_text_sha256": "6f541c403ddb7ad1ba23949146b4fe32d0f8d33d7e41269fdb30e70566cdf210",
      "translation": "“切……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0042",
      "source_text_sha256": "67c0f811ec86889d339a49b28372db4df417edfc64b344165ec57fe500f079a0",
      "translation": "“……走了啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0043",
      "source_text_sha256": "c47821668d1e3eabe996d697485a30095772d74f7ea54889bc424d08852f0e0b",
      "translation": "“……真君……可能是我多管闲事，\n　但请让我说一句……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0044",
      "source_text_sha256": "cfaff58bbc771edddaeeaa15678942558ecd30161755e1f4a0d70ade2edbaacd",
      "translation": "“千万不要带着仇恨去和那台自由高达战斗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0045",
      "source_text_sha256": "f1ccba902ce85cafd32c76d84a23291d0ffe238911cc13fb3126a97102e390d3",
      "translation": "“$n先生……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0046",
      "source_text_sha256": "3fcf9ab0c8106b28114b129fdf58ac57559564d48ddaf940c87a79fdd456f7c3",
      "translation": "“我们该做的不是为史黛拉报仇……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/stella"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0047",
      "source_text_sha256": "1c4251b3c877e112879dfb182f7e8c289dd2d16a8278e19526394111e3655030",
      "translation": "“而是为了结束这场战争，\n　去打倒那些扩大战火的人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0048",
      "source_text_sha256": "ded12756d4045e6347471a3b8b77f1282aac1497efd90db6986f7e410d0395d0",
      "translation": "“……我知道，卡缪……\n　我知道的……所以我……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0049",
      "source_text_sha256": "f0f7f8e67877934c93b1754e54f3108a7a76cf9d7e70307938ac78e12717bfe9",
      "translation": "“我相信你，真。所以下次自由高达出现时，\n　我会把一切都托付给你。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0050",
      "source_text_sha256": "acd2b4cdf21097e2c5a1acfdd31cff13b5745c549e12e220175488bbd1853118",
      "translation": "“打倒它的方法，我也隐约看到了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0051",
      "source_text_sha256": "ef7a9b5f6151a13fa5b00e9890aebf04545e6984f19fcd6939b9956b8cbe95dc",
      "translation": "“真的吗，卡缪！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0052",
      "source_text_sha256": "e81463a516b4ffa42fedd62e5ae1445583bee406ac9d28413aef9c6e22842c99",
      "translation": "“嗯……为此你需要发挥出\n　脉冲高达120%的力量。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": ""
    },
    {
      "id": "story/067/dialogue/02.01/0053",
      "source_text_sha256": "20917d66d488568140f9ea227b2830f1f0b6eb64c79825ba3ea2be0b3abcb044",
      "translation": "“脉冲高达120%的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short"
      ],
      "notes": ""
    }
  ]
}
