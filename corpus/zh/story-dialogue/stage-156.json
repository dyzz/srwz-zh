    {
      "id": "story/156/dialogue/00.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0003",
      "source_text_sha256": "5d82dba0ed6a87b04573296f59ef64abf292b22bd8b15b829a58a5392982d348",
      "translation": "“不愧是被称为交易点的地方……。\n　各种物资都有啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0004",
      "source_text_sha256": "46fb9ceef72d2b5fd4ad9ec2ad14e71e08d44f49e0f3e36643eeea824fc5ea2f",
      "translation": "“要是有有趣的部件卖，就买下来吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/part"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0005",
      "source_text_sha256": "785090a25032c4b47a3a430c0bfc6610a303331e251a1ad0fb8ba696f748cd5e",
      "translation": "“……你，莫非是奥古的机械师？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0006",
      "source_text_sha256": "14dbb2c7b4c475493bd610638802bd07c6d4df5ebe2eefac7be485d1669993a9",
      "translation": "“啊，我是阿斯托纳吉·梅多索。\n　阿伽玛的整备班队长。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/chief",
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0007",
      "source_text_sha256": "bcfbb83265bcbf207746799b24de72d7a501a7a6c014bff245be3eb82197efa6",
      "translation": "“这么说，以后就是旅途中的伙伴了。……我\n　是基德·萨尔萨米尔。和平号的机械师队长。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-e453576c1081",
        "unit/freeden"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0008",
      "source_text_sha256": "b19fb97371c5fe71e20367d96f897556a6337b7af6b8fb58dc0ad5044c270957",
      "translation": "“那么，那三台高达\n　是你负责整备的吗？真是漂亮啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gundam-generic"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0009",
      "source_text_sha256": "93f8144d3a6fae6cad19d8f5a867fd319c88d5d8ca1f57fc0bddd17995ebeb36",
      "translation": "“嘿嘿……被这么一说，还挺不好意思的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0010",
      "source_text_sha256": "abab459c5005b138d734ce492a653efdfb7573d6e67bbc54dca4c2c76eb89da7",
      "translation": "“阿斯托纳吉先生！那边有稀有部件在卖！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/part"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0011",
      "source_text_sha256": "fbb2b4cea7f452cc95b6e1a29b54de46135f6290e6e8d89d0ccb5df55994cb65",
      "translation": "“最好抓紧时间。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0012",
      "source_text_sha256": "306415461399aa5ebbfe150bd1981bcd930b6ab127844e3cc9065ad24a4b2835",
      "translation": "“钢铁齿轮的那个方脸戴眼镜的人\n　好像也在盯着那部件。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/iron-gear"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0013",
      "source_text_sha256": "65413071ff6e4f07c995ceac1d9c6f5e41f63aed2a6ed972093a12582d7406a5",
      "translation": "“这些人是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0014",
      "source_text_sha256": "06e6a8fb0ea379f771ecbabed4757bf92dcfcad60824ae4aa3da9540660a2b0d",
      "translation": "“我和尤兰都是密涅瓦的机械师。请多关照。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-2e82cab71317",
        "people/youlan-short",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0015",
      "source_text_sha256": "24fffb5f9fa9584bddd8f72d10a914583cd6d9cedfe4d0b793e58eb335f1cf1e",
      "translation": "“寒暄待会儿再说，维诺！\n　赶紧带我去看那个稀有部件！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-616aa64fa534",
        "people/vino-short"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.01/0016",
      "source_text_sha256": "8117614390b6799c8f18444e1cabd8a2e502bb3978267faa350ffbea0ebd60aa",
      "translation": "“了解，阿斯托纳吉先生！\n　那东西多半能用在奥古的MS上！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b",
        "system/mobile-suit"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0000",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0001",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0002",
      "source_text_sha256": "37c16a648ffd44529087c57a52d978348599d555d35fcd43c725cbb6cd794446",
      "translation": "阿伽玛机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0003",
      "source_text_sha256": "00607c209d9b5758856ffe923b7fa19ad0210b466a39926d73f0e73ad869248c",
      "translation": "“阿斯托纳吉先生，这个集装箱是？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d606de50ee0b"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0004",
      "source_text_sha256": "f3ed6294bca21900ae32834f9e4055ed4c29c84c09acb026fdeb58632cabd2a3",
      "translation": "“……是在集市上淘到的宝贝。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0005",
      "source_text_sha256": "ca6958465d69e4126d4ec1df2f1529a5c227229373a0b5a49bb49173a2ac101e",
      "translation": "“大容量能源包吗……\n　要说用来装光束步枪，怎么想都太大了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "part/large-energy-pack",
        "weapon/0121",
        "weapon/0215",
        "weapon/0226"
      ],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0006",
      "source_text_sha256": "05efd9c47b982450d034abd576a2de4a75b09b8df5805e094e117f868c9acf44",
      "translation": "“买这种东西，打算干什么用？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0007",
      "source_text_sha256": "12f9b92ed036e3c0a73717e3722a25bca6723d48e878af4f825c5bb157a2fedd",
      "translation": "“这个嘛……因为有客人在跟我抢，\n　一时冲动就买下来了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0008",
      "source_text_sha256": "2b4f5ec33b1fd73dc22c9e0066f6d9173f02a07cd51b41b32b043c76008e0e82",
      "translation": "“要是能有控制这么大能量的电容器，\n　说不定就能找到利用方法了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/156/dialogue/00.02/0009",
      "source_text_sha256": "bef0a9a99b98bd0b8315aa5e32d30e4f032f4269582fc44a83b0435d5ff5b7e4",
      "translation": "“暂时只能当机库里的摆设了…………要是被\n　布莱德舰长发现，肯定要挨一顿臭骂吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-312cbf08471d"
      ],
      "notes": ""
    }
  ]
}
