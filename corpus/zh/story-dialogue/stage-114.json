{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hans",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      114
    ],
    "entry_count": 49,
    "unique_source_text_count": 45,
    "translated_entry_count": 49,
    "punctuation_only_entry_count": 3
  },
  "entries": [
    {
      "id": "story/114/dialogue/01.01/0000",
      "source_text_sha256": "6ab7e4f2db3dad54499fdb8337a4c68b21e53e95c248ee10aef4741737f600ad",
      "translation": "“ZAFT的攻击部队，已降落到月球表面！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0001",
      "source_text_sha256": "228781f6e9ee64ccff8d622732dca5ecc7ac7021298372fe5c0d8ff5c1d9a882",
      "translation": "“哼，吉布利尔那家伙！快点！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0002",
      "source_text_sha256": "69d5a3a6a01315690eb0c47b509cb492961d41f92e51aa0863f2eefdea724eb0",
      "translation": "“在干什么！蒂珐·阿迪尔还没能访问吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0003",
      "source_text_sha256": "1a53eab74f4d4b2fb4448a3bfea456dd4f75e8062a0a79b3d7d36c87cceb5237",
      "translation": "“请放心，阁下。\n　她的精神已经在我们控制之下了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0004",
      "source_text_sha256": "4e84a8563358b875249d9ef12b92d9837f2c3f2e772fb00f64f87e32245ba85f",
      "translation": "“能量填充也即将完成。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0005",
      "source_text_sha256": "e20fafc08bd1fa96c75b7140142c6cf2ff1c57feda00c3502841f66262215365",
      "translation": "“好……！迪兰达尔，首先为你奏响镇魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.01/0006",
      "source_text_sha256": "91e4198a12a29a93acb8bdee3a6eaf5b9df1eae3b9c5def9c7f4f120a55d9343",
      "translation": "“LOGOS那家伙！打算死守要塞吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:official-logos。"
    },
    {
      "id": "story/114/dialogue/01.01/0007",
      "source_text_sha256": "c7f4e1f9b7c2883df6495a30d365a2e3c9db59aed2531c9c2daa4b3a844da012",
      "translation": "“等等，伊扎克！那个设施的地下，\n　有巨大的能量反应！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/yzak"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.02/0000",
      "source_text_sha256": "6bfecdeac4e5906df878f6329ac690fcde11b1ca1f6090ea089be2bd71366078",
      "translation": "“中继站，确认姿态稳定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.02/0001",
      "source_text_sha256": "b25af79b9c3d3d5db8be4e1ba835936e471c081706cb79834439868916819229",
      "translation": "“镇魂曲，发生器正常运作。\n　距离临界还有30秒。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.02/0002",
      "source_text_sha256": "74e37e5d9a530d17b9bacd655ea9af08e8488082fa959fe7181258364fb4d220",
      "translation": "“瞄准，PLANT首都阿普里琉斯。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/01.02/0003",
      "source_text_sha256": "9c1c66f15e62b49c28746f12d530a4bd1d326f9f21d1e3338a6a50ceee071a02",
      "translation": "“来吧，奏响吧，迪兰达尔！\n　为你们奏响镇魂曲！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0000",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0001",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0002",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0003",
      "source_text_sha256": "f2201e4e1a5f2e31aa58d083bb725e488f92841a8d9e669a018360270e83e551",
      "translation": "〜亚特兰迪亚〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0004",
      "source_text_sha256": "b91cb444be617dec91315a9c1e007d08ded68dfaf753f24ccfbb485a26592154",
      "translation": "“亚特兰迪亚……美丽之都……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0005",
      "source_text_sha256": "c34ea33f22879168165e3ccaec443d927833c010f5401223cf5cd3abb0ca2d94",
      "translation": "“吹拂的风芬芳怡人，摇曳着树梢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0006",
      "source_text_sha256": "a5d2cc803510d973ffb783cd7ec7145b54798b11685f44a4e8e7380d6ecece19",
      "translation": "“妖精轻声欢笑……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0007",
      "source_text_sha256": "7a75c633ec4ac6e87afcea0a5590b2d3ffabe2e5c99e9e4fa3644f74f279290e",
      "translation": "“繁花似锦，铺满都城。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0008",
      "source_text_sha256": "785be7ca9d1a2a19f03ebf1c3e156c9de2b84f11c8cbc981402e5c0f6b600e40",
      "translation": "“溶入人命的钟声，\n　在刻满历史的墙壁上回响……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0009",
      "source_text_sha256": "25e126159cb8ffbeb66f94fcdbbfc1c335a814897a21d710d0dcd414040d734a",
      "translation": "“然后，王者的墓穴开启，\n　鲜烈的破灭将笼罩这个世界。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0010",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0011",
      "source_text_sha256": "8e5003573ac98a167e4c2a444a3fccc3d0c97be13cc88c48082a07d3e55fd55a",
      "translation": "“你……似乎也习惯这里的生活了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0012",
      "source_text_sha256": "a182d2773a3d650311510e68b13b94a224ecc3fa23b9c3a34563d9d9780c5985",
      "translation": "“嗯……简直就像从出生起就在这里一样。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0013",
      "source_text_sha256": "dbf16f439c001293bb301a34e356f5be4a21f2c498fa5b348fcd618f0398f572",
      "translation": "“……你确实诞生于此。\n　在遥远的过去，以及现在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0014",
      "source_text_sha256": "3426901439661278ec854e24764a57170cb684af0d5c0183dfe8a90b5c7dfb32",
      "translation": "“作为太阳之翼……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0015",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0016",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0017",
      "source_text_sha256": "7280ae46a4e7f3e10df726c7c131fbae2649a7cb1adaf34ea85628764d571e65",
      "translation": "“被那家伙夺走头翅，不甘心吗，音翅？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0018",
      "source_text_sha256": "cc834856820c6bb88d01215f754e826b6553384b5698a7a4ce9b969e204fba9d",
      "translation": "“那是邪恶之风……\n　是这亚特兰迪亚不需要的东西……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0019",
      "source_text_sha256": "63dcac5afb68918240b5102e5deed4553e8f06675113f5620b8e9811fc621027",
      "translation": "“……那家伙交给头翅处理就好。\n　囚禁我们的无限牢狱之门，很快就要打开了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0020",
      "source_text_sha256": "3937137c3141d0896a243c70612ef0d27b165a3e4024fd9f2dffa68e3193d191",
      "translation": "“但是，栖息于次元之壁的那些家伙的觉醒，\n　难道不会将世界本身引向破灭吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0021",
      "source_text_sha256": "55331b61232bc172f17a99f574834046dae9a64998a32a36303aec66eba502c7",
      "translation": "“最近神话平衡的崩溃，\n　正是那家伙即将觉醒的证据。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0022",
      "source_text_sha256": "06bef260b516fde6747d3babbe176aabd3cf32979dc8049b352fc1e26e6a431a",
      "translation": "“那时，伟大的力量将再次降临。那在1亿\n　2000万年前引发乐园崩溃的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0023",
      "source_text_sha256": "d487f75c0ba13574638d41c2eaa9ad138589a8994d62e555c3461db009f11b87",
      "translation": "“将我们堕天翅束缚于因果之链，\n　幽闭于无限牢狱的乐园崩溃……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0024",
      "source_text_sha256": "112591494a50beeb69fe0bcb7a42fb46be19ea9e88e0bca2796ea1515979f223",
      "translation": "“那之后，我们经历了无数岁月。\n　就这样，冷眼旁观人世几度变迁……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0025",
      "source_text_sha256": "cc737bc901018e3cb1653b2338eda0a9352152b62a6a49346157a6ae27771076",
      "translation": "“束缚我们的可憎诅咒，连腐朽都不允许，\n　让我们反复陷入沉睡与觉醒……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0026",
      "source_text_sha256": "1ac61defd0c26a3cc412cfb8c190384a12ab8cb32140b8744063a93a1c55073c",
      "translation": "“然后，一次又一次与无翼者重复战斗。\n　就像每晚上演同一出戏的小丑……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/wingless"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0027",
      "source_text_sha256": "1643c56991e099af76644a3f6c5739f91c9b87142f4040a7fb1347b04e5043b4",
      "translation": "“然后，在乐园崩溃后的9999万年，\n　那场战斗中再次发生了乐园崩溃。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0028",
      "source_text_sha256": "87ceff63832bf89d8bb947c245b4737df076316b0b85687ff23a72f3019823a6",
      "translation": "“那时，头翅大人明明确实\n　再次与太阳之翼重逢了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0029",
      "source_text_sha256": "9ac52469429e2b4dc73593680e02d588b50ae8cda0a1e2cfbb26582f159cff9d",
      "translation": "“可憎的力量再次出现，将我们锁入牢狱，\n　甚至夺走了那份记忆……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0030",
      "source_text_sha256": "7f4e928a1c4c867142adc3e1b5d392822446361e1fce6b44b62a8d46b3ef52da",
      "translation": "“但是，从那时起经过1万2000年，\n　终于要迎来变化了。\n　因为那次时空震在因果上撕开了裂痕。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0031",
      "source_text_sha256": "cd89841319c801bedd9bec1ebb7b56d9eedc43fe45eef6a74d5bddf627090670",
      "translation": "“世界崩坏……除了伟大力量之外的存在，\n　竟然能引发时空震……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/break-the-world"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ]
    },
    {
      "id": "story/114/dialogue/02.01/0032",
      "source_text_sha256": "ba7b570c866f5f04f5e6f6d1c94f735a1b8767f07750899e2f5336ff479e779e",
      "translation": "“但，那正是为我们指明了创圣之路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0033",
      "source_text_sha256": "5d7d3187ba7a8c9224f7641b1aa249914e2c7eaa7c226d78c0b9f79705a10059",
      "translation": "“剩下的，只需在生命之树的花凋零之前，\n　进行神圣授粉，结出创圣之果。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0034",
      "source_text_sha256": "75d8aea83a334d19589a702e351a0f09a4de6525f0c704af8742fc4f5bfb7fe2",
      "translation": "“而那一天，已经临近了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0035",
      "source_text_sha256": "5305497a2c6f3cf75a1db35a7ef93d754c394769264fc53b03723f4e298a4c19",
      "translation": "“诗翅……看看无翼者的世界吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sirius-wing",
        "species/wingless"
      ],
      "notes": ""
    },
    {
      "id": "story/114/dialogue/02.01/0036",
      "source_text_sha256": "26d0bc34f0fbe5cee3e2f873b2eea6cc042b481058ffb8f98e7bef2178d9b237",
      "translation": "“今天他们也在同类相残……\n　就连那美丽的月亮，也变成了战场……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
