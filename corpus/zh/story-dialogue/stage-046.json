{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hans",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      46
    ],
    "entry_count": 28,
    "unique_source_text_count": 28,
    "translated_entry_count": 28,
    "punctuation_only_entry_count": 0
  },
  "entries": [
    {
      "id": "story/046/dialogue/00.01/0000",
      "source_text_sha256": "3c826fff86817b626e4404b3aac2b8656c106a5ff3288ad6e1f25e350cc4c953",
      "translation": "“来了，希德拉元帅！\n　他们就是$c！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-3bf5cd30c935"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.01/0001",
      "source_text_sha256": "f47db31870b499557bed10dff5a3c11a051b9b838d2e1001385992cfce610cf0",
      "translation": "“盖塔机器人和亚库艾里翁\n　也在那支部队里吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/aquarion",
        "unit/getter-robo",
        "user/unit/aquarion"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.01/0002",
      "source_text_sha256": "3d0d4a6d532c183cf55260a9d173cd708e6b82986808d252f7279e2520094df8",
      "translation": "“是的！请赶快派出迎击部队！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.01/0003",
      "source_text_sha256": "e1e1f047f1c7fac447d66cdfac545e8b46179451c2ae4896e11b701f8dec08df",
      "translation": "“别慌张，独眼鬼。\n　这座光子力研究所的防备是完美的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-be29ed800edf",
        "place/photon-power-laboratory"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.01/0004",
      "source_text_sha256": "4e506afa3240de6ae2fb863fcdbed330dac67b3a86e72e3ce29cb3c31fe3c77a",
      "translation": "“光子力研究所没有动静！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/photon-power-laboratory"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.01/0005",
      "source_text_sha256": "4cf53658e4a4c74d9ea417436ef4c598260889820017f7f6388d50fde346ca72",
      "translation": "“你是说他们没有迎击我们的意思吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.02/0000",
      "source_text_sha256": "82f87a80e4c30c75ad2f8eec2a609f4d8f296d159ba79ba5269314273efb06ac",
      "translation": "“甲儿的双重飞天神机出击了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4",
        "system/launch",
        "unit/double-spazer"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.02/0001",
      "source_text_sha256": "72187d85f34e03fc80dcf3e3b9658dac948d32e3dee1f77e5681bffff4f2e1af",
      "translation": "“别做鲁莽的事，甲儿君！\n　先观察敌人的动向！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.02/0002",
      "source_text_sha256": "4d070bafed00bc8caf4715ac4111b6fbc55d09a88113336e2b502a434d27c5ee",
      "translation": "“可没这个闲工夫！\n　再磨蹭下去，研究所就会用那个了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.03/0000",
      "source_text_sha256": "187d62c9bad94f6cc5478b227c211a46af1167da7fb10aa832ce95b01a5aaefe",
      "translation": "“这边也跟上甲儿君！密涅瓦，最大战速！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.03/0001",
      "source_text_sha256": "3374ca8ac169ed7a1f2dcc2f19a5077c5a524aef267bdca6a8201f4ed56bc324",
      "translation": "“了解！密涅瓦，最大战速！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.04/0000",
      "source_text_sha256": "f485f865db16046ac44f9934f83abda953286c45d5f4c0587c68914fa5eb898e",
      "translation": "“哼……飞蛾扑火！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.04/0001",
      "source_text_sha256": "316cc72b584215d7abe043d124f3e4eb3815d2c593c6e974bff299e43c3210f1",
      "translation": "“屏障发生装置，以及迎击系统启动！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0000",
      "source_text_sha256": "9ddf0c7808ce73f1c2ffc295ad30003f94bf9a92ed257057cd9349060a746b62",
      "translation": "“呜哇啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0001",
      "source_text_sha256": "368e49e18e42f823bd0b30bd5bc5db739c8934bfca6e7ce1b5581995527bc99e",
      "translation": "“甲儿！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0002",
      "source_text_sha256": "62b15c346347191d9d8ea3cf22ff44a989e25ed4b080010b341138a06784f71b",
      "translation": "“爸爸！继续留在这里，\n　只会成为迎击系统的靶子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0003",
      "source_text_sha256": "2f265df106d467937cf0c83107b8d51c7ff7e054e089eb226f74b9d65aa92e76",
      "translation": "“但是，有那道屏障在，也无法前进……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0004",
      "source_text_sha256": "e4dd2faabb2478d30e0455a43746434e5062c27ff6302e4abd335b78ddd1a14b",
      "translation": "“撤退，源五郎！\n　也给密涅瓦和阿伽玛下达指示！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-1bc14eb5d42d",
        "unit/argama",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0005",
      "source_text_sha256": "e1ed47576a0a6bedb124a90bb606bce71171466ffc2d8b5f737cf554a9620fa7",
      "translation": "“了解！回收甲儿君后，撤退！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-52bd0a2936b4"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.05/0006",
      "source_text_sha256": "f9e9d98bb03daef9fa937259c781a93788309759adba02abe6cd3fbbfa6cccf7",
      "translation": "“可恶啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0000",
      "source_text_sha256": "225f51391e3865a714df02734486de8bade1ed5da431abc9325e46d60ce86b52",
      "translation": "“哈哈哈哈哈哈！\n　那些家伙，夹着尾巴逃跑了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0001",
      "source_text_sha256": "4d15bd61f8678b75b9a1cdfb34bea0a7b389d23c2428bb5f352d3c2f601fb786",
      "translation": "“干得好，铁甲鬼。以占领的研究所为据点\n　这个计策，值得赞赏。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d34010c02035"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0002",
      "source_text_sha256": "9fde857282f406d33dabec9c0c3e77e6bd69c1746a4067512199aec24fb3ea1b",
      "translation": "“这种程度，谁都能想到。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0003",
      "source_text_sha256": "cc41d9508d06d5cd7832183228138853780f59f8e4de49e1ca822ac9a9a496d6",
      "translation": "“如果要称赞的话，应该称赞把研究所的屏障\n　强化到这种程度的弓教授吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-d97da89d3d05"
      ],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0004",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0005",
      "source_text_sha256": "7a832411736336b708d820be615b2dc8dce24377da2e64a5c1306ccda853ae15",
      "translation": "“父亲大人……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0006",
      "source_text_sha256": "2ff4ece4d51ee0fa943999b381e7430bf0c004eb9aa3c9bdc45f35774e73e7a0",
      "translation": "“尽管来吧，$c。\n　每次都会让你们有来无回。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/046/dialogue/00.06/0007",
      "source_text_sha256": "3f4e55165eeae9a6546afc2b07125bf7a8d2f3d41847efadd6d77ef751e47be8",
      "translation": "（来吧，盖塔机器人，来破解我的计策吧……。\n　那才是真正的战斗……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/getter-robo"
      ],
      "notes": ""
    }
  ]
}
