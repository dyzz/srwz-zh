    {
      "id": "story/093/dialogue/01.01/0000",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号　机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/gekkostate-ship"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/093/dialogue/01.01/0001",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号　机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/gekkostate-ship"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/093/dialogue/01.01/0002",
      "source_text_sha256": "58ce97b9690e587d2d45aa62e5cc1a60c6622c007cbefc4e7dbe1078be1d6e0b",
      "translation": "月光号　机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/gekkostate-ship"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/093/dialogue/01.01/0003",
      "source_text_sha256": "c6a06f5227417a33316ff6f8de3a91b82308056778980dbf4ec60ef0b3954ca0",
      "translation": "“那个叫查尔斯的大叔们……\n　果然是霍兰德的熟人吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0004",
      "source_text_sha256": "bbf74b712403bb06dd5c81dcc60864d7f3a932ce3e5e1b04b1c2f082792098f5",
      "translation": "“我……遇到了查尔斯先生和雷先生，\n　他们教会了我很多事情……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0005",
      "source_text_sha256": "d688109f9976aaa94b9fbe8ee786f24729aef51c857cf2bba08ed8ae0e6dfe2f",
      "translation": "“比如自己是个小鬼……\n　小鬼也有小鬼必须做的事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0006",
      "source_text_sha256": "2f3bebdd01d43775702567e3c14f216b6da962cbf69a36b5ad7d06a9b31ea3f6",
      "translation": "“还有，什么才是重要的事……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0007",
      "source_text_sha256": "ce334444a8be5baac230663380647ec5558c08d490d4bf268ef452969cbc485c",
      "translation": "“所以，你才回到了月光号吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0008",
      "source_text_sha256": "b35a069b5bb138582f778d3eb6099a1bb9a7bcc90b8f87f52171f9892b5128ab",
      "translation": "“嗯……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0009",
      "source_text_sha256": "d4cf728f172edcf12811f27a8047fd21e25437576a91a61454e8044ad6b3303f",
      "translation": "“哟……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0010",
      "source_text_sha256": "a4b884b84925d289c9e5d0f5215fbdb578797e1279c0896a425834f5650754f6",
      "translation": "“霍兰德……我……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0011",
      "source_text_sha256": "106b6cf9b976bccca3b365d31bbd0d16bab90f9272e2a54509a7a910f2e962ac",
      "translation": "“看来我们都有话想说。……你先说吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0012",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0013",
      "source_text_sha256": "11af07bb28634b461c40b80aeaa103d3f8365a777fcdc63070553b79be0cbd9b",
      "translation": "“难道就没有……不和他们战斗的方法吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0014",
      "source_text_sha256": "bb87a4780eaf2f6eab41040ecca19c2973fecc3a73789de59beb9bd0ca8e99a2",
      "translation": "“……查尔斯和雷，\n　都和我还有优莱卡一样，是《SOF》。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles",
        "people/eureka",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0015",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0016",
      "source_text_sha256": "9b4f1ea014a58e9af018d6f78d66239fba7d06c95853c87e78f1f2e5ae602b89",
      "translation": "“这是事实。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0017",
      "source_text_sha256": "baed5023266f631adcb85e557076c964f489feff721a31559e6e5b7beb72faa2",
      "translation": "“那为什么雷小姐会憎恨优莱卡呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0018",
      "source_text_sha256": "a6e2dc09d70fc3af5313386390911206a9101bb7d0847012861f25f07aacc6ac",
      "translation": "“他们两人想要组建家庭。\n　但是，雷变得无法生育了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0019",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0020",
      "source_text_sha256": "146e4f79acab10874dc1f58c211e44f35da653b73554c3576908910ba0fbddc6",
      "translation": "“都是因为‘爱之夏’。\n　所以，雷认为原因在于优莱卡。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka",
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0021",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0022",
      "source_text_sha256": "b0c76f4067b04f05f9b3b721827f134947f59c931445931e1cd8fc690a970b5d",
      "translation": "“……就算拼上这条命，\n　我也会保护优莱卡和你……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0023",
      "source_text_sha256": "606d2b7a4cb57c08c33d421591eaef2d185f6683185fd5bb01ce07156426c231",
      "translation": "“但是，如果我出了什么事，\n　优莱卡就拜托你了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0024",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0025",
      "source_text_sha256": "e8b917baa1d8e20f33b595ed56136a02be9cc026995efa51dbc2bc9be99c63f2",
      "translation": "“被选中的人是你……。……\n　刚才你问我为什么和查尔斯他们战斗吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/charles"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0026",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0027",
      "source_text_sha256": "f871fc92215891b6559d332ef832d857fdf70f7f20116f568721c65c9ec5a322",
      "translation": "“因为我们……\n　是除了战斗之外别无他法的人种。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0028",
      "source_text_sha256": "d148ae641961a63b7e651c8ae9336df29a766f98a68ce5768cf858bef7e41fab",
      "translation": "“所以，我会保护你们。\n　这就是我今后的战斗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0029",
      "source_text_sha256": "3b73a8832d937d2e58f6deb0f114551b99d70e2fe7665666f532d172d7838978",
      "translation": "“霍兰德……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0030",
      "source_text_sha256": "eee3603e9fd99082051e81a2038cf7685322fe83df6fdbce71bafc6ddf42a35c",
      "translation": "“大将！教训兰顿的事先放一边！\n　发生紧急情况了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0031",
      "source_text_sha256": "7c22e00e77b28bfd9995c9a914631266cc0c2f60d89a5d6b58d4950feaa6523c",
      "translation": "“出什么事了！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0032",
      "source_text_sha256": "e5ea407ef3f2e6e5de53d31dbf877beda2f5289e96f585bb5bf79b460deeaa34",
      "translation": "“新地球联邦军突然开始\n　向奇拉姆发动进攻了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/093/dialogue/01.01/0033",
      "source_text_sha256": "f740c73478cd707fcbc37c85d40a40299186df4bd9628c1ac028cb6f2f8346ad",
      "translation": "“怎么会！联邦和奇拉姆不是\n　应该保持着友好关系吗……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0034",
      "source_text_sha256": "97828002260915c91f0d44ffbd0cd639f1ce5cc95abf695c53ba90e26e0ce7b9",
      "translation": "“我也完全没听说过这事。\n　大概是提坦斯或蓝色宇宙直接调动了部队吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/titans"
      ],
      "notes": "嵌套词表子串自动例外：system/turn\n本句的ターン用于Turn A、动作名或一般转向，不是战斗系统“回合”。",
      "glossary_exceptions": [
        "system/turn"
      ]
    },
    {
      "id": "story/093/dialogue/01.01/0035",
      "source_text_sha256": "b94b322ad9057f2145201e68b5b8b6867f97bb5f8cf9f34e972ca07ef2824883",
      "translation": "“这消息从哪来的！不会是假情报吧！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0036",
      "source_text_sha256": "337c53570f2f71a36b59c55b16cd1601db51e69ac303756fd03d4fc93345a92c",
      "translation": "“这条情报是由大天使号提供的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/archangel"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0037",
      "source_text_sha256": "73128f2b8fd65b2fdf6b376e16b76afe328903a5aef81b6f1191742833c0db84",
      "translation": "“是那些家伙……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0038",
      "source_text_sha256": "ec20808b1248a170abddd746f9c634e2b327c95f31428adc12a9d7e76acee9c0",
      "translation": "“贾米尔和夏伊亚说要去奇拉姆确认情况。\n　怎么办，霍兰德？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/holland",
        "people/speaker-7e722f885dfc"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-7e722f885dfc。"
    },
    {
      "id": "story/093/dialogue/01.01/0039",
      "source_text_sha256": "0de1116143a59d0162429f7eda02fe052e2d301dca75004c2a9ae89af169cf90",
      "translation": "“联邦的行动让我很在意……。\n　月光号也出发……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/gekkostate-ship"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0040",
      "source_text_sha256": "a0f4ed31becf5970f2a6157ec1ed053519a6485fabfc2e469b8bb1318a11061a",
      "translation": "“要变成……一场大战了吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0041",
      "source_text_sha256": "333d3d152c7112ccdad01a2f459aa9d998c71202499603bd7d0856be8a20d0d4",
      "translation": "“兰顿……世界即将开始变动。\n　而身处其中心的，是你和优莱卡……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka",
        "people/renton"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0042",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0043",
      "source_text_sha256": "7ab781430d0dca75200c65dc375abbdb36e13e3258be9af1b4c7aa9a21f88b52",
      "translation": "“我决定赌在你和优莱卡身上。记住这点。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0044",
      "source_text_sha256": "079fe8cef9e5223678a916cf86ed1be81fb594fec3e89afa313fcf48822352ff",
      "translation": "“我和优莱卡……成为世界的中心……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/eureka"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0045",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0046",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0047",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0048",
      "source_text_sha256": "19558c640af5ab2eabb0d720d6cd030bfbbc65891a031428d821e2e519c2738b",
      "translation": "阿加托结晶内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0049",
      "source_text_sha256": "19558c640af5ab2eabb0d720d6cd030bfbbc65891a031428d821e2e519c2738b",
      "translation": "阿加托结晶内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0050",
      "source_text_sha256": "19558c640af5ab2eabb0d720d6cd030bfbbc65891a031428d821e2e519c2738b",
      "translation": "阿加托结晶内",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0051",
      "source_text_sha256": "ddcde5d6402c37f2b1fed182842f532d8af26311e3ed6266d572c9c6e9e3577c",
      "translation": "〜阿加托结晶内〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0052",
      "source_text_sha256": "8212abcef785305d10da67ae92867e291f70a82b881554d8b79ddce1055870eb",
      "translation": "“哦……超限恶魔被打败了吗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0053",
      "source_text_sha256": "f01b29ea810dd4f2a8f09bff3d9b92bc844e8bc40693f4653f6eb226aab9e475",
      "translation": "“那个带着头发的超限人驾驶员，\n　似乎品味不错嘛。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0054",
      "source_text_sha256": "981497c66043d8030b80464d44a4fccdd16879f5121d8522ec9bd280fec725b4",
      "translation": "“超越100%的力量……\n　那才是真正的超感知啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/oversense"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0055",
      "source_text_sha256": "d066574f6dce8d03f603776830f0a02af031e998111dc3d2373339fd9a9bedd6",
      "translation": "“比你的孙女辛西娅还强吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/093/dialogue/01.01/0056",
      "source_text_sha256": "53d98175e40fd711e3f33200f524f99324230ba5877e2ff3ddef76088449614f",
      "translation": "“哼……利用我和女儿的存在来提\n　高辛西娅能力的男人，还真敢说。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0057",
      "source_text_sha256": "601eebd5ffe358333d2d224a9f47db11bef95bcb52198acd764ad958a6ecb39e",
      "translation": "“那孩子对亲情抱有憧憬。我只是想告诉她，\n　辛西娅有个叫玛尔蒂娜·雷恩的祖母。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/093/dialogue/01.01/0058",
      "source_text_sha256": "e19b86ff30a451b3563db82866c0fe053041252822ceeba221f91df0ab834a4f",
      "translation": "“你是想说，母亲被超限恶魔杀死，\n　祖母被冰封的事吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0059",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0060",
      "source_text_sha256": "a1c8079b0d1232bb4482e689530b3c94a9536f3f3dc37c3b727edb8a5f177133",
      "translation": "“基兹·姆特！超限恶魔明明已经败了，\n　你怎么还这么悠闲！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0061",
      "source_text_sha256": "73ff7b50de8397629fa7a670eba3f74543bb4b03cd08cf55d768f8812abc11b3",
      "translation": "“那家伙不是恶魔的超限人吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0062",
      "source_text_sha256": "721ed071b2b3c91b969e7cd589a9f64a263ddc60540fadb8bf391d5a281c8d66",
      "translation": "“准确地说，那只是其中之一……\n　而且不过是个小角色。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0063",
      "source_text_sha256": "9cc417b635da35f1c326c7b5ebbe6341a2e5c9432bbed724340e7df8c3a448d2",
      "translation": "“什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0064",
      "source_text_sha256": "c7099febd8cc9729df43dac628797ae994abc86544898d34a2b7461f2ca15991",
      "translation": "“呵呵……调查不足啊，阿斯哈姆。\n　这样可拿不到超限恶魔的力量哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0065",
      "source_text_sha256": "b99e823dd313b44e7e864f094f9903ba6cf54647b75961b1d5a98093f175ab0c",
      "translation": "“唔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0066",
      "source_text_sha256": "95cefaedbddbba60045827bd65bab07bdea1bf1b3a7d8bddeca747a32a48ed59",
      "translation": "“以前给我看过的梅黛尤公爵的收藏中，\n　有一册书记载了当时的情况……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-71462da7547f"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-71462da7547f。"
    },
    {
      "id": "story/093/dialogue/01.01/0067",
      "source_text_sha256": "b1be838a2abc423efe6fcce48c52afef2392b7dbad7117dc75160eb03306afb3",
      "translation": "“与堕天翅战斗的超限恶魔军团，\n　以及闪耀的蝶翼……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0068",
      "source_text_sha256": "edc93b8b12728f02bc5052e5b6729a2bdd7d75bf3c288e39bcc986d80a3432a0",
      "translation": "“还有，最后出现的伟大之力的使徒们……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-power"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/great-power。"
    },
    {
      "id": "story/093/dialogue/01.01/0069",
      "source_text_sha256": "47b7df58dee9384f1fe000d98470041f93a11747bf300d1d21872776e3ca26b0",
      "translation": "“是黑历史的一节吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0070",
      "source_text_sha256": "e281e390b6e824ed8f47cb1d1e1761fbb7a8658c8300e969bac6f5ee54c1813d",
      "translation": "“没错。而且，在这阿加托结晶中，\n　沉睡着更强大的超限恶魔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0071",
      "source_text_sha256": "9a87bd9b2d4ed004cd9030298d36e27b437c3ad17c61691d7361d2dcad6f4056",
      "translation": "“今天战斗中出现的那些堕天翅，\n　很快就会让它觉醒吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0072",
      "source_text_sha256": "64fdeb07104da620dde5be21b0fd9b80b7e9698c35be29b539e5ec5bfbac8971",
      "translation": "“别做蠢事，基兹·姆特！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0073",
      "source_text_sha256": "5e5363eb99b515cddc9868c476ccb89f252102c02292b05d5322f50043a5ee93",
      "translation": "“呵呵……这次超限恶魔的级别，\n　和上次的完全不同。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0074",
      "source_text_sha256": "c5afb8f6a30c146469e6a6d4581886ab7f923c266aa56deaf7b05e850193c44a",
      "translation": "“它会吸收拥有强大超感知的人类，\n　其力量将真正成为世界最强。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/oversense"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0075",
      "source_text_sha256": "88a1288ad1b572f6384de9f74ee7dc4d1be8724ba4793f507e74ac3d5fe9aef0",
      "translation": "“蠢货！竟敢把重要的事随口说出来！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0076",
      "source_text_sha256": "bad0b431aafeda0a4fb50cd4af6b3c05a677a38f31c23da1e07b8027f0a0532e",
      "translation": "“那个真正的超限恶魔，就由我来得到！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0077",
      "source_text_sha256": "5593fe87a73336615debbd8332ba1d60fd853c4c14d5f6469028c573381356ad",
      "translation": "“不会让你得逞的，阿斯哈姆！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0078",
      "source_text_sha256": "d091cda7dd089d50653c91ddcaea902e2441e72733e2cd99d184ae43c4203154",
      "translation": "“给我让开啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0079",
      "source_text_sha256": "94b549b04c1957e33a22cc1050685ba6d04c1dd93b8faf503bf5564f08ad3166",
      "translation": "“……没用的，小子。你以为那是拳头吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0080",
      "source_text_sha256": "7e48b1fbf2c77125c072244df7ff14d5fc6436e26d21d53bc5fd069a5b3af482",
      "translation": "“什、什么！？\n　竟然接住了我文武双全的全力一击！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "嵌套词表子串自动例外：skill/extreme",
      "glossary_exceptions": [
        "skill/extreme"
      ]
    },
    {
      "id": "story/093/dialogue/01.01/0081",
      "source_text_sha256": "e531ff074cba5b9fb3dbcc6a39e18234e6179ac8a9b109f5a29dfe019303d61f",
      "translation": "“基兹·姆特！你这家伙是怪物吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0082",
      "source_text_sha256": "f84f2036b9e2d16043abc5eed86577accec911ee859de9f7ced62a3d424dd9d9",
      "translation": "“阿斯哈姆！\n　我要把你做成阿斯哈姆三明治啊啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0083",
      "source_text_sha256": "198504b8fceadfbe31551e5fa35b7a79ce04efc3c7675e4d3f7de66ee87c287f",
      "translation": "“唔哦哦哦哦哦！这、这是什么力量！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0084",
      "source_text_sha256": "502a4ef6c22ff972064412129c3bae09c1cbfb62f66523c624901d4c87721273",
      "translation": "“认清自己的斤两，小子！！\n　你以为就凭你，能糊弄得了我基兹·姆特吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0085",
      "source_text_sha256": "66d4a9c20b8d5c04d7f1eb49b5584ed701b04799ef47e6bb2b2aaf36b5cb259d",
      "translation": "“不、不好！这样下去的话！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0086",
      "source_text_sha256": "cff1d33955404218b530e493b9f19e19fdb1fb3f950ceccc98dce158ff016c7b",
      "translation": "“唔！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/093/dialogue/01.01/0087",
      "source_text_sha256": "461ecfcce75145e97b80f4071e52b991c4fedba49a69697c339635fd8920bbf0",
      "translation": "“觉醒吧，超限恶魔！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    }
  ]
}
