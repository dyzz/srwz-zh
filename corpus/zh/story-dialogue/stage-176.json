  "entries": [
    {
      "id": "story/176/dialogue/00.01/0000",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0001",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0002",
      "source_text_sha256": "baf48dbe8b16163879638896f1aebbf8537d796e5da0c9c4baae4d1935f93993",
      "translation": "集市会场",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0003",
      "source_text_sha256": "dcd6dc5dc7a5314743a5b258e4ad4e7957e4e40feeb68fad74997f39b991f868",
      "translation": "“卡洛德……那套化妆品，你要卖掉吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0004",
      "source_text_sha256": "ce71684efd8df976e5ced819e52d3db9e6857e67e427e0d6e8f702c8ff578a01",
      "translation": "“算是吧……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0005",
      "source_text_sha256": "2fb3728c29251f079a927442ab308ef79cbd834f3963cb987cafb3de2ff29c8e",
      "translation": "“那……不是为了送给蒂珐才买的吗……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0006",
      "source_text_sha256": "17ced1129da95ac43593904336cf82fc7cacecb9511eea42ad7b936062ad4d2a",
      "translation": "“难道说，你……！已经放弃蒂珐了吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0007",
      "source_text_sha256": "c6ce997767d61630b5c7a907a2b6d90b9530d30f95c4ca0e785fa34449025200",
      "translation": "“别误会。卖掉这个，是为了攒钱买\n　去接蒂珐时的礼物。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0008",
      "source_text_sha256": "6b3b10ad32f52fb96753592c65db1500cae7d82a8816e624a6d3630b2763331a",
      "translation": "“结果，那套化妆品还是没送出去啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0009",
      "source_text_sha256": "ddaa339fa067c34e0e4cd75ff36c05fb1e304ad42e36c2ae187dbe38a6cb8987",
      "translation": "“这东西对蒂珐来说好像还太早了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0010",
      "source_text_sha256": "104c87899a419745c080e7c16da09a89d53a6a8078492ada1c1cdb1d8bd3f3b5",
      "translation": "“所以，我想换成能让她立刻高兴的东西。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0011",
      "source_text_sha256": "0c2359bf3d80e6d9ace3e33ed25614564a90f1d694c4d4a0d736cf9696386ab7",
      "translation": "“不愧是卡洛德！什么时候都这么乐观！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0012",
      "source_text_sha256": "2d4c338bb3d9406ce727a7ad3b09418d0caa08ec4a05e619ac3adf349a6b9cec",
      "translation": "“就算消沉下去，蒂珐也不会回来……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0013",
      "source_text_sha256": "cfa45e7a3d19dc706e598bb40fd4942684efd0254dfade5dc4d77dfc096af1a6",
      "translation": "“既然如此，至少心态上要\n　积极地去想蒂珐的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0014",
      "source_text_sha256": "cef0aca4304fd1662b85877662b4e6272d1015584006c10b8b82f3978649c0fa",
      "translation": "“这想法真像你的风格，卡洛德。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0015",
      "source_text_sha256": "4165e20d59b15ab0329f9ca74f834b1fb62fb97db5cb6d375a02b0b7828025b2",
      "translation": "“既然这样，我可以帮你挑选礼物哦。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0016",
      "source_text_sha256": "aa29b050fd16963fb14dc4c5c7cfd921c60ca8b40ac830de9125fea87a970921",
      "translation": "“真的吗，艾妮尔？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/enil"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0017",
      "source_text_sha256": "d043e9581e7c2f99055478fae0fa554e4fdc66c908c6c79f629a04f4e24ca646",
      "translation": "“虽然有点不甘心，\n　但要是能看到你的笑容，我也愿意搭把手。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.01/0018",
      "source_text_sha256": "10b4c98a3479ce048963347ba9249fb5aa98259e494f6e8afba08977b3cbc286",
      "translation": "“谢啦！那，就请你马上陪我去市场吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0000",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平号娱乐室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0001",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平号娱乐室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0002",
      "source_text_sha256": "77903d21bebc5be905633ebd8fe4da9283286d509f7481e70174e76ed91ccef0",
      "translation": "和平号娱乐室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/freeden"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0003",
      "source_text_sha256": "b4046ef429986151307f7b7e4a59d19fb6555ea8301b21abac879793269a34c6",
      "translation": "“所以买的就是这束花吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0004",
      "source_text_sha256": "68560920b1b9b42862a716031d627422b564703e7031bf531e4a2d0ff30412d8",
      "translation": "“真漂亮！女孩子果然还是喜欢美丽的东西，\n　蒂珐一定会高兴的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0005",
      "source_text_sha256": "752d24e7dba5442fc2366636b1bd724512f976c6c1969ab2c13b09c3dc265c6f",
      "translation": "“可是……在见到蒂珐之前，\n　这花不会枯萎吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0006",
      "source_text_sha256": "803b7a8112df4ef9a263651a4f08dc8f386ac996560a09ac2e8051903050da8b",
      "translation": "“不用担心。这是为了做成保鲜花才买的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0007",
      "source_text_sha256": "8eca032d370460f71b0078b4ce9d1fd8677decd4fa25bbab86335bd4f6bfb916",
      "translation": "“那是什么……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0008",
      "source_text_sha256": "a8e9f3fc7a49027a5afcd50f596c860852af4138fd8f1f078bcd0f55811a6a21",
      "translation": "“听说是一种保存花的方法。这样见到\n　蒂珐的时候，花还能保持盛开的样子。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0009",
      "source_text_sha256": "636b48cda9459fb8e76832576c54b821324f33a0e5f66c49e06ce3e655daf405",
      "translation": "“然后，你会说吧？‘我的思念，\n　也像这花的美丽一样，是永恒的’之类的！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0010",
      "source_text_sha256": "2db2211fe7780ea4b53cc1f1c6d027d2d9ec8d6b60a8a377fc98a6692ba40a80",
      "translation": "“笨、笨蛋！那么难为情的话，\n　怎么说得出口！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0011",
      "source_text_sha256": "422d3e90f50d7cbe045170914fe3d280dfcbe942d6e192358b7a9aeb4e7d75d5",
      "translation": "（那副样子……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0012",
      "source_text_sha256": "bf4d56ca3fe777106f608d1c695d846d91f548c46501aeccdb9617d49b1e5596",
      "translation": "（难道说，卡洛德……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/garrod"
      ],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0013",
      "source_text_sha256": "53fdd1e3f663b81be7a5fc38856f5ff1b73f73f902e6e500bfb504eeee9689aa",
      "translation": "（他该不会是真打算说吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0014",
      "source_text_sha256": "83b878e4140e0226f951c012e3d123fc6c61328cf43d01b5c24ee737eff21b2e",
      "translation": "（唉……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0015",
      "source_text_sha256": "4ea1b817a1470687421fe6602821b63b85fea6b5d9bef16de2ae23973b261f4f",
      "translation": "（会不会有点扫兴呢……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/176/dialogue/00.02/0016",
      "source_text_sha256": "a68e837ed26f512c1a8d98e4eefadb86549400b5da56859742299dae4f970dcc",
      "translation": "（等着我，蒂珐……。\n　带着这束花……我一定会去接你的……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-68642f8dc73f"
      ],
      "notes": ""
    }
  ]
}
