  "entries": [
    {
      "id": "story/070/dialogue/01.01/0000",
      "source_text_sha256": "31e93b0a7f7d3bf06dd5855ad06633d0f6bdc026c22ff1126a5bc0377220d7e4",
      "translation": "“刚才那是……像耳鸣一样的声音……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.01/0001",
      "source_text_sha256": "0e216c504ad37aa6d91b63df92e2c571c317a8987bdc5342dd565c40aaf996a5",
      "translation": "“有人说看到西边的天空有光箭落下来，\n　会不会是那个原因呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.01/0002",
      "source_text_sha256": "5ed7e3db1d96f2dfee530684d5325acbb8b38d4d5b303b3b6be29c1f27af9d94",
      "translation": "“说不定，那是外星人的新兵器吧！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.01/0003",
      "source_text_sha256": "3344bbfdf489522c1a928e5713e62f87dc0a87b220880c354c3ddaa7e5bac9bc",
      "translation": "“喂……那边的天空……\n　有奇怪的云过来了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.01/0004",
      "source_text_sha256": "378bce491f7ada97a403799ac25014f0917475e0f9bf6e62a901ddeb4f4f0fc2",
      "translation": "“那、那是什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.02/0000",
      "source_text_sha256": "8cc8a80af2ee387e45fa83012e9ec83edce34ad3e7c13b58f14ac96e5e573694",
      "translation": "“怪、怪物啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/01.02/0001",
      "source_text_sha256": "084acdf00abfac1a30cd2842a072780bc67317488325e049cdd48e0e21f1db8c",
      "translation": "“呀啊啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0000",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/070/dialogue/02.01/0001",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/070/dialogue/02.01/0002",
      "source_text_sha256": "d2d84922df5f4883f8fc99024851c1b7e5cce41ccdd53018bb79ed279870f209",
      "translation": "密涅瓦机库",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/070/dialogue/02.01/0003",
      "source_text_sha256": "5b0f3c04abe6b98fc4161002ade7070dd68f913f010cef3a43b9407a5141177b",
      "translation": "〜密涅瓦机库〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/hangar",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/070/dialogue/02.01/0004",
      "source_text_sha256": "f1ccba902ce85cafd32c76d84a23291d0ffe238911cc13fb3126a97102e390d3",
      "translation": "“$n小姐……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0005",
      "source_text_sha256": "f75b8ded815e5923c7508f90560035935741c2fb208794cf32ff2208e3ff7fff",
      "translation": "“怎么了？现在应该是真的休息时间才对……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0006",
      "source_text_sha256": "3926ef8185ec0c6b9391ed119cb605c41d525963e0da4fc97f0407fc437a2fdd",
      "translation": "“$n小姐不也一样吗。……\n　又在用模拟器训练了？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0007",
      "source_text_sha256": "faf202b569f6402a37894115c90dea0f2b822b9cdba8d29791f22fd54366bb85",
      "translation": "“嗯……还有，\n　我在检查巴尔戈拉的枪机摄像头录下的影像。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/virgola"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0008",
      "source_text_sha256": "3f29661eefe3793088a152df26a1fb4e8ecb779a685e4ea32793fb9d74c9fb78",
      "translation": "“不只是战斗，您还做这些事啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0009",
      "source_text_sha256": "4e2a92df95ea852d6cb042e32a6c22838285fdec05945042230f8c17ab215f6c",
      "translation": "“这也是我的任务……\n　真君，你为什么来机库？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn",
        "system/hangar"
      ],
      "notes": "按日文源词绑定统一全局术语：system/hangar。"
    },
    {
      "id": "story/070/dialogue/02.01/0010",
      "source_text_sha256": "c7ef4f64393ac0c13f0208f8ee1ee2fc1a586a1e7b9abdb32972479957be16b3",
      "translation": "“发生了很多事，总觉得心情很烦躁……\n　就在附近随便走走。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0011",
      "source_text_sha256": "3699298701a5361d2428998041ed480dc336f102efdbfc33ac81376037fb4662",
      "translation": "“这种时候，更应该好好休息才对。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0012",
      "source_text_sha256": "d54d7195f766fad00040940d1094dde69c0858f524da7d0821bd92b8ffca7616",
      "translation": "“我可不想被整天训练的\n　$n小姐这么说。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0013",
      "source_text_sha256": "2094bed9f3c486353c3905cefa486cb6f1ec8a82d190dfc4c35782007e3f7b5f",
      "translation": "“……虽然不是说打一巴掌给颗糖，\n　但你要吃颗糖吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0014",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“诶……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0015",
      "source_text_sha256": "62640c8f38066af491f339ad548a06c467075ac8b028875a4b262f23a0f22131",
      "translation": "“$n小姐……你喜欢甜食吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0016",
      "source_text_sha256": "a706028effb64c4a0054996641bb884cf5923c32a62ec4a6a245abb11add5ce9",
      "translation": "“谢谢。……那我收下了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0017",
      "source_text_sha256": "adec961cd167ec191ce2fdc9fd15369328049bc32669022281883d173a9269b7",
      "translation": "“那我走了。谢谢你的建议。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0018",
      "source_text_sha256": "3aa8e2076b55c8e1b6c94aa155e217d5e6997bd3094cc54ebb6978153f85f8f0",
      "translation": "（加油啊，真君……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0019",
      "source_text_sha256": "46adf16f0fb1de5f9eb0a158e1da54d93d76e92ded8bfef66bdb07f54301dd77",
      "translation": "（你给我的糖……虽然像在舔石子，\n　但能让心变得温柔……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0020",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0021",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0022",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0023",
      "source_text_sha256": "ca2664e1a37951191118bbc0e5df3f5f3511f03be627ba98546b05b940454c3a",
      "translation": "杜威办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.01/0024",
      "source_text_sha256": "ca2664e1a37951191118bbc0e5df3f5f3511f03be627ba98546b05b940454c3a",
      "translation": "杜威办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.01/0025",
      "source_text_sha256": "ca2664e1a37951191118bbc0e5df3f5f3511f03be627ba98546b05b940454c3a",
      "translation": "杜威办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.01/0026",
      "source_text_sha256": "0c175f6ff51f6070b77d31f8670e113438501891d97577e8a99d4569ddf43679",
      "translation": "“AFX……装备了Orange，\n　已到达预定高度。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "weapon/orange"
      ],
      "notes": "按日文源词绑定统一全局术语：weapon/orange。"
    },
    {
      "id": "story/070/dialogue/02.01/0027",
      "source_text_sha256": "df56943fec48e46b7eb88b7cf9158e4e7f9015de6b353ba1aa53eeb844abd0ca",
      "translation": "“作战计划没有变更。各传感器状况如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0028",
      "source_text_sha256": "cf240e73ab22068e08e3a504d52b5676542c40a44eea28008758dd6cbb481615",
      "translation": "“次元边界线的扭曲……在预想范围内。\n　目前未确认到类似科拉利安的活动。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian",
        "technology/dimensional-boundary-line"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。按日文源词绑定统一全局术语：technology/dimensional-boundary-line。"
    },
    {
      "id": "story/070/dialogue/02.01/0029",
      "source_text_sha256": "2a483742dec05a4f6434cd028e892d282c16262ae3226237c7a9dbe6df32f671",
      "translation": "“那就好。否则投下Orange\n　就毫无意义了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "weapon/orange"
      ],
      "notes": "按日文源词绑定统一全局术语：weapon/orange。"
    },
    {
      "id": "story/070/dialogue/02.01/0030",
      "source_text_sha256": "fc83d5c21f75472d6c48fd8a5c121b2f8bbe0c3b7068326a66e28ff19ceb67e9",
      "translation": "“故意制造伤口……它们会从那里过来。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0031",
      "source_text_sha256": "4ddb6a13b32200c32f997f6fe6a4503c0820749e291a6b6ffdc284d2693725d8",
      "translation": "“然后，重复这个过程，就能查明被称为\n　它们核心的东西与这个世界境界的位置。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0032",
      "source_text_sha256": "d6d19422cf0639df733c6bca4ee3f00e5c1a19e74594bacd31fad3e7d7de3f4f",
      "translation": "“……时间到了。开始倒计时。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.01/0033",
      "source_text_sha256": "ba5ae58642da809109f8736236ebd810180222e2ed736e0b74855f9e24321d90",
      "translation": "“为了拯救世界的战斗，现在拉开帷幕……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0000",
      "source_text_sha256": "702618f3f817d4d841d6517f8330d06989a31bd4643b1d9985313957be79b525",
      "translation": "杜威司令室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0001",
      "source_text_sha256": "702618f3f817d4d841d6517f8330d06989a31bd4643b1d9985313957be79b525",
      "translation": "杜威司令室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0002",
      "source_text_sha256": "702618f3f817d4d841d6517f8330d06989a31bd4643b1d9985313957be79b525",
      "translation": "杜威司令室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0003",
      "source_text_sha256": "599f568829332733598b52267f2d22087011563a6db139799e74dbcb5fde942f",
      "translation": "“……收看这段广播的市民们。我是新地球联邦\n　军阿盖哈队司令官杜威·诺瓦克上校。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation\n采用项目研究过的人名“杜威”。\n用户定稿组织名“阿盖哈队”。"
    },
    {
      "id": "story/070/dialogue/02.02/0004",
      "source_text_sha256": "9173c192fa6a7bba1278f57198c4cd9154e33eab43fe877e7eb30089291f9841",
      "translation": "“我在此带来了必须向大家传达的真相。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0005",
      "source_text_sha256": "c8511e02f75fb36049c8252939b71ccee2e3ddc1119d349033bcc68ddba0111a",
      "translation": "“真相未必总是甜蜜的。\n　有时也会痛苦难受。但我们必须直面它。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0006",
      "source_text_sha256": "47fdcd239d16ce005fcb37e86e9dc220127f844cfdcdafc3f5b94d9ae827b20d",
      "translation": "“正因为是真相！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0007",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0008",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0009",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0010",
      "source_text_sha256": "47fdcd239d16ce005fcb37e86e9dc220127f844cfdcdafc3f5b94d9ae827b20d",
      "translation": "“正因为是真相！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0011",
      "source_text_sha256": "b7e1f9c47f78afb3cd7377a4f594a674b0c42fa3a4be155dab8d076494cb9e74",
      "translation": "“又是新联邦的重大发表吗……\n　那帮家伙还真不腻啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0012",
      "source_text_sha256": "7525343bcfdced061ad2ee24358bc2a27c35b8abefb8aa46f720fcc9d7975f94",
      "translation": "“不过，那个叫杜威的男人的眼神，\n　看起来非同小可。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0013",
      "source_text_sha256": "fe3bfc038e67c6ddee4e9a851a2a1f34d7a15293ce35bd4f56a0c7a9301e8eab",
      "translation": "“充满了决意和意志……和之前的\n　布拉德曼临时总统似乎是不同类型的人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0014",
      "source_text_sha256": "8e2686de13d91742d897abd1f42bd2a6ce0f68881e2fddd37d3067c2aec4d3b7",
      "translation": "“但是，到底是什么啊？\n　那个痛苦难受的真相……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0015",
      "source_text_sha256": "b67f1f4c9059f78e357e67edc8a570ce1115ae0ba05a82bce300c6146fe4330f",
      "translation": "“大概是贤人会议那帮人的贪污之类的事吧？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0016",
      "source_text_sha256": "c4898cfb9bd1c103e3e8bac321e7577e84445dd8a9b751ea5e13b581c2d08c16",
      "translation": "“如果只是那种程度，反而该觉得庆幸了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0017",
      "source_text_sha256": "4a68448d84d17f1a745b2aa46ef62c050bbbdeb47d68f1ccc528330f78ddf3c7",
      "translation": "“请大家看这段影像！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0018",
      "source_text_sha256": "34173e4863e1411ccda5aeb2697abab5c30471ecf47f2bcab6e61eed87a06a72",
      "translation": "“这是！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0019",
      "source_text_sha256": "1a7d8b09658a906bc0f07ab867930ad894e3280efbbb493e1927d5221b492b98",
      "translation": "科拉利安",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0020",
      "source_text_sha256": "1a7d8b09658a906bc0f07ab867930ad894e3280efbbb493e1927d5221b492b98",
      "translation": "科拉利安",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0021",
      "source_text_sha256": "1a7d8b09658a906bc0f07ab867930ad894e3280efbbb493e1927d5221b492b98",
      "translation": "科拉利安",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0022",
      "source_text_sha256": "72de60fd1f35fd37cef00612284f447ef2214ebbc6f7e2308a82a186a5b352c1",
      "translation": "“这是日前某个城市遭到\n　人类之敌袭击的记录。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0023",
      "source_text_sha256": "c36c296b84821654522b14bade9023a4dd82ffc3c39b964da5110d39ef8fd907",
      "translation": "“看吧，这惨剧！这就是现在这个世界正在发\n　生的惨剧！不……这并非今天才开始的事！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0024",
      "source_text_sha256": "35c6da0f487725955558b138f265cebe3e226c00676ba9e2100ab7911cc2ec90",
      "translation": "“这个世界从以前就一直受到名为\n　科拉利安的未知生命体的威胁！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0025",
      "source_text_sha256": "8b9d78294d8639b8f3f7cdf4637ffa966590a121cc2717d31b1a46fab6726f07",
      "translation": "“尽管如此，贤人会议却一直隐瞒这个事实！\n　为什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0026",
      "source_text_sha256": "5f5de5d2060191aff554e3668e1824f0ca7116ddaddeea21fb85d5fd0f245e07",
      "translation": "“因为恐惧！他们没有能力控制它！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0027",
      "source_text_sha256": "de1cd5c607474a441ef76dfd1308b12d2660d74b952d80a381e3339ae8a2c505",
      "translation": "“我们面对这个威胁，只能坐以待毙吗……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0028",
      "source_text_sha256": "04aaf0486153926504c2e37c7e7c64bccbc5219c15f47d24c9d2f764d7be7c5f",
      "translation": "“答案是否！断然否定！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0029",
      "source_text_sha256": "cbcd6f3d463db73de0dfb9d4deee892178d38b1ff896ec11b482b648ca51cb35",
      "translation": "“我和那些把自己的无能抛在一边、\n　进行权宜隐瞒的贤人会议的老头子们不同！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0030",
      "source_text_sha256": "199c9dcdece1db65d7adb3e1928ad9f39d5f370049e20018435ea8be6b84bfc8",
      "translation": "“我断然说否！世界不会毁灭！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0031",
      "source_text_sha256": "c454259f02bf6c7bd6a674baf9d316fc380f1162e94f9f24dfee4d58755b3140",
      "translation": "“以力制力……！如果敌人拥有绝对的力量，\n　我们也要拥有同样的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0032",
      "source_text_sha256": "0627fab3e2ea0413f9757191ce3853554f7d8225a6219ec9e4ab65ac90ffebad",
      "translation": "“与宇宙移民的战争，外星人等其他外\n　敌的威胁……！打破它们的是力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/spacenoid"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0033",
      "source_text_sha256": "18b71ca4fb32b69cf446c916b19b67337b3fbcfc33a58e8d6f30d1b4ed59810a",
      "translation": "“没有力量，人类就没有未来！\n　力量才是开拓未来的关键！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0034",
      "source_text_sha256": "21590c6a8c8ab55ec684b55aeafca422a3d4dd9f77475b6bd808d08ddee651a6",
      "translation": "“为此新地球联邦军存在。而且，\n　我们拥有最后的希望，阿盖哈队和……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation\n用户定稿组织名“阿盖哈队”。"
    },
    {
      "id": "story/070/dialogue/02.02/0035",
      "source_text_sha256": "d33e7a92f8a3556c96b629967342b46e6941289c94e6503936814835406a5e7e",
      "translation": "“率领它的美丽战斗女神，安妮莫奈！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/anemone"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0036",
      "source_text_sha256": "4c38322a55c51fcc6c5d3f0ac1818b798427a05d73b616a66e1ade1e0219d063",
      "translation": "“是！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0037",
      "source_text_sha256": "9895d27e9d473335d6db42ffb4425d07bfca63ba0bd215bef8bbdf3409a25fa3",
      "translation": "“……预见到今天这种事态，\n　想要建立对抗科拉利安组织的并不是我！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0038",
      "source_text_sha256": "cfcf23409f3d6fbf62204aca0c9126872677a61535deaef77ff871d730a04483",
      "translation": "“那是谁呢……是拯救了构成这个多元世界的\n　其中一个世界——约定之地的英雄阿德罗克！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": "采用项目研究过的人名“阿德罗克”。"
    },
    {
      "id": "story/070/dialogue/02.02/0039",
      "source_text_sha256": "256d26f7a44a015db17bdb90233a8f38b0b1362d95cb4663a4938478ee419d98",
      "translation": "“正是他预见了科拉利安的来袭，\n　为我们留下了看透一切的阿盖哈构想！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/ageha-plan",
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0040",
      "source_text_sha256": "7e02a0264b0f483c2db4ed41ea180a5426c3042413778bf38e2f14d4e39317b5",
      "translation": "“全世界的各位……这个发表是真实的，\n　听到这个的各位想必会动摇吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0041",
      "source_text_sha256": "9ea3d2df809037f75a06804353c71f2b49057943bcdd424dc7f74867b200a1af",
      "translation": "“但是，新地球联邦向大家承诺未来。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/070/dialogue/02.02/0042",
      "source_text_sha256": "73d8703151755bec55507a3010110f08e33478ae94224bf52b821d65e83dc3db",
      "translation": "“以杜威上校和阿盖哈队为首的新地球联邦军，\n　必将打破威胁，为这个世界带来和平！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation\n采用项目研究过的人名“杜威”。\n用户定稿组织名“阿盖哈队”。"
    },
    {
      "id": "story/070/dialogue/02.02/0043",
      "source_text_sha256": "8c03923abd9476522d32aa88b7aa72da7d58a04fd7b412e8229afb4fdfec4141",
      "translation": "“现在正是将人类的力量合而为一！新地球联邦\n　才是世界的领导者……正确引导人类的存在！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/070/dialogue/02.02/0044",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0045",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0046",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0047",
      "source_text_sha256": "76122756827b724a8cea5a1a03bc65f20158662ccafbd0e60df4c5a5260dd461",
      "translation": "阿伽玛食堂",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/argama"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0048",
      "source_text_sha256": "45e1cf3ae7f0237452159b8e047f17959d18570e3fb02b8213c4ae4c618062bf",
      "translation": "“真是有力的言辞啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0049",
      "source_text_sha256": "a8ce32e7bae40ca56df7cbdb8aeee38d94500db278e8d7ab15c6b3b024adcb9f",
      "translation": "“布拉德曼暂且不论，市民们会依附\n　于杜威·诺瓦克这个男人的话吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0050",
      "source_text_sha256": "99604e6c3f080cd29feada34c4925346c9e320d04e5fc37303903b796c075f0d",
      "translation": "“看了那段科拉利安的影像，\n　会那样也不奇怪。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0051",
      "source_text_sha256": "e32f7b2c1b166d40a0202c07779aff2cd334d75957d81ba909975a9800c79b05",
      "translation": "“打倒贤人会议，从威胁中拯救市民……\n　重组的新联邦似乎完全站稳了脚跟。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0052",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0053",
      "source_text_sha256": "d5fd3cc6eaa2141de7823fccae4ebaa752e5e1de239219c11e4551124b87d420",
      "translation": "“怎么了，卡缪……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0054",
      "source_text_sha256": "ff4c82379aaab2891115e9b64ff983e5bb29546e99f85611c523411a542dcf22",
      "translation": "“和杜威·诺瓦克一起的那群像是军队幕\n　僚的人当中，有帕普提马斯·西罗克。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。\n采用项目研究过的人名“西罗克”。"
    },
    {
      "id": "story/070/dialogue/02.02/0055",
      "source_text_sha256": "493fd34dee4d9f230c9c07640c32ab79ef4388e1e37456938fa90356304bc98d",
      "translation": "“是卡缪警惕的那个男人吗……在战场上对\n　峙时，那个男人的压迫感确实难以估量。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0056",
      "source_text_sha256": "23d42bff0d25caa7b1e8238171a1657602d544349200eddaabd77eba153527b9",
      "translation": "“能出席如此规模的典礼，说明那个男人……\n　在现在的联邦军中处于相当高的地位吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/federation-forces"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0057",
      "source_text_sha256": "243f46a013bbbb92d5da3d365a85e42cfe5d2a191ad2f7bee03a9960b9523955",
      "translation": "“卡缪君推测那个企图让我们自相残杀的\n　人就是他，这样一来可信度也增加了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0058",
      "source_text_sha256": "f3f1f041369c5b5229994dd9f978ef960e3aa8131d4fae804754bb94478a772e",
      "translation": "“然后，杜威·诺瓦克吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“杜威”。"
    },
    {
      "id": "story/070/dialogue/02.02/0059",
      "source_text_sha256": "570019d6cfb5fe010db1248166ddea18e56c81f6d1f255bbb13d6c0c9d85a020",
      "translation": "“说起来，\n　月光洲的霍兰德非常在意那个男人的存在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0060",
      "source_text_sha256": "66345907128babf17f8196d07f077c33f15545cea03f3a60b7fd869b9476087e",
      "translation": "“听到那个名字时，那个人……脸色都变了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0061",
      "source_text_sha256": "665189ccdd2e8c3f19013932ca7749f96e8ec3c772a87f28b783e8c6a49513cb",
      "translation": "“两人之间似乎有什么因缘。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0062",
      "source_text_sha256": "890884959dfba4f2c1fd9adbb2889acadc0a3ae9a705aa9a619b759d490767df",
      "translation": "“说不定，霍兰德他们知道\n　关于那些科拉利安的一些事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/holland",
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0063",
      "source_text_sha256": "2ea92f79a5d2120b0e5cb08800d3a01055cbac797d11af5e5c5a79d81e815b39",
      "translation": "“而且，刚才演讲中提到的英雄阿德罗克，\n　是那位兰顿君的父亲。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/renton"
      ],
      "notes": "采用项目研究过的人名“阿德罗克”。"
    },
    {
      "id": "story/070/dialogue/02.02/0064",
      "source_text_sha256": "1e40b215d2c91df4b73eb5491613dbf9f42a64c6e373c4e93087688892da3228",
      "translation": "“杜威·诺瓦克和阿盖哈队，\n　月光洲和兰顿及其父亲……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "people/renton"
      ],
      "notes": "采用项目研究过的人名“杜威”。\n用户定稿组织名“阿盖哈队”。"
    },
    {
      "id": "story/070/dialogue/02.02/0065",
      "source_text_sha256": "391bad94c633b375333917babec9ae9fa485e223223e06f5e10ace3b07203bba",
      "translation": "“连接它们的线的延长线上，\n　有那个叫科拉利安的谜之敌人的存在吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/coralian"
      ],
      "notes": "按日文源词绑定统一全局术语：species/coralian。"
    },
    {
      "id": "story/070/dialogue/02.02/0066",
      "source_text_sha256": "bf77834387a8389cebd18fe34cab4a500b4a8001bfbb96d3addc3c8e88f6d2ed",
      "translation": "“布莱德舰长，还没有掌握别动队的动向吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/burai"
      ],
      "notes": "采用项目研究过的人名“布莱德”。"
    },
    {
      "id": "story/070/dialogue/02.02/0067",
      "source_text_sha256": "97ec435f029c19069c3ca0838607387cfe32b080fd7051e35c619c147429f305",
      "translation": "“很遗憾。虽然确定他们在北阿梅利亚，\n　但无法确定位置。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0068",
      "source_text_sha256": "6c4612df86a6e6bb40bbd5c77a64bde19b316715273cf4f4ed1f053c6f5a873c",
      "translation": "“对方也和我们一样受了相当重的伤……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "本句是对白中的受伤或受损语义，保留自然中文，不强制系统词“伤害”。",
      "glossary_exceptions": [
        "system/damage"
      ]
    },
    {
      "id": "story/070/dialogue/02.02/0069",
      "source_text_sha256": "4fbc58937f9a7acedfba3e35df0b7d39ef2928da5e5a3b1c3139a31821aa27d2",
      "translation": "“一定是为了修理而躲在什么地方吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/repair"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0070",
      "source_text_sha256": "69ef40542930b15de5a0c19e2b64ef9a4d55da95da349d54e45086102381ccc0",
      "translation": "“总之为了今后，得尽早和他们汇合。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0071",
      "source_text_sha256": "f344787b329c2c13898eb302f589f4a65aa6e7a3cceac60a73b9d5a94c0996b3",
      "translation": "“到时候如果能顺利解开误会就好了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0072",
      "source_text_sha256": "9f119c64bb8fc44b54eae88f0a72b89835a5e04104e786f77e0056641b9c4c23",
      "translation": "“布莱德舰长，\n　外出侦察的阿波利中尉发来了联络。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/apolly",
        "people/burai"
      ],
      "notes": "采用项目研究过的人名“布莱德”。"
    },
    {
      "id": "story/070/dialogue/02.02/0073",
      "source_text_sha256": "5b9b9873d4a92d5878784bf96356c154ecb1382f18a41442b1918bdaf0dec02c",
      "translation": "“找到别动队了吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0074",
      "source_text_sha256": "8e2883b6aa6e924ccc607fb27d86c91f3525565e4771c062461f8d23edabd850",
      "translation": "“不……据说在从这里西南方向50公里\n　的地点，确认到了像是来自上空的轰炸。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0075",
      "source_text_sha256": "5c922571ab3f6095eea1589d0ed380b7cfc9d8ea8820cd1cfd31effb53e6e804",
      "translation": "“中尉认为可能是外星人的攻击，\n　请求出动$c。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0076",
      "source_text_sha256": "666082af3acec8809a175ef14b6eb3899284ea3db8202a3397f0acad322b3a98",
      "translation": "“那附近虽然规模小，但也有城市。考虑到\n　万一的情况，我们最好去现场确认一下。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0077",
      "source_text_sha256": "2091170812e0fc684f54721accc16fbc5d96a2e22a20ce20fc933955c41eb642",
      "translation": "“是啊。萨埃格萨……\n　也联络密涅瓦和帝皇比亚路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/king-beal",
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/070/dialogue/02.02/0078",
      "source_text_sha256": "d37cdd51e3426e152fb03346202b88fd702d1de6bc0e6d1c20e9305ee0ca5b95",
      "translation": "“明白。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0079",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0080",
      "source_text_sha256": "86406ddfa5165d2f7cbb3f9cb39f3c92f2d16df76b5d52a162b129cd6af69d1f",
      "translation": "“转换心情，卡缪。要出击了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0081",
      "source_text_sha256": "e62c834cf6bc8aa5589dd0afd06d511177d233ee63edb39fcb5fbce4e3f93460",
      "translation": "“是、是的……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/070/dialogue/02.02/0082",
      "source_text_sha256": "fc17cb29c4ba9bbc3e23d26ce8088d842695727118ef00f41edef8ce003f6bff",
      "translation": "（影像中西罗克旁边那个像是秘书的女性……\n　那是……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“西罗克”。"
    },
    {
      "id": "story/070/dialogue/02.02/0083",
      "source_text_sha256": "883682c988e155ef6fd0e66709a72b418bd8e1d8d5071edd08d7319ee0b8d194",
      "translation": "（不……不可能……那个人不可能在联邦……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
