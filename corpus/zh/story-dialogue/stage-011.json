{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hans",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      11
    ],
    "entry_count": 45,
    "unique_source_text_count": 45,
    "translated_entry_count": 45,
    "punctuation_only_entry_count": 0
  },
  "entries": [
    {
      "id": "story/011/dialogue/01.01/0000",
      "source_text_sha256": "85266a09ef6b22717d3bca51be0890d2855ccd9389f9ff9275c944b612fb06f1",
      "translation": "“啧！差不多到极限了吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0001",
      "source_text_sha256": "5e99df9cfaec12b9baf4edd9aa67f6c416e69d2e2a304a7158c52cba1dd8baa5",
      "translation": "“你在干什么！？撤退命令已经下达了吧！\n　通讯也应该收到了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0002",
      "source_text_sha256": "3b294a9b0947e170c9aa30598cf2dec3540fec84a048fafd6f486dd4927b4b4d",
      "translation": "“我知道……！但这样下去的话……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0003",
      "source_text_sha256": "af3d98dd5c9e7f84ee14081c181b4c4b8d2ca95d070e0f4485d52528607f0f89",
      "translation": "“密涅瓦马上就来，\n　要对这家伙进行炮击！所以！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0004",
      "source_text_sha256": "7fa56b9d56bf0f003a2da8853d46959e8480e5a595ddd5f498feb08bc1046219",
      "translation": "“光那样还不够稳妥！在给它造成重大打\n　击之前，必须至少先制造一些裂缝……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0005",
      "source_text_sha256": "f593c906f0592cf0fd87dc2e12403fb7839647a24552f97773988cb69dcf697f",
      "translation": "“……像你这样的人，\n　为什么会待在奥布……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/orb"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0006",
      "source_text_sha256": "d7ae8dbf5702a27c219685145d6087abeff7605b1e35c5e125366bd278a99064",
      "translation": "“你也走到这一步了，那就来帮忙！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.01/0007",
      "source_text_sha256": "a5af3fea94500b95ef226fa304cca1c723bc184889fa565ecbc57df1415de961",
      "translation": "“我知道！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.02/0000",
      "source_text_sha256": "85a1db16e79c34dfeeff5b5d9d424f592fa3ed050ccb87492105652ca6af7903",
      "translation": "“能做的都做了……\n　接下来就等密涅瓦了……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.02/0001",
      "source_text_sha256": "82333e22398f88c43599dfa48c354ff48bbe9277dbe961a5b8677bf0617f83ce",
      "translation": "“你的机体还能撤退！\n　剩下的交给我，快退下！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.02/0002",
      "source_text_sha256": "fdae4dd964c208a41ef6c1b723cffbb08346d4da203aeaf5a5525674952130b7",
      "translation": "“都到这里了，还说这种话！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0000",
      "source_text_sha256": "36b566a7163247033e531d6288bb304727fb69c1d7395068527fe29064cc4b06",
      "translation": "“你想干什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0001",
      "source_text_sha256": "13198a6c996fef9fbbc824581e48aa97edbc7f4ce37d87d3f8f53896dd599abd",
      "translation": "“我要带你回去！加上脉冲高达的输出，\n　就算是扎古也能挣脱重力！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/impulse-gundam-short",
        "unit/zaku-generic"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0002",
      "source_text_sha256": "119693d4568962302ffe57853625b38eb35ebfb715259fa55e6f4fed7fd27f2d",
      "translation": "“不行！这样下去，我们俩都会死！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0003",
      "source_text_sha256": "a4f0994412f34d36c3aab7e0e2618dd85d11f0d0d306d48672c0b5f3436a0162",
      "translation": "“但是……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0004",
      "source_text_sha256": "f70af677675768a69211ce23b0b204ac163f75bb5e6785a30f6655bb8921c1f6",
      "translation": "“快走！别死在这种地方！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0005",
      "source_text_sha256": "2c1f087033cdbc83378b3655cc63c250d4960f7266bed1971bde7f22fb05f181",
      "translation": "“为什么你总是说这种……\n　这种看破一切的话！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0006",
      "source_text_sha256": "0742e1ffcfdb81bf1894eb6d90192d159065686627270ae029f37b79431375aa",
      "translation": "“……那，我该说什么好？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0007",
      "source_text_sha256": "fd85892fc612481c14764c5126ce27284d5040749c4bebc4a17972d0667c0234",
      "translation": "“救我啊，你这混蛋！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0008",
      "source_text_sha256": "8e9ace97096e953f6770da8a26d59f150ba14d4ed6c6b03b1d22cf226a3db76d",
      "translation": "“……之类的？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0009",
      "source_text_sha256": "bea1b1f36ddc302fdd03dce6c3f2e31eb4a7d05849f85e1dffc4dfc92c87ebec",
      "translation": "“这样更好吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0010",
      "source_text_sha256": "6d4df7109c6845b585edac75e64934079fff9a5ea3244f51190c9a71b29d69a5",
      "translation": "“只是打个比方！\n　现在可不是说这种无聊话的时候！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.03/0011",
      "source_text_sha256": "fb20ce1df869fc22217987123baed4cadb65a095a623b134946828be4cec3864",
      "translation": "“……抱歉……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.04/0000",
      "source_text_sha256": "6f541c403ddb7ad1ba23949146b4fe32d0f8d33d7e41269fdb30e70566cdf210",
      "translation": "“呃……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.04/0001",
      "source_text_sha256": "30bcfcf72e8c6f06a34ed41a876b5a885c5d5bcf0224cd00f1b2863e6712ab07",
      "translation": "（拉力比想象中更大……！这样下去……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.04/0002",
      "source_text_sha256": "a124aff40328c86731c5a09a3de21976dcdd613a03ea4e836ac919027c8924e5",
      "translation": "“保持现在的位置，真！我这就过去！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/shinn"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.05/0000",
      "source_text_sha256": "7e96505b7f1fe670589ba283534f6cb60109a0b267b0c6411f3c9c0c8501e584",
      "translation": "“是卡缪吗……！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kamille"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.05/0001",
      "source_text_sha256": "5cbd7784e51dd231c1d0d1214c4b012db1207a4fe3170ec72ca8eb404905dedf",
      "translation": "“你们两个，快上飞行装甲！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.06/0000",
      "source_text_sha256": "ecc128c87b706de6b6aa447591ebfb923bf351bbc81c9c57660b05e658e4ce28",
      "translation": "“有了这个，就算是MS也能突入大气层！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/mobile-suit"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.06/0001",
      "source_text_sha256": "044dd8826b91920a11faf60bf7fff128f66df5f626cd203c9ca0d095e050dd58",
      "translation": "“但是，这样下去朱尼厄斯七号会……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/unious-seven"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.06/0002",
      "source_text_sha256": "74ca12fd3ceaaf0b087c337253bee6e9db5c2671c95ac1aed3d646c2fbd43b73",
      "translation": "“我既不想看着你送死，\n　也不想让这东西掉到地球上。你看。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0000",
      "source_text_sha256": "1e9500a47e19b7ec995e55d49418a041efd36963d14b9106acfdb348941f8ec1",
      "translation": "“粉碎岩石的诀窍，总之就是先打入楔子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0001",
      "source_text_sha256": "d4fc412960d8e5d3974cf611f3e997db54cb210e0be0698c7cb1b92ef77516f5",
      "translation": "“大家都听到了吧！这个任务由我们来完成！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0002",
      "source_text_sha256": "846335d2cdd9d7232d4feda9fbbaecc3934966829b1dc66b67b80e497f2235bc",
      "translation": "“后面就拜托了，老爷子！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0003",
      "source_text_sha256": "81020978faeae1c8d3c87684327a49b1902e338e94fd3fb043347e2227cd5c6e",
      "translation": "“一太郎，用离子炮！\n　配合那边两艘舰的炮击，我们也上！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "",
      "glossary_exceptions": [
        "place/io"
      ]
    },
    {
      "id": "story/011/dialogue/01.07/0004",
      "source_text_sha256": "81876ba54b455603491d101ea9aaa357423d707c8cb1d5a8450d6632f33ab875",
      "translation": "“明白！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0005",
      "source_text_sha256": "9f0e426a78854af946f82123cd5d31b2c8d6af84a822fe74885b186038fc8173",
      "translation": "“拜托了，诸位……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0006",
      "source_text_sha256": "ffca9c1597e86531112ef1b9fa6755fa3a9906d73200f08d7275ef8c605a0b1e",
      "translation": "“库拉迪斯舰长！密涅瓦负责左边！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title",
        "unit/minerva"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0007",
      "source_text_sha256": "451272e86b2a1dca7e5ba8d7b672ae9135feaa4021b4d79c6ec4aece9168322d",
      "translation": "“明白！全体注意！启动坦豪瑟！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0008",
      "source_text_sha256": "5e2dded70a8e65dfab1ca6e04a69528f24140f3729f35816a3e926a926676eb2",
      "translation": "“斗、斗牙！\n　荣耀之星的所有人都还没回到比亚尔！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/glory-star"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0009",
      "source_text_sha256": "748b222ffbd231b27e5323d5f0f0622a728565208ebd58e0d45e93c222e5bb10",
      "translation": "“那些军人大叔们，难道被卷入坠落了吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0010",
      "source_text_sha256": "a495bb7dd2c45e3796c0367ea7f575ccb85a2735820d2eff392c982564e27cf9",
      "translation": "“现在优先粉碎朱尼厄斯七号。\n　他们的搜索，之后再说。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/unious-seven"
      ],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0011",
      "source_text_sha256": "34055ce1fb7ea2b383410f687ce647732a2eb8242214dd62630a1f82040111e4",
      "translation": "“可恶！现在难道就没办法了吗！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0012",
      "source_text_sha256": "b016f483a82f2cfcc8707fcfa9c3366fab76e7af1380d4b9306e9148fe75d063",
      "translation": "“瞄准！右舷前方，结构体！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/011/dialogue/01.07/0013",
      "source_text_sha256": "51ed94f098fc30d81d0cc983cf8bb9bc0560f9f23842de0f73d346e5a2af4df5",
      "translation": "“拜托了，库拉迪斯舰长……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title"
      ],
      "notes": ""
    }
  ]
}
