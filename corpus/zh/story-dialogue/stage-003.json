{
  "schema_version": 1,
  "batch_id": "v1-story-dialogue",
  "language": "zh-Hans",
  "scope": {
    "domain": "story",
    "kind": "dialogue",
    "stage_indices": [
      3
    ],
    "entry_count": 36,
    "unique_source_text_count": 36,
    "translated_entry_count": 36,
    "punctuation_only_entry_count": 1
  },
  "entries": [
    {
      "id": "story/003/dialogue/01.01/0000",
      "source_text_sha256": "a61cfd12ed0c57f7fc4a9a7e825c031c56f0137d4355907aa324c19b70da06de",
      "translation": "“那些家伙是地球联合的部队吗！？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-alliance-short"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.01/0001",
      "source_text_sha256": "ac3d0c5f505ef8f2be8ab9b4363d53d8df3edc9f4f5cdd0efd742e6a74463364",
      "translation": "“不、不行了，队长！\n　再这样下去我们撑不住了……！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.02/0000",
      "source_text_sha256": "9c095416913fbbd375edb566ccb5c3e79501332d85a222c6ef5c3a8f231c6b60",
      "translation": "“抱歉了……我们也有任务在身”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.02/0001",
      "source_text_sha256": "7ac41c050d737e8dc722ee8f3612f62b32a4448bacd1b36ed7fefa5cf98cd1f5",
      "translation": "“上校，防卫部队已被彻底压制。\n　接下来只需回收斯汀他们了”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sting"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.02/0002",
      "source_text_sha256": "6d4604356088f32f99942485a7fff8d9df9b5b2c0463fc4cc985955e6dfda74d",
      "translation": "“知道了。……那么，他们能顺利得手吗……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.02/0003",
      "source_text_sha256": "dcbfde0471804ddac7544af5796cccedab7029dcce2a0c058922a7d3d4fc197d",
      "translation": "“他们本就是为这种任务而投入的扩展人”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extended"
      ],
      "notes": "按日文源词绑定采用《高达SEED DESTINY》专名“扩展人”，与《SEED》的“生体CPU”和宇宙世纪“强化人”区分。"
    },
    {
      "id": "story/003/dialogue/01.02/0004",
      "source_text_sha256": "7a2bd29de4b41c49167085f9d7e44cd08684c3a5ca71f6e737cb621ad0763a74",
      "translation": "“只为战斗而生的存在……吗……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.02/0005",
      "source_text_sha256": "c396fbe616ec2be4ac06a2c74289d3993576e824b9662b75587eb21a86ff94d8",
      "translation": "“尼奥·罗阿诺克上校，\n　军械库一号方向发现机影！数量为3！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/neo",
        "people/neo-roanoke-full",
        "place/armory-one"
      ],
      "notes": "Neo Roanoke 全名采用阶段术语表定名，并保持三行军事报告结构。"
    },
    {
      "id": "story/003/dialogue/01.02/0006",
      "source_text_sha256": "4b9c8a6b50197153c7b046fd1e8349e7c21f95d35326cc33df710096036b540a",
      "translation": "“来了吗”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.03/0000",
      "source_text_sha256": "93f19f0cc8f66038875693dc60fd600503d5f422e1cbd9114f20e6cc90c44293",
      "translation": "“这里是斯汀，\n　已按计划夺得3架新型机。现在返航”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/sting"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.03/0001",
      "source_text_sha256": "e8ecf38a6f675279db14db3a43ceb23c36d3694273c98d3b695f1980716bb361",
      "translation": "“确认任务成功。辛苦了”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.03/0002",
      "source_text_sha256": "9eba6b7aa57bf10671eccda405189ae6ff87044077676f73d7a727d7fed3bd9d",
      "translation": "“尼奥！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/neo"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.03/0003",
      "source_text_sha256": "cd273539104d6544a9d34d51e9c1364655883dba84ad4a697c1eb8af9e0bc8d1",
      "translation": "“干得好，史黛拉。真是个好孩子”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/stella"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.03/0004",
      "source_text_sha256": "2b91e7835d95907bbc14c53b93a1d593f4552819fbb3268ffe1d141bb96e0e17",
      "translation": "“现在高兴还太早了吧？\n　有碍事的家伙黏上来了”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.04/0000",
      "source_text_sha256": "a5c5664e2a7250aecb5c033fdb2253b753123dc0bf15343ff5c66612f5910289",
      "translation": "“那就是ZAFT的新锐战舰吗”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/zaft"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.04/0001",
      "source_text_sha256": "4941ef0948bba51f1f691559423a6ab9d8b01833a1c24b0208f9dece874228e4",
      "translation": "“原来如此，看来是艘好舰。\n　正因如此，乐趣还是留到以后吧”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.04/0002",
      "source_text_sha256": "8cf883edf5c9bf94e54524aaea87a9184fd7d0b39f09c458918b5731520c89cd",
      "translation": "“后撤，舰长！\n　趁对方尚未整顿好阵势立刻脱离这片宙域！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.04/0003",
      "source_text_sha256": "05e48089f70dad4beea75dd71ab1759fc6e1578c35640fe4d1fea08cadd0d98b",
      "translation": "“明白！各机迅速返航！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0000",
      "source_text_sha256": "4ae84512519d68f69a88100edb821328384460ba5e6d768aa42f2ef2dfae7461",
      "translation": "“库拉迪斯舰长！敌舰正在撤退！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/talia-gladys-title"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0001",
      "source_text_sha256": "f82eaba18cf3728f47a8d71c5f9a2c21dab77eb039c5866c55f55f70234abf8e",
      "translation": "“看来比起与密涅瓦交战，\n　他们更重视夺走机体”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/minerva"
      ],
      "notes": "按日文源词绑定统一全局术语：unit/minerva。"
    },
    {
      "id": "story/003/dialogue/01.05/0002",
      "source_text_sha256": "9ca9a16d7c1581e0214afa811e2274a3351b1ab343c60569fe1d352f20a74178",
      "translation": "“他们是地球联合的部队吗……？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-alliance-short"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0003",
      "source_text_sha256": "96dd49deaf5e4215a8ab97c5c88b45165c16de4ffee687d31dcc0738f7dafdf1",
      "translation": "“目前还无法判断。也可能只是海盗之流……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0004",
      "source_text_sha256": "2a7bc8322dc8c5c86b592fb2cf2d097e090d997a08cae30db7718603feb8814b",
      "translation": "“你打算怎么办，舰长？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0005",
      "source_text_sha256": "c865cbb2e9edea5d1169de4e66a29255f753c6e425ec56094b5a928d30b0cd78",
      "translation": "“本舰将继续追击敌舰。议长请尽快下舰”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0006",
      "source_text_sha256": "ef6e2bf0eef5dfba7bc7fa0de784963cd98da037be237978396b298a4aa018ca",
      "translation": "“……塔丽亚，\n　眼下实在不是留下来等待报告的时候”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-aa16fea188ec"
      ],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0007",
      "source_text_sha256": "a4f0994412f34d36c3aab7e0e2618dd85d11f0d0d306d48672c0b5f3436a0162",
      "translation": "“可是……！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0008",
      "source_text_sha256": "bcc24a9de425811d1a5f21fa4c0e755ce5f09f55554c7aaf276a633f27482b70",
      "translation": "“我既有这个权限，也有这份义务”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0009",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点演出：将日文七点省略号规范为中文双省略号，语义不变。"
    },
    {
      "id": "story/003/dialogue/01.05/0010",
      "source_text_sha256": "f0f33775f6cd85d9582346c16d43f37bf1ee818969327e28aa444515660a7fd0",
      "translation": "“我也随舰同行。请批准吧”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0011",
      "source_text_sha256": "76232b61c6cd573313ff53348388d4819e14b4cce268b7d95c37ceeb9d642db1",
      "translation": "“……我明白了”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0012",
      "source_text_sha256": "7b4321fae3d521a8792e13fa350e43059e9ffd6fb58b72ef60031a8b136d16c9",
      "translation": "“通知全员。本舰即刻追击敌舰。\n　从现在起，目标代号为不明舰1号！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "system/bogey-one"
      ],
      "notes": "正式词表构建审计修正。"
    },
    {
      "id": "story/003/dialogue/01.05/0013",
      "source_text_sha256": "60841bd077fa8bfa14d7ee5c6b53de696d5ecca0013adcba660a85ede773aaa1",
      "translation": "“发布红色警戒！全员就位！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "system/condition-red"
      ],
      "notes": "Condition Red 首译为“红色警戒”，列入 proposed 术语供 SEED 系列字幕口径复核。"
    },
    {
      "id": "story/003/dialogue/01.05/0014",
      "source_text_sha256": "81876ba54b455603491d101ea9aaa357423d707c8cb1d5a8450d6632f33ab875",
      "translation": "“明白！”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/003/dialogue/01.05/0015",
      "source_text_sha256": "2a3ef4ef038ae3c3c1d677d8c4586bbf700c52e94fc86c0224e54c0414af9a42",
      "translation": "“舰长，那3架投降的未知机体，\n　其驾驶员现在情况如何？”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "system/pilot",
        "system/unknown-machine"
      ],
      "notes": "原句指第 002 话中投降的三架未知机体及其驾驶员，不是三架被夺取的新型机。"
    },
    {
      "id": "story/003/dialogue/01.05/0016",
      "source_text_sha256": "ca2f3fc7a0901685a23c3ac1a64f31c69d247c5ace79021583e364411dbcda56",
      "translation": "“审讯已交给阿瑟·川恩副长负责”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [
        "people/arthur-short",
        "people/arthur-trine-full"
      ],
      "notes": "Arthur Trine 全名采用阶段术语表定名。"
    },
    {
      "id": "story/003/dialogue/01.05/0017",
      "source_text_sha256": "33c8bc44c12ccb4a3a6acf92290f68cd98956437accbe6e4f519df931b5feb05",
      "translation": "“是吗……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
