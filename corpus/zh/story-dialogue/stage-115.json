  "entries": [
    {
      "id": "story/115/dialogue/01.01/0000",
      "source_text_sha256": "d0381e36d56a6843eb23328498994dba2eaca3580cda073c31863f7b6d09cb91",
      "translation": "“那个殖民卫星……\n　从刚才开始就在细微地调整位置”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/space-colony-short"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.01/0001",
      "source_text_sha256": "c9bb8ce65e099f67f782e07f15ecf453a4423b2177c694fec9e28af9f8fec39c",
      "translation": "“既然能穿透过去，看来不是居住设施……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.02/0000",
      "source_text_sha256": "dfd5a9d6485e47f30407cd5ff3fbbc5fb63bc1a74419d6cd43b3c9b7ab856dbf",
      "translation": "“月球出现高能量体！正朝这边飞来！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.02/0001",
      "source_text_sha256": "eafb375c3c91cd669400fb5bd6c943c0d70a338c5246786d21f1bbecfdbcf75c",
      "translation": "“各机回避！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/evasion"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.03/0000",
      "source_text_sha256": "b5c1af32e2ff0c896beef8e2371f63820377f54d2bb71226287f73fed6886317",
      "translation": "“光束居然弯曲了！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.03/0001",
      "source_text_sha256": "fb9d2d0d39999be3d4654a8bbd5c4c4e436ac6b4c784a4db24c155122ec74ab8",
      "translation": "“这个方向……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/01.03/0002",
      "source_text_sha256": "c4e5445a3f943aa71cbb93bbb80e2979e0be4b2938ebc734242c406ec5525966",
      "translation": "“攻击目标是PLANT吗！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0000",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0001",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0002",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0003",
      "source_text_sha256": "814a51cc4282b883a45524c89d0524a8b7c5028ae2c04ba3b0c6bc6c86cc51f3",
      "translation": "“……你在悲伤吗……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0004",
      "source_text_sha256": "6304f6addde0bd903a2e12a730554ee8b4a4f8637ea0b9ecb3ff53ec7df6228d",
      "translation": "“……因为我的力量，很多人受伤了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0005",
      "source_text_sha256": "43424a0b550c0ff3b5825ac26b253897c9d7eafd375b2ec3320cf01de724a787",
      "translation": "“那并非你所愿”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0006",
      "source_text_sha256": "b0cf25a03917cb9d4650cbb9bd8b39af491ccf1226985e59d6404c97caa4b9e6",
      "translation": "“而且你至今仍在内心抵抗着”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0007",
      "source_text_sha256": "b573db0011e6f4664e95649a5b793e3fdd3dafb36d43c846e72efc7db423eab8",
      "translation": "“为什么……？既然你有意识，\n　为什么还要把力量借给那些人……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0008",
      "source_text_sha256": "4b5d872e716a70b83cdc3d3840d5f5c36eb6bc8e9262cb125bf6238d791d3aa0",
      "translation": "“我什么都没有……\n　我只是在观测人类的未来……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0009",
      "source_text_sha256": "9f33876951f49c5f65ed236d90df65bcc75fcc8597b5d7eb3551053245121f5b",
      "translation": "“我是D.O.M.E.……\n　曾经被称为新人类的存在……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/newtype",
        "technology/dome"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0010",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0011",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0012",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
      "translation": "黑屏",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "script/black-screen"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0013",
      "source_text_sha256": "bfae3cb8ecaad8f00abdb7cb610bd944f347cbe3636842fe7d217c639696c85b",
      "translation": "镇魂曲内部",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0014",
      "source_text_sha256": "bfae3cb8ecaad8f00abdb7cb610bd944f347cbe3636842fe7d217c639696c85b",
      "translation": "镇魂曲内部",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0015",
      "source_text_sha256": "bfae3cb8ecaad8f00abdb7cb610bd944f347cbe3636842fe7d217c639696c85b",
      "translation": "镇魂曲内部",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0016",
      "source_text_sha256": "fe7f38da6fa16582cd0de27d8e80da1033523d41588950debf228c01f7f406a2",
      "translation": "〜镇魂曲司令室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0017",
      "source_text_sha256": "edacf36cca5b225cb94863a11f8fb1fdd61538de392779c157102465f1267340",
      "translation": "“阿普利乌斯还健在！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0018",
      "source_text_sha256": "9735bd74233a226d7e0a802190f10b8fb327364e960a03abfd48881fae14a025",
      "translation": "“看来镇魂曲的输出比预定稍显不足”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0019",
      "source_text_sha256": "9875c5bdcc97d7f71fa39c3de73570180b682bd42e4a05e37569d122b8fae366",
      "translation": "“但PLANT方面的损失惨重。\n　包括降下月球的部队在内，全军已暂时撤退”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0020",
      "source_text_sha256": "93254196bab97b83dc4ae30b5dbd6b858e769f91b396397b5fc1cbc1fdb69ff2",
      "translation": "“不除掉迪兰达尔，就不能算胜利！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0021",
      "source_text_sha256": "b33baed7ad4c72dc211f9cfb572afcf1505e2c5e75c69f2102887a4dbe175ed9",
      "translation": "“赶紧准备再次发射！\n　这次一定要毁灭阿普利乌斯！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0022",
      "source_text_sha256": "9370eca5ce125552080fffb545fdf606ad587812c73b2ac62461604fad555a91",
      "translation": "“请稍等……考虑到蒂珐·阿迪尔的状态，\n　连续使用很危险”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0023",
      "source_text_sha256": "9cc417b635da35f1c326c7b5ebbe6341a2e5c9432bbed724340e7df8c3a448d2",
      "translation": "“什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0024",
      "source_text_sha256": "9ccb5ad5742a50d11dbf5764dd94b13323493dc7c786a29d266adfc12a2f2fdd",
      "translation": "“为了访问发电设施D.O.M.E.的\n　意志并使用其功能，我们控制了她的精神”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/dome"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0025",
      "source_text_sha256": "03ada3f80adba8243975ec595212b761f1bb43aaa8e02bf3bf6f1d5cd18a225a",
      "translation": "“这我已经听说了。就算有些不足，\n　事实上镇魂曲已经启动”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0026",
      "source_text_sha256": "4af48460adde7d114d47595ff2a0f6867e9b07d58cb3406159241afcd35e29f5",
      "translation": "“调整输出后，立刻再次发动攻击！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0027",
      "source_text_sha256": "5dc1222d1166d50d3b1728b4db85839da8e1142d6dc1328e768690f7bef3a57d",
      "translation": "“蒂珐·阿迪尔的精神控\n　制需要非常精密的调整”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0028",
      "source_text_sha256": "4f246d7599b9f92eacdcb15795266e1947714f7dcc610897e734e2bb1b185a27",
      "translation": "“如果完全剥夺她的意志，\n　她的感应能力也会被扼杀”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0029",
      "source_text_sha256": "9adeffa15d13e3a918e949f2f151331fb219249bf6ed771ce7936cd7b595ce91",
      "translation": "“因此，过度使用可能导致无法挽回的局面”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0030",
      "source_text_sha256": "94e1cde237ae76f797933be035705f2a63f0d3f911e1345870c734b4a7ef4b8e",
      "translation": "“唔……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0031",
      "source_text_sha256": "490ee1331ab0fec36a947cf1fbf37334363695bf0d829f810bab5120e9ea9e0e",
      "translation": "“请放心，阁下。这次不过是试射”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0032",
      "source_text_sha256": "cf5c905b435e74b23cc8e144df40aaf8eb69e453dee6525d6a4f9c2cd44ca079",
      "translation": "“分析本次获得的数据后，总有一天无需依\n　赖新人类的力量也能控制D.O.M.E.”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/newtype",
        "technology/dome"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0033",
      "source_text_sha256": "904a3a139c5f3589d69edc35515065406795a49dff6e6e39ef4414f79c88304d",
      "translation": "“那需要多少时间？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0034",
      "source_text_sha256": "1844b301fcda6066b897e18f6e0afc9bd4d88bff4a883b5e316a6ed1cc9ca941",
      "translation": "“请给我十天”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0035",
      "source_text_sha256": "d923d4244da74ad96acf73a4fdcd16f1fd13eb407697ba206203ac97a2295f8b",
      "translation": "“一周内完成。这是命令”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0036",
      "source_text_sha256": "70cc031ea4d4acf69a103463eb34f13bf23f4e899115ee813fe213c8fe909320",
      "translation": "“遵命。一定在一周内拿出成果”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0037",
      "source_text_sha256": "2279ccd8ab45ffd9b6ec4d1fa519c1c51287d3393b1da66104c3e01763e0d7d7",
      "translation": "“迪兰达尔那家伙……\n　现在大概正被镇魂曲的威力吓得发抖吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0038",
      "source_text_sha256": "a5405b29389716702a57db4bf7cc620b795fb0567303e786d11c3efd96f67b74",
      "translation": "“好好与恐惧和绝望为伴吧。\n　一周后，我会让你听到真正的镇魂曲”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0039",
      "source_text_sha256": "9aa103ce68f1e3c9ad6b63fb7b6b222060edd76a4a7b76d9bb5819d12056a851",
      "translation": "“然后下一个就是西罗克、杜威和艾岱尔！\n　排除他们，我将再次成为地球的盟主！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-96eedf25cbff",
        "people/speaker-e6fa3d02a89f"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-e6fa3d02a89f。按日文源词绑定统一全局术语：people/speaker-96eedf25cbff。"
    },
    {
      "id": "story/115/dialogue/02.01/0040",
      "source_text_sha256": "5126542fdd8f8f40ce914f79a7209acba8a31c0d2f10e5799ea6446f482e86ce",
      "translation": "（哥哥……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0041",
      "source_text_sha256": "0a0144dff5935ae98d1d9d6f1732be0c9998d83221776491ece36d3577f69008",
      "translation": "（让他做做梦也好……就现在而已……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0042",
      "source_text_sha256": "209b77cb64c88716d8714fe53e4969c8ffd522041a74f3c23c845dd3453af2d3",
      "translation": "（一周后……\n　那时才是我们真正的战斗开始……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0043",
      "source_text_sha256": "870ce5066e9e3ece17cd5a98ef96478997f850cb60aa20764b861096a99a34b1",
      "translation": "（得感谢那个告诉我们那男\n　人存在的黑之卡里斯马啊）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/black-charisma"
      ],
      "notes": "全文术语定稿：U:U49。"
    },
    {
      "id": "story/115/dialogue/02.01/0044",
      "source_text_sha256": "cfa8d743f7c2c00aca64ed1bf52dc5d835963a4cd8cfc3508ae16c77e08a9982",
      "translation": "（还有，这个多元世界也……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0045",
      "source_text_sha256": "a63928cff66210a98ced7bddb52b5253bbaa48686625d39e5011d5d96481c738",
      "translation": "（对命运的复仇……\n　我不会原谅那个夺走我们未来的男人）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0046",
      "source_text_sha256": "f08dac9ab391a8010b0352703dab3c36bd234f09c0633da5eff7b3e8137164f6",
