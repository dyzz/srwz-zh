    },
    {
      "id": "story/115/dialogue/02.01/0049",
      "source_text_sha256": "3fa7f52506d8a1074db37d517043dfdd8f7010b94932bbbac72a72323cf050dc",
      "translation": "评议会议长办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0050",
      "source_text_sha256": "3fa7f52506d8a1074db37d517043dfdd8f7010b94932bbbac72a72323cf050dc",
      "translation": "评议会议长办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0051",
      "source_text_sha256": "3fa7f52506d8a1074db37d517043dfdd8f7010b94932bbbac72a72323cf050dc",
      "translation": "评议会议长办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0052",
      "source_text_sha256": "9022c2f9f39e895eaf008b0fd348209a84a3ac6b7bfc1f18163af9edfd29e916",
      "translation": "〜最高评议会议长办公室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0053",
      "source_text_sha256": "1fd4d9892000727f13ab89936d73cd2a4f895bcffbfa7301d1d1d4ed0a782a79",
      "translation": "“迪兰达尔议长，\n　PLANT的受损情况如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/plant",
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0054",
      "source_text_sha256": "307577b94082c6d2872f51f020aa74defe71acd79d6a43568dd93087fdf995ad",
      "translation": "“……还是让你看影像比较快”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0055",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0056",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0057",
      "source_text_sha256": "3fe3a9d5ff5031b4a1a9f594cb565c8f7ef7186527690676d3e3ef2f40304c71",
      "translation": "？？？",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "纯标点或控制项，机器流程原样保留"
    },
    {
      "id": "story/115/dialogue/02.01/0058",
      "source_text_sha256": "1f786858184fbf3503ad4cc51630027a0d508c5b7dfa83d91ba0d8b8f77a16ae",
      "translation": "“……真惨啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0059",
      "source_text_sha256": "ff0cac1e5045bb9755465c0eabd6282d603402bbd29a5a8f371dc862a7e9a6e4",
      "translation": "“雅努阿里乌斯1到4被直击，迪森贝尔\n　7和8因雅努阿里乌斯4的撞击而崩溃”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0060",
      "source_text_sha256": "de2bb5360ac56d46f3637fa54e32adbe5fdd8cedb6319edcfac6d0cde2ac3930",
      "translation": "“包括二次灾害，共计6座殖民卫星毁灭。\n　死伤者超过100万人”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/space-colony-short"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0061",
      "source_text_sha256": "6ec8e26965869f3ba9b257605c867a2f799bb2885219044f5a36a28e9eb27a02",
      "translation": "“利用废弃殖民卫星的防护罩弯曲光束，\n　从各种角度进行狙击吗”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/space-colony-short"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0062",
      "source_text_sha256": "1238ae3810fff9c9c28e172fe70e46763799608b4c223d226a03381e0a25d7d5",
      "translation": "“据驻留月球附近的部队报告，\n　尚未发现第二次发射的迹象”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0063",
      "source_text_sha256": "407fd033a31ff7e8e11ed3856a19c274932f478016b6fde5a126ce01726818d9",
      "translation": "“看来可以认为它无法连射”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0064",
      "source_text_sha256": "3abdee01f7fc6c4619a16403187aca71ed56fdd2362fffd9acd4da05cc29e79a",
      "translation": "“但既然不知道下一次何时会来，\n　必须尽快摧毁它”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0065",
      "source_text_sha256": "9e522461c5ef25955a2860a7849c6a1411bf68a91cbf8ea5c20d64084a13d3f3",
      "translation": "“你打算怎么行动？\n　奥古叛离后，多线作战形势严峻啊”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/aeug"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0066",
      "source_text_sha256": "0ca7172c15a0ec837982e62ba5c4fa53ca5496b9a3eb38e54d52ded3abd2acd3",
      "translation": "“我要启动弥赛亚。为了用那东西吸\n　引吉布利尔的注意，我也会上前线”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0067",
      "source_text_sha256": "ac8a5fbcb2de1e5cc24fbd268502d03eef01c66ceb3337d9fdea2d205208c5c3",
      "translation": "“决一雌雄的时刻到了……我们、LOGOS\n　和新联邦……胜利者将肩负人类的明天”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/new-federation",
        "people/speaker-539973d146a5"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-539973d146a5。"
    },
    {
      "id": "story/115/dialogue/02.01/0068",
      "source_text_sha256": "7a4bde3b0f67c0ca7482aefef68f52075c303511c588c8f982615bb5851b55ef",
      "translation": "“如果我们胜利了呢……？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0069",
      "source_text_sha256": "7787cb01a4a9caa6ea94800dc1fa979ff0a788628fc228fe9f678e065ac807ef",
      "translation": "“为了不再重复这种愚蠢的错误，\n　我打算实施那个计划”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0070",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0071",
      "source_text_sha256": "4c06a4c34c661d8df73a7aae671d9bd6f7149a254da0b55dcbaa0e5c57fe8597",
      "translation": "“……明白了。宇宙革命军的主力离月球最近。\n　先让赛德尔行动吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/space-revolutionary-army",
        "people/speaker-f04a695faeed"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-f04a695faeed。"
    },
    {
      "id": "story/115/dialogue/02.01/0072",
      "source_text_sha256": "f8ee29d93f70731a823a749679c225bb0d5e2fe930747a30fa343b0c399a2246",
      "translation": "“哈曼·卡恩。感谢你成为我的同志”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0073",
      "source_text_sha256": "043dacef31084a55bfbf392c0300392565ed2852bb41179f49aea655b464b07d",
      "translation": "“我是忧心人类明天的人。\n　为此，我想采取最合适的行动”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0074",
      "source_text_sha256": "0af2146f99149a8546ae7f724abe65f6142be436b2f100d13b9c7cd9dcb130c9",
      "translation": "“那么，告辞了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0075",
      "source_text_sha256": "a3ca6a1dc55d4b1953c4b7918935f43f2a29d8033e0d9959448f72af94078c8c",
      "translation": "“人类的明天吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0076",
      "source_text_sha256": "8e3122eb21747fe9584b4115d1645be3123ec1839ba1f3c9b3e7ef9737686268",
      "translation": "“会是一场大战呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0077",
      "source_text_sha256": "80957b407e3aad88b8704ce1f2c520720e60dd4a3add988523e959263fecc2b9",
      "translation": "“而且将是最后一战。……你至今为止辛苦了”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0078",
      "source_text_sha256": "765ab3616b297b99fa454b696b7b584f7a3c13ecf002543153faab05cb46286b",
      "translation": "“是、是的……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0079",
      "source_text_sha256": "a7ded4261053b3814b92dd61d061d2d269a85d3b24bbb703188f5f8454574461",
      "translation": "“接下来世界将由力量推动。\n　在局势稳定前，你到后方好好休息吧”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0080",
      "source_text_sha256": "6e80de93b986dd383629950b9f014842f35ab05ca376c801f7093ec3076e92cd",
      "translation": "“我在月球的自由都市哥白尼准备了房间。\n　在那里等一段时间”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0081",
      "source_text_sha256": "7c697d2481f7b9f6fc6e99c079a83a96e63e6e55041de22007bf53f377871b1a",
      "translation": "“议长……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0082",
      "source_text_sha256": "401791d6cd71e0f4e6f5778ce66720cd3a615fb0d7a4cd6010875916d962fca0",
      "translation": "（在那之后不久，你就要永远告别了……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0083",
      "source_text_sha256": "f5996ea3394360d4b12ef04e36497df85757ad635208810cc5296888f7f0ccd5",
      "translation": "（塔丽亚……我真正的战斗即将开始……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-aa16fea188ec"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0084",
      "source_text_sha256": "998fef958a12c4e05ccb6f30c58953acf2b9cb0ac95f283389736326ee1f28df",
      "translation": "（你和雷他们也要回来。我打算用尽所有力量，\n　挑战这个世界和命运……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/ray",
        "people/rey-za-burrel-short"
      ],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0085",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。"
    },
    {
      "id": "story/115/dialogue/02.01/0086",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。"
    },
    {
      "id": "story/115/dialogue/02.01/0087",
      "source_text_sha256": "9dac21f56bfc0d848e47fb414bacddca98170326bd85b5296fd3f6435b4cc50d",
      "translation": "亚特兰迪亚",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。"
    },
    {
      "id": "story/115/dialogue/02.01/0088",
      "source_text_sha256": "37a2fba3530cb70cd218fcd95a318deb2c233c351410e054863341a6e92e5236",
      "translation": "“……丑陋……\n　为什么人类要同类相憎，互相残杀……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0089",
      "source_text_sha256": "5d9d7551fffa0c5d1bcf5f6bdf196477cf28146b0fa503fca0e674278a665955",
      "translation": "“那种丑陋的生物连存在都不被允许……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0090",
      "source_text_sha256": "34c429d9a68d2d9dfb47fe15d1ae44aad53e2c5ddf90ee16c483c55d9dec637d",
      "translation": "“……创圣之果结实时，\n　亚特兰迪亚将从因果中解放，新世界诞生”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/atlandia"
      ],
      "notes": "按日文源词绑定统一全局术语：place/atlandia。"
    },
    {
      "id": "story/115/dialogue/02.01/0091",
      "source_text_sha256": "76b9a0a6825531788a320cc6c541d2abe66c95388e983ec3d16641810d9ba4b6",
      "translation": "“创圣……新世界的诞生……\n　多么甘美的回响……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0092",
      "source_text_sha256": "617a3f89071d12530c0db953cf68e59d579ec511fb6b4eb6c6918bb531bb71ac",
      "translation": "“只有美丽的灵魂才应被迎入那个新世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/115/dialogue/02.01/0093",
      "source_text_sha256": "23a410e59bbc39670878e3e9bca38d3953805930d222a9909b35c004551d6860",
      "translation": "“人类没有那个资格”",
      "editorial_status": "draft",
      "translation_action": "translate",
