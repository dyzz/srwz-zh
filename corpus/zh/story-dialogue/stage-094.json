      "source_text_sha256": "bf6164bf0aa031416a86921ca844068461ed56e77910967b564506a5f68a04e2",
      "translation": "“知、知道了！\n　至少让我买一个……就一个部件！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/part"
