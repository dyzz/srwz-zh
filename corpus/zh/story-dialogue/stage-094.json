    ],
    "entry_count": 56,
    "unique_source_text_count": 54,
    "translated_entry_count": 56,
    "punctuation_only_entry_count": 1
  },
  "entries": [
    {
      "id": "story/094/dialogue/01.01/0000",
      "source_text_sha256": "7b7e2e3145fd9cb76cb7d9c8e655a1fc10b1ce22a90742d98edd0c77d8b7bbd1",
      "translation": "“醒过来了吗……真正的超限恶魔……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.01/0001",
      "source_text_sha256": "4f0d7ec2b86486960a369e8434ba832348911d4d33cd676af3cd72fed52b44ed",
      "translation": "“呜哦哦哦！超限恶魔！\n　好厉害……我能感受到好厉害的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.01/0002",
      "source_text_sha256": "ea900de6f1ad3afa0705ecfae8613d54a1670e0e3acd47435c3e4d2344feb295",
      "translation": "“这简直就是恶魔的能量！呀哈哈哈哈哈哈！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.01/0003",
      "source_text_sha256": "88d74e4ad80d89a15ec576bdf0aa5f1f859a977b3caf7f9e6246af8e58c1a028",
      "translation": "“那家伙！他想接触超限恶魔吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.01/0004",
      "source_text_sha256": "b45cbbb289cf3c533bdd806abb47b30d1e6332e704af1da3476b913719c2f857",
      "translation": "“我要得到它！终极之力，\n　给我到手吧啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "skill/extreme"
      ],
      "notes": "嵌套词表子串自动例外：skill/extreme"
    },
    {
      "id": "story/094/dialogue/01.01/0005",
      "source_text_sha256": "5c69dd99788ad5529dabd978767c4194dbb2cdad695e65e0509265375c0c3f33",
      "translation": "“来吧，超限恶魔！赐予我力量！\n　把你全部的力量都给我啊啊啊！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.02/0000",
      "source_text_sha256": "3c669232c8047d05c18f5e0324af72c5b533caaa4b1b77c924ce3cdf734abb63",
      "translation": "“为什么！？为什么毫无反应！？\n　还缺了什么吗！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.02/0001",
      "source_text_sha256": "85850b9c43ef18c7f791a16bbc5d5566ee7326708dab50373f958387cae149f9",
      "translation": "“缺的是你的品味啊，阿斯哈姆君～！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.02/0002",
      "source_text_sha256": "eb4259cf3c9e0b99bd32a07d8ed8ee97b6a5d9ac7a60ed7de34ce6c216e822ed",
      "translation": "“唔唔唔！你这混蛋啊啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0000",
      "source_text_sha256": "32fbe3305ac31506a37683a5f0386346cd1604a35343168aea00ce61e121cecb",
      "translation": "“哦！回来了吗，辛西亚！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.03/0001",
      "source_text_sha256": "ee3fa136aa0d3437a73b1e32e14fad2cec9341a336f2e9b3f463255f0e432154",
      "translation": "“那就是辛西亚……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.03/0002",
      "source_text_sha256": "f3c0149b8a440172c159192fb26210057653af3b59405291876f5543744f7117",
      "translation": "“超、超限恶魔也在这里！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0003",
      "source_text_sha256": "55bee78eb7c9db0d4e66d8693f378c8c9e0962b148565de5b0bccdadba4e3dac",
      "translation": "“切！有碍事的家伙来了吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0004",
      "source_text_sha256": "0bbc53ff0bb22a9b4379ec2106850b922e5cfa1df398fd32a2431b093f9d4307",
      "translation": "“阿斯哈姆·布恩！\n　你对基兹大人做了什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0005",
      "source_text_sha256": "6c07c5df4f9868cc218ea510a735010e4a3374f55db613d4de576b4732a4a636",
      "translation": "“闭嘴，突击丫头！\n　连那个带毛的都没拦住，我没空理你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0006",
      "source_text_sha256": "8480de7169c75f3b01097694e220081ec8041426e632cb2cb35854bc1bd0848c",
      "translation": "“你这家伙！就算是开玩笑也饶不了你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0007",
      "source_text_sha256": "042b363f38201a3dc87c08fa4530375e486bc0f8d8cb507da6fc5157f7101123",
      "translation": "“我本以为你还有点利用价值，\n　才对你客气，看来是我看走眼了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.03/0008",
      "source_text_sha256": "b347f425083150b5f4cde36cc578c57407aff910cc6c98c2ab5eeab07db00bd8",
      "translation": "“我不会原谅你的，阿斯哈姆！\n　我绝不会让你伤害基兹大人！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.04/0000",
      "source_text_sha256": "78b196b776261f0da362594090b51e189510fa2672a9a13e94ead534d6a71c6f",
      "translation": "“什么！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.04/0001",
      "source_text_sha256": "2438a4919814613e021bd8f9f813f2cfb08c3da258da3ab54e5cfb4e1e8a4a00",
      "translation": "“辛西亚·琳！这里交给我！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.05/0000",
      "source_text_sha256": "115bf34dcee4eb99aa9c06dd531b9445514a96837e7735a8ccdb400a2a90659e",
      "translation": "“啊……啊啊……好冷……冻僵了……啊啊……\n　我的……钻石……冻住了……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.06/0000",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.07/0000",
      "source_text_sha256": "a739c23310201001934d7697089befcc572bb9f5ced156924af1e31a6ed39b2c",
      "translation": "“别、别过来！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.08/0000",
      "source_text_sha256": "eb8ef602f8b8cf68f4efb84cea0df04b7a2275b258d7d4c9cb77907cbb42dad8",
      "translation": "“不、不要……！\n　我不想变成远古时代的冰之女王！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0000",
      "source_text_sha256": "42c3e13d5661e13006b05cc8dda9509f38ff43f787cf759be886f5cc71e42ae4",
      "translation": "“超限恶魔要吞噬辛西亚吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia",
        "unit/overdevil"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.09/0001",
      "source_text_sha256": "1044a1605b31070f255381281e0cbbf57177c37d93b5feee369dfb141246921d",
      "translation": "“啊……啊啊……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0002",
      "source_text_sha256": "5b8c4c949799639091c36256200617e8f9151808d83bbacbdfbff72a784fa05f",
      "translation": "“辛西亚！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.09/0003",
      "source_text_sha256": "b1e6e33b0e5c9f699be0ff75498961a05571082e23291183ebbed23b11711206",
      "translation": "“为什么，超限恶魔！为什么不选我！？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0004",
      "source_text_sha256": "c5443e258df722c5d1bb11d30312029ab08f9090c74d4d1021f6d5ff01d1e275",
      "translation": "“我真正渴望的东西，难道什么都得不到吗！？\n　卡琳的心……还有该隐的力量！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/gain"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0005",
      "source_text_sha256": "712bb96b42fee0727cfb0a19424533df678bcb038caa24714a23af19e9ab855f",
      "translation": "“超限恶魔！为了我的目的，我需要你！\n　我想要你啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0006",
      "source_text_sha256": "fddf3ef0bee0482072f4bcc3c46253c2e9d33a9712f2e86aa99d73f936b598b0",
      "translation": "“把我！把这充满绝望的灵魂献给你！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.09/0007",
      "source_text_sha256": "a7528cb0f0aad56860649ed6de5f7de9c857629dddd3c54eb02bbf21429d39f6",
      "translation": "“所以！听听这个叫阿斯哈姆的\n　可怜男人的声音吧啊啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.10/0000",
      "source_text_sha256": "fd086d77543090edb1b156cc63e996c273f774c84cae34aa9b2e131b270da154",
      "translation": "“哦哦哦！哦哦哦哦哦！！\n　你回应了我的声音吗！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.10/0001",
      "source_text_sha256": "56f3058d13914771c6fe83591431464f5bfc375124f05a239d77892b2f72deab",
      "translation": "“多米尼达！到我这边来！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "user/unit/dominator"
      ],
      "notes": "正式词表构建审计修正。",
      "glossary_exceptions": [
        "unit/dominator"
      ]
    },
    {
      "id": "story/094/dialogue/01.11/0000",
      "source_text_sha256": "e20d45027754bb29a4bc7a46620f3fdda34ab51db0a36a96f651b5b4c946e6e7",
      "translation": "“歌唱吧，超限恶魔！让世界超限冻结！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.12/0000",
      "source_text_sha256": "4d64fc00fa9767c9c6561a839df385c5385faa62ace78b0ff9421fd6b41a151a",
      "translation": "“不好！阿斯哈姆那家伙！\n　被超限恶魔吞噬了心灵吗！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/asuham",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.12/0001",
      "source_text_sha256": "95cd0283e4ddc9c458f0bf153ce05916f2fb487473f1be55149f1269a6536acf",
      "translation": "“撤退！放弃阿加托结晶！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/agato-crystal"
      ],
      "notes": "按日文源词绑定统一全局术语：place/agato-crystal。"
    },
    {
      "id": "story/094/dialogue/01.13/0000",
      "source_text_sha256": "4eec674a8127bd1383c2c50a04d9135ae3ce148600f3cfe587717f76c47fe237",
      "translation": "“辛西亚……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/cynthia"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/094/dialogue/01.13/0001",
      "source_text_sha256": "2678ba11fcd6fa6a8f56f294ee5dd4d75aa9c8067e196e255e9e1efbe0f696c7",
      "translation": "“重整态势！\n　向全世界西伯铁分公司发出联络！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/siberian-railway"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0000",
      "source_text_sha256": "598667970e0ab7897a24cb4e422f1041d2e246f1b791a4cd9426fecafe8b9798",
      "translation": "“那就是超限恶魔的真正力量……\n　黑历史中传颂的破坏军团的一员……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/black-history",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0001",
      "source_text_sha256": "c4ff3c4ec14b803fcca7fcc63c8b42bcb1d5654e247bafac7bd382a446fd3477",
      "translation": "“堕天翅、超限恶魔、月之蝶……\n　世界正走向终结……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "species/fallen-angel",
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0002",
      "source_text_sha256": "30825d93bec021916c729a36e48dbacfdd59a8a0fb667951bb446c20c4ceea66",
      "translation": "“在最后显现的真相……那是伟大之力……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/great-power"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/great-power。"
    },
    {
      "id": "story/094/dialogue/01.14/0003",
      "source_text_sha256": "ccd083f3311b755f15bcd32e8662ea8eefb1bfa13fa9b40dab5635c7a11c90fc",
      "translation": "“哈哈哈哈哈哈！超限恶魔啊，\n　用暗黑的白夜覆盖世界吧啊啊啊！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "unit/overdevil"
      ],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0004",
      "source_text_sha256": "612ccbaea32a4dc5d368b5f17d87b1d354a49306ace9769d0e2eb3432841136a",
      "translation": "“就算你不按我的意思来，那也无所谓！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0005",
      "source_text_sha256": "60459efe47cdaae136f20d949449a977aee1d108b03b0c07bfeb67ef8501fb2a",
      "translation": "“但你听到了我内心的声音！从今天起我就是\n　你的一部分！让我和你一起冻结世界吧！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0006",
      "source_text_sha256": "89952908c62d47fa5290ea420ae4b8ca94dc0f9fe7b830bac0cdd4d29c7a5829",
      "translation": "“哈哈哈哈哈哈！哈哈哈哈哈哈哈哈哈哈！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/094/dialogue/01.14/0007",
      "source_text_sha256": "e0151a2223643ec731662523c4b1cf2a795a4c07bc660a1d9615e8fb25bf8b28",
