      "source_text_sha256": "3ef0887a5d3323a0224bd07e430209a2075f014408d02bb1b8ce155499423ceb",
      "translation": "“等等！\n　这几天的战斗让巴扎上出了好多便宜货！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
