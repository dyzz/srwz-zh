    ],
    "entry_count": 81,
    "unique_source_text_count": 78,
    "translated_entry_count": 81,
    "punctuation_only_entry_count": 3
  },
  "entries": [
    {
      "translation": "“罗杰·史密斯先生呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0000",
      "source_text_sha256": "683a6d4939c4963d59240f39aa47f2aaae1fb2a0ed699b7cf5a6c265b8455326"
    },
    {
      "translation": "“今天一早就出发了。\n　他说不需要大张旗鼓地送行……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0001",
      "source_text_sha256": "a7c5e5a64ca93e4d9ef615da042a4e0b227fcda8335920eb7d8e635c2eb48640"
    },
    {
      "translation": "“那个人有些与众不同的讲究呢。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0002",
      "source_text_sha256": "a463e1eb2767930c1462b287835c200276c650e68fe00c73b5e95ed3456a0f1d"
    },
    {
      "translation": "“算是他自己的美学吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0003",
      "source_text_sha256": "33c48e6a244719acd469c98b036c339f2838932d7f24a47544efb884c4e8ff48"
    },
    {
      "translation": "“啊——……难得又见到多萝茜小姐，\n　却马上又要分别了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0004",
      "source_text_sha256": "84c7a6a4ca7d62de294de554e2b252af5c5ff09e6f3032f858ee1ab0b02850a8"
    },
    {
      "translation": "“说什么呢，摩姆。\n　同为机器人，不是还有老夫在吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0005",
      "source_text_sha256": "e830335c18f6fbd1de7ca2cf45983f3e897d750f64fd54036a9d6d56e10de694"
    },
    {
      "translation": "“那么，上尉……！能帮忙洗衣服、打扫吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "id": "story/049/dialogue/00.01/0006",
      "source_text_sha256": "4ac0788807b6f508570aaf9abd05cd47bb642b14d2c718998ce00f48c1eb307c"
    },
    {
      "id": "story/049/dialogue/00.01/0007",
      "source_text_sha256": "f51a5fd118c9da16ed14b60ef1e7763bf0febca761eab9f969423e52eada2ba8",
      "translation": "“这、这个嘛……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "translation": "“布里吉塔她们也要离开，\n　人手不够了。不愿意也得帮忙哦！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0008",
      "source_text_sha256": "f1fb07ac111cf789e553c8e4b54bf0fc6b288dd3bccbb5a6bb9679d4a815c3c4"
    },
    {
      "translation": "“好了好了，别吵了。差不多该出发了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0009",
      "source_text_sha256": "89cc774ad9b9b6de20ec9ea0be7749d5bfc6d1f7caead43aa8bb415c15de432d"
    },
    {
      "translation": "（只要ZAFT部队能牵制奇拉姆，\n　我们就能安全前往埃曼……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0010",
      "source_text_sha256": "6003c24ad284410a5ddc6a22803d2431eb95bdb497be447d288e06c07e212b49"
    },
    {
      "translation": "（虽然对格拉迪斯舰长过意不去，\n　但这里就让他们当诱饵吧。）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0011",
      "source_text_sha256": "7a3d51522e83bc45bdb612ac2c4aac365f4a2cefdf51eb12834a2d2f2c71f904"
    },
    {
      "translation": "“不过，这样真的好吗，小姐？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0012",
      "source_text_sha256": "48b25983a503a6535ec5709bafd6fc05799442718d60563388cc671f7fd02334"
    },
    {
      "translation": "“要是继续和ZAFT在一起，\n　就真的非得跟联邦军开战不可了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0013",
      "source_text_sha256": "bcdf05085901118c47bef1498a4165b97f07959d42fae4df5d56eb2e466f85a2"
    },
    {
      "translation": "“但只要在这里分开，\n　联邦军肯定会追他们，放过我们。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0014",
      "source_text_sha256": "2cbf1e6ccf23b9949bcff4eacd95e6e7df98bf9a1e51b69921a5bc1eca071b3a"
    },
    {
      "translation": "“这个嘛……对我们来说，不管联邦还\n　是ZAFT获胜，都没什么关系……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0015",
      "source_text_sha256": "1934b53f46ef363abe1d2ad8a25fbbf3540db03e0b33ad9ffbaf648663654eee"
    },
    {
      "translation": "“今后要向格罗玛学习，好好做搬运生意！\n　毕竟ZAFT不会再给报酬了！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0016",
      "source_text_sha256": "6b69bafa4058baf19b7d0f1da69970cfcada71aea83d480f1a9655a8f2f842e6"
    },
    {
      "id": "story/049/dialogue/00.01/0017",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "translation": "“不用担心，蒂珐。我们只要走自己的路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0018",
      "source_text_sha256": "d4aefff588691cd3bf6443c6f1987fa327b13f7c1eeaf5c442098720ca97b576"
    },
    {
      "translation": "“可是，和ZAFT一起行动\n　不是更有安全保障吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0019",
      "source_text_sha256": "4d84cd45eab16b8ef89fb2e73b1185412929252333db5edaa48c944cc4389e34"
    },
    {
      "translation": "“……也许吧。但在这看不见明天的世界……\n　我们要自己决定前进的道路。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0020",
      "source_text_sha256": "88e5d07980b4822da795010a148f71161d3385cdddfc1537fa5a30310d17dd6a"
    },
    {
      "translation": "“因为和ZAFT一起行动，\n　就不会有那种自由了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0021",
      "source_text_sha256": "4d149a37bf0824533389e37efa1a975093ed89bee0f47441da930e63c3ed4a6d"
    },
    {
      "translation": "（阿姆罗上尉……我也打算自己寻找答案。\n　和蒂珐、伙伴们一起……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-12eb2b5facdc"
      ],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。按日文源词绑定统一全局术语：people/speaker-12eb2b5facdc。",
      "id": "story/049/dialogue/00.01/0022",
      "source_text_sha256": "2f63c4a43fdb46af6cccad9909cac06e880dcd47415499be4ff488cdc196db75"
    },
    {
      "translation": "“我也赞成那个墨镜舰长的想法。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0023",
      "source_text_sha256": "36d3494686a2b6411aa1da11e0ccb651135e5c1bf064e202035022baa25edf02"
    },
    {
      "translation": "“不愧是前新人类啊。不过……\n　我的直觉也告诉我，这样下去不会有好事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0024",
      "source_text_sha256": "5a045e75f3459e6d97b64b6f9a06ef88e97305efdbb3e2c9bd18d41db5fffced"
    },
    {
      "translation": "“这就是月光洲脱离的理由吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0025",
      "source_text_sha256": "6125c3ae485aaaf0255009480b640c969df4c634bc43df6ee4efdcd0640af8b9"
    },
    {
      "translation": "“我讨厌事情在我不知道的地方擅自被决定。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0026",
      "source_text_sha256": "f6391e7132fcd8d1009adb5f85af0ebbc4cdb3b6d743130e4979c5ecc9b84423"
    },
    {
      "translation": "“听从素未谋面的某人指示，\n　被使唤得团团转，我已经受够了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0027",
      "source_text_sha256": "beb2a58d141621a67c939786abec914e97b3adb38a4831573c24429acfb5450b"
    },
    {
      "translation": "“同感！果然自己的路，就该由自己决定！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0028",
      "source_text_sha256": "f208e4b88d1e81c10c422600ecd0147c4f1976ef0056a81beac52cf626fe50e6"
    },
    {
      "translation": "“说得对。……不要哀求，学会争取！\n　若是如此，终有所获！！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0029",
      "source_text_sha256": "12ac3ec73af98d259cc0a5c7311b1369e678ac9d766d01cb422b555ca01e2ceb"
    },
    {
      "translation": "“那就出发吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0030",
      "source_text_sha256": "9b05c557ed3232c23ced7c8801977ec5baf4cce055ead5188d082177d7124fcc"
    },
    {
      "translation": "“$c各舰，出发！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.01/0031",
      "source_text_sha256": "62f1afbb149e5509356d69bcf12e2db7c2dcef4a4f622635f4a52c3e8b680abb"
    },
    {
      "translation": "（再见了，伙伴……有缘的话，再会吧……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.02/0000",
      "source_text_sha256": "d1052643eb1f6a8d1735c5f7cc903b567b44a96b5a2e784e1f6a83babde066e8"
    },
    {
      "id": "story/049/dialogue/00.03/0000",
      "source_text_sha256": "1c58432c4614d72a36b0e36cd60aebc248b6452e1d25220e19094a63cc4915c9",
      "translation": "“走了吗……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "translation": "“他们有他们的活法……\n　而我们也有自己的战斗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0001",
      "source_text_sha256": "725e5c8d3facdb2742706e6cd71a2644d675d218041bf91168896ce60cddbcc8"
    },
    {
      "translation": "“是……我们也出发吧。……$c\n　各舰，启动！目标，加利亚大陆……香港！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0002",
      "source_text_sha256": "057bc4f8a23cf938d904048c519042b84e1c730faa3c0e1e5fffe956470f26da"
    },
    {
      "translation": "“明白！　各舰，启动！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.03/0003",
      "source_text_sha256": "dd37603188ab4416a85572a4e38bd41247ea22196e44443ed90846966f9e8d74"
    },
    {
      "translation": "（我的战斗……既是为了世界，\n　也是为了我自己……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.04/0000",
      "source_text_sha256": "0458001c0afaa46d6ac7a8e744157c58b9318cc7aea27d5f783c94e70bb7f7c5"
    },
    {
      "translation": "（队长、托比……我会背负荣耀之星，\n　继续战斗下去……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.04/0001",
      "source_text_sha256": "14d9de5cbeafe082015669a748e63b26cd7c819e0dc0a9e754b054256a38c1f5"
    },
    {
      "translation": "“大哥——！大家——！　要加油啊——！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0000",
      "source_text_sha256": "c9bd202088baf55503f4048cfab2ffa53593cd0bd101c295686eb9a6aa2abb98"
    },
    {
      "translation": "“姐姐——！大家——！　要保重啊——！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。日文“元気”为普通词“保重”，不是人物元气。",
      "id": "story/049/dialogue/00.05/0001",
      "source_text_sha256": "6202a2d8c17ba3aac29f63b73e8e1dd6cbc414b4b47df89c2f76c257f6054247",
      "glossary_exceptions": [
        "people/speaker-7fc6e83611c6"
      ]
    },
    {
      "translation": "“战士们踏上旅途……\n　即使目标各不相同，也要英勇振翅……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0002",
      "source_text_sha256": "654157d85c58e5cf240efbb94bc3d96ba954cc17ef3f04929bc42992b79d1ad4"
    },
    {
      "translation": "“莉娜……看得到吗？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0003",
      "source_text_sha256": "4572ab56497f8e8c6ccc5172b7a78317f5f3aa82d0d30d2b80b3d3ac18c36661"
    },
    {
      "translation": "“无论哪一支$c，\n　前方都阴云密布。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0004",
      "source_text_sha256": "24c9f90fc4aad9ed984dd3aeb016f72f88f072babfd7751ab506f5e099daf669"
    },
    {
      "translation": "“怎么会……！既然已经预见到意外，\n　就应该给他们一些建议！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0005",
      "source_text_sha256": "2cc2881abf17c1d1cbae3ad2a5f0bb29e23fc243399ac7838611c486dda38629"
    },
    {
      "translation": "“……阴云会唤来风暴，降下雨水……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0006",
      "source_text_sha256": "7fab5ecda6f5ec2dd40934a348090b37579d673b55c1970263aa2782afddb1b8"
    },
    {
      "translation": "“然而，风会带来新鲜空气，\n　雨水会滋润大地……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0007",
      "source_text_sha256": "0d165c986f4cb9fb35de956b2e5b366b757e9815da17a71557da8fe9fec9f932"
    },
    {
      "id": "story/049/dialogue/00.05/0008",
      "source_text_sha256": "6fabd32f4374540741642ed446234b3357d188a0822fe8a2101731d7363bef2b",
      "translation": "“咦……”",
      "editorial_status": "reviewed",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "跨关同源感叹；按上下文分别处理为疑惑、迟疑或震惊。"
    },
    {
      "translation": "“也就是说，不能断言那一定是凶兆。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0009",
      "source_text_sha256": "2e2e41ad7bd36343473688a9ad12b526160665f9287abedb6df3dc3a2c08a3fb"
    },
    {
      "translation": "“当然，也不能说是吉兆。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0010",
      "source_text_sha256": "98b9fff230679559ab8dc06747cda6d7c5b101c13396a683bd57757d24f735f9"
    },
    {
      "translation": "“那么，究竟会怎样呢……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0011",
      "source_text_sha256": "867bf402d5b28253030a114192e8b73a04bccd66d2a0f4a3ce94055261c927f4"
    },
    {
      "translation": "“美丽地起舞吧，战士们……\n　遵从自己的内心……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "ISSUE-025：补录结构扫描发现的多引用 STAGE 首剧情块。",
      "id": "story/049/dialogue/00.05/0012",
      "source_text_sha256": "90ffe760aa3933c06993f974ee2915aa99f12335e4ea598531a24e02556a5a47"
    },
    {
      "id": "story/049/dialogue/01.01/0000",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0001",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0002",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0003",
      "source_text_sha256": "e8b9727619e821b9ce768729f518750cd6c1caab535d8ea1072bb0ddc485bcb7",
      "translation": "〜新地球联邦军　高官用办公室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0004",
      "source_text_sha256": "05b33233869117e586096750f36055503ae9d87548d47a0c760458e216d9af0c",
      "translation": "“……通知就这些，艾岱尔·贝尔纳尔准将。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0005",
      "source_text_sha256": "d5ec30fb3008da34f41f77def5ccec81991d187f5d4a160f5a919e82bcec8195",
      "translation": "“我成为贤人会议的成员？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0006",
      "source_text_sha256": "4d60d896bff3052ecee311a5acde54b50d415557bce21c59b7564ee8ebc036d9",
      "translation": "“这是说加米托夫和约定之地\n　的三贤人都认可你的功绩。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "location/promised-land"
      ],
      "notes": "按日文源词绑定统一全局术语：location/promised-land。"
    },
    {
      "id": "story/049/dialogue/01.01/0007",
      "source_text_sha256": "7485ca23b26e6a91b7496b584a776b1fffd1933104ab4802d635a063ec0e2eaa",
      "translation": "“……明白了。我谨此接受。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0008",
      "source_text_sha256": "010027e6db2125c8884cdbd93e5e10466967e4db0ff26c1b2bd4d95256b40ac1",
      "translation": "“从今天起，\n　你也将成为决定这个多元世界未来的一员。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0009",
      "source_text_sha256": "78404faad85aa0e0742c9ee92b5bc51ab0117cb5a705ae47e6f7154c83526ffb",
      "translation": "“不过，\n　迟早那些老人也得请他们退场就是了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0010",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0011",
      "source_text_sha256": "14c7b85710346b1ba5cc94b75310f6aa13f517ee6414571fd1f8d7b2378317b4",
      "translation": "“到那时，也期待你的力量。那么……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0012",
      "source_text_sha256": "faaa3c02c275bb256bd44a23f873813acb42495cba4e40916512d5d6a689cee6",
      "translation": "“新地球联邦的幕后支配者，\n　贤人会议……我，将成为其中一员……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0013",
      "source_text_sha256": "0c5b75bf64f02a888367c89359da3a95e3224bb54136eaed56795d77fabf2e2a",
      "translation": "“这也许是机会，\n　但也有可能暴露我们的动向……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0014",
      "source_text_sha256": "e7ae70d723e0b8fa2fc39c4a22aaefbc96fb6452928bb738ee095502b08c5b56",
      "translation": "“爱你哟～！艾岱尔大人，\n　这里就用积极思维来应对吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:user-u42。",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/049/dialogue/01.01/0015",
      "source_text_sha256": "cbf191f6ba92204a1c1aa770d8d858acde20d3ecb02f0ceb8fa451582b5a3be5",
      "translation": "“……极艾博士，情况如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。"
    },
    {
      "id": "story/049/dialogue/01.01/0016",
      "source_text_sha256": "825fc7fd1d1c16edc2b9eaea1202eca144093d61d481a137ccf8ce73b21f9f78",
      "translation": "“嚯嚯嚯！雷本和休兰那边有报告了。\n　日本的善后工作一切顺利喵。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": "采用项目研究过的人名“休兰”。"
    },
    {
      "id": "story/049/dialogue/01.01/0017",
      "source_text_sha256": "c0cd93a4c0ab239d5746d461c3cfa2a56836f08428b2a651e6722d8054039f23",
      "translation": "“$c呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0018",
      "source_text_sha256": "fb6cd5e1a206ae74385ce422a43fef5dbde55c0109a431bdbf1943c33cc5cde1",
      "translation": "“呜嘿嘿！那帮家伙内讧了喵！\n　这倒是出乎意料，嗯哼哼！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0019",
      "source_text_sha256": "bdb25f5ad6f01d8b3d6755965bd24f69062896f6a02388add00c713021192d4e",
      "translation": "“加米托夫和吉布利尔似乎打算一边派\n　幻痛部队，另一边派阿盖哈队去对付。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/phantom-pain"
      ],
      "notes": "采用项目研究过的人名“吉布利尔”。"
    },
    {
      "id": "story/049/dialogue/01.01/0020",
      "source_text_sha256": "07e01372b8c5e4ad2e0cf14b9c283536dcb7a386c911ec2e690330036876cd55",
      "translation": "“立刻通过雷本，把两队的情报发\n　送给双方的$c……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0021",
      "source_text_sha256": "074b390b4db68e6104960624178847a9883b9edf1a6da2124be4746e3f9cbf93",
      "translation": "“诶——！我觉得保持沉默更有意思的说……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0022",
      "source_text_sha256": "3a1bfabeb1cd5f24dbf3c8a9ea0f1aa0ce2d91118dd75d0f958b287d7b2fe210",
      "translation": "“我们不是在闹着玩！无论是我们还是他们，\n　都是为了世界和平……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0023",
      "source_text_sha256": "a7c263a54b88411fe4173cdbfed297de52707a270ff78a24dea966e444aece94",
      "translation": "“爱你哟～！请别那么生气嘛，\n　艾岱尔·贝尔纳尔准将。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": "全文术语定稿：P:user-u42。"
    },
    {
      "id": "story/049/dialogue/01.01/0024",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0025",
      "source_text_sha256": "4393563ae12aace2bab5fe446bf4892f8cd35e7a48f80c80cbd79b09db0b782a",
      "translation": "“……明白了。那么，\n　博士请继续您的研究吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0026",
      "source_text_sha256": "9a03c245d564c1b67a05f41cf828fa13a18812a83c836987d897d8b243ba4318",
      "translation": "“呜嘿嘿！那我就恭敬不如从命了喵。\n　告辞了，呜嚯嚯！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0027",
      "source_text_sha256": "261a11f5edf405b7970acb5154e2b90e56bb518669ca1bd47a297b80eb922a0c",
      "translation": "“……拜托您了，极艾博士。还有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。"
    },
    {
      "id": "story/049/dialogue/01.01/0028",
      "source_text_sha256": "1f9bd4fe6cbe9a38e7734a40b8d8bc4bcef2938b2076937aaa2f4507779f9a4a",
      "translation": "“不能输啊，$c。\n　因为你们，是改变这个混沌世界的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
