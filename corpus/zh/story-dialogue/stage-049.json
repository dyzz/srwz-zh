  "entries": [
    {
      "id": "story/049/dialogue/01.01/0000",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0001",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0002",
      "source_text_sha256": "f7cb66929e65665cf2298998c4584cf9b256abf238b662f0e645a9d944bf285d",
      "translation": "新地球联邦军本部　高官用办公室",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0003",
      "source_text_sha256": "e8b9727619e821b9ce768729f518750cd6c1caab535d8ea1072bb0ddc485bcb7",
      "translation": "〜新地球联邦军　高官用办公室〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/federation-forces",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0004",
      "source_text_sha256": "05b33233869117e586096750f36055503ae9d87548d47a0c760458e216d9af0c",
      "translation": "“……通知就这些，艾岱尔·贝尔纳尔准将。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0005",
      "source_text_sha256": "d5ec30fb3008da34f41f77def5ccec81991d187f5d4a160f5a919e82bcec8195",
      "translation": "“我成为贤人会议的成员？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0006",
      "source_text_sha256": "4d60d896bff3052ecee311a5acde54b50d415557bce21c59b7564ee8ebc036d9",
      "translation": "“这是说加米托夫和约誓之地\n　的三贤人都认可你的功绩。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0007",
      "source_text_sha256": "7485ca23b26e6a91b7496b584a776b1fffd1933104ab4802d635a063ec0e2eaa",
      "translation": "“……明白了。我谨此接受。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0008",
      "source_text_sha256": "010027e6db2125c8884cdbd93e5e10466967e4db0ff26c1b2bd4d95256b40ac1",
      "translation": "“从今天起，\n　你也将成为决定这个多元世界未来的一员。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0009",
      "source_text_sha256": "78404faad85aa0e0742c9ee92b5bc51ab0117cb5a705ae47e6f7154c83526ffb",
      "translation": "“不过，\n　迟早那些老人也得请他们退场就是了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0010",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0011",
      "source_text_sha256": "14c7b85710346b1ba5cc94b75310f6aa13f517ee6414571fd1f8d7b2378317b4",
      "translation": "“到那时，也期待你的力量。那么……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0012",
      "source_text_sha256": "faaa3c02c275bb256bd44a23f873813acb42495cba4e40916512d5d6a689cee6",
      "translation": "“新地球联邦的幕后支配者，\n　贤人会议……我，将成为其中一员……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/049/dialogue/01.01/0013",
      "source_text_sha256": "0c5b75bf64f02a888367c89359da3a95e3224bb54136eaed56795d77fabf2e2a",
      "translation": "“这也许是机会，\n　但也有可能暴露我们的动向……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0014",
      "source_text_sha256": "e7ae70d723e0b8fa2fc39c4a22aaefbc96fb6452928bb738ee095502b08c5b56",
      "translation": "“爱你哟～！艾岱尔大人，\n　这里就用积极思维来应对吧！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "全文术语定稿：P:user-u42。",
      "glossary_exceptions": [
        "people/shinn"
      ]
    },
    {
      "id": "story/049/dialogue/01.01/0015",
      "source_text_sha256": "cbf191f6ba92204a1c1aa770d8d858acde20d3ecb02f0ceb8fa451582b5a3be5",
      "translation": "“……极艾博士，情况如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。"
    },
    {
      "id": "story/049/dialogue/01.01/0016",
      "source_text_sha256": "825fc7fd1d1c16edc2b9eaea1202eca144093d61d481a137ccf8ce73b21f9f78",
      "translation": "“嚯嚯嚯！雷本和休兰那边有报告了。\n　日本的善后工作一切顺利喵。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": "采用项目研究过的人名“休兰”。"
    },
    {
      "id": "story/049/dialogue/01.01/0017",
      "source_text_sha256": "c0cd93a4c0ab239d5746d461c3cfa2a56836f08428b2a651e6722d8054039f23",
      "translation": "“$c呢？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0018",
      "source_text_sha256": "fb6cd5e1a206ae74385ce422a43fef5dbde55c0109a431bdbf1943c33cc5cde1",
      "translation": "“呜嘿嘿！那帮家伙内讧了喵！\n　这倒是出乎意料，嗯哼哼！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0019",
      "source_text_sha256": "bdb25f5ad6f01d8b3d6755965bd24f69062896f6a02388add00c713021192d4e",
      "translation": "“加米托夫和吉布利尔似乎打算一边派\n　幻痛部队，另一边派凤蝶队去对付。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/phantom-pain"
      ],
      "notes": "采用项目研究过的人名“吉布利尔”。"
    },
    {
      "id": "story/049/dialogue/01.01/0020",
      "source_text_sha256": "07e01372b8c5e4ad2e0cf14b9c283536dcb7a386c911ec2e690330036876cd55",
      "translation": "“立刻通过雷本，把两队的情报发\n　送给双方的$c……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/leben"
      ],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0021",
      "source_text_sha256": "074b390b4db68e6104960624178847a9883b9edf1a6da2124be4746e3f9cbf93",
      "translation": "“诶——！我觉得保持沉默更有意思的说……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0022",
      "source_text_sha256": "3a1bfabeb1cd5f24dbf3c8a9ea0f1aa0ce2d91118dd75d0f958b287d7b2fe210",
      "translation": "“我们不是在闹着玩！\n　无论是我们还是他们，都是为了世界和平……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0023",
      "source_text_sha256": "a7c263a54b88411fe4173cdbfed297de52707a270ff78a24dea966e444aece94",
      "translation": "“爱你哟～！请别那么生气嘛，\n　艾岱尔·贝尔纳尔准将。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": "全文术语定稿：P:user-u42。"
    },
    {
      "id": "story/049/dialogue/01.01/0024",
      "source_text_sha256": "34368aa8863a39b65209577a75f10dac6789c2d354755b1712786b26792dc22a",
      "translation": "“！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0025",
      "source_text_sha256": "4393563ae12aace2bab5fe446bf4892f8cd35e7a48f80c80cbd79b09db0b782a",
      "translation": "“……明白了。那么，\n　博士请继续您的研究吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0026",
      "source_text_sha256": "9a03c245d564c1b67a05f41cf828fa13a18812a83c836987d897d8b243ba4318",
      "translation": "“呜嘿嘿！那我就恭敬不如从命了喵。\n　告辞了，呜嚯嚯！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/049/dialogue/01.01/0027",
      "source_text_sha256": "261a11f5edf405b7970acb5154e2b90e56bb518669ca1bd47a297b80eb922a0c",
      "translation": "“……拜托您了，极艾博士。还有……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": "采用项目研究过的人名“极艾”。"
    },
    {
      "id": "story/049/dialogue/01.01/0028",
      "source_text_sha256": "1f9bd4fe6cbe9a38e7734a40b8d8bc4bcef2938b2076937aaa2f4507779f9a4a",
      "translation": "“不能输啊，$c。\n　因为你们，是改变这个混沌世界的力量……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
