  "entries": [
    {
      "id": "story/081/dialogue/01.01/0000",
      "source_text_sha256": "beef6afa431e042aead7a2e2bc1c3a117a1aebbcbe16bc61a0686c817e00a828",
      "translation": "贤人会议",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0001",
      "source_text_sha256": "beef6afa431e042aead7a2e2bc1c3a117a1aebbcbe16bc61a0686c817e00a828",
      "translation": "贤人会议",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0002",
      "source_text_sha256": "beef6afa431e042aead7a2e2bc1c3a117a1aebbcbe16bc61a0686c817e00a828",
      "translation": "贤人会议",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0003",
      "source_text_sha256": "8c19d33d58b9ffd44d67432a8add50727b4faaadf240142130b9c6fc5756ac9c",
      "translation": "〜新地球联邦本部　贤人会议〜",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-federation",
        "organization/new-earth-federation"
      ],
      "notes": "嵌套词表子串自动例外：organization/earth-federation"
    },
    {
      "id": "story/081/dialogue/01.01/0004",
      "source_text_sha256": "7c40f9de3473f684767e32c0ca53a63dbfa62a11087d306d69be17a235d0fc54",
      "translation": "“……奇拉姆拒绝提供时空控制技术？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0005",
      "source_text_sha256": "59922d5549fba2da0d65fecd8fb15cb12c389ea4a7366cc12eb3c7f1a9e65911",
      "translation": "“嗯……他们似乎打算推进那个D计划，\n　靠自己的力量修复时空。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0006",
      "source_text_sha256": "e952181b09df2ee726d03f02b4fc87bbe370dd77bc8ed0877ca937961377c7ea",
      "translation": "“换句话说，\n　他们是想按奇拉姆的意愿重塑世界吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0007",
      "source_text_sha256": "e6c67e1af83c6ad3df55b67433e23e58ab7d2707382c5435d6a145c30bc85427",
      "translation": "“奇拉姆那帮家伙……\n　难道还死守着世界崩坏之前的体制不放吗。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "event/break-the-world",
        "organization/chiram"
      ],
      "notes": "",
      "glossary_exceptions": [
        "people/ray"
      ]
    },
    {
      "id": "story/081/dialogue/01.01/0008",
      "source_text_sha256": "ad1ee155c909e4615a1e1f7dad40979995ab28a372b7bb4ee31cae3ddecb5da8",
      "translation": "“那个国家，是因时空破坏导致时间轴错乱，被\n　提前二十年抛到多元世界的人们建立起来的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0009",
      "source_text_sha256": "3259770617a2b9106a904a13264fbfaa3f9f2661d3029d5f1ba3e91c993235cf",
      "translation": "“听说它的母体，是与旧地球联合\n　核心的大西洋联邦对立的国家。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/earth-alliance"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0010",
      "source_text_sha256": "b7b88d068b6ff94813812cae6e911508aeb4143209c2e5a7734dd95fc7cd64bb",
      "translation": "“而且，凭借那二十年的优势，\n　他们拥有我们没有的时空控制技术。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0011",
      "source_text_sha256": "403cbe9a24ed0d0f356c55eaf6fd4a9c8c2e84cf828de3fe18122f569fe2c22f",
      "translation": "“加米托夫·海曼！\n　这是你作为谈判代表的失职！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0012",
      "source_text_sha256": "22ad1c4fb4658ac63b9ef697ae0366451a5b3f5ecbdb7e481684e6eaa700a176",
      "translation": "“奇拉姆可能会以D计划为盾牌，\n　逼迫我们屈服！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0013",
      "source_text_sha256": "e10dc6087319d751a95e64f39ce2fbe003edf2a79bd10cd189fdfa9fde8d9751",
      "translation": "“冷静点，吉布利尔。\n　奇拉姆也还没完成时空控制系统。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "people/speaker-088d6bffb66a"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-088d6bffb66a。"
    },
    {
      "id": "story/081/dialogue/01.01/0014",
      "source_text_sha256": "1911d6611db8ae37478430ee4842698162a3c8d63d9b8406b9753ce6cbbee39d",
      "translation": "“而且，\n　他们恐怕也没有确信那系统能完全运作。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0015",
      "source_text_sha256": "054e90281781e9da8d2fbdf6a0d736186bb435c7df1e852ec97c1f720b376963",
      "translation": "“根据杜威的报告，\n　奇拉姆和埃曼都在继续追踪奇点。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "organization/emaan",
        "people/speaker-96eedf25cbff",
        "technology/singularity"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-96eedf25cbff。"
    },
    {
      "id": "story/081/dialogue/01.01/0016",
      "source_text_sha256": "53ba657c0af9dd4b64e7565e74be69cf648ff7dade3d21fa70bbf519cc891de8",
      "translation": "“奇点从埃曼叛逃了吗……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan",
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0017",
      "source_text_sha256": "362678eccb3f2cecff0150a3a53f893be1b18b30750d3f0aa07ccb93f533b4c9",
      "translation": "“怎么办？要不要把奇点弄到手作为保险？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0018",
      "source_text_sha256": "fad237ff8c0dce3371e28cf7d21cc40ce1b34898dcdccf5173a44daa1e8a0ea2",
      "translation": "“像捕获这种畏首畏尾的做法，\n　可能会被奇拉姆或埃曼抢先。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "organization/emaan"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0019",
      "source_text_sha256": "bd88b347c005a04f81c8ab868f429d840963e900dc66504a7888fdd878efe963",
      "translation": "“与其留下后患，不如将其抹杀。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0020",
      "source_text_sha256": "0da1f0cd78dd12a91d61f1abc13d15edfb40589c7bf35ba515dd7516d9a8d03d",
      "translation": "“这也是一个方案……一个看不清大局的凡人，\n　绝不能让他改变世界……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0021",
      "source_text_sha256": "eb425449e31be5f1702989b4245c6833f6f51cb67d0f92f57fafaf59cb72a413",
      "translation": "“因为决定世界走向的，正是这个贤人会议。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0022",
      "source_text_sha256": "2832acac4c78cdf49871b0db5cf761f485280d7b03f12f899f2da1f77fe211e5",
      "translation": "“件之极限……那个会破坏多元世界\n　之理的东西，无论如何都必须阻止。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "concept/limit-of-questions",
        "place/multiverse"
      ],
      "notes": "按日文源词绑定统一全局术语：concept/limit-of-questions。"
    },
    {
      "id": "story/081/dialogue/01.01/0023",
      "source_text_sha256": "059850b83d21b0d248ccf476a87b9107539be11e23de831345ef0580d05d1cd5",
      "translation": "“为了根除它，\n　我们才认可了那个男人的回归……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0024",
      "source_text_sha256": "39e6638d34e0ddaecb1cc4b0332e5f057dc8f11d789627810942963f6a4b0031",
      "translation": "“阿盖哈队在干什么？\n　那个奇点可是和月光洲一起行动的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "technology/singularity",
        "organization/gekkostate"
      ],
      "notes": "全文术语定稿：U:U33。"
    },
    {
      "id": "story/081/dialogue/01.01/0025",
      "source_text_sha256": "cd4371c6ddf8c48b4695de5c04f3a2c8123febd22faa2c0eb9c19e787318eb87",
      "translation": "“赶紧抓住他们，\n　连同奇点一起处理掉就行了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "technology/singularity"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0026",
      "source_text_sha256": "f862617a233d09ec5c48cfb214ed7ef637b4430dcacb154c940f59c37829ca4f",
      "translation": "“别那么着急。\n　阿盖哈队的目的可不只是歼灭月光洲。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "organization/gekkostate"
      ],
      "notes": "全文术语定稿：U:U33。"
    },
    {
      "id": "story/081/dialogue/01.01/0027",
      "source_text_sha256": "56a9be8bcdd5d16bb4d79e62cc10ca352c045e6d7bcbf8e0aa8fb1ee1d5d003f",
      "translation": "“但奇点的存在不能忽视。让杜威上校在推\n　进计划的同时，也负责捕获桂木桂这个人。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/kei",
        "people/speaker-96eedf25cbff",
        "technology/singularity"
      ],
      "notes": "嵌套词表子串自动例外：people/kei；按日文源词绑定统一全局术语：people/speaker-96eedf25cbff。"
    },
    {
      "id": "story/081/dialogue/01.01/0028",
      "source_text_sha256": "4c700ded20d8f590c330b68dc14b0c6b3581818f20e0e675cda79e9574d7e1b4",
      "translation": "“当然，如果捕获困难，也允许抹杀。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0029",
      "source_text_sha256": "dcd89ef9740a43ae05aa9b4219e699264758057ac8f59513542ebe154d9a10dd",
      "translation": "“明白了。我会这样命令杜威。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-96eedf25cbff"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-96eedf25cbff。"
    },
    {
      "id": "story/081/dialogue/01.01/0030",
      "source_text_sha256": "7e11c148fd1ae0f553cfa6f694bf11b322de72c5881feb02dce306cd79ded669",
      "translation": "“他们现在的动向如何？”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0031",
      "source_text_sha256": "c5751740c1aa9f6cb4538f43674000f7ddd5484e96dc656d1ccad717284b5f39",
      "translation": "“为了躲避埃曼的追踪，他们逃进了南美洲。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/emaan"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0032",
      "source_text_sha256": "449e7776163064fac4106aaf36c40a8ded45c06b062c381095424821cce1a7dc",
      "translation": "“南美洲吗……逃进无法地带，\n　倒是老鼠会干的事。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0033",
      "source_text_sha256": "c28c880421ba36259600230d6ddbb64a6ea5083e516b1acb2062087cb8e890ce",
      "translation": "“……”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0034",
      "source_text_sha256": "0008bc77ffe8a9def6cb9870cc85623f5980f9d45277b8f0b0e1bd4a13d92437",
      "translation": "“而且，不配合地球联邦的\n　奇拉姆只是碍事的存在。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram",
        "organization/earth-federation"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0035",
      "source_text_sha256": "74273f9934301637f6191f5467aba3021674fd2f300d4a50a0aa18e028e23ecf",
      "translation": "“正好是个机会。把那台机体投入奇拉姆吧。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0036",
      "source_text_sha256": "2ae9b3d0b44f0d3c099f6dee1e4f0c626529eb0f5173d4772d90fb79389c245c",
      "translation": "“请等一下。在这个时机进攻奇拉姆，\n　没有任何好处。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/chiram"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0037",
      "source_text_sha256": "86c844c39363d26c8f18b6e071c9b0b55c7bd39253278750285ff64197232228",
      "translation": "“如果他们有自己的时空修复方案，我们应该互\n　相拿出计划，探讨阻止世界崩溃的最佳方法。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0038",
      "source_text_sha256": "faf11633ddabfa458e058a768fbe16024774a5df80fd4b338cfa3aac20704ff4",
      "translation": "“艾岱尔准将……\n　那件事交给奇点或阿盖哈队去做就行了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "organization/ageha-team",
        "technology/singularity"
      ],
      "notes": "全文术语定稿：U:U33。\n删除模型响应串行化尾部污染。"
    },
    {
      "id": "story/081/dialogue/01.01/0039",
      "source_text_sha256": "d58b37a193710a5948334b7e4f3717ce56875b342a391e238b80b9728819af27",
      "translation": "“我们应该考虑的，已经是下一个阶段了。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0040",
      "source_text_sha256": "9c8ac8b27e16b2840ed9fc839dd33c69d0c7530c31977faf38f3e2376b3265ce",
      "translation": "“这怎么行……世界一旦崩溃，\n　一切都会归于虚无啊。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0041",
      "source_text_sha256": "5b59a98c8ef591bbd19fed3774d0ec7a8bd68689a0e65b4b1799107227c7b4eb",
      "translation": "“注意你的言辞，艾岱尔·贝尔纳尔……！”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/edel-bernal"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0042",
      "source_text_sha256": "c2e59d1b7fba737101a3c34360aa90b3509d4bc34698a68ff4f297bcce1a32be",
      "translation": "“加米托夫总帅说得对。这个贤人会议，\n　是为了统御多元世界而存在的。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "place/multiverse"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0043",
      "source_text_sha256": "0d4fcf3c0c2e8407a9d4e2179357f0c083a77a752a1821ce3b116edd8e35e570",
      "translation": "“虽然你只是末席，但让你参加是看在\n　UN的贡献份上。要认清自己的身份。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "system/un-network"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0044",
      "source_text_sha256": "fe5257bef6b55a5aeb27d92c2fdeabc38d3af2dfbdbc669184eed16b779afb98",
      "translation": "“……是。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0045",
      "source_text_sha256": "c255c6fe1c5df1a1a6d49dfbb19f994ffbfd469f2f0aeaa95f1b00c950445a10",
      "translation": "（哼……以LOGOS的经济实力为后盾\n　的贤人会议，终究只是个摆设……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/speaker-539973d146a5"
      ],
      "notes": "按日文源词绑定统一全局术语：people/speaker-539973d146a5。"
    },
    {
      "id": "story/081/dialogue/01.01/0046",
      "source_text_sha256": "7d9ef3de34da541e244daebda4c801148c3bae47b721efd193c7491706800365",
      "translation": "（总有一天，\n　也要让这些老家伙们明白这一点……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0047",
      "source_text_sha256": "668bbbd47b64197d2dc7473861b6a548b604dd7dee3a25830f3f1f4779583318",
      "translation": "“这个世界不会毁灭。而统御世界、\n　引导人类走向更好的方向，是我们的职责。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0048",
      "source_text_sha256": "8d970bfb0c4809f9e40b640e5c4ced2b45359c846be66888f86988f15063a7a8",
      "translation": "“绝不能把这个世界交给迪兰达尔之流。”",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [
        "people/durandal"
      ],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0049",
      "source_text_sha256": "aad5a4355392a03e3ae46cae18efe6797f2eb14883d790e6e447f15ebd1a6413",
      "translation": "（被眼前利益束缚的人，\n　没有预见未来的能力……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    },
    {
      "id": "story/081/dialogue/01.01/0050",
      "source_text_sha256": "1cbab45b183c4b1ec780cacfe0c0603844013aac0a8b58b5c6811d45f95430d6",
      "translation": "（也许，坐在这里的人才是将\n　世界封闭于黑暗的元凶……）",
      "editorial_status": "draft",
      "translation_action": "translate",
      "glossary_refs": [],
      "notes": ""
    }
  ]
}
